#!/bin/sh

# Node naming / Erlang distribution for the release.
#
# This script is sourced by *every* release command (start, eval, remote, ...).
# It originally curled the AWS ECS task-metadata endpoint to derive the
# container IP for a distributed node name. That endpoint does not exist on
# Fly.io, so the curl failed ("curl: (3) URL rejected: No host part in the URL")
# and every release command — including DB migrations — aborted at boot.
#
# Detect the platform instead:
#   * Fly.io  -> single machine, no clustering, so distribution is disabled.
#   * AWS ECS -> keep the original metadata-based distributed node name.
#   * neither -> no distribution.

if [ -n "$FLY_ALLOC_ID" ] || [ -n "$FLY_PRIVATE_IP" ]; then
  export RELEASE_DISTRIBUTION=none
elif [ -n "$ECS_CONTAINER_METADATA_URI_V4" ]; then
  # The interpolated env var is created by default by AWS ECS. See
  # https://docs.aws.amazon.com/AmazonECS/latest/userguide/task-metadata-endpoint-v4-fargate.html
  TASK_METADATA=$(curl -s "${ECS_CONTAINER_METADATA_URI_V4}/task")
  HOSTNAME=$(echo "$TASK_METADATA" | jq -r '.Containers[0].Networks[0].IPv4Addresses[0]')

  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="$RELEASE_NAME@$HOSTNAME"
else
  export RELEASE_DISTRIBUTION=none
fi
