{
 "uid": "mehungry-fly",
 "title": "Mehungry \u2014 Fly platform (m3hungry)",
 "tags": [
  "mehungry",
  "fly"
 ],
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "timezone": "browser",
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "CPU used (cores) per machine",
   "datasource": {
    "type": "prometheus",
    "uid": "fly"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fly"
     },
     "expr": "sum by (instance) (rate(fly_instance_cpu{app=\"m3hungry\",mode!=\"idle\"}[$__rate_interval]))",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "id": 1
  },
  {
   "type": "timeseries",
   "title": "Memory used per machine",
   "datasource": {
    "type": "prometheus",
    "uid": "fly"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fly"
     },
     "expr": "fly_instance_memory_mem_total{app=\"m3hungry\"} - fly_instance_memory_mem_available{app=\"m3hungry\"}",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "id": 2
  },
  {
   "type": "timeseries",
   "title": "Swap used per machine",
   "datasource": {
    "type": "prometheus",
    "uid": "fly"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fly"
     },
     "expr": "fly_instance_memory_swap_total{app=\"m3hungry\"} - fly_instance_memory_swap_free{app=\"m3hungry\"}",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "id": 3
  },
  {
   "type": "timeseries",
   "title": "Load average (1m)",
   "datasource": {
    "type": "prometheus",
    "uid": "fly"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fly"
     },
     "expr": "fly_instance_load_average{app=\"m3hungry\",minutes=\"1\"}",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "Edge HTTP responses by status",
   "datasource": {
    "type": "prometheus",
    "uid": "fly"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fly"
     },
     "expr": "sum by (status) (rate(fly_edge_http_responses_count{app=\"m3hungry\"}[$__rate_interval]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "App HTTP response time",
   "datasource": {
    "type": "prometheus",
    "uid": "fly"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fly"
     },
     "expr": "histogram_quantile(0.50, sum by (le) (rate(fly_app_http_response_time_seconds_bucket{app=\"m3hungry\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fly"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(fly_app_http_response_time_seconds_bucket{app=\"m3hungry\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fly"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(fly_app_http_response_time_seconds_bucket{app=\"m3hungry\"}[$__rate_interval])))",
     "legendFormat": "p99",
     "refId": "C"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Concurrent connections per machine",
   "datasource": {
    "type": "prometheus",
    "uid": "fly"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fly"
     },
     "expr": "fly_app_concurrency{app=\"m3hungry\"}",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Network throughput",
   "datasource": {
    "type": "prometheus",
    "uid": "fly"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fly"
     },
     "expr": "sum by (instance) (rate(fly_instance_net_recv_bytes{app=\"m3hungry\",device=\"eth0\"}[$__rate_interval]))",
     "legendFormat": "{{instance}} in",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fly"
     },
     "expr": "sum by (instance) (rate(fly_instance_net_sent_bytes{app=\"m3hungry\",device=\"eth0\"}[$__rate_interval]))",
     "legendFormat": "{{instance}} out",
     "refId": "B"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "id": 8
  }
 ]
}