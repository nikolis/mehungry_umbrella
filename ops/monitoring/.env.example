# Copy to .env on the monitoring box (chmod 600). Never commit the real file.

# Grafana login (user: admin)
GRAFANA_ADMIN_PASSWORD=

# Backend scrape: the METRICS_API_TOKEN Fly secret of the m3hungry app
METRICS_API_TOKEN=

# Fly hosted Prometheus. Token from `fly tokens create readonly personal`;
# paste the whole value including the "FlyV1 " prefix, in double quotes.
FLY_ORG_SLUG=personal
FLY_PROM_TOKEN=""

# Supabase: Project Settings -> General (ref) and -> API keys (service_role / secret key)
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry (EU region). Token scopes: org:read, project:read, event:read
SENTRY_URL=https://de.sentry.io
SENTRY_ORG_SLUG=
SENTRY_AUTH_TOKEN=
