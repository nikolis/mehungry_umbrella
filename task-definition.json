                },
                {
                    "name": "STRIPE_PRO_PRICE_ID",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/stripe_pro_price_id-3mHTYD"
                },
                {
                    "name": "STRIPE_PRO_YEARLY_PRICE_ID",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/stripe_pro_yearly_price_id-aYKUVh"
                },
