{
    "family": "mehungry_app_deployment",
    "taskRoleArn": "arn:aws:iam::011528270584:role/EcsTaskCommunicationRole",
    "executionRoleArn": "arn:aws:iam::011528270584:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "2048",
    "memory": "4096",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "containerDefinitions": [
        {
          "name": "log_router",
          "image": "011528270584.dkr.ecr.eu-central-1.amazonaws.com/mehungry-fluent-bit:latest",
          "cpu": 128,
          "memoryReservation": 128,
          "essential": true,
          "secrets": [
            {
              "name": "ALLOY_LOG_TOKEN",
              "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/logs_api_token-AN5l42"
            }
          ],
          "firelensConfiguration": {
            "type": "fluentbit",
            "options": {
              "enable-ecs-log-metadata": "true",
              "config-file-type": "file",
              "config-file-value": "/extra.conf"
            }
          },
          "logConfiguration": {
             "logDriver": "awslogs",
             "options": {
              "awslogs-group": "/ecs/mehungry_firelens",
              "awslogs-region": "eu-central-1",
              "awslogs-create-group": "true",
              "awslogs-stream-prefix": "firelens",
              "mode": "non-blocking",
              "max-buffer-size": "25m"
            }
          }
        },
        {
            "name": "mehungry_app",
            "image": "011528270584.dkr.ecr.eu-central-1.amazonaws.com/mehungry_ecr:4e3bf58c1f8ea3052f8539eaad140ed77f337b6a",
            "cpu": 0,
            "essential": true,
            "portMappings": [
                {
                    "name": "mehungry_app-4000-tcp",
                    "containerPort": 4000,
                    "hostPort": 4000,
                    "protocol": "tcp",
                    "appProtocol": "http"
                },
                { "containerPort": 4369, "hostPort": 4369, "protocol": "tcp" },
                { "containerPort": 9000, "hostPort": 9000, "protocol": "tcp" },
                { "containerPort": 9001, "hostPort": 9001, "protocol": "tcp" },
                { "containerPort": 9002, "hostPort": 9002, "protocol": "tcp" },
                { "containerPort": 9003, "hostPort": 9003, "protocol": "tcp" },
                { "containerPort": 9004, "hostPort": 9004, "protocol": "tcp" }
            ],
            "environment": [
                { "name": "SOME_APP_SSL_KEY_PATH", "value": "priv/cert/SSL_PrivateKEY_www_m3hungry_com.pem" },
                { "name": "SOME_APP_SSL_CERT_PATH", "value": "priv/cert/SSL_CSR_www_m3hungry_com.pem" },
                { "name": "AWS_ASSETS_BUCKET_NAME", "value": "mehungry-main-bucket" },
                { "name": "POOL_SIZE", "value": "18" },
                { "name": "ERL_AFLAGS", "value": "+S 2:2 +sbwt none +sbwtdcpu none +sbwtdio none" }
            ],
            "secrets": [
                {
                    "name": "OPENAI_API_KEY",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/open_api_key-jzV1rM"
                },
                {
                    "name": "LOCAL_AI_API_TOKEN",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/local_ai_api_key-85FS2Q"
                },
                {
                    "name": "METRICS_API_TOKEN",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/metrics_api_token-c9gkhq"
                },

                {
                    "name": "RELEASE_COOKIE",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/release_cookie-QYj6rK"
                },
                {
                    "name": "DATABASE_URL",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/database_url-dRiOCt"
                },
                {
                    "name": "PINTEREST_CLIENT_ID",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/pinterest_client_id-Gyq1Ms"
                },
                {
                    "name": "PINTEREST_CLIENT_SECRET",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/pinterest_client_secret-cN7CS0"
                },
                {
                    "name": "AWS_ACCESS_KEY_ID",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/aws_key_id-DGDOfP"
                },
                {
                    "name": "AWS_SECRET_ACCESS_KEY",
