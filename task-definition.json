{
    "family": "mehungry_app_deployment",
    "taskRoleArn": "arn:aws:iam::011528270584:role/EcsTaskCommunicationRole",
    "executionRoleArn": "arn:aws:iam::011528270584:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "1024",
    "memory": "3072",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "containerDefinitions": [
        {
            "name": "mehungry_app",
            "image": "011528270584.dkr.ecr.eu-central-1.amazonaws.com/mehungry_ecr:4e3bf58c1f8ea3052f8539eaad140ed77f337b6a",
            "cpu": 0,
            "essential": true,
            "portMappings": [
                {
                    "name": "mehungry_app-4000-tcp",
                    "containerPort": 4000,
                    "hostPort": 4000,
                    "protocol": "tcp",
                    "appProtocol": "http"
                },
                { "containerPort": 4369, "hostPort": 4369, "protocol": "tcp" },
                { "containerPort": 9000, "hostPort": 9000, "protocol": "tcp" },
                { "containerPort": 9001, "hostPort": 9001, "protocol": "tcp" },
                { "containerPort": 9002, "hostPort": 9002, "protocol": "tcp" },
                { "containerPort": 9003, "hostPort": 9003, "protocol": "tcp" },
                { "containerPort": 9004, "hostPort": 9004, "protocol": "tcp" }
            ],
            "environment": [
                { "name": "ERLANG_COOKIE", "value": "MEHUNGRY_SECURE_CLUSTER_COOKIE_2024" }
            ],
            "secrets": [
                {
                    "name": "RELEASE_COOKIE",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/release_cookie-QYj6rK"
                },
                {
                    "name": "STRIPE_SECRET_KEY",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/stripe_secret_key-QS1Cz9"
                },
                {
                    "name": "STRIPE_WEBHOOK_SECRET",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/stripe_webhook_secret-5RXsew"
                },
                {
                    "name": "STRIPE_PRO_PRICE_ID",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/stripe_pro_price_id-3mHTYD"
                },
                {
                    "name": "STRIPE_PRO_YEARLY_PRICE_ID",
                    "valueFrom": "arn:aws:secretsmanager:eu-central-1:011528270584:secret:mehungry/prod/stripe_pro_yearly_price_id-aYKUVh"
                }
            ],
            "environmentFiles": [],
            "mountPoints": [],
            "volumesFrom": [],
            "ulimits": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/mehungry_app_deployment",
                    "mode": "non-blocking",
                    "awslogs-create-group": "true",
                    "max-buffer-size": "25m",
                    "awslogs-region": "eu-central-1",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        }
    ]
}
