{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping Mehungry /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["mehungry", "ai"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "name": "agent",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(mehungry_web_prom_ex_ai_agent_run_total, agent)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "title": "Mehungry — AI Agents",
  "uid": "mehungry-ai-agents",
  "panels": [
    {
      "type": "row",
      "title": "Reliability",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Agent runs by outcome (per min)",
      "description": "end_turn is success; max_iterations / max_tokens / error are the failure modes.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(mehungry_web_prom_ex_ai_agent_run_total{agent=~\"$agent\"}[5m]) * 60)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Non-success run ratio (last 6h)",
      "description": "Share of runs that ended in max_iterations / max_tokens / error.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.15 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(mehungry_web_prom_ex_ai_agent_run_total{outcome!=\"end_turn\", agent=~\"$agent\"}[6h])) / clamp_min(sum(increase(mehungry_web_prom_ex_ai_agent_run_total{agent=~\"$agent\"}[6h])), 1)",
          "legendFormat": "non-success"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RecipeAgent no-submit retries (per min)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(mehungry_web_prom_ex_ai_agent_no_submit_retry_total[5m]) * 60)",
          "legendFormat": "no_submit retries"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Run duration p50 / p95 (ms)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, agent) (rate(mehungry_web_prom_ex_ai_agent_run_duration_milliseconds_bucket{agent=~\"$agent\"}[5m])))",
          "legendFormat": "p50 {{agent}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(mehungry_web_prom_ex_ai_agent_run_duration_milliseconds_bucket{agent=~\"$agent\"}[5m])))",
          "legendFormat": "p95 {{agent}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Iterations per run p95 (ceiling watch)",
      "description": "If p95 approaches the agent's max_iterations, the loop is nearly running out of turns.",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(mehungry_web_prom_ex_ai_agent_run_iterations_bucket{agent=~\"$agent\"}[5m])))",
          "legendFormat": "p95 {{agent}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Tools",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "type": "timeseries",
      "title": "Tool calls by tool & status (per min)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "sum by (tool, status) (rate(mehungry_web_prom_ex_ai_agent_tool_total{agent=~\"$agent\"}[5m]) * 60)",
          "legendFormat": "{{tool}} · {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool duration p95 by tool (ms)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(mehungry_web_prom_ex_ai_agent_tool_duration_milliseconds_bucket{agent=~\"$agent\"}[5m])))",
          "legendFormat": "p95 {{tool}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Anthropic API (cost & latency)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }
    },
    {
      "type": "timeseries",
      "title": "Tokens per min by model",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "targets": [
        {
          "expr": "sum by (model) (rate(mehungry_web_prom_ex_ai_client_input_tokens_total[5m]) * 60)",
          "legendFormat": "in · {{model}}"
        },
        {
          "expr": "sum by (model) (rate(mehungry_web_prom_ex_ai_client_output_tokens_total[5m]) * 60)",
          "legendFormat": "out · {{model}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API latency p95 & error rate",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(mehungry_web_prom_ex_ai_client_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p95 {{model}}"
        },
        {
          "expr": "sum(rate(mehungry_web_prom_ex_ai_client_request_total{status=\"error\"}[5m]) * 60)",
          "legendFormat": "errors/min"
        }
      ]
    }
  ]
}
