# App-status snapshot env — copy to ~/.config/mehungry/report.env and fill in.
# This example is committed; the real file is NOT (keep it out of git, chmod 600).
# Loaded by bin/report_snapshot.sh before running `mix report.snapshot`.

# Prod read-only DB (the report_ro role, via the Supabase IPv4 pooler — the
# direct db.<ref>.supabase.co host is IPv6-only). See docs/app_status.md §7.1.
REPORT_RO_DATABASE_URL="postgresql://report_ro.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# GA4 + Search Console (one service account; see §7.2).
GA4_SA_KEY="/absolute/path/to/service-account.json"   # path to the JSON key, or the raw JSON inline
GA4_PROPERTY_ID="123456789"                            # numeric GA4 property id
GSC_SITE_URL="sc-domain:example.com"                   # or https://www.example.com/

# Pinterest analytics (§7.4). Needs live host + the prod app credentials; the
# stored token may need a one-time reconnect in the prod app if it has lapsed.
PINTEREST_ENV="live"
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
