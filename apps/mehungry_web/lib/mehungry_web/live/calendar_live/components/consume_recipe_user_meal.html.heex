<div id={"rootb_layer" <> to_string(@f.index)} style={if @deleted, do: "display: none"}>
  <input
    type="hidden"
    name={Phoenix.HTML.Form.input_name(@f, :delete)}
    value={to_string(Phoenix.HTML.Form.input_value(@f, :delete))}
  />
  <.input field={@f[:user_meal_id]} value={to_string(@user_meal.id)} type="hidden" />

  <div class="bg-slate-800 border border-slate-700 rounded-xl p-3 space-y-3">
    <div class="flex items-start gap-2">
      <div class="flex-1 min-w-0">
        <.live_component
          module={MehungryWeb.SelectComponent}
          form={@f}
          items={@recipe_user_meals}
          input_variable="recipe_user_meal_id"
          label_function={fn x -> x.recipe.title end}
          id={"user_meal_search_component" <> Integer.to_string(@f.index)}
        />
      </div>
      <button
        type="button"
        phx-click="delete_consume_record"
        phx-target={@parent_component}
        phx-value-index={@f.index}
        class="mt-1 p-1.5 rounded-lg text-slate-500 hover:text-red-400 hover:bg-red-500/10 transition-colors flex-shrink-0"
      >
        <svg width="1.1rem" height="1.1rem" viewBox="0 0 24 24" fill="none">
          <path
            d="M4 7h16M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2M6 10v8a2 2 0 002 2h8a2 2 0 002-2V10M10 12v5M14 12v5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </div>

    <div class="input-form">
      <.input field={@f[:consume_portions]} type="number" label="Consume portions" />
    </div>
  </div>
</div>
