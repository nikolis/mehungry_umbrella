<div id={"root_layer" <> to_string(@f.index)} style={if @deleted, do: "display: none"}>
  <input
    type="hidden"
    name={Phoenix.HTML.Form.input_name(@f, :delete)}
    value={to_string(Phoenix.HTML.Form.input_value(@f, :delete))}
  />

  <div class="bg-black/20 border border-ink-panel2 rounded-xl p-3 space-y-3">
    <div class="flex items-start gap-2">
      <div class="flex-1 min-w-0">
        <.live_component
          module={MehungryWeb.SelectComponent}
          form={@f}
          items={Enum.map(@recipes, fn x -> {Integer.to_string(x.id), x.title} end)}
          input_variable={:recipe_id}
          id={"recipe_search_component" <> Integer.to_string(@f.index)}
        />
      </div>
      <button
        type="button"
        phx-click="delete_recipe_record"
        phx-value-index={@f.index}
        phx-target={@parent_component}
        class="mt-1 p-1.5 rounded-lg text-parchment-dim hover:text-red-400 hover:bg-red-500/10 transition-colors flex-shrink-0"
      >
        <svg width="1.1rem" height="1.1rem" viewBox="0 0 24 24" fill="none">
          <path
            d="M4 7h16M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2M6 10v8a2 2 0 002 2h8a2 2 0 002-2V10M10 12v5M14 12v5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div class="input-form">
        <.input field={@f[:cooking_portions]} type="text" label="Prepare" />
      </div>
      <div class="input-form">
        <.input field={@f[:consume_portions]} type="text" label="Consume" />
      </div>
    </div>
  </div>
</div>
