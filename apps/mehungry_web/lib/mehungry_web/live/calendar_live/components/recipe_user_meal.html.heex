<div id={"root_layer" <> to_string(@f.index)} class="" style={if @deleted, do: "display: none"}>
  <div class="w-full max-w-md mx-auto px-4 pt-4">
    <!-- Mode Toggle -->
    <div class="flex bg-slate-700 rounded-xl p-1 shadow-inner">
      <button
        type="button"
        phx-click="set_mode"
        phx-value-mode="recipe"
        phx-target={@myself}
        class={
        "flex-1 py-2 text-sm font-medium rounded-lg transition-all px-2 " <>
        if @mode == "recipe" do
          "bg-slate-900 text-white shadow"
        else
          "text-slate-400 hover:text-slate-200"
        end
      }
      >
        Recipe
      </button>
      <button
        type="button"
        phx-click="set_mode"
        phx-target={@myself}
        phx-value-mode="ingredient"
        class={
        "flex-1 py-2 text-sm font-medium rounded-lg transition-all px-2 " <>
        if @mode == "ingredient" do
          "bg-slate-900 text-white shadow"
        else
          "text-slate-400 hover:text-slate-200"
        end
      }
      >
        Ingredient
      </button>
      <div class="px-3 py-2 text-slate-400 text-sm font-medium">Meal</div>
    </div>
  </div>

  <input
    type="hidden"
    name={Phoenix.HTML.Form.input_name(@f, :delete)}
    value={to_string(Phoenix.HTML.Form.input_value(@f, :delete))}
  />

  <div class="p-4 space-y-3">
    <div class="w-full">
      <.live_component
        module={MehungryWeb.SelectComponent}
        form={@f}
        items={Enum.map(@recipes, fn x -> {Integer.to_string(x.id), x.title} end)}
        input_variable={:recipe_id}
        id={"recipe_search_component" <> Integer.to_string(@f.index)}
      />
    </div>

    <div class="flex gap-3 justify-center">
      <div class="input-form h-10 w-32">
        <.input field={@f[:cooking_portions]} type="text" label="Prepare" />
      </div>
      <div class="input-form h-10 w-32">
        <.input field={@f[:consume_portions]} type="text" label="Consume" />
      </div>
    </div>
  </div>
</div>
