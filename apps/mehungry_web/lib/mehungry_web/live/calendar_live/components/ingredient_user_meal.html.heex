<div
  id={"root_layer_ingredient" <> to_string(@f.index)}
  style={if @deleted, do: "display: none"}
>
  <input
    type="hidden"
    name={Phoenix.HTML.Form.input_name(@f, :delete)}
    value={to_string(Phoenix.HTML.Form.input_value(@f, :delete))}
  />

  <div class="bg-black/20 border border-ink-panel2 rounded-xl p-3 space-y-3">
    <div class="flex items-start gap-2">
      <div class="flex-1 min-w-0">
        <.live_component
          module={MehungryWeb.SelectComponentDeep}
          form={@f}
          item_function={fn term -> Mehungry.Food.IngredientSearch.search(term, [], @current_user_id) end}
          flags_function={
            fn ids -> MehungryWeb.RecipeFlags.flags_for_ingredient_ids(ids, @condition_ids) end
          }
          get_by_id_func={&Mehungry.Food.get_ingredient!/1}
          input_variable="ingredient_id"
          label_function={fn item -> Mehungry.Utils.remove_parenthesis(item.name) end}
          placeholder="Select an ingredient..."
          modal_title="Search Ingredients"
          parent_id={"ingredient_form_#{@f.index}"}
          id={"ingredient_search_component" <> Integer.to_string(@f.index)}
        />
      </div>
      <button
        type="button"
        phx-click="delete_ingredient_record"
        phx-value-index={@f.index}
        phx-target={@parent_component}
        class="mt-1 p-1.5 rounded-lg text-parchment-dim hover:text-red-400 hover:bg-red-500/10 transition-colors flex-shrink-0"
      >
        <svg width="1.1rem" height="1.1rem" viewBox="0 0 24 24" fill="none">
          <path
            d="M4 7h16M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2M6 10v8a2 2 0 002 2h8a2 2 0 002-2V10M10 12v5M14 12v5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div class="input-form">
        <.input field={@f[:quantity]} type="number" label="Quantity" />
      </div>
      <div>
        <.live_component
          module={MehungryWeb.SelectComponent}
          items={Enum.map(@measurement_units, fn x -> {Integer.to_string(x.id), x.name} end)}
          form={@f}
          id={"measurement_unit_search_component" <> Integer.to_string(@f.index)}
          input_variable={:measurement_unit_id}
        />
      </div>
    </div>
  </div>
</div>
