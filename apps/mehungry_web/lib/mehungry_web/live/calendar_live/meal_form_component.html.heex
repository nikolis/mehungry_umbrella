<div class="flex flex-col h-full bg-ink">
  <.form
    id={@id}
    for={@form}
    phx-change="validate"
    phx-submit="submit"
    class="flex flex-col h-full"
    phx-target={@myself}
  >
    <.input field={@form[:title]} label="Title" type="hidden" />
    <.input field={@form[:meal_type]} type="hidden" />
    <.input field={@form[:start_dt]} type="hidden" />
    <.input field={@form[:end_dt]} type="hidden" />
    <.input field={@form[:user_id]} type="hidden" />

    <div class="px-4 pt-4 pb-3 border-b border-ink-panel2">
      <p class="text-xs font-semibold text-parchment-dim uppercase tracking-wider mb-2">
        Meal
      </p>
      <% current_meal_type =
        if @form[:meal_type].value in [nil, ""], do: nil, else: @form[:meal_type].value %>
      <div class="flex flex-wrap gap-1.5 mb-3">
        <%= for meal_type <- Mehungry.History.MealType.ordered() ++ [nil] do %>
          <% selected = current_meal_type == meal_type %>
          <button
            type="button"
            phx-click="set_meal_type"
            phx-value-meal_type={meal_type || "unsorted"}
            phx-target={@myself}
            class={
              "px-3 py-1.5 text-xs font-medium rounded-full transition-all " <>
              if selected do
                "bg-paprika text-ink shadow"
              else
                "bg-ink-panel2 text-parchment-dim hover:text-parchment"
              end
            }
          >
            {Mehungry.History.MealType.label(meal_type)}
          </button>
        <% end %>
      </div>
    </div>

    <div class="px-4 pt-4 pb-3 border-b border-ink-panel2">
      <div class="flex bg-ink-panel2 rounded-xl p-1">
        <button
          type="button"
          phx-click="set_mode"
          phx-value-mode="recipe"
          phx-target={@myself}
          class={
            "flex-1 py-2 text-sm font-medium rounded-lg transition-all " <>
            if @mode == "recipe" do
              "bg-paprika text-ink shadow"
            else
              "text-parchment-dim hover:text-parchment"
            end
          }
        >
          Recipe
        </button>
        <button
          type="button"
          phx-click="set_mode"
          phx-value-mode="ingredient"
          phx-target={@myself}
          class={
            "flex-1 py-2 text-sm font-medium rounded-lg transition-all " <>
            if @mode == "ingredient" do
              "bg-paprika text-ink shadow"
            else
              "text-parchment-dim hover:text-parchment"
            end
          }
        >
          Ingredient
        </button>
      </div>
    </div>

    <div class="flex-1 overflow-y-auto px-4 py-4 space-y-6">
      <div>
        <p class="text-xs font-semibold text-parchment-dim uppercase tracking-wider mb-3">
          Prepare
        </p>
        <div class="space-y-2">
          <%= if @mode == "recipe" do %>
            <.inputs_for :let={f_recipe_user_meal} field={@form[:recipe_user_meals]}>
              <Components.recipe_user_meal_render
                f={f_recipe_user_meal}
                parent_component={@myself}
                recipes={@recipes}
                mode={@mode}
                myself={@myself}
                recipe_ids={@recipe_ids}
              />
            </.inputs_for>
            <button
              type="button"
              phx-click="new_recipe"
              phx-target={@myself}
              class="w-full py-2 rounded-lg border border-dashed border-ink-panel2 text-parchment-dim hover:border-basil/40 hover:text-parchment text-sm transition-colors"
            >
              + Add recipe
            </button>
          <% else %>
            <.inputs_for :let={f_ingredient_user_meal} field={@form[:ingredient_user_meals]}>
              <Components.ingredient_user_meal_render
                f={f_ingredient_user_meal}
                parent_component={@myself}
                recipes={@recipes}
                mode={@mode}
                current_user_id={@current_user.id}
                condition_ids={@condition_ids}
                unit_options={
                  Map.get(@unit_options_by_index, f_ingredient_user_meal.index, @gram_options)
                }
                myself={@myself}
                recipe_ids={@recipe_ids}
              />
            </.inputs_for>
            <button
              type="button"
              phx-click="new_ingredient"
              phx-target={@myself}
              class="w-full py-2 rounded-lg border border-dashed border-ink-panel2 text-parchment-dim hover:border-basil/40 hover:text-parchment text-sm transition-colors"
            >
              + Add ingredient
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <div class="sticky bottom-0 bg-ink border-t border-ink-panel2 px-4 py-3 flex items-center justify-between gap-2">
      <%= if @live_action in [:edit] do %>
        <button
          type="button"
          phx-value-id={@user_meal.id}
          phx-click="delete_user_meal"
          class="px-2 py-2 text-red-500/70 hover:text-red-400 text-sm font-medium transition-colors"
        >
          Delete
        </button>
      <% else %>
        <div />
      <% end %>
      <button
        type="submit"
        class="px-6 py-2 rounded-lg bg-paprika hover:bg-paprika-soft text-ink text-sm font-bold transition-colors shadow-md"
        phx-disable-with="Saving…"
      >
        Save
      </button>
    </div>
  </.form>
</div>
