<div class="bg-slate-900 min-h-full">
  <.form
    id={@id}
    for={@form}
    phx-change="validate"
    phx-submit="submit"
    class="w-full"
    phx-target={@myself}
  >
    <.input field={@form[:title]} label="Title" type="hidden" />
    <.input field={@form[:start_dt]} type="hidden" />
    <.input field={@form[:end_dt]} type="hidden" />
    <.input field={@form[:user_id]} type="hidden" />

    <div class="w-full pb-16">
      <%= if @mode == "recipe" do %>
        <.inputs_for :let={f_recipe_user_meal} field={@form[:recipe_user_meals]}>
          <Components.recipe_user_meal_render
            f={f_recipe_user_meal}
            parent_component={@myself}
            recipes={@recipes}
            mode={@mode}
            myself={@myself}
            recipe_ids={@recipe_ids}
          />
        </.inputs_for>
      <% else %>
        <.inputs_for :let={f_ingredient_user_meal} field={@form[:ingredient_user_meals]}>
          <Components.ingredient_user_meal_render
            f={f_ingredient_user_meal}
            parent_component={@myself}
            recipes={@recipes}
            mode={@mode}
            measurement_units={
              get_measurement_units(f_ingredient_user_meal, f_ingredient_user_meal.index)
            }
            myself={@myself}
            recipe_ids={@recipe_ids}
          />
        </.inputs_for>
      <% end %>
      <.inputs_for :let={f_consume_recipe_user_meal} field={@form[:consume_recipe_user_meals]}>
        <Components.consume_recipe_user_meal_render
          f={f_consume_recipe_user_meal}
          parent_component={@myself}
          recipe_user_meals={@recipe_user_meals}
          recipe_user_meal_ids={@recipe_user_meal_ids}
          user_meal={@user_meal}
        />
      </.inputs_for>
    </div>

    <div class="absolute bottom-3 right-4 flex gap-2 items-center">
      <%= if @live_action in [:edit] do %>
        <button
          class="px-4 py-2 rounded-lg border border-red-500/50 text-red-400 hover:bg-red-500/10 text-sm font-medium transition-colors"
          phx-value-id={@user_meal.id}
          phx-click="delete_user_meal"
          type="button"
        >
          Delete
        </button>
      <% end %>
      <button
        class="px-5 py-2 rounded-lg bg-primary-500 hover:bg-primary-400 text-white text-sm font-semibold transition-colors shadow-md"
        phx_disable_with="Saving..."
      >
        Save
      </button>
    </div>
  </.form>
</div>
