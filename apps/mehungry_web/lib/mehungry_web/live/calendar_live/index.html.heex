<div id="page-timer" phx-hook="PageTimer" class="hidden"></div>
<div
  style="height: 100%; overflow-y: auto;"
  class="bg-slate-900"
>
  <div class="px-3 sm:px-4 pt-3">
    <div class="flex justify-end mb-2">
      <button
        type="button"
        id="ai-plan-toggle"
        phx-click={
          Phoenix.LiveView.JS.toggle(
            to: "#ai-plan-panel",
            in:
              {"transition-all duration-300 ease-out", "opacity-0 -translate-y-2 scale-95",
               "opacity-100 translate-y-0 scale-100"},
            out:
              {"transition-all duration-200 ease-in", "opacity-100 translate-y-0 scale-100",
               "opacity-0 -translate-y-2 scale-95"}
          )
          |> Phoenix.LiveView.JS.toggle_class("bg-primary-500/20 border-primary-500",
            to: "#ai-plan-toggle"
          )
        }
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-primary-500/50 text-primary-400 hover:bg-primary-500/10 text-xs font-medium transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 10V3L4 14h7v7l9-11h-7z"
          />
        </svg>
        Plan with AI
      </button>
    </div>

    <div
      class="bg-slate-800 border border-slate-700 rounded-xl p-4 mb-3 hidden"
      id="ai-plan-panel"
    >
      <h3 class="text-white font-semibold text-sm mb-3 flex items-center gap-2">
        <svg
          class="w-4 h-4 text-primary-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 10V3L4 14h7v7l9-11h-7z"
          />
        </svg>
        Generate this week's meal plan
      </h3>
      <form phx-submit="ai_plan_week" class="flex flex-col sm:flex-row gap-3">
        <textarea
          name="prompt"
          rows="2"
          placeholder="Describe your preferences… e.g. 'Healthy week for 2, high protein, no shellfish'"
          class="flex-1 bg-slate-900 text-white rounded-lg p-3 text-sm resize-none border border-slate-600 focus:border-primary-500 focus:outline-none"
        ></textarea>
        <button
          type="submit"
          disabled={@ai_plan_generating}
          class="px-5 py-2 bg-primary-500 hover:bg-primary-600 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg text-white font-semibold text-sm self-end transition"
        >
          <%= if @ai_plan_generating do %>
            <span class="flex items-center gap-2">
              <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"
                >
                </circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                >
                </path>
              </svg>
              Planning…
            </span>
          <% else %>
            Generate
          <% end %>
        </button>
      </form>
      <%= if @ai_plan_result do %>
        <p class="text-green-400 text-xs mt-3 flex items-center gap-1.5">
          <svg
            class="w-3.5 h-3.5 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"
            />
          </svg>
          {@ai_plan_result}
        </p>
      <% end %>
      <%= if @ai_quota_exceeded do %>
        <div class="mt-3 rounded-lg bg-amber-500/10 border border-amber-500/30 p-3 flex items-center justify-between gap-3">
          <p class="text-amber-300 text-xs">
            You've reached your AI meal plan limit for this month.
          </p>
          <.link
            navigate={~p"/upgrade"}
            class="flex-shrink-0 px-3 py-1.5 rounded-lg bg-primary-500 hover:bg-primary-600 text-white text-xs font-semibold transition"
          >
            Upgrade
          </.link>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Meal plan rating widget (shown when user has a nutritionist) -->
  <%= if assigns[:has_nutritionist] do %>
    <div class="px-3 sm:px-4 pt-2 pb-1">
      <div
        class="bg-slate-800/60 border border-teal-700/30 rounded-xl p-4"
        x-data="{dailyScore: 0, weeklyScore: 0, showRating: false}"
      >
        <button
          x-on:click="showRating = !showRating"
          class="flex items-center gap-2 text-teal-400 text-xs font-medium hover:text-teal-300 transition"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
            />
          </svg>
          Rate this week's meal plan
          <svg
            class="w-3 h-3 transition-transform"
            x-bind:class="showRating ? 'rotate-180' : ''"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            />
          </svg>
        </button>

        <div x-show="showRating" x-transition class="mt-3 space-y-4">
          <!-- Weekly rating -->
          <div>
            <p class="text-slate-300 text-xs mb-2 font-medium">Weekly rating</p>
            <form phx-submit="rate_meal_plan" class="flex flex-col gap-2">
              <input type="hidden" name="type" value="weekly" />
              <input
                type="hidden"
                name="date"
                value={Date.beginning_of_week(Date.utc_today()) |> Date.to_iso8601()}
              />
              <div class="flex items-center gap-1" x-data="{score: 0}">
                <%= for i <- 1..5 do %>
                  <button
                    type="button"
                    x-on:click={"score = #{i}; document.getElementById('weekly_score').value = #{i}"}
                    x-bind:class={"score >= #{i} ? 'text-yellow-400' : 'text-slate-600'"}
                    class="transition text-2xl"
                  >★</button>
                <% end %>
                <input type="hidden" name="score" id="weekly_score" x-bind:value="score" />
              </div>
              <textarea
                name="comment"
                rows="2"
                placeholder="Optional comment..."
                class="w-full bg-slate-900 border border-slate-600 rounded-lg px-3 py-2 text-white text-xs focus:outline-none focus:border-teal-500"
              ></textarea>
              <button
                type="submit"
                class="self-start px-3 py-1.5 rounded-lg bg-teal-700 hover:bg-teal-600 text-white text-xs transition"
              >
                Submit weekly rating
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <.modal
    :if={@live_action in [:new, :edit]}
    on_cancel={JS.patch(~p"/calendar")}
    id="calendar_modal"
    show
  >
    <div class="w-full h-full">
      <.live_component
        module={MehungryWeb.CalendarLive.MealFormComponent}
        id={@user_meal.id || :new}
        title={@user_meal.title || @title}
        live_action={@live_action}
        invocations={@invocations}
        recipes={@recipes}
        dates={@dates}
        current_user={@current_user}
        return_to={@detail_return_to || Routes.calendar_index_path(@socket, :index)}
      />
    </div>
  </.modal>

  <.modal
    :if={@live_action in [:nutrition_details]}
    on_cancel={JS.patch(~p"/calendar")}
    id="calendar_modal23"
    show
  >
    <div class="w-full">
      <.live_component
        module={MehungryWeb.NutrientAnalysisComponent}
        id={:details}
        current_user={@current_user}
        particular_date={@nutrition_details}
        return_to={@detail_return_to || Routes.calendar_index_path(@socket, :index)}
      />
    </div>
  </.modal>

  <.live_component
    module={MehungryWeb.CalendarLive.Calendar.Widget}
    id={:new}
    user_meals={@user_meals}
    particular_date={@particular_date}
    title="Alter Basket"
    calendar_view={@calendar_view}
    action={@live_action}
    user={@current_user}
    device_width={@device_width}
    current_language={@current_language}
  />
</div>
