<div
  style="height: 100%; overflow-y: auto;"
  class="calendar-page bg-ink text-parchment"
>
  <div class="px-3 sm:px-4 pt-3">
    <div class="flex justify-end gap-2 mb-2">
      <button
        type="button"
        id="share-week-open"
        phx-click={show_modal("share_week_modal")}
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-ink-panel2 text-parchment-dim hover:text-parchment hover:border-paprika/40 text-xs font-medium transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
          />
        </svg>
        {gettext("Share this week")}
      </button>
      <button
        type="button"
        id="avoid-foods-open"
        phx-click={show_modal("avoid_foods_modal")}
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-ink-panel2 text-parchment-dim hover:text-parchment hover:border-amber-400/50 text-xs font-medium transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"
          />
        </svg>
        {gettext("Foods I avoid")}
        <span
          :if={@avoid_foods != []}
          class="ml-0.5 inline-flex items-center justify-center min-w-[1.1rem] h-[1.1rem] px-1 rounded-full bg-amber-500/20 text-amber-300 text-[0.65rem] font-bold"
        >
          {length(@avoid_foods)}
        </span>
      </button>
      <button
        type="button"
        id="create-week-basket"
        phx-click="create_week_basket"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-ink-panel2 text-parchment-dim hover:text-parchment hover:border-basil/40 text-xs font-medium transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-1.5 1.5M17 13l1.5 1.5M9 21h6M12 21v-8"
          />
        </svg>
        {gettext("Shopping list")}
      </button>
      <button
        type="button"
        id="clear-week"
        phx-click="clear_week_meals"
        data-confirm={gettext("Delete every meal from the week you're viewing? This can't be undone.")}
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-ink-panel2 text-parchment-dim hover:text-red-300 hover:border-red-500/50 text-xs font-medium transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
          />
        </svg>
        {gettext("Clear week")}
      </button>
      <button
        type="button"
        id="ai-plan-toggle"
        phx-click={
          Phoenix.LiveView.JS.toggle(
            to: "#ai-plan-panel",
            in:
              {"transition-all duration-300 ease-out", "opacity-0 -translate-y-2 scale-95",
               "opacity-100 translate-y-0 scale-100"},
            out:
              {"transition-all duration-200 ease-in", "opacity-100 translate-y-0 scale-100",
               "opacity-0 -translate-y-2 scale-95"}
          )
          |> Phoenix.LiveView.JS.toggle_class("bg-ink-panel2 border-basil/50",
            to: "#ai-plan-toggle"
          )
        }
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-ink-panel2 text-parchment-dim hover:text-parchment hover:border-basil/40 text-xs font-medium transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 10V3L4 14h7v7l9-11h-7z"
          />
        </svg>
        Plan with AI
      </button>
    </div>

    <div
      class={[
        "bg-ink-panel border border-ink-panel2 rounded-xl p-4 mb-3",
        !@preselected_blueprint_id && "hidden"
      ]}
      id="ai-plan-panel"
    >
      <h3 class="font-display font-medium text-parchment text-sm mb-3 flex items-center gap-2">
        <svg
          class="w-4 h-4 text-parchment-dim"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 10V3L4 14h7v7l9-11h-7z"
          />
        </svg>
        Generate this week's meal plan
      </h3>
      <form phx-submit="ai_plan_week" class="flex flex-col sm:flex-row gap-3">
        <div class="flex-1 flex flex-col gap-2">
          <textarea
            name="prompt"
            rows="2"
            placeholder="Describe your preferences… e.g. 'Healthy week for 2, high protein, no shellfish'"
            class="flex-1 bg-ink text-parchment rounded-lg p-3 text-sm resize-none border border-ink-panel2 focus:border-paprika focus:outline-none"
          ></textarea>
          <div :if={@blueprints != []} class="flex items-center gap-2">
            <label class="text-parchment-dim text-xs whitespace-nowrap">Follow blueprint:</label>
            <select
              name="blueprint_id"
              class="flex-1 bg-ink text-parchment rounded-lg px-2 py-1.5 text-xs border border-ink-panel2 focus:border-paprika focus:outline-none"
            >
              <option value="">None</option>
              <option
                :for={bp <- @blueprints}
                value={bp.id}
                selected={to_string(bp.id) == @preselected_blueprint_id}
              >
                {bp.name}
              </option>
            </select>
            <.link navigate={~p"/browse"} class="text-paprika-soft text-xs hover:text-paprika">
              Browse
            </.link>
          </div>
        </div>
        <button
          type="submit"
          disabled={@ai_plan_generating}
          class="px-5 py-2 rounded-lg border border-ink-panel2 text-parchment-dim hover:text-parchment hover:border-parchment-dim disabled:opacity-50 disabled:cursor-not-allowed font-semibold text-sm self-end transition"
        >
          <%= if @ai_plan_generating do %>
            <span class="flex items-center gap-2">
              <MehungryWeb.SvgComponents.get_loading compact class="w-4 h-4" />
              Planning…
            </span>
          <% else %>
            Generate
          <% end %>
        </button>
      </form>
      <%= if @ai_plan_result do %>
        <p class="text-green-400 text-xs mt-3 flex items-center gap-1.5">
          <svg
            class="w-3.5 h-3.5 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"
            />
          </svg>
          {@ai_plan_result}
        </p>
      <% end %>
      <%= if @ai_quota_exceeded do %>
        <div class="mt-3 rounded-lg bg-amber-500/10 border border-amber-500/30 p-3 flex items-center justify-between gap-3">
          <p class="text-amber-300 text-xs">
            You've reached your AI meal plan limit for this month.
          </p>
          <.link
            navigate={~p"/upgrade"}
            class="flex-shrink-0 px-3 py-1.5 rounded-lg border border-amber-500/40 text-amber-300 hover:bg-amber-500/10 text-xs font-semibold transition"
          >
            Upgrade
          </.link>
        </div>
      <% end %>
    </div>

    <MehungryWeb.BlueprintComponents.blueprint_progress
      :if={@active_blueprint && @blueprint_progress}
      blueprint={@active_blueprint}
      progress={@blueprint_progress}
    />
  </div>

  <!-- Meal plan rating widget (shown when user has a nutritionist) -->
  <%= if assigns[:has_nutritionist] do %>
    <div class="px-3 sm:px-4 pt-2 pb-1">
      <.link
        navigate={~p"/messages"}
        class="inline-flex items-center gap-1.5 mb-2 text-paprika-soft text-xs font-medium hover:text-paprika transition"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
          />
        </svg>
        Message your nutritionist →
      </.link>
      <div
        class="bg-ink-panel border border-ink-panel2 rounded-xl p-4"
        x-data="{showRating: false}"
      >
        <button
          x-on:click="showRating = !showRating"
          class="flex items-center gap-2 text-parchment-dim text-xs font-medium hover:text-parchment transition"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
            />
          </svg>
          Rate this week's meal plan
          <svg
            class="w-3 h-3 transition-transform"
            x-bind:class="showRating ? 'rotate-180' : ''"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            />
          </svg>
        </button>

        <div x-show="showRating" x-transition class="mt-3 space-y-4">
          <!-- Weekly rating -->
          <div>
            <p class="text-parchment-dim text-xs mb-2 font-medium">Weekly rating</p>
            <form phx-submit="rate_meal_plan" class="flex flex-col gap-2">
              <input type="hidden" name="type" value="weekly" />
              <input
                type="hidden"
                name="date"
                value={Date.beginning_of_week(Date.utc_today()) |> Date.to_iso8601()}
              />
              <div class="flex items-center gap-1" x-data="{score: 0}">
                <%= for i <- 1..5 do %>
                  <button
                    type="button"
                    x-on:click={"score = #{i}; document.getElementById('weekly_score').value = #{i}"}
                    x-bind:class={"score >= #{i} ? 'text-yellow-400' : 'text-parchment-dim/40'"}
                    class="transition text-2xl"
                  >★</button>
                <% end %>
                <input type="hidden" name="score" id="weekly_score" x-bind:value="score" />
              </div>
              <textarea
                name="comment"
                rows="2"
                placeholder="Optional comment..."
                class="w-full bg-ink border border-ink-panel2 rounded-lg px-3 py-2 text-parchment text-xs focus:outline-none focus:border-paprika"
              ></textarea>
              <button
                type="submit"
                class="self-start px-3 py-1.5 rounded-lg border border-ink-panel2 text-parchment-dim hover:text-parchment hover:border-parchment-dim text-xs font-medium transition"
              >
                Submit weekly rating
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <.modal
    :if={@live_action in [:new, :edit]}
    on_cancel={JS.patch(~p"/calendar")}
    id="calendar_modal"
    show
  >
    <div class="w-full h-full">
      <.live_component
        module={MehungryWeb.CalendarLive.MealFormComponent}
        id={@user_meal.id || :new}
        title={@user_meal.title || @title}
        meal_type={@user_meal.meal_type}
        live_action={@live_action}
        invocations={@invocations}
        recipes={@recipes}
        dates={@dates}
        current_user={@current_user}
        current_language={@current_language}
        return_to={@detail_return_to || ~p"/calendar"}
      />
    </div>
  </.modal>

  <.modal
    :if={@live_action in [:nutrition_details]}
    on_cancel={JS.patch(~p"/calendar")}
    id="calendar_modal23"
    show
  >
    <div class="w-full">
      <.live_component
        module={MehungryWeb.NutrientAnalysisComponent}
        id={:details}
        current_user={@current_user}
        particular_date={@nutrition_details}
        return_to={@detail_return_to || ~p"/calendar"}
      />
    </div>
  </.modal>

  <MehungryWeb.RecipeComponents.recipe_modal
    :if={@live_action in [:show_recipe] and @recipe}
    on_cancel={JS.patch(~p"/calendar")}
    id="calendar_recipe_details_modal"
    show
  >
    <div class="w-full" style="min-height: 55vh;">
      <.live_component
        module={MehungryWeb.RecipeDetailsComponent}
        id="recipe_details_component"
        recipe={@recipe}
        user_recipes={@current_user_recipes}
        current_user={@current_user}
        page_title={"Recipe #{@recipe.title}"}
        user_follows={@current_user_follows}
        live_action={@live_action}
      />
    </div>
  </MehungryWeb.RecipeComponents.recipe_modal>

  <.modal id="share_week_modal" show={false} on_cancel={JS.push("reset_share")}>
    <div class="w-full">
      <h3 class="font-display font-medium text-parchment text-lg mb-1 flex items-center gap-2">
        <svg class="w-5 h-5 text-paprika" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
          />
        </svg>
        {gettext("Share this week")}
      </h3>

      <%= cond do %>
        <% @share_generating -> %>
          <div class="flex flex-col items-center gap-3 py-10">
            <svg
              class="animate-spin w-8 h-8 text-paprika"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
            </svg>
            <p class="text-parchment-dim text-sm">{gettext("Creating your card…")}</p>
          </div>

        <% @share_graphic && !@share_regenerate -> %>
          <p class="text-parchment-dim/70 text-xs mb-3">
            {gettext("Your saved card for this week.")}
          </p>
          <img
            src={@share_graphic.image_url}
            alt={gettext("Weekly plan card")}
            class="w-full max-w-sm mx-auto rounded-xl border border-ink-panel2 mb-4"
          />
          <div class="flex flex-wrap gap-2 justify-center">
            <a
              href={@share_graphic.image_url}
              target="_blank"
              rel="noopener"
              download
              class="flex items-center gap-1.5 px-4 py-2 rounded-lg border border-ink-panel2 text-parchment-dim hover:text-parchment hover:border-basil/40 text-sm font-medium transition-colors"
            >
              {gettext("Download")}
            </a>
            <button
              id="share-week-native"
              phx-hook="WebShare"
              data-url={@share_graphic.image_url}
              data-title={gettext("My weekly meal plan")}
              class="flex items-center gap-1.5 px-4 py-2 rounded-lg border border-ink-panel2 text-parchment-dim hover:text-parchment hover:border-basil/40 text-sm font-medium transition-colors"
            >
              <span>{gettext("Share")}</span>
            </button>
            <button
              :if={!@share_posted}
              type="button"
              phx-click="post_week_plan"
              class="flex items-center gap-1.5 px-4 py-2 rounded-lg bg-paprika hover:bg-paprika-soft text-ink text-sm font-bold transition-colors"
            >
              {gettext("Post to m3hungry")}
            </button>
          </div>
          <p :if={@share_posted} class="text-center text-basil text-sm mt-4">
            {gettext("Posted!")}
            <.link navigate={~p"/home"} class="underline hover:text-basil/80">
              {gettext("View in feed")}
            </.link>
          </p>
          <div class="mt-5 pt-4 border-t border-ink-panel2 text-center">
            <button
              type="button"
              phx-click="start_regenerate"
              class="inline-flex items-center gap-1.5 text-parchment-dim hover:text-parchment text-sm font-medium transition-colors"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                />
              </svg>
              {gettext("Re-generate from the latest plan")}
            </button>
          </div>

        <% true -> %>
          <form phx-submit="generate_week_card" class="space-y-4">
            <div>
              <label class="block text-parchment-dim text-xs uppercase tracking-wide mb-1">
                {gettext("Goal label (optional)")}
              </label>
              <input
                type="text"
                name="goal_label"
                maxlength="28"
                value={@share_graphic && @share_graphic.goal_label}
                placeholder={gettext("e.g. Anti-inflammatory")}
                class="w-full bg-ink border border-ink-panel2 rounded-lg px-3 py-2 text-parchment text-sm focus:outline-none focus:border-paprika"
              />
            </div>
            <p class="text-parchment-dim/70 text-xs leading-relaxed">
              {gettext(
                "This shares your meal titles and weekly nutrition totals publicly. Your day notes and shopping basket stay private."
              )}
            </p>
            <button
              type="submit"
              class="w-full flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg bg-paprika hover:bg-paprika-soft text-ink text-sm font-bold transition-colors"
            >
              <%= if @share_graphic do %>
                {gettext("Replace saved card")}
              <% else %>
                {gettext("Create shareable card")}
              <% end %>
            </button>
          </form>
      <% end %>
    </div>
  </.modal>

  <.modal id="avoid_foods_modal" show={false} on_cancel={%JS{}}>
    <div class="w-full">
      <h3 class="font-display font-medium text-parchment text-lg mb-1 flex items-center gap-2">
        <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636"
          />
        </svg>
        {gettext("Foods I avoid")}
      </h3>
      <p class="text-parchment-dim/70 text-xs leading-relaxed mb-4">
        {gettext(
          "List foods you'd rather not eat — one per line. Any meal on your calendar containing one gets flagged. This list is private to you."
        )}
      </p>
      <form phx-submit="save_avoid_foods" class="space-y-4">
        <textarea
          name="foods"
          rows="6"
          placeholder={gettext("e.g.\nonion\ngarlic\nshellfish")}
          class="w-full bg-ink border border-ink-panel2 rounded-lg px-3 py-2 text-parchment text-sm focus:outline-none focus:border-amber-400 resize-none"
        ><%= Enum.join(@avoid_foods, "\n") %></textarea>
        <button
          type="submit"
          phx-click={hide_modal("avoid_foods_modal")}
          class="w-full flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-ink text-sm font-bold transition-colors"
        >
          {gettext("Save avoid list")}
        </button>
      </form>
    </div>
  </.modal>

  <.live_component
    module={MehungryWeb.CalendarLive.Calendar.Widget}
    id={:new}
    user_meals={@user_meals}
    day_notes={@day_notes}
    particular_date={@particular_date}
    calendar_view={@calendar_view}
    user={@current_user}
    calorie_target={@calorie_target}
    device_width={@device_width}
    current_language={@current_language}
    active_blueprint={@active_blueprint}
    blueprint_progress={@blueprint_progress}
    avoid_terms={@avoid_terms}
  />
</div>
