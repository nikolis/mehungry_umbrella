<div class="species-detail-page min-h-screen bg-ink text-parchment pb-16">
  <div class="container max-w-3xl mx-auto px-4 py-8">
    <nav class="text-sm text-parchment-dim mb-6">
      <a href="/foods" class="hover:text-parchment transition-colors">Foods</a>
      <span class="mx-2">›</span>
      <span class="text-parchment">{@display_name}</span>
    </nav>

    <%!-- ── Hero: food identity + the page's unfair advantage (the evidence
          signal). Both are in the dead render — the tally is resolved
          synchronously for crawlers; when connected it pops in after the async
          research load. --%>
    <% research_ready = @research.ok? and @research.result != [] %>
    <% hero_tally = if research_ready, do: research_tally(@research.result), else: nil %>
    <div class="mb-8 flex items-start gap-4 sm:gap-5">
      <div class="shrink-0 text-5xl sm:text-6xl leading-none select-none" aria-hidden="true">
        {Mehungry.Food.species_icon(@species)}
      </div>
      <div class="min-w-0 flex-1">
        <h1 class="text-3xl font-display font-medium text-parchment mb-2">{@display_name}</h1>
        <div class="flex flex-wrap gap-2">
          <%= if @species.scientific_name && @species.scientific_name != "" do %>
            <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-ink-panel2 text-parchment-dim italic">
              {@species.scientific_name}
            </span>
          <% end %>
          <%= if @species.family && @species.family != "" do %>
            <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-ink-panel2 text-parchment-dim">
              {@species.family}
            </span>
          <% end %>
          <%= if @species.variety && @species.variety != "" do %>
            <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-ink-panel2 text-parchment-dim">
              {@species.variety}
            </span>
          <% end %>
        </div>

        <%!-- The thesis: this isn't a USDA mirror — every claim is PubMed-cited and
             verdict-checked. Lead with it; it's what no other nutrition DB has. --%>
        <a
          :if={hero_tally && hero_tally.total > 0}
          href="#research-findings"
          class="group mt-3 inline-flex flex-wrap items-center gap-x-2 gap-y-1.5 text-sm text-parchment-dim"
        >
          <span class="inline-flex items-center gap-1.5 rounded-full bg-ink-panel border border-ink-panel2 px-3 py-1 group-hover:border-parchment-dim/40 transition-colors">
            <span class="[font-variant-numeric:tabular-nums] text-parchment font-medium">
              {hero_tally.total}
            </span>
            {gettext("PubMed-cited findings")}
          </span>
          <span
            :if={hero_tally.verified > 0}
            class="inline-flex items-center gap-1.5 text-basil"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-basil" aria-hidden="true" />
            <span class="[font-variant-numeric:tabular-nums] font-medium">{hero_tally.verified}</span>
            {gettext("corroborated")}
          </span>
        </a>
      </div>
    </div>

    <%!-- ── Nutrients (per selected ingredient) ─────────────────────────── --%>
    <section class="mb-10">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-4">
        <h2 class="text-lg font-display font-medium text-parchment">
          Nutrition <span class="text-parchment-dim font-normal text-sm ml-2">per 100g</span>
        </h2>
        <%= if length(@ingredients) > 0 do %>
          <form id="species-ingredient-form" phx-change="select_ingredient" class="relative">
            <label class="sr-only" for="ingredient-select">Choose a food</label>
            <select
              id="ingredient-select"
              name="id"
              class="appearance-none cursor-pointer bg-ink-panel border border-ink-panel2 rounded-xl pl-3 pr-9 py-2 text-sm text-parchment hover:border-parchment-dim/40 focus:outline-none focus:border-paprika focus:ring-1 focus:ring-paprika transition-colors max-w-full"
            >
              <%= for ingredient <- @ingredients do %>
                <option
                  value={ingredient.id}
                  selected={@selected_ingredient && ingredient.id == @selected_ingredient.id}
                >
                  {ingredient.name}
                </option>
              <% end %>
            </select>
            <svg
              class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-parchment-dim"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </form>
        <% end %>
      </div>

      <%= cond do %>
        <% is_nil(@selected_ingredient) -> %>
          <p class="text-parchment-dim text-sm">
            No USDA foods are curated onto this species yet.
          </p>
        <% length(@top_nutrients) == 0 -> %>
          <p class="text-parchment-dim text-sm">
            No nutrition data for {@selected_ingredient.name} yet.
          </p>
        <% true -> %>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
            <%= for n <- @top_nutrients do %>
              <div class="bg-ink-panel rounded-xl p-4 text-center border border-ink-panel2">
                <div class="text-2xl font-bold text-basil [font-variant-numeric:tabular-nums]">
                  {format_macro(n.amount)}<span class="text-sm font-medium text-parchment-dim ml-0.5">{macro_unit(n.unit)}</span>
                </div>
                <div class="text-sm font-medium text-parchment-dim mt-1.5">
                  {MehungryWeb.NutrientLabels.translate_name(n.label)}
                </div>
              </div>
            <% end %>
          </div>
      <% end %>
    </section>

    <%= if map_size(@nutrient_tree) > 0 do %>
      <section class="mb-10">
        <h2 class="text-lg font-display font-medium text-parchment mb-4">
          {gettext("Full Nutrition Breakdown")}
          <span class="text-parchment-dim font-normal text-sm ml-2">{gettext("per 100g")}</span>
        </h2>
        <%= if @composition_summary do %>
          <p class="text-parchment-dim leading-relaxed mb-4">{@composition_summary}</p>
        <% end %>
        <%= if @micronutrient_summary do %>
          <p class="text-parchment-dim leading-relaxed mb-4">{@micronutrient_summary}</p>
        <% end %>
        <div class="bg-ink-panel border border-ink-panel2 rounded-xl overflow-hidden">
          <MehungryWeb.NutritionAccordion.nutrition_accordion
            nutrients={@nutrient_tree}
            max_height="600px"
            show_title={false}
            locale={assigns[:current_language] || "en"}
          />
        </div>
      </section>
    <% end %>

    <%!-- ── Origins & cultivation (enrichment facts) ───────────────────────── --%>
    <%!-- Promoted Wikidata (CC0) + FAOSTAT (CC BY) facts. Rendered in the dead render
          (assigned synchronously) so the origin/producers content is crawlable. --%>
    <section :if={enrichment?(@facts)} class="mb-10">
      <h2 class="text-lg font-display font-medium text-parchment mb-4">
        {gettext("Origins & cultivation")}
      </h2>
      <dl class="grid gap-4 sm:grid-cols-2">
        <div :if={fact_text(@facts, "origin_region")} class="bg-ink-panel border border-ink-panel2 rounded-xl p-4">
          <dt class="text-xs font-semibold uppercase tracking-wide text-parchment-dim/60">
            {gettext("Origin")}
          </dt>
          <dd class="mt-1 text-parchment">{fact_text(@facts, "origin_region")}</dd>
        </div>

        <div :if={producer_countries(@facts) != []} class="bg-ink-panel border border-ink-panel2 rounded-xl p-4">
          <dt class="text-xs font-semibold uppercase tracking-wide text-parchment-dim/60">
            {gettext("Top producing countries")}
          </dt>
          <dd class="mt-1 text-parchment">{Enum.join(producer_countries(@facts), " · ")}</dd>
          <%!-- FAOSTAT is CC BY 4.0 — attribution is required where its data is shown. --%>
          <p class="mt-2 text-xs text-parchment-dim/60">
            {gettext("Production data")}: FAO FAOSTAT{if year = producers_year(@facts),
              do: " (#{year})"} · CC BY 4.0
          </p>
        </div>

        <div
          :if={fact_text(@facts, "description")}
          class="bg-ink-panel border border-ink-panel2 rounded-xl p-4 sm:col-span-2"
        >
          <dt class="text-xs font-semibold uppercase tracking-wide text-parchment-dim/60">
            {gettext("About")}
          </dt>
          <dd class="mt-1 text-parchment">
            {fact_text(@facts, "description")}
            <a
              :if={fact_text(@facts, "wikipedia_url")}
              href={fact_text(@facts, "wikipedia_url")}
              target="_blank"
              rel="noopener"
              class="ml-1 text-sm text-basil-soft hover:text-basil whitespace-nowrap"
            >
              {gettext("Read more on Wikipedia")} ↗
            </a>
          </dd>
        </div>

        <div
          :if={is_nil(fact_text(@facts, "description")) and not is_nil(fact_text(@facts, "wikipedia_url"))}
          class="bg-ink-panel border border-ink-panel2 rounded-xl p-4 sm:col-span-2"
        >
          <dd class="text-parchment">
            <a
              href={fact_text(@facts, "wikipedia_url")}
              target="_blank"
              rel="noopener"
              class="text-sm text-basil-soft hover:text-basil"
            >
              {gettext("Read more on Wikipedia")} ↗
            </a>
          </dd>
        </div>
      </dl>
    </section>

    <%!-- ── Research findings (mined biomedical facts) ─────────────────────── --%>
    <%!-- Verdict-led "evidence ledger": facts grouped by honest verification
          verdict and ranked human-relevance → verdict → evidence strength. The
          Verified claims lead; the disputed + unverified tail collapses behind a
          single toggle. All facts stay in the (crawlable) dead-render DOM —
          Alpine only toggles visibility, so SEO is unaffected. --%>
    <section id="research-findings" class="mb-10 scroll-mt-6">
      <div class="flex items-baseline justify-between gap-3 mb-1">
        <h2 class="text-lg font-display font-medium text-parchment">
          {gettext("Research findings")}
        </h2>
      </div>
      <p class="text-sm text-parchment-dim/80 leading-relaxed mb-5 max-w-2xl">
        {gettext(
          "Each finding is a claim distilled from a published study, with an honest verdict on how strongly the wider literature backs it."
        )}
      </p>
      <%= cond do %>
        <% @research.loading -> %>
          <div class="space-y-2" aria-hidden="true">
            <div :for={_ <- 1..3} class="m3-skeleton h-16 w-full rounded-xl bg-ink-panel2" />
          </div>
        <% @research.failed -> %>
          <p class="text-parchment-dim text-sm">{gettext("Couldn't load research.")}</p>
        <% @research.ok? && length(@research.result) == 0 -> %>
          <p class="text-parchment-dim text-sm">
            {gettext("No research findings mined for this species yet.")}
          </p>
        <% true -> %>
          <% {lead, rest} = research_lead_and_rest(@research.result) %>
          <% tally = research_tally(@research.result) %>
          <%!-- Honest evidence tally — the section's opening signal. --%>
          <div class="flex flex-wrap items-center gap-2 mb-5 text-xs font-medium">
            <span
              :if={tally.verified > 0}
              class="inline-flex items-center gap-1.5 rounded-full bg-basil/15 text-basil px-2.5 py-1"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-basil" aria-hidden="true" />
              <span class="[font-variant-numeric:tabular-nums]">{tally.verified}</span>
              {gettext("corroborated")}
            </span>
            <span
              :if={tally.contradicted > 0}
              class="inline-flex items-center gap-1.5 rounded-full bg-paprika/15 text-paprika px-2.5 py-1"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-paprika" aria-hidden="true" />
              <span class="[font-variant-numeric:tabular-nums]">{tally.contradicted}</span>
              {gettext("contradicted")}
            </span>
            <span
              :if={tally.unverified > 0}
              class="inline-flex items-center gap-1.5 rounded-full bg-ink-panel2 text-parchment-dim px-2.5 py-1"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-parchment-dim/40" aria-hidden="true" />
              <span class="[font-variant-numeric:tabular-nums]">{tally.unverified}</span>
              {gettext("unverified")}
            </span>
            <span class="text-parchment-dim/60 ml-auto">
              {gettext("PubMed-cited")}
            </span>
          </div>

          <%!-- Lead: the verified, human-relevant claims (the readable payload). --%>
          <ul :if={lead != []} class="space-y-3">
            <.research_fact :for={fact <- lead} fact={fact} />
          </ul>
          <p :if={lead == []} class="text-sm text-parchment-dim/80 mb-3">
            {gettext("No verified claims yet — see the findings under review below.")}
          </p>

          <%!-- Tail: contradicted + unverified, one honest click away. Native
               <details> — no JS, keyboard-accessible, and every fact stays in the
               crawlable dead-render DOM even while collapsed (SEO unaffected). --%>
          <details :if={rest != []} class="group/rest mt-4">
            <summary class="inline-flex items-center gap-1.5 cursor-pointer list-none text-sm font-medium text-parchment-dim hover:text-parchment transition-colors [&::-webkit-details-marker]:hidden">
              <span class="group-open/rest:hidden">
                {gettext("Show %{count} findings under review", count: length(rest))}
              </span>
              <span class="hidden group-open/rest:inline">
                {gettext("Hide findings under review")}
              </span>
              <svg
                class="w-4 h-4 transition-transform group-open/rest:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <ul class="space-y-3 mt-3">
              <.research_fact :for={fact <- rest} fact={fact} />
            </ul>
          </details>
      <% end %>
    </section>

    <%!-- ── Recipes with this food ──────────────────────────────────────────── --%>
    <section class="mb-10">
      <h2 class="text-lg font-display font-medium text-parchment mb-4">
        {gettext("Recipes with %{food}", food: @display_name)}
      </h2>

      <%= cond do %>
        <% @recipes.loading -> %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" aria-hidden="true">
            <div
              :for={_ <- 1..4}
              class="flex items-center gap-3 bg-ink-panel border border-ink-panel2 rounded-xl p-3"
            >
              <div class="m3-skeleton w-16 h-16 rounded-lg bg-ink-panel2 flex-shrink-0" />
              <div class="flex-1 min-w-0 space-y-2">
                <div class="m3-skeleton h-3.5 w-4/5 rounded bg-ink-panel2" />
                <div class="m3-skeleton h-3 w-1/3 rounded bg-ink-panel2" />
              </div>
            </div>
          </div>
        <% @recipes.failed -> %>
          <p class="text-parchment-dim text-sm">{gettext("Couldn't load recipes for this food.")}</p>
        <% @recipes.ok? && length(@recipes.result) == 0 -> %>
          <p class="text-parchment-dim text-sm">{gettext("No recipes use this food yet.")}</p>
        <% true -> %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <%= for recipe <- @recipes.result do %>
              <a
                href={"/browse/#{recipe.id}"}
                class="group flex items-center gap-3 bg-ink-panel border border-ink-panel2 rounded-xl p-3 hover:border-paprika/50 hover:bg-ink-panel2/80 transition-colors"
              >
                <div class="w-16 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-ink-panel2">
                  <%= if recipe.image_url do %>
                    <img
                      src={recipe.image_url}
                      alt={recipe.title}
                      class="w-full h-full object-cover"
                    />
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center">
                      <svg
                        class="w-6 h-6 text-parchment-dim"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                        />
                      </svg>
                    </div>
                  <% end %>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-parchment group-hover:text-paprika-soft transition-colors truncate">
                    {recipe.title}
                  </p>
                  <%= if recipe.cooking_time_lower_limit do %>
                    <p class="text-xs text-parchment-dim mt-0.5">
                      <span class="font-bold text-basil [font-variant-numeric:tabular-nums]">{recipe.cooking_time_lower_limit}</span>
                      {gettext("min")}
                    </p>
                  <% end %>
                </div>
                <svg
                  class="w-4 h-4 text-parchment-dim/50 group-hover:text-parchment-dim flex-shrink-0 transition-colors"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            <% end %>
          </div>
      <% end %>
    </section>

    <.nutritionist_recruit_cta current_user={assigns[:current_user]} variant={:inline} class="mt-12" />
  </div>
</div>
