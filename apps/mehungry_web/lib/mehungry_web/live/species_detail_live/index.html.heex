<div class="species-detail-page min-h-screen bg-ink text-parchment pb-16">
  <div class="container max-w-3xl mx-auto px-4 py-8">
    <nav class="text-sm text-parchment-dim mb-6">
      <a href="/foods" class="hover:text-parchment transition-colors">Foods</a>
      <span class="mx-2">›</span>
      <span class="text-parchment">{@display_name}</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-display font-medium text-parchment mb-2">{@display_name}</h1>
      <div class="flex flex-wrap gap-2">
        <%= if @species.scientific_name && @species.scientific_name != "" do %>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-ink-panel2 text-parchment-dim italic">
            {@species.scientific_name}
          </span>
        <% end %>
        <%= if @species.family && @species.family != "" do %>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-ink-panel2 text-parchment-dim">
            {@species.family}
          </span>
        <% end %>
        <%= if @species.variety && @species.variety != "" do %>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-ink-panel2 text-parchment-dim">
            {@species.variety}
          </span>
        <% end %>
      </div>
    </div>

    <%!-- ── Nutrients (per selected ingredient) ─────────────────────────── --%>
    <section class="mb-10">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-4">
        <h2 class="text-lg font-display font-medium text-parchment">
          Nutrition <span class="text-parchment-dim font-normal text-sm ml-2">per 100g</span>
        </h2>
        <%= if length(@ingredients) > 0 do %>
          <form id="species-ingredient-form" phx-change="select_ingredient">
            <label class="sr-only" for="ingredient-select">Choose a food</label>
            <select
              id="ingredient-select"
              name="id"
              class="bg-ink-panel border border-ink-panel2 rounded-xl px-3 py-2 text-sm text-parchment focus:outline-none focus:border-paprika focus:ring-1 focus:ring-paprika transition-colors max-w-full"
            >
              <%= for ingredient <- @ingredients do %>
                <option
                  value={ingredient.id}
                  selected={@selected_ingredient && ingredient.id == @selected_ingredient.id}
                >
                  {ingredient.name}
                </option>
              <% end %>
            </select>
          </form>
        <% end %>
      </div>

      <%= cond do %>
        <% is_nil(@selected_ingredient) -> %>
          <p class="text-parchment-dim text-sm">
            No USDA foods are curated onto this species yet.
          </p>
        <% length(@top_nutrients) == 0 -> %>
          <p class="text-parchment-dim text-sm">
            No nutrition data for {@selected_ingredient.name} yet.
          </p>
        <% true -> %>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
            <%= for n <- @top_nutrients do %>
              <div class="bg-ink-panel rounded-xl p-4 text-center border border-ink-panel2">
                <div class="text-2xl font-bold text-basil [font-variant-numeric:tabular-nums]">
                  {format_amount(n.amount)}
                </div>
                <div class="text-xs text-parchment-dim mt-0.5">{n.unit}</div>
                <div class="text-sm font-medium text-parchment-dim mt-1">
                  {MehungryWeb.NutrientLabels.translate_name(n.label)}
                </div>
              </div>
            <% end %>
          </div>
      <% end %>
    </section>

    <%= if map_size(@nutrient_tree) > 0 do %>
      <section class="mb-10">
        <h2 class="text-lg font-display font-medium text-parchment mb-4">
          {gettext("Full Nutrition Breakdown")}
          <span class="text-parchment-dim font-normal text-sm ml-2">{gettext("per 100g")}</span>
        </h2>
        <%= if @composition_summary do %>
          <p class="text-parchment-dim leading-relaxed mb-4">{@composition_summary}</p>
        <% end %>
        <div class="bg-ink-panel border border-ink-panel2 rounded-xl overflow-hidden">
          <MehungryWeb.NutritionAccordion.nutrition_accordion
            nutrients={@nutrient_tree}
            max_height="600px"
            show_title={false}
            locale={assigns[:current_language] || "en"}
          />
        </div>
      </section>
    <% end %>

    <%!-- ── Bioactive compounds ─────────────────────────────────────────── --%>
    <section class="mb-10">
      <h2 class="text-lg font-display font-medium text-parchment mb-4">
        {gettext("Bioactive Compounds")}
      </h2>
      <%= cond do %>
        <% @compounds.loading -> %>
          <div class="space-y-2" aria-hidden="true">
            <div :for={_ <- 1..3} class="m3-skeleton h-10 w-full rounded-xl bg-ink-panel2" />
          </div>
        <% @compounds.failed -> %>
          <p class="text-parchment-dim text-sm">{gettext("Couldn't load compounds.")}</p>
        <% @compounds.ok? && length(@compounds.result) == 0 -> %>
          <p class="text-parchment-dim text-sm">
            {gettext("No compounds linked to this species yet.")}
          </p>
        <% true -> %>
          <div class="flex flex-wrap gap-2">
            <%= for rel <- @compounds.result do %>
              <span class="inline-flex items-center gap-2 bg-ink-panel border border-ink-panel2 rounded-xl px-3 py-1.5 text-sm">
                <span class="text-parchment">{rel.compound.name}</span>
                <button
                  type="button"
                  phx-click="show_evidence"
                  phx-value-rel-id={rel.id}
                  phx-value-compound={rel.compound.name}
                  title={gettext("View the research supporting this")}
                  class="text-xs text-parchment-dim underline decoration-dotted underline-offset-2 hover:text-paprika-soft transition-colors cursor-pointer"
                >
                  {relationship_label(rel.relationship_type)}
                </button>
              </span>
            <% end %>
          </div>
      <% end %>
    </section>

    <%!-- ── Recipes with this food ──────────────────────────────────────────── --%>
    <section class="mb-10">
      <h2 class="text-lg font-display font-medium text-parchment mb-4">
        {gettext("Recipes with %{food}", food: @display_name)}
      </h2>

      <%= cond do %>
        <% @recipes.loading -> %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" aria-hidden="true">
            <div
              :for={_ <- 1..4}
              class="flex items-center gap-3 bg-ink-panel border border-ink-panel2 rounded-xl p-3"
            >
              <div class="m3-skeleton w-16 h-16 rounded-lg bg-ink-panel2 flex-shrink-0" />
              <div class="flex-1 min-w-0 space-y-2">
                <div class="m3-skeleton h-3.5 w-4/5 rounded bg-ink-panel2" />
                <div class="m3-skeleton h-3 w-1/3 rounded bg-ink-panel2" />
              </div>
            </div>
          </div>
        <% @recipes.failed -> %>
          <p class="text-parchment-dim text-sm">{gettext("Couldn't load recipes for this food.")}</p>
        <% @recipes.ok? && length(@recipes.result) == 0 -> %>
          <p class="text-parchment-dim text-sm">{gettext("No recipes use this food yet.")}</p>
        <% true -> %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <%= for recipe <- @recipes.result do %>
              <a
                href={"/browse/#{recipe.id}"}
                class="group flex items-center gap-3 bg-ink-panel border border-ink-panel2 rounded-xl p-3 hover:border-paprika/50 hover:bg-ink-panel2/80 transition-colors"
              >
                <div class="w-16 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-ink-panel2">
                  <%= if recipe.image_url do %>
                    <img
                      src={recipe.image_url}
                      alt={recipe.title}
                      class="w-full h-full object-cover"
                    />
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center">
                      <svg
                        class="w-6 h-6 text-parchment-dim"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                        />
                      </svg>
                    </div>
                  <% end %>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-parchment group-hover:text-paprika-soft transition-colors truncate">
                    {recipe.title}
                  </p>
                  <%= if recipe.cooking_time_lower_limit do %>
                    <p class="text-xs text-parchment-dim mt-0.5">
                      <span class="font-bold text-basil [font-variant-numeric:tabular-nums]">{recipe.cooking_time_lower_limit}</span>
                      {gettext("min")}
                    </p>
                  <% end %>
                </div>
                <svg
                  class="w-4 h-4 text-parchment-dim/50 group-hover:text-parchment-dim flex-shrink-0 transition-colors"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            <% end %>
          </div>
      <% end %>
    </section>
  </div>

  <%!-- ── Supporting-research modal (studies loaded lazily on open) ────────── --%>
  <.modal
    :if={@evidence_modal}
    id="compound-evidence-modal"
    show
    on_cancel={JS.push("close_evidence")}
  >
    <div class="space-y-4">
      <div>
        <h2
          id="compound-evidence-modal-title"
          class="text-xl font-display font-medium text-parchment"
        >
          {@display_name} · {@evidence_modal.compound}
        </h2>
        <p class="text-sm text-parchment-dim mt-1">
          {gettext("Research supporting this compound link.")}
        </p>
      </div>

      <%= if @evidence_modal.studies == [] do %>
        <p class="text-parchment-dim text-sm">
          {gettext("No PubMed papers are on file for this link yet.")}
        </p>
      <% else %>
        <div class="space-y-3 max-h-[60vh] overflow-y-auto pr-1 m3-scrollbar">
          <a
            :for={study <- @evidence_modal.studies}
            href={pubmed_url(study)}
            target="_blank"
            rel="noopener"
            class="group block bg-ink-panel2 border border-ink-panel2 rounded-xl p-4 hover:border-paprika/50 transition-colors"
          >
            <p class="text-sm font-medium text-parchment group-hover:text-paprika-soft transition-colors leading-snug">
              {study.title || gettext("Untitled study")}
            </p>
            <p class="text-xs text-parchment-dim mt-1">
              <%= if study.journal && study.journal != "" do %>
                {study.journal}
              <% end %>
              <%= if study.publication_date && study.publication_date != "" do %>
                · {study.publication_date}
              <% end %>
              <%= if study.pmid do %>
                · PMID {study.pmid}
              <% end %>
            </p>
          </a>
        </div>
      <% end %>
    </div>
  </.modal>
</div>
