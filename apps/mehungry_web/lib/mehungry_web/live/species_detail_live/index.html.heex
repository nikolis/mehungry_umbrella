<div id="page-timer" phx-hook="PageTimer" class="hidden"></div>
<div class="species-detail-page min-h-screen bg-ink text-parchment pb-16">
  <div class="container max-w-3xl mx-auto px-4 py-8">
    <nav class="text-sm text-parchment-dim mb-6">
      <a href="/foods" class="hover:text-parchment transition-colors">Foods</a>
      <span class="mx-2">›</span>
      <span class="text-parchment">{@display_name}</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-display font-medium text-parchment mb-2">{@display_name}</h1>
      <div class="flex flex-wrap gap-2">
        <%= if @species.scientific_name && @species.scientific_name != "" do %>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-ink-panel2 text-parchment-dim italic">
            {@species.scientific_name}
          </span>
        <% end %>
        <%= if @species.family && @species.family != "" do %>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-ink-panel2 text-parchment-dim">
            {@species.family}
          </span>
        <% end %>
        <%= if @species.variety && @species.variety != "" do %>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-ink-panel2 text-parchment-dim">
            {@species.variety}
          </span>
        <% end %>
      </div>
    </div>

    <%!-- ── Nutrients (per selected ingredient) ─────────────────────────── --%>
    <section class="mb-10">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-4">
        <h2 class="text-lg font-display font-medium text-parchment">
          Nutrition <span class="text-parchment-dim font-normal text-sm ml-2">per 100g</span>
        </h2>
        <%= if length(@ingredients) > 0 do %>
          <form id="species-ingredient-form" phx-change="select_ingredient">
            <label class="sr-only" for="ingredient-select">Choose a food</label>
            <select
              id="ingredient-select"
              name="id"
              class="bg-ink-panel border border-ink-panel2 rounded-xl px-3 py-2 text-sm text-parchment focus:outline-none focus:border-paprika focus:ring-1 focus:ring-paprika transition-colors max-w-full"
            >
              <%= for ingredient <- @ingredients do %>
                <option
                  value={ingredient.id}
                  selected={@selected_ingredient && ingredient.id == @selected_ingredient.id}
                >
                  {ingredient.name}
                </option>
              <% end %>
            </select>
          </form>
        <% end %>
      </div>

      <%= cond do %>
        <% is_nil(@selected_ingredient) -> %>
          <p class="text-parchment-dim text-sm">
            No USDA foods are curated onto this species yet.
          </p>
        <% length(@top_nutrients) == 0 -> %>
          <p class="text-parchment-dim text-sm">
            No nutrition data for {@selected_ingredient.name} yet.
          </p>
        <% true -> %>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
            <%= for n <- @top_nutrients do %>
              <div class="bg-ink-panel rounded-xl p-4 text-center border border-ink-panel2">
                <div class="text-2xl font-bold text-basil [font-variant-numeric:tabular-nums]">
                  {format_amount(n.amount)}
                </div>
                <div class="text-xs text-parchment-dim mt-0.5">{n.unit}</div>
                <div class="text-sm font-medium text-parchment-dim mt-1">{n.label}</div>
              </div>
            <% end %>
          </div>
      <% end %>
    </section>

    <%= if length(@nutrients_by_family) > 0 do %>
      <section class="mb-10">
        <h2 class="text-lg font-display font-medium text-parchment mb-4">
          Full Nutrition Breakdown
          <span class="text-parchment-dim font-normal text-sm ml-2">per 100g</span>
        </h2>
        <%!-- ~15 rows tall, then scroll; zero-valued nutrients are filtered out. --%>
        <div class="space-y-6 max-h-[540px] overflow-y-auto pr-1 m3-scrollbar">
          <%= for {family, nutrients} <- @nutrients_by_family do %>
            <div class="bg-ink-panel rounded-xl border border-ink-panel2 overflow-hidden">
              <div class="px-4 py-2 bg-ink-panel2/50 border-b border-ink-panel2">
                <h3 class="text-sm font-semibold text-parchment-dim uppercase tracking-wide">
                  {family}
                </h3>
              </div>
              <table class="w-full">
                <tbody>
                  <%= for {n, idx} <- Enum.with_index(nutrients) do %>
                    <tr class={if rem(idx, 2) == 0, do: "bg-ink-panel", else: "bg-ink-panel/50"}>
                      <td class="px-4 py-2 text-sm text-parchment-dim">{n.nutrient.name}</td>
                      <td class="px-4 py-2 text-sm text-basil text-right font-bold [font-variant-numeric:tabular-nums]">
                        {format_amount(n.amount)}
                        <span class="text-parchment-dim font-normal">{nutrient_unit(n)}</span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <%!-- ── Bioactive compounds ─────────────────────────────────────────── --%>
    <section class="mb-10">
      <h2 class="text-lg font-display font-medium text-parchment mb-4">Bioactive Compounds</h2>
      <%= cond do %>
        <% @compounds.loading -> %>
          <div class="space-y-2" aria-hidden="true">
            <div :for={_ <- 1..3} class="m3-skeleton h-10 w-full rounded-xl bg-ink-panel2" />
          </div>
        <% @compounds.failed -> %>
          <p class="text-parchment-dim text-sm">Couldn't load compounds.</p>
        <% @compounds.ok? && length(@compounds.result) == 0 -> %>
          <p class="text-parchment-dim text-sm">
            No compounds linked to this species yet.
          </p>
        <% true -> %>
          <div class="flex flex-wrap gap-2">
            <%= for rel <- @compounds.result do %>
              <span class="inline-flex items-center gap-2 bg-ink-panel border border-ink-panel2 rounded-xl px-3 py-1.5 text-sm">
                <span class="text-parchment">{rel.compound.name}</span>
                <span class="text-xs text-parchment-dim">{relationship_label(
                  rel.relationship_type
                )}</span>
              </span>
            <% end %>
          </div>
      <% end %>
    </section>

    <%!-- ── Health conditions (advice via the compounds) ────────────────── --%>
    <section class="mb-10">
      <h2 class="text-lg font-display font-medium text-parchment mb-4">Health Conditions</h2>
      <%= cond do %>
        <% @recommendations.loading -> %>
          <div class="space-y-2" aria-hidden="true">
            <div :for={_ <- 1..2} class="m3-skeleton h-12 w-full rounded-xl bg-ink-panel2" />
          </div>
        <% @recommendations.failed -> %>
          <p class="text-parchment-dim text-sm">Couldn't load health conditions.</p>
        <% @recommendations.ok? && length(@recommendations.result) == 0 -> %>
          <p class="text-parchment-dim text-sm">
            No condition-specific dietary advice for this species yet.
          </p>
        <% true -> %>
          <div class="space-y-2">
            <%= for rec <- @recommendations.result do %>
              <div class="flex flex-wrap items-center gap-2 bg-ink-panel border border-ink-panel2 rounded-xl px-4 py-3">
                <span class={[
                  "inline-block px-2 py-0.5 rounded-full text-xs font-bold uppercase tracking-wide",
                  if(encourage?(rec.recommendation),
                    do: "bg-basil/20 text-basil",
                    else: "bg-paprika/20 text-paprika-soft"
                  )
                ]}>
                  {rec.recommendation}
                </span>
                <span class="text-sm text-parchment font-medium">{rec.condition.name}</span>
                <span class="text-xs text-parchment-dim">
                  via {rec.compound.name}
                  <%= if rec.severity && rec.severity != "" do %>
                    · {rec.severity}
                  <% end %>
                  <%= if rec.evidence_level && rec.evidence_level != "" do %>
                    · evidence: {rec.evidence_level}
                  <% end %>
                </span>
              </div>
            <% end %>
          </div>
      <% end %>
    </section>

    <%!-- ── Research (PubMed) ───────────────────────────────────────────── --%>
    <section class="mb-10">
      <h2 class="text-lg font-display font-medium text-parchment mb-4">Research</h2>
      <%= cond do %>
        <% @studies.loading -> %>
          <div class="space-y-3" aria-hidden="true">
            <div :for={_ <- 1..3} class="m3-skeleton h-16 w-full rounded-xl bg-ink-panel2" />
          </div>
        <% @studies.failed -> %>
          <p class="text-parchment-dim text-sm">Couldn't load research.</p>
        <% @studies.ok? && length(@studies.result) == 0 -> %>
          <p class="text-parchment-dim text-sm">
            No PubMed research linked to this species yet.
          </p>
        <% true -> %>
          <p class="text-sm text-parchment-dim mb-3">
            <span class="font-bold text-basil [font-variant-numeric:tabular-nums]">{length(
              @studies.result
            )}</span>
            studies discovered for {@display_name}.
          </p>
          <%!-- Capped height, then scroll — matches the nutrition breakdown. --%>
          <div class="space-y-3 max-h-[540px] overflow-y-auto pr-1 m3-scrollbar">
            <%= for study <- @studies.result do %>
              <a
                href={pubmed_url(study)}
                target="_blank"
                rel="noopener"
                class="group block bg-ink-panel border border-ink-panel2 rounded-xl p-4 hover:border-paprika/50 hover:bg-ink-panel2/80 transition-colors"
              >
                <p class="text-sm font-medium text-parchment group-hover:text-paprika-soft transition-colors leading-snug">
                  {study.title || "Untitled study"}
                </p>
                <p class="text-xs text-parchment-dim mt-1">
                  <%= if study.journal && study.journal != "" do %>
                    {study.journal}
                  <% end %>
                  <%= if study.publication_date && study.publication_date != "" do %>
                    · {study.publication_date}
                  <% end %>
                  <%= if study.pmid do %>
                    · PMID {study.pmid}
                  <% end %>
                </p>
              </a>
            <% end %>
          </div>
      <% end %>
    </section>
  </div>
</div>
