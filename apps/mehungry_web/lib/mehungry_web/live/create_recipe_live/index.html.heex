<div class="min-h-screen bg-slate-900">
  <div class="container mx-auto px-4 py-4">
    <!-- Header -->
    <div class="mb-4">
      <h1 class="text-3xl font-bold text-white flex items-center gap-3">
        <svg
          class="w-8 h-8 text-primary-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 6v6m0 0v6m0-6h6m-6 0H6"
          />
        </svg>
        Create New Recipe
      </h1>
    </div>
    <.modal
      :if={is_nil(@user_profile.onboarding_level) or @user_profile.onboarding_level < 1}
      id="onboarding-modal"
      show
      on_cancel={JS.patch(~p"/")}
    >
      <.live_component
        module={MehungryWeb.Onboarding.FormComponent}
        user_profile={@user_profile}
        id={:new}
        patch={~p"/"}
      />
    </.modal>

    <div class="m-auto w-fit md:hidden absolute top-0  right-0 left-0 m-auto relative m-auto pb-2">
      <.stepper />
    </div>

    <div class="flex ">
      <div class="bg-red w-full h-full p-2 hidden md:block">
        <%= if ! is_nil(@plain_meal) do %>
          <.live_component
            module={MehungryWeb.JsonViewerComponent}
            id="json-viewer"
            json={@plain_meal}
          />
        <% end %>
      </div>

      <div class="w-full">
        <div class="flex justify-end mb-2">
          <button
            type="button"
            id="ai-panel-toggle"
            phx-click={
              Phoenix.LiveView.JS.toggle(to: "#ai-panel",
                in: {"transition-all duration-300 ease-out", "opacity-0 -translate-y-2 scale-95", "opacity-100 translate-y-0 scale-100"},
                out: {"transition-all duration-200 ease-in", "opacity-100 translate-y-0 scale-100", "opacity-0 -translate-y-2 scale-95"}
              )
              |> Phoenix.LiveView.JS.toggle_class("bg-primary-500/20 border-primary-500", to: "#ai-panel-toggle")
            }
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-primary-500/50 text-primary-400 hover:bg-primary-500/10 text-xs font-medium transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Generate with AI
          </button>
        </div>

        <div class="content_container mb-4 p-4 hidden" id="ai-panel">
          <form phx-submit="ai_generate" class="flex flex-col sm:flex-row gap-3">
            <textarea
              name="prompt"
              rows="3"
              placeholder="Describe your recipe… e.g. 'Creamy mushroom risotto for 4 people, medium difficulty'"
              class="flex-1 bg-slate-800 text-white rounded-lg p-3 text-sm resize-none border border-slate-600 focus:border-primary-500 focus:outline-none"
            ></textarea>
            <button
              type="submit"
              disabled={@ai_generating}
              class="px-5 py-2 bg-primary-500 hover:bg-primary-600 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg text-white font-semibold text-sm self-end transition"
            >
              <%= if @ai_generating do %>
                <span class="flex items-center gap-2">
                  <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                  </svg>
                  Generating…
                </span>
              <% else %>
                Generate
              <% end %>
            </button>
          </form>
          <%= if @ai_unmatched != [] do %>
            <p class="text-yellow-400 text-xs mt-3">
              Not found in database and skipped: <%= Enum.join(@ai_unmatched, ", ") %>. Add these manually if needed.
            </p>
          <% end %>
        </div>

        <.live_component
          module={MehungryWeb.RecipeFormComponent}
          uploads={@uploads}
          id="recipe-form"
          ingredients={@ingredients}
          recipe={@recipe}
          measurement_units={@measurement_units}
          f={@f}
          measurement_units={@measurement_units}
        />

        <%= if @current_user.email in ["nikolisgal@gmail.com", "r3qviem@hotmail.com"]  do %>
          <div class="content_container " id="url_component_container">
            <.form
              :let={b}
              id={@f.id<>"2"}
              for={%{}}
              phx-change="validate"
              phx-submit="save"
              class="gap-2 flex  flex-col  relative w-fit m-auto"
              style=""
            >
              <.input
                field={b[:url_to_drill]}
                type="text"
                label="themealdb id i.e 52764"
                class="px-10"
              />
              <div class=" absolute right-0 ">
                {submit("Get blueprint",
                  class: "button bg-complementary border-2 border-transparent  ",
                  type: "submit",
                  phx_disable_with: "Saving...",
                  id: "save_button2"
                )}
              </div>
            </.form>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
