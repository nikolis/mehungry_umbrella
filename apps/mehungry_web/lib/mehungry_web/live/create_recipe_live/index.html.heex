<div
  :if={@ai_generating}
  class="fixed inset-0 z-[60] bg-ink/80 backdrop-blur-sm flex flex-col items-center justify-center gap-4"
>
  <MehungryWeb.SvgComponents.get_loading class="w-20 h-20" />
  <p class="text-parchment text-sm">{gettext("Generating your recipe…")}</p>
</div>
<div class="create-recipe-page min-h-screen bg-ink text-parchment">
  <div class="container mx-auto px-4 py-4 pb-36 lg:pb-4">
    <.page_header
      title={gettext("Create new recipe")}
      subtitle={gettext("Fill in the details and watch your recipe come together.")}
    />

    <.modal
      :if={is_nil(@user_profile.onboarding_level) or @user_profile.onboarding_level < 1}
      id="onboarding-modal"
      show
      on_cancel={JS.patch(~p"/")}
    >
      <.live_component
        module={MehungryWeb.Onboarding.FormComponent}
        user_profile={@user_profile}
        id={:new}
        patch={~p"/"}
      />
    </.modal>

    <%!-- AI generation + URL import — a refined but deliberately secondary
          affordance, collapsed behind a toggle above the manual form. --%>
    <div class="mb-4">
      <div class="flex justify-end mb-2">
        <button
          type="button"
          id="ai-panel-toggle"
          phx-click={
            Phoenix.LiveView.JS.toggle(
              to: "#ai-panel",
              in:
                {"transition-all duration-300 ease-out", "opacity-0 -translate-y-2 scale-95",
                 "opacity-100 translate-y-0 scale-100"},
              out:
                {"transition-all duration-200 ease-in", "opacity-100 translate-y-0 scale-100",
                 "opacity-0 -translate-y-2 scale-95"}
            )
            |> Phoenix.LiveView.JS.toggle_class("bg-paprika/20 border-paprika",
              to: "#ai-panel-toggle"
            )
          }
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-ink-panel2 text-parchment-dim hover:text-parchment hover:border-parchment-dim text-xs font-medium transition-colors"
        >
          <.icon name="hero-sparkles" class="w-3.5 h-3.5" />
          {gettext("Generate with AI")}
        </button>
      </div>

      <div
        class="mb-4 p-4 hidden border border-ink-panel2 bg-black/20 rounded-2xl"
        id="ai-panel"
      >
        <form phx-submit="ai_generate" class="flex flex-col sm:flex-row gap-3">
          <textarea
            name="prompt"
            rows="3"
            placeholder={
              gettext(
                "Describe your recipe… e.g. 'Creamy mushroom risotto for 4 people, medium difficulty'"
              )
            }
            class="flex-1 bg-ink-panel2 text-parchment rounded-lg p-3 text-sm resize-none border border-ink-panel2 focus:border-paprika focus:outline-none"
          ></textarea>
          <.action variant={:secondary} type="submit" disabled={@ai_generating} class="self-end">
            <%= if @ai_generating do %>
              <MehungryWeb.SvgComponents.get_loading compact class="w-4 h-4" />
              {gettext("Generating…")}
            <% else %>
              {gettext("Generate")}
            <% end %>
          </.action>
        </form>

        <div class="flex items-center gap-3 my-3">
          <div class="flex-1 h-px bg-ink-panel2"></div>
          <span class="text-xs text-parchment-dim uppercase tracking-wide">
            {gettext("or import from a link")}
          </span>
          <div class="flex-1 h-px bg-ink-panel2"></div>
        </div>

        <form phx-submit="ai_import_url" class="flex flex-col sm:flex-row gap-3">
          <input
            name="url"
            type="url"
            inputmode="url"
            placeholder={gettext("Paste a recipe link, e.g. https://…")}
            class="flex-1 bg-ink-panel2 text-parchment rounded-lg px-4 py-2.5 text-sm border border-ink-panel2 focus:border-paprika focus:outline-none"
          />
          <.action variant={:secondary} type="submit" disabled={@ai_generating} class="self-end sm:self-auto">
            <%= if @ai_generating do %>
              <MehungryWeb.SvgComponents.get_loading compact class="w-4 h-4" />
              {gettext("Importing…")}
            <% else %>
              {gettext("Import")}
            <% end %>
          </.action>
        </form>
        <p class="text-parchment-dim text-xs mt-2">
          {gettext(
            "We copy the ingredients, rewrite the steps in our own words, and give it a fresh title and description."
          )}
        </p>

        <p :if={@ai_unmatched != []} class="text-yellow-400 text-xs mt-3">
          {gettext(
            "Not found in database and skipped: %{items}. Add these manually if needed.",
            items: Enum.join(@ai_unmatched, ", ")
          )}
        </p>
        <div
          :if={@ai_quota_exceeded}
          class="mt-3 rounded-lg bg-amber-500/10 border border-amber-500/30 p-3 flex items-center justify-between gap-3"
        >
          <p class="text-amber-300 text-xs">
            {gettext("You've reached your AI recipe limit for this month.")}
          </p>
          <.link
            navigate={~p"/upgrade"}
            class="flex-shrink-0 text-paprika-soft hover:text-paprika text-xs font-semibold transition-colors"
          >
            {gettext("Upgrade")}
          </.link>
        </div>
      </div>
    </div>

    <.modal
      :if={@show_ai_ingredients_modal}
      id="ai-ingredients-modal"
      show
      on_cancel={JS.push("ai_cancel_generate")}
    >
      <h2 class="text-lg font-display font-medium text-parchment mb-1">
        {gettext("Use your ingredients?")}
      </h2>
      <p class="text-parchment-dim text-sm mb-4">
        {gettext(
          "You've already added: %{items}. Should the AI build the recipe around them?",
          items: Enum.join(@ai_existing_ingredients, ", ")
        )}
      </p>
      <div class="flex gap-3">
        <.action variant={:primary} phx-click="ai_generate_confirm" phx-value-keep="true">
          {gettext("Yes, use them")}
        </.action>
        <.action variant={:secondary} phx-click="ai_generate_confirm" phx-value-keep="false">
          {gettext("No, start fresh")}
        </.action>
      </div>
    </.modal>

    <%!-- Two-pane on desktop: form left, live preview right (sticky).
          On mobile the aside is hidden; the preview is reached via the
          sticky bottom bar's "Preview" button (see below). --%>
    <div class="grid lg:grid-cols-12 gap-6 items-start">
      <div class="lg:col-span-7">
        <.live_component
          module={MehungryWeb.RecipeFormComponent}
          uploads={@uploads}
          id="recipe-form"
          recipe={@recipe}
          f={@f}
          search_language={@current_language}
          current_user_id={@current_user.id}
          spoonacular_unmatched={@spoonacular_unmatched}
        />
      </div>

      <aside class="hidden lg:block lg:col-span-5 lg:sticky lg:top-6">
        <MehungryWeb.RecipeComponents.recipe_preview preview={@preview} uploads={@uploads} />
      </aside>
    </div>

    <%!-- Spoonacular import is shadowed (not surfaced to users); see
          CreateRecipeLive.Index.spoonacular_enabled?/0 --%>
    <%= if @spoonacular_enabled do %>
      <div
        class="mt-4 p-4 border border-ink-panel2 bg-ink-panel rounded-2xl"
        id="url_component_container"
      >
        <p class="text-xs text-parchment-dim uppercase tracking-wide font-semibold mb-3">
          Import from Spoonacular
        </p>
        <form phx-submit="spoonacular_search" class="flex gap-3">
          <input
            name="query"
            type="text"
            placeholder="Search recipes e.g. pasta carbonara"
            class="flex-1 bg-ink-panel2 text-parchment rounded-lg px-4 py-2.5 text-sm border border-ink-panel2 focus:border-paprika focus:outline-none"
          />
          <.action variant={:secondary} type="submit" disabled={@spoonacular_search_loading}>
            <%= if @spoonacular_search_loading do %>
              <MehungryWeb.SvgComponents.get_loading compact class="w-4 h-4" /> Searching…
            <% else %>
              Search
            <% end %>
          </.action>
        </form>
        <p
          :if={@spoonacular_fetch_loading}
          class="text-parchment-dim text-sm mt-3 animate-pulse flex items-center gap-2"
        >
          <MehungryWeb.SvgComponents.get_loading compact class="w-4 h-4" /> Importing recipe into form…
        </p>
      </div>

      <.modal
        :if={@show_spoonacular_modal}
        id="spoonacular-modal"
        show
        on_cancel={JS.push("close_spoonacular_modal")}
      >
        <h2 class="text-lg font-display font-medium text-parchment mb-1">Select a recipe</h2>
        <p class="text-parchment-dim text-sm mb-4">
          Click a recipe to import it into the form for review before saving.
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 max-h-[60vh] overflow-y-auto pr-1">
          <button
            :for={result <- @spoonacular_results}
            type="button"
            phx-click="spoonacular_select"
            phx-value-id={result["id"]}
            class="flex flex-col rounded-xl bg-ink-panel hover:bg-ink-panel2 border border-ink-panel2 hover:border-paprika transition-colors overflow-hidden text-left group"
          >
            <img
              src={result["image"]}
              alt={result["title"]}
              class="w-full object-cover h-32 group-hover:opacity-90 transition-opacity"
            />
            <p class="text-sm text-parchment font-medium px-3 py-2 line-clamp-2">
              {result["title"]}
            </p>
          </button>
        </div>
      </.modal>
    <% end %>
  </div>

  <%!-- Mobile-only sticky action bar. Sits above the app's 60px bottom nav;
        controls are left-aligned so the right corner stays clear of the global
        Feedback FAB (fixed bottom-20 right-4). Save submits the form via the
        `form` attribute; Preview opens the live card in a sheet. --%>
  <div class="lg:hidden fixed bottom-[60px] inset-x-0 z-30 border-t border-ink-panel2 bg-ink/95 backdrop-blur-sm px-4 py-3">
    <div class="flex items-center gap-3">
      <button
        type="submit"
        form="create-recipe-form"
        class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-paprika px-5 py-2 text-sm font-bold text-ink hover:bg-paprika-soft transition-colors"
      >
        {gettext("Save recipe")}
      </button>
      <button
        type="button"
        phx-click={show_modal("mobile-preview")}
        aria-label={gettext("Preview recipe")}
        class="inline-flex items-center gap-1.5 rounded-lg border border-ink-panel2 px-3 py-2 text-sm font-medium text-parchment hover:border-parchment-dim transition-colors"
      >
        <.icon name="hero-eye" class="h-4 w-4" />
      </button>
      <span
        class={["inline-block h-2.5 w-2.5 rounded-full", (@preview.valid? && "bg-basil") || "bg-amber-500"]}
        title={(@preview.valid? && gettext("Ready to save")) || gettext("In progress")}
      >
      </span>
    </div>
  </div>

  <.modal id="mobile-preview" show={false} on_cancel={hide_modal("mobile-preview")}>
    <MehungryWeb.RecipeComponents.recipe_preview preview={@preview} uploads={@uploads} />
  </.modal>
</div>
