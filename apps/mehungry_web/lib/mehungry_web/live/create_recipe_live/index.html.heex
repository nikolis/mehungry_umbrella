<div id="page-timer" phx-hook="PageTimer" class="hidden"></div>
<div class="min-h-screen bg-slate-900">
  <div class="container mx-auto px-4 py-4">
    <!-- Header -->
    <div class="mb-4">
      <h1 class="text-3xl font-bold text-white flex items-center gap-3">
        <svg
          class="w-8 h-8 text-primary-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 6v6m0 0v6m0-6h6m-6 0H6"
          />
        </svg>
        Create New Recipe
      </h1>
    </div>
    <.modal
      :if={is_nil(@user_profile.onboarding_level) or @user_profile.onboarding_level < 1}
      id="onboarding-modal"
      show
      on_cancel={JS.patch(~p"/")}
    >
      <.live_component
        module={MehungryWeb.Onboarding.FormComponent}
        user_profile={@user_profile}
        id={:new}
        patch={~p"/"}
      />
    </.modal>

    <div class="flex justify-center md:hidden pb-4">
      <.stepper />
    </div>

    <div class={if !is_nil(@plain_meal), do: "flex gap-4", else: ""}>
      <%= if !is_nil(@plain_meal) do %>
        <div class="w-full h-full p-2">
          <.live_component
            module={MehungryWeb.JsonViewerComponent}
            id="json-viewer"
            json={@plain_meal}
          />
        </div>
      <% end %>

      <div class="w-full">
        <div id="ai-section" class="content_container">
          <div class="flex justify-end mb-2">
            <button
              type="button"
              id="ai-panel-toggle"
              phx-click={
                Phoenix.LiveView.JS.toggle(
                  to: "#ai-panel",
                  in:
                    {"transition-all duration-300 ease-out", "opacity-0 -translate-y-2 scale-95",
                     "opacity-100 translate-y-0 scale-100"},
                  out:
                    {"transition-all duration-200 ease-in", "opacity-100 translate-y-0 scale-100",
                     "opacity-0 -translate-y-2 scale-95"}
                )
                |> Phoenix.LiveView.JS.toggle_class("bg-primary-500/20 border-primary-500",
                  to: "#ai-panel-toggle"
                )
              }
              class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-primary-500/50 text-primary-400 hover:bg-primary-500/10 text-xs font-medium transition-colors"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                />
              </svg>
              Generate with AI
            </button>
          </div>

          <div class="content_container mb-4 p-4 hidden" id="ai-panel">
            <form phx-submit="ai_generate" class="flex flex-col sm:flex-row gap-3">
              <textarea
                name="prompt"
                rows="3"
                placeholder="Describe your recipe… e.g. 'Creamy mushroom risotto for 4 people, medium difficulty'"
                class="flex-1 bg-slate-800 text-white rounded-lg p-3 text-sm resize-none border border-slate-600 focus:border-primary-500 focus:outline-none"
              ></textarea>
              <button
                type="submit"
                disabled={@ai_generating}
                class="px-5 py-2 bg-primary-500 hover:bg-primary-600 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg text-white font-semibold text-sm self-end transition"
              >
                <%= if @ai_generating do %>
                  <span class="flex items-center gap-2">
                    <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                      <circle
                        class="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        stroke-width="4"
                      >
                      </circle>
                      <path
                        class="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                      >
                      </path>
                    </svg>
                    Generating…
                  </span>
                <% else %>
                  Generate
                <% end %>
              </button>
            </form>
            <%= if @ai_unmatched != [] do %>
              <p class="text-yellow-400 text-xs mt-3">
                Not found in database and skipped: {Enum.join(@ai_unmatched, ", ")}. Add these manually if needed.
              </p>
            <% end %>
            <%= if @ai_quota_exceeded do %>
              <div class="mt-3 rounded-lg bg-amber-500/10 border border-amber-500/30 p-3 flex items-center justify-between gap-3">
                <p class="text-amber-300 text-xs">
                  You've reached your AI recipe limit for this month.
                </p>
                <.link
                  navigate={~p"/upgrade"}
                  class="flex-shrink-0 px-3 py-1.5 rounded-lg bg-primary-500 hover:bg-primary-600 text-white text-xs font-semibold transition"
                >
                  Upgrade
                </.link>
              </div>
            <% end %>
          </div>
        </div>

        <.live_component
          module={MehungryWeb.RecipeFormComponent}
          uploads={@uploads}
          id="recipe-form"
          ingredients={@ingredients}
          recipe={@recipe}
          measurement_units={@measurement_units}
          f={@f}
          search_language={@current_language}
          spoonacular_unmatched={@spoonacular_unmatched}
        />

        <%= if @current_user.email in ["nikolisgal@gmail.com", "r3qviem@hotmail.com"] do %>
          <div class="content_container mt-4 p-4 bg-slate-800/50 rounded-xl" id="url_component_container">
            <p class="text-xs text-slate-400 uppercase tracking-wide font-semibold mb-3">
              Import from Spoonacular
            </p>
            <form phx-submit="spoonacular_search" class="flex gap-3">
              <input
                name="query"
                type="text"
                placeholder="Search recipes e.g. pasta carbonara"
                class="flex-1 bg-slate-900 text-white rounded-lg px-4 py-2.5 text-sm border border-slate-600 focus:border-primary-500 focus:outline-none"
              />
              <button
                type="submit"
                disabled={@spoonacular_search_loading}
                class="px-5 py-2.5 bg-primary-500 hover:bg-primary-600 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg text-white font-semibold text-sm transition-colors"
              >
                <%= if @spoonacular_search_loading do %>
                  <span class="flex items-center gap-2">
                    <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                    </svg>
                    Searching…
                  </span>
                <% else %>
                  Search
                <% end %>
              </button>
            </form>
            <%= if @spoonacular_fetch_loading do %>
              <p class="text-slate-400 text-sm mt-3 animate-pulse flex items-center gap-2">
                <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                </svg>
                Importing recipe into form…
              </p>
            <% end %>
          </div>

          <.modal
            :if={@show_spoonacular_modal}
            id="spoonacular-modal"
            show
            on_cancel={JS.push("close_spoonacular_modal")}
          >
            <h2 class="text-lg font-semibold text-white mb-1">Select a recipe</h2>
            <p class="text-slate-400 text-sm mb-4">
              Click a recipe to import it into the form for review before saving.
            </p>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 max-h-[60vh] overflow-y-auto pr-1">
              <%= for result <- @spoonacular_results do %>
                <button
                  type="button"
                  phx-click="spoonacular_select"
                  phx-value-id={result["id"]}
                  class="flex flex-col rounded-xl bg-slate-900 hover:bg-slate-700 border border-slate-700 hover:border-primary-500 transition-colors overflow-hidden text-left group"
                >
                  <img
                    src={result["image"]}
                    alt={result["title"]}
                    class="w-full object-cover h-32 group-hover:opacity-90 transition-opacity"
                  />
                  <p class="text-sm text-white font-medium px-3 py-2 line-clamp-2">
                    {result["title"]}
                  </p>
                </button>
              <% end %>
            </div>
          </.modal>
        <% end %>
      </div>
    </div>
  </div>
</div>
