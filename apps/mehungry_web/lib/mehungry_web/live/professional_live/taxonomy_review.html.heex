<div class="max-w-5xl mx-auto p-4 space-y-8">
  <h1 class="text-2xl font-semibold text-parchment">Taxonomy Review</h1>

  <section class="space-y-3 rounded-lg border border-ink-panel2 bg-ink-panel p-4">
    <div class="flex flex-wrap items-center gap-2">
      <button
        type="button"
        phx-click="seed"
        data-confirm="Seed / re-seed the bio-nutritional taxonomy tree? This is idempotent."
        class="px-3 py-1.5 rounded bg-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
      >
        Run Seeds
      </button>

      <button
        type="button"
        phx-click="classify"
        disabled={is_nil(@taxonomy) or running?(@run)}
        data-confirm="Classify all ingredients into taxonomy leaves via AI? This uses API quota."
        class="px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed"
      >
        {if running?(@run), do: "Classifying…", else: "Run Classification"}
      </button>

      <button
        type="button"
        phx-click="refresh"
        class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90 ml-auto"
      >
        Refresh
      </button>
    </div>

    <div>
      <div class="flex items-center justify-between text-xs text-parchment-dim mb-1">
        <span>
          Classified: {@progress.classified} / {@progress.total} ({percent(@progress)}%)
        </span>
        <span class={"font-medium #{run_class(@run)}"} title={run_error(@run)}>
          {run_label(@run)}
        </span>
      </div>
      <div class="h-2 w-full rounded bg-ink-panel2 overflow-hidden">
        <div class="h-full bg-basil rounded" style={"width: #{percent(@progress)}%"}></div>
      </div>
    </div>
  </section>

  <%= if @taxonomy do %>
    <p class="text-parchment-dim text-sm">
      Reviewing <span class="font-medium">{@taxonomy.name}</span>
      (<code>{@taxonomy.slug}</code>). Lowest-confidence assignments first.
    </p>

    <section>
      <h2 class="text-lg font-medium text-parchment mb-2">Tree</h2>
      <MehungryWeb.AccordionComponent.accordion items={@tree} accordion_id="taxonomy-tree" />
    </section>

    <section>
      <h2 class="text-lg font-medium text-parchment mb-2">Pending assignments</h2>

      <div
        id="taxonomy_pending"
        phx-hook="InfiniteScroll"
        phx-update="stream"
        data-page={@page}
        class="divide-y divide-ink-panel2"
      >
        <div
          :for={{dom_id, mapping} <- @streams.mappings}
          id={dom_id}
          class="py-3 flex flex-wrap items-center gap-3 justify-between"
        >
          <div class="min-w-0 flex-1">
            <div class="text-parchment font-medium truncate">{mapping.ingredient.name}</div>
            <div class="text-xs text-parchment-dim">
              category: {(mapping.ingredient.category && mapping.ingredient.category.name) || "—"} · confidence: {confidence_label(
                mapping.confidence
              )} · source: {mapping.source}
            </div>
            <div class="text-xs text-basil mt-0.5">
              → {node_path(@node_paths, mapping.taxonomy_node)}
            </div>
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              phx-click="confirm"
              phx-value-id={mapping.id}
              class="px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
            >
              Confirm
            </button>

            <form
              id={"override-#{mapping.id}"}
              phx-change="override"
              class="flex items-center gap-1"
            >
              <input type="hidden" name="mapping_id" value={mapping.id} />
              <select
                name="node_id"
                class="text-sm rounded bg-ink-panel border border-ink-panel2 text-parchment px-2 py-1"
              >
                <option value="">Override…</option>
                <option :for={{path, id} <- @leaf_options} value={id}>{path}</option>
              </select>
            </form>
          </div>
        </div>
      </div>

      <p class="text-parchment-dim text-sm mt-4">
        Scroll to load more. Confirmed and overridden rows leave this list.
      </p>
    </section>
  <% else %>
    <p class="text-parchment-dim">
      No taxonomy found. Click <span class="font-medium">Run Seeds</span> above to create one.
    </p>
  <% end %>
</div>
