<div class="max-w-5xl mx-auto p-4 space-y-6">
  <%!-- ── Header ─────────────────────────────────────────────────────────────── --%>
  <div class="space-y-3">
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-2xl font-semibold text-parchment">Fact mining</h1>
      <.link navigate={~p"/professional/usda-schema"} class="text-xs text-basil hover:underline">
        ← USDA schema (curate species)
      </.link>
    </div>
    <p class="text-parchment-dim text-sm max-w-3xl">
      Mine per-species biomedical facts from the external
      <span class="font-medium">biomed-fact-miner</span>. Pick a species, edit the question
      sent to the miner (pre-filled with the default), and mine it — the returned
      PMID-cited claims (verified / contradicted / unverified) <span class="font-medium">replace</span>
      that species' stored facts. One Oban job on the <code class="text-parchment">:fact_mining</code>
      queue — watch it finish live below.
    </p>
  </div>

  <%!-- ── Miner connection + trigger ───────────────────────────────────────────── --%>
  <section class="rounded-lg border border-ink-panel2 bg-ink-panel p-4 space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2 text-sm">
        <span class="text-parchment-dim">Miner:</span>
        <%= case @reachable do %>
          <% :ok -> %>
            <span class="inline-flex items-center gap-1 text-basil">● reachable</span>
          <% {:error, _} -> %>
            <span class="inline-flex items-center gap-1 text-paprika">● unreachable</span>
          <% _ -> %>
            <span class="inline-flex items-center gap-1 text-parchment-dim">● checking…</span>
        <% end %>
        <button phx-click="recheck" class="text-xs text-basil hover:underline">recheck</button>
      </div>

      <div class="flex items-center gap-2">
        <%= if in_flight?(@counts) do %>
          <button
            phx-click="cancel"
            data-confirm="Cancel the species still in this batch?"
            class="rounded-md bg-paprika/20 text-paprika px-3 py-1.5 text-sm hover:bg-paprika/30"
          >
            Cancel
          </button>
        <% end %>
      </div>
    </div>

    <%!-- Mine one species with an editable prompt --%>
    <form phx-submit="mine_species" class="space-y-3">
      <div class="space-y-1">
        <label class="text-xs text-parchment-dim">Species</label>
        <select
          name="species_id"
          phx-change="select_species"
          class="w-full rounded-md border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-2"
        >
          <option value="" selected={is_nil(@selected_species_id)}>— pick a species —</option>
          <option
            :for={s <- @species_options}
            value={s.id}
            selected={@selected_species_id == s.id}
          >
            {s.name}{if s.scientific_name, do: " · #{s.scientific_name}"}{if s.variety,
              do: " (#{s.variety})"}
          </option>
        </select>
      </div>

      <div class="space-y-1">
        <label class="text-xs text-parchment-dim">Prompt sent to the miner</label>
        <textarea
          name="query"
          rows="3"
          placeholder="Pick a species to pre-fill the default prompt…"
          class="w-full rounded-md border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-2 placeholder:text-parchment-dim"
        >{@mine_query}</textarea>
        <p class="text-xs text-parchment-dim">
          Edit freely — leave blank to fall back to the default
          <em>"tell me all the facts about {"{name}"} ({"{scientific_name}"})"</em>.
        </p>
      </div>

      <button
        type="submit"
        disabled={@mining? or is_nil(@selected_species_id)}
        class="rounded-md bg-basil text-ink px-4 py-1.5 text-sm font-medium hover:bg-basil/90 disabled:opacity-40 disabled:cursor-not-allowed"
      >
        {if @mining?, do: "Starting…", else: "Mine species"}
      </button>
    </form>

    <%!-- connection config: miner base URL + optional JWT/bearer token --%>
    <details class="rounded-md border border-ink-panel2 bg-ink-panel2/40" open={@reachable == {:error, :probe_crashed} or match?({:error, _}, @reachable)}>
      <summary class="cursor-pointer select-none px-3 py-2 text-sm text-parchment-dim hover:text-parchment">
        Miner connection
        <span class="text-parchment-dim/70">— {@settings.base_url}</span>
      </summary>
      <.form
        for={@settings_form}
        phx-change="validate_connection"
        phx-submit="save_connection"
        class="px-3 pb-3 pt-1 space-y-3"
      >
        <.input
          field={@settings_form[:base_url]}
          type="url"
          label="Base URL"
          placeholder="http://127.0.0.1:8811"
        />
        <.input
          field={@settings_form[:auth_token]}
          type="password"
          label="Auth token (JWT / bearer — optional)"
          autocomplete="off"
          placeholder="sent as Authorization: Bearer …"
        />
        <p class="text-xs text-parchment-dim">
          Saved to the database (overrides the <code>FACT_MINER_BASE_URL</code> /
          <code>FACT_MINER_AUTH_TOKEN</code> env fallback). Leave the token blank for an
          unauthenticated miner.
        </p>
        <button
          type="submit"
          class="rounded-md bg-ink-panel2 text-parchment px-3 py-1.5 text-sm hover:bg-ink-panel2/70"
        >
          Save connection
        </button>
      </.form>
    </details>

    <%!-- progress summary --%>
    <div class="flex flex-wrap gap-4 text-sm">
      <span class="text-parchment-dim">Pending <span class="text-parchment font-medium">{@counts.pending}</span></span>
      <span class="text-parchment-dim">Processing <span class="text-amber-300 font-medium">{@counts.processing}</span></span>
      <span class="text-parchment-dim">Completed <span class="text-basil font-medium">{@counts.completed}</span></span>
      <span class="text-parchment-dim">Failed <span class="text-paprika font-medium">{@counts.failed}</span></span>
      <span class="text-parchment-dim ml-auto">Facts mined <span class="text-parchment font-medium">{@counts.facts_total}</span></span>
    </div>
  </section>

  <%!-- ── Per-species stream ───────────────────────────────────────────────────── --%>
  <section class="rounded-lg border border-ink-panel2 bg-ink-panel p-4 space-y-3">
    <header class="flex items-baseline gap-2">
      <h2 class="text-lg font-medium text-parchment">Species</h2>
      <span class="text-xs text-parchment-dim">{@counts.total} in batch</span>
    </header>

    <div id="fact-mining-rows" phx-update="stream" class="divide-y divide-ink-panel2">
      <div
        :for={{dom_id, row} <- @streams.rows}
        id={dom_id}
        class="flex flex-wrap items-center gap-3 py-2"
      >
        <div class="min-w-[12rem]">
          <span class="text-parchment">{row.species.name}</span>
          <span :if={row.species.scientific_name} class="text-parchment-dim text-xs italic ml-1">
            {row.species.scientific_name}
          </span>
        </div>

        <span class={"inline-flex rounded-full px-2 py-0.5 text-xs font-medium #{status_badge_class(row.status)}"}>
          {row.status}
        </span>

        <span :if={row.status == "completed"} class="text-xs text-parchment-dim">
          {row.facts_total} fact{if row.facts_total == 1, do: "", else: "s"}
          <span :if={row.verified_count > 0} class="text-basil ml-1">{row.verified_count} verified</span>
          <span :if={row.contradicted_count > 0} class="text-paprika ml-1">{row.contradicted_count} contradicted</span>
        </span>

        <span :if={row.status == "failed" and row.error} class="text-xs text-paprika truncate max-w-[20rem]" title={row.error}>
          {row.error}
        </span>
      </div>
    </div>

    <p :if={@counts.total == 0} class="text-parchment-dim text-sm">
      No mine yet — pick a species above and click <span class="font-medium">Mine species</span> to start.
    </p>
  </section>
</div>
