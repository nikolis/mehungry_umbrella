<div class="max-w-5xl mx-auto p-4 space-y-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-parchment">Health Conditions</h1>
      <p class="text-parchment-dim text-sm">
        Curate the advice layer: create conditions and attach compound recommendations
        (condition → <span class="font-medium">compound</span> → advice). Recommendations
        reference compounds only — the implicated food species are resolved at read time and
        shown on <code class="text-parchment">/conditions/:id</code>.
      </p>
    </div>
    <button
      type="button"
      phx-click="seed_conditions"
      data-confirm="Bulk-load the bundled condition catalogue? Idempotent — existing conditions are refreshed, not duplicated."
      class="shrink-0 rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 hover:bg-ink-panel"
    >
      Seed registry
    </button>
  </div>

  <%!-- ── Add condition ──────────────────────────────────────────────── --%>
  <section class="space-y-3 rounded-lg border border-ink-panel2 bg-ink-panel p-4">
    <h2 class="text-lg font-medium text-parchment">Add condition</h2>
    <form phx-submit="save_condition" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <input
        type="text"
        name="condition[name]"
        required
        placeholder="Name (e.g. Kidney Stones)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim"
      />
      <input
        type="text"
        name="condition[category]"
        placeholder="Category (e.g. renal, GI)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim"
      />
      <input
        type="text"
        name="condition[synonyms]"
        placeholder="Synonyms (comma-separated)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim sm:col-span-2"
      />
      <textarea
        name="condition[description]"
        placeholder="Description (optional)"
        rows="2"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim sm:col-span-2"
      ></textarea>
      <button
        type="submit"
        class="justify-self-start px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
      >
        Add condition
      </button>
    </form>
  </section>

  <%!-- ── Add recommendation ─────────────────────────────────────────── --%>
  <section class="space-y-3 rounded-lg border border-ink-panel2 bg-ink-panel p-4">
    <h2 class="text-lg font-medium text-parchment">Add recommendation</h2>
    <p :if={@conditions == []} class="text-parchment-dim text-sm">
      Add a condition first.
    </p>
    <form
      :if={@conditions != []}
      phx-submit="save_recommendation"
      class="grid grid-cols-1 sm:grid-cols-3 gap-3"
    >
      <select name="recommendation[condition_id]" required class={select_class()}>
        <option value="">Condition…</option>
        <option :for={c <- @conditions} value={c.id}>{c.name}</option>
      </select>
      <select name="recommendation[compound_id]" required class={select_class()}>
        <option value="">Compound…</option>
        <option :for={c <- @compounds} value={c.id}>{c.name}</option>
      </select>
      <select name="recommendation[recommendation]" class={select_class()}>
        <option :for={r <- recommendations()} value={r}>{r}</option>
      </select>
      <select name="recommendation[severity]" class={select_class()}>
        <option value="">Severity…</option>
        <option :for={s <- severities()} value={s}>{s}</option>
      </select>
      <select name="recommendation[evidence_level]" class={select_class()}>
        <option value="">Evidence…</option>
        <option :for={e <- evidence_levels()} value={e}>{e}</option>
      </select>
      <select name="recommendation[source]" class={select_class()}>
        <option :for={s <- sources()} value={s}>{s}</option>
      </select>
      <input
        type="text"
        name="recommendation[notes]"
        placeholder="Notes (optional)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim sm:col-span-2"
      />
      <button
        type="submit"
        class="justify-self-start px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
      >
        Add recommendation
      </button>
    </form>
  </section>

  <%!-- ── Review derived recommendations (from literature) ───────────── --%>
  <section class="space-y-3 rounded-lg border border-ink-panel2 bg-ink-panel p-4">
    <div class="flex flex-wrap items-center gap-2">
      <h2 class="text-lg font-medium text-parchment mr-2">
        Review derived recommendations ({length(@rec_candidates)})
      </h2>
      <.link
        navigate={~p"/professional/science"}
        class="text-sm text-basil hover:underline ml-auto"
      >
        Derive more →
      </.link>
    </div>
    <p class="text-parchment-dim text-sm">
      Candidates derived from PubTator's directional chemical↔disease relations. The
      <span class="font-medium">suggested</span>
      direction comes from relation valence
      (negative → encourage, positive → avoid); confirm the direction & severity, then
      <span class="font-medium">Promote</span>
      to write a curated recommendation
      (<code class="text-parchment">source: literature</code>). Nothing is auto-promoted.
    </p>

    <p :if={@rec_candidates == []} class="text-parchment-dim text-sm">
      No pending candidates. Run derivation from the Science Pipeline.
    </p>

    <div
      :for={cand <- @rec_candidates}
      class="py-3 border-t border-ink-panel2 flex flex-wrap items-start gap-3 justify-between"
    >
      <div class="min-w-0 flex-1">
        <div class="text-parchment font-medium truncate">
          {cand.condition.name}
          <span class="text-parchment-dim">·</span>
          {cand.compound.name}
          <span class={"text-xs ml-1 #{rec_class(cand.suggested_recommendation)}"}>
            (suggests {cand.suggested_recommendation || "neutral"})
          </span>
        </div>
        <div class="text-xs text-parchment-dim">
          evidence: <span class="font-medium">{cand.evidence_level || "insufficient"}</span>
          · score: {cand.evidence_score} · relations −{(cand.relation_counts || %{})["negative"] ||
            0} / +{(cand.relation_counts || %{})["positive"] || 0} / ~{(cand.relation_counts ||
                                                                          %{})["association"] || 0} · {cand.study_count} stud{if cand.study_count ==
                                                                                                                                   1,
                                                                                                                                 do:
                                                                                                                                   "y",
                                                                                                                                 else:
                                                                                                                                   "ies"}
        </div>
        <div :if={cand.studies != []} class="text-xs text-parchment-dim mt-0.5">
          refs:
          <a
            :for={study <- cand.studies}
            href={"https://pubmed.ncbi.nlm.nih.gov/#{study.pmid}/"}
            target="_blank"
            rel="noopener"
            class="text-basil hover:underline mr-1"
          >{study.pmid}</a>
        </div>
      </div>

      <form phx-submit="promote_recommendation" class="flex flex-wrap items-center gap-2">
        <input type="hidden" name="id" value={cand.id} />
        <select name="recommendation" class={select_class()}>
          <option
            :for={r <- recommendations()}
            value={r}
            selected={r == default_rec(cand.suggested_recommendation)}
          >
            {r}
          </option>
        </select>
        <select name="severity" class={select_class()}>
          <option value="">Severity…</option>
          <option :for={s <- severities()} value={s}>{s}</option>
        </select>
        <button
          type="submit"
          class="px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
        >
          Promote
        </button>
        <button
          type="button"
          phx-click="reject_recommendation"
          phx-value-id={cand.id}
          data-confirm="Reject this candidate? It will not be promoted."
          class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
        >
          Reject
        </button>
      </form>
    </div>
  </section>

  <%!-- ── Conditions list ────────────────────────────────────────────── --%>
  <section class="space-y-3">
    <h2 class="text-lg font-medium text-parchment">
      Conditions ({length(@conditions)})
    </h2>

    <p :if={@conditions == []} class="text-parchment-dim text-sm">
      No conditions yet.
    </p>

    <div
      :for={condition <- @conditions}
      class="rounded-lg border border-ink-panel2 bg-ink-panel p-4 space-y-2"
    >
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-parchment font-medium">{condition.name}</span>
        <span
          :if={condition.category}
          class="text-xs rounded bg-ink-panel2 text-parchment-dim px-2 py-0.5"
        >
          {condition.category}
        </span>
        <button
          type="button"
          phx-click="delete_condition"
          phx-value-id={condition.id}
          data-confirm={"Delete “#{condition.name}” and all its recommendations?"}
          class="ml-auto text-xs text-red-400 hover:underline"
        >
          Delete condition
        </button>
      </div>

      <p :if={condition.description} class="text-xs text-parchment-dim">
        {condition.description}
      </p>

      <div class="divide-y divide-ink-panel2 border-t border-ink-panel2 pt-1">
        <p :if={@recs[condition.id] == []} class="text-xs text-parchment-dim py-2">
          No recommendations yet.
        </p>
        <div
          :for={rec <- @recs[condition.id]}
          class="py-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm"
        >
          <span class={"font-medium #{rec_class(rec.recommendation)}"}>{rec.recommendation}</span>
          <span class="text-parchment">{rec.compound.name}</span>
          <span class="text-xs text-parchment-dim">
            {[rec.severity, rec.evidence_level, rec.source]
            |> Enum.reject(&is_nil/1)
            |> Enum.join(" · ")}
          </span>
          <button
            type="button"
            phx-click="delete_recommendation"
            phx-value-id={rec.id}
            data-confirm="Remove this recommendation?"
            class="ml-auto text-xs text-red-400 hover:underline"
          >
            Remove
          </button>
        </div>
      </div>
    </div>
  </section>
</div>
