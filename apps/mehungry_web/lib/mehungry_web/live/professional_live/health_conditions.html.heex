<div class="max-w-7xl mx-auto p-4 space-y-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-parchment">Health Conditions</h1>
      <p class="text-parchment-dim text-sm">
        The condition registry behind the advice layer: create conditions and mine their
        facts below. Compound recommendations (condition → <span class="font-medium">compound</span>
        → advice) aren't entered here — they arrive through the review-gated promote flows and
        are listed per condition with a Remove action. Recommendations reference compounds
        only — the implicated food species are resolved at read time and shown on
        <code class="text-parchment">/nutritionist/conditions/:id</code>.
      </p>
    </div>
    <%!-- Everyday mining lives in the hero card below; the header keeps only
         secondary nav + rare setup + a guarded danger zone, so neither rare nor
         destructive actions share billing with the page's primary job. --%>
    <div class="shrink-0 flex items-center gap-2">
      <.link
        navigate={~p"/professional/compound-pipeline"}
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 hover:bg-ink-panel"
      >
        Compound pipeline →
      </.link>

      <%!-- Setup: rare, idempotent one-time loads, folded out of the primary row. --%>
      <div class="relative" x-data="{ open: false }" @keydown.escape="open = false">
        <button
          type="button"
          @click="open = !open"
          class="inline-flex items-center gap-1 rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 hover:bg-ink-panel"
        >
          Setup
          <svg class="w-3 h-3" x-bind:class="open && 'rotate-180'" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          x-show="open"
          x-cloak
          @click.outside="open = false"
          @click="open = false"
          class="absolute right-0 z-20 mt-1 w-56 rounded-lg border border-ink-panel2 bg-ink-panel shadow-lg p-1"
        >
          <button
            type="button"
            phx-click="seed_conditions"
            data-confirm="Bulk-load the bundled condition catalogue? Idempotent — existing conditions are refreshed, not duplicated."
            class="block w-full text-left rounded px-3 py-1.5 text-sm text-parchment hover:bg-ink-panel2"
          >
            Seed registry
          </button>
          <button
            type="button"
            phx-click="seed_diet_patterns"
            data-confirm="Add the starter diet-pattern blueprints to your account? Idempotent — patterns you already own are skipped."
            class="block w-full text-left rounded px-3 py-1.5 text-sm text-parchment hover:bg-ink-panel2"
          >
            Seed diet patterns
          </button>
        </div>
      </div>

      <%!-- Danger zone: irreversible wipes, one click deeper so they can't be hit by accident. --%>
      <div class="relative" x-data="{ open: false }" @keydown.escape="open = false">
        <button
          type="button"
          @click="open = !open"
          class="inline-flex items-center gap-1 rounded border border-paprika/50 bg-paprika/10 text-paprika text-sm px-3 py-1.5 hover:bg-paprika/20"
        >
          Danger zone
          <svg class="w-3 h-3" x-bind:class="open && 'rotate-180'" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          x-show="open"
          x-cloak
          @click.outside="open = false"
          @click="open = false"
          class="absolute right-0 z-20 mt-1 w-72 rounded-lg border border-paprika/40 bg-ink-panel shadow-lg p-1"
        >
          <button
            type="button"
            phx-click="clear_all_recommendations"
            data-confirm="Delete ALL recommendation candidates AND promoted recommendations (compound + nutrient + phase-aware) for EVERY condition? This cannot be undone. Conditions and compounds are kept."
            class="block w-full text-left rounded px-3 py-1.5 text-sm text-paprika hover:bg-paprika/10"
          >
            Clear all suggestions
          </button>
          <button
            type="button"
            phx-click="wipe_extractor_data"
            data-confirm="Permanently delete ALL legacy extractor data — every study analysis, every extractor-sourced full text, the analyzer connection settings, and all research-ingestion run history? This cannot be undone. The fact-miner data and all curated recommendations are kept."
            class="block w-full text-left rounded px-3 py-1.5 text-sm text-paprika hover:bg-paprika/10"
          >
            Wipe extractor data
          </button>
        </div>
      </div>
    </div>
  </div>

  <%!-- ── Mine conditions (biomed-fact-miner) ───────────────────────────── --%>
  <section class="space-y-3 rounded-lg border border-ink-panel2 bg-ink-panel p-4" x-data="{ open: false }">
    <div class="flex items-center justify-between gap-2">
      <h2 class="text-lg font-medium text-parchment">Mine conditions (fact-miner)</h2>
      <button
        type="button"
        @click="open = !open"
        class="text-xs rounded border border-ink-panel2 bg-ink-panel2 text-parchment px-2 py-1 hover:bg-ink-panel"
      >
        <span x-text="open ? 'Hide' : 'Configure'"></span>
      </button>
    </div>
    <p class="text-parchment-dim text-sm">
      Ask the external <span class="font-medium">biomed-fact-miner</span>
      for a condition's food-related facts — mine one condition at a time from its
      card below (each opens an editable prompt). The condition's stored facts are
      <span class="font-medium">fully replaced</span>
      (idempotent). The miner only needs to be reachable
      <span class="font-medium">while a mine runs</span>; afterwards the nutritionist
      research search serves each condition from the database. Facts carry a
      per-source licence: <em>commercial_ok</em>
      papers are shown with their quotes, everything else becomes a "free claim"
      (distilled wording + a source link).
    </p>
    <p class="text-parchment-dim text-sm">
      Currently using <code class="text-parchment">{@miner_base_url}</code><span :if={
        @miner_auth_token
      }> · JWT token set</span>.
    </p>

    <%!-- URL + JWT the miner is reached at (UI-managed, env/config fallback). --%>
    <form
      x-show="open"
      x-cloak
      phx-submit="save_fact_miner_settings"
      class="grid grid-cols-1 sm:grid-cols-2 gap-3"
    >
      <label class="text-xs text-parchment-dim sm:col-span-2 -mb-1">Service URL</label>
      <input
        type="url"
        name="settings[base_url]"
        value={@miner_base_url}
        required
        placeholder="http://127.0.0.1:8811"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim sm:col-span-2"
      />
      <label class="text-xs text-parchment-dim sm:col-span-2 -mb-1">
        JWT token (optional) — sent as <code class="text-parchment">Authorization: Bearer …</code>; leave blank for none
      </label>
      <input
        type="password"
        name="settings[auth_token]"
        value={@miner_auth_token}
        autocomplete="off"
        placeholder="JWT / bearer token (optional)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim sm:col-span-2"
      />
      <button
        type="submit"
        class="justify-self-start px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
      >
        Save fact-miner settings
      </button>
    </form>

    <div class="flex flex-wrap items-center gap-3 text-xs">
      <span class="text-parchment-dim">
        Mine a condition one at a time from its card below — each opens an editable prompt.
      </span>
      <span class="ml-auto">
        <span :if={@miner_reachable == :unknown} class="text-parchment-dim">checking miner…</span>
        <span :if={@miner_reachable == :ok} class="text-basil">miner online</span>
        <span :if={match?({:error, _}, @miner_reachable)} class="text-red-400">
          miner offline
          <button type="button" phx-click="recheck_miner" class="underline ml-1">recheck</button>
        </span>
      </span>
    </div>
  </section>

  <%!-- ── Add condition ──────────────────────────────────────────────── --%>
  <section class="space-y-3 rounded-lg border border-ink-panel2 bg-ink-panel p-4">
    <h2 class="text-lg font-medium text-parchment">Add condition</h2>
    <form phx-submit="save_condition" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <input
        type="text"
        name="condition[name]"
        required
        placeholder="Name (e.g. Kidney Stones)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim"
      />
      <input
        type="text"
        name="condition[category]"
        placeholder="Category (e.g. renal, GI)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim"
      />
      <input
        type="text"
        name="condition[synonyms]"
        placeholder="Synonyms (comma-separated)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim sm:col-span-2"
      />
      <textarea
        name="condition[description]"
        placeholder="Description (optional)"
        rows="2"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim sm:col-span-2"
      ></textarea>
      <label class="text-xs text-parchment-dim sm:col-span-2 -mb-1">
        Parent condition (optional) — a subtype inherits its parent's general suggestions
      </label>
      <select
        name="condition[parent_condition_id]"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 sm:col-span-2"
      >
        <option value="">No parent (top-level condition)</option>
        <option :for={c <- @conditions} value={c.id}>{c.name}</option>
      </select>
      <button
        type="submit"
        class="justify-self-start px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
      >
        Add condition
      </button>
    </form>
  </section>

  <%!-- ── Dormant: literature-derived recommendation review ──────────── --%>
  <%!-- Both queues below are fed by literature-derivation pipelines that are
       currently dormant, so they normally stay empty. Folded away by default;
       the toggle still shows the combined pending count. --%>
  <section
    class="space-y-3 rounded-lg border border-ink-panel2 bg-ink-panel p-4"
    x-data="{ open: false }"
  >
    <div class="flex items-start justify-between gap-2">
      <div>
        <h2 class="text-lg font-medium text-parchment">
          Literature-derived recommendation review
          <span class="text-xs rounded-full bg-ink-panel2 text-parchment-dim px-2 py-0.5 ml-1">
            dormant
          </span>
        </h2>
        <p class="text-parchment-dim text-xs">
          Review queues for recommendations derived from the literature pipelines.
          These pipelines are currently dormant, so the lists are normally empty.
        </p>
      </div>
      <button
        type="button"
        @click="open = !open"
        class="shrink-0 text-xs rounded border border-ink-panel2 bg-ink-panel2 text-parchment px-2 py-1 hover:bg-ink-panel"
      >
        <span x-text="open ? 'Hide' : 'Show'"></span>
        ({length(@rec_candidates) + length(@phase_candidates)})
      </button>
    </div>

    <div x-show="open" x-cloak class="space-y-6">
      <div class="space-y-3">
        <h3 class="text-base font-medium text-parchment">
          Review derived recommendations ({length(@rec_candidates)})
        </h3>
    <p class="text-parchment-dim text-sm">
      Candidates derived from PubTator's directional chemical↔disease relations. The
      <span class="font-medium">suggested</span>
      direction comes from relation valence
      (negative → encourage, positive → avoid); confirm the direction & severity, then
      <span class="font-medium">Promote</span>
      to write a curated recommendation
      (<code class="text-parchment">source: literature</code>). Nothing is auto-promoted.
    </p>

    <p :if={@rec_candidates == []} class="text-parchment-dim text-sm">
      No pending candidates. (The literature-driven derivation for condition↔compound advice
      candidates is currently dormant.)
    </p>

    <div
      :for={cand <- @rec_candidates}
      class="py-3 border-t border-ink-panel2 flex flex-wrap items-start gap-3 justify-between"
    >
      <div class="min-w-0 flex-1">
        <div class="text-parchment font-medium truncate">
          {cand.condition.name}
          <span class="text-parchment-dim">·</span>
          {cand.compound.name}
          <span class={"text-xs ml-1 #{rec_class(cand.suggested_recommendation)}"}>
            (suggests {cand.suggested_recommendation || "neutral"})
          </span>
        </div>
        <div class="text-xs text-parchment-dim">
          evidence: <span class="font-medium">{cand.evidence_level || "insufficient"}</span>
          · score: {cand.evidence_score} · relations −{(cand.relation_counts || %{})["negative"] ||
            0} / +{(cand.relation_counts || %{})["positive"] || 0} / ~{(cand.relation_counts ||
                                                                          %{})["association"] || 0} · {cand.study_count} stud{if cand.study_count ==
                                                                                                                                   1,
                                                                                                                                 do:
                                                                                                                                   "y",
                                                                                                                                 else:
                                                                                                                                   "ies"}
        </div>
        <div :if={cand.studies != []} class="text-xs text-parchment-dim mt-0.5">
          refs:
          <a
            :for={study <- cand.studies}
            href={"https://pubmed.ncbi.nlm.nih.gov/#{study.pmid}/"}
            target="_blank"
            rel="noopener"
            class="text-basil hover:underline mr-1"
          >{study.pmid}</a>
        </div>
      </div>

      <form phx-submit="promote_recommendation" class="flex flex-wrap items-center gap-2">
        <input type="hidden" name="candidate_id" value={cand.id} />
        <select name="recommendation" class={select_class()}>
          <option
            :for={r <- recommendations()}
            value={r}
            selected={r == default_rec(cand.suggested_recommendation)}
          >
            {r}
          </option>
        </select>
        <select name="severity" class={select_class()}>
          <option value="">Severity…</option>
          <option :for={s <- severities()} value={s}>{s}</option>
        </select>
        <button
          type="submit"
          class="px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
        >
          Promote
        </button>
        <button
          type="button"
          phx-click="reject_recommendation"
          phx-value-id={cand.id}
          data-confirm="Reject this candidate? It will not be promoted."
          class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
        >
          Reject
        </button>
      </form>
    </div>
      </div>

      <%!-- ── Phase-aware candidates (Active Flare vs Remission …) ──── --%>
      <div class="space-y-3 rounded-lg border border-paprika/30 p-3">
        <h3 class="text-base font-medium text-parchment">
          Review phase-aware candidates ({length(@phase_candidates)})
        </h3>
        <p class="text-parchment-dim text-sm">
          Candidates tagged with a <span class="font-medium">disease phase</span>
          (Active Flare, Remission …). Confirm the direction, severity and phase, then
          <span class="font-medium">Promote</span>
          to write a phase-specific recommendation
          (<code class="text-parchment">condition_state_recommendations</code>, shown only on
          the condition page). Nothing is auto-promoted.
        </p>

    <p :if={@phase_candidates == []} class="text-parchment-dim text-sm">
      No pending phase candidates. (The phase-aware literature extraction that fed
      this queue is currently dormant.)
    </p>

    <div
      :for={cand <- @phase_candidates}
      class="py-3 border-t border-ink-panel2 flex flex-wrap items-start gap-3 justify-between"
    >
      <div class="min-w-0 flex-1">
        <div class="text-parchment font-medium truncate">
          {cand.condition.name}
          <span class="text-parchment-dim">·</span>
          {phase_target(cand)}
          <span class="text-xs ml-1 px-2 py-0.5 rounded-full bg-paprika/20 text-paprika-soft">
            {if cand.condition_state, do: cand.condition_state.name, else: "general"}
          </span>
          <span class={"text-xs ml-1 #{rec_class(cand.suggested_recommendation)}"}>
            (suggests {cand.suggested_recommendation || "neutral"})
          </span>
        </div>
        <div class="text-xs text-parchment-dim">
          target: <span class="font-medium">{cand.target_kind}</span>
          · confidence: {cand.confidence || cand.evidence_score} · {cand.study_count} stud{if cand.study_count ==
                                                                                                 1,
                                                                                               do: "y",
                                                                                               else: "ies"}
        </div>
        <div :if={is_map(cand.evidence) && cand.evidence["snippet"]} class="text-xs text-parchment-dim/80 mt-0.5 italic truncate">
          “{cand.evidence["snippet"]}”
        </div>
        <div :if={cand.studies != []} class="text-xs text-parchment-dim mt-0.5">
          refs:
          <a
            :for={study <- cand.studies}
            href={"https://pubmed.ncbi.nlm.nih.gov/#{study.pmid}/"}
            target="_blank"
            rel="noopener"
            class="text-basil hover:underline mr-1"
          >{study.pmid}</a>
        </div>
      </div>

      <form phx-submit="promote_phase_candidate" class="flex flex-wrap items-center gap-2">
        <input type="hidden" name="candidate_id" value={cand.id} />
        <select name="condition_state_id" class={select_class()}>
          <option value="">General (all phases)</option>
          <option
            :for={st <- states_for_candidate(cand)}
            value={st.id}
            selected={cand.condition_state_id == st.id}
          >
            {st.name}
          </option>
        </select>
        <select name="recommendation" class={select_class()}>
          <option
            :for={r <- recommendations()}
            value={r}
            selected={r == default_rec(cand.suggested_recommendation)}
          >
            {r}
          </option>
        </select>
        <select name="severity" class={select_class()}>
          <option value="">Severity…</option>
          <option :for={s <- severities()} value={s} selected={s == cand.suggested_severity}>
            {s}
          </option>
        </select>
        <button
          type="submit"
          class="px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
        >
          Promote
        </button>
        <button
          type="button"
          phx-click="reject_phase_candidate"
          phx-value-id={cand.id}
          data-confirm="Reject this candidate? It will not be promoted."
          class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
        >
          Reject
        </button>
      </form>
    </div>
      </div>
    </div>
  </section>

  <%!-- ── Conditions list ────────────────────────────────────────────── --%>
  <% total = length(@conditions) %>
  <%!-- Client-side (Alpine) filter + per-card expand over the ~200 already-loaded
       conditions — no per-keystroke round-trip (mirrors UsdaSchema.species_combobox/1).
       `recount()` re-derives the visible tally via x-effect whenever `q` changes,
       feeding the live heading count and the empty state. --%>
  <section
    class="space-y-3"
    x-data="{ q: '', count: null, recount() { this.count = [...$root.querySelectorAll('[data-condition]')].filter(el => !this.q || el.dataset.search.includes(this.q.trim().toLowerCase())).length } }"
    x-effect="recount()"
  >
    <%!-- Sticky filter bar: the list is long, so keep search reachable while scrolling.
         top-14 md:top-0 clears the mobile top bar; bg-ink so rows scroll cleanly under. --%>
    <div class="sticky top-14 md:top-0 z-20 bg-ink border-b border-ink-panel2 py-2 space-y-2">
      <h2 class="text-lg font-medium text-parchment">
        Conditions (<span x-text={"q ? count + ' of #{total}' : '#{total}'"}>{total}</span>)
      </h2>
      <div :if={@conditions != []} class="relative max-w-md">
        <input
          type="search"
          x-model.debounce.120ms="q"
          placeholder="Filter by name, category, or synonym…"
          aria-label="Filter conditions"
          class="w-full rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 pr-8 placeholder:text-parchment-dim"
        />
        <button
          type="button"
          x-show="q"
          x-cloak
          @click="q = ''"
          aria-label="Clear filter"
          class="absolute right-2 top-1/2 -translate-y-1/2 text-parchment-dim hover:text-parchment"
        >
          ✕
        </button>
      </div>
    </div>

    <p :if={@conditions == []} class="text-parchment-dim text-sm">
      No conditions yet.
    </p>

    <p x-show="q && count === 0" x-cloak class="text-parchment-dim text-sm">
      No conditions match “<span x-text="q"></span>”.
    </p>

    <%!-- Shared options for the per-paper "Re-assign to…" search-selects below. --%>
    <datalist id="conditions-datalist">
      <option :for={c <- @conditions} value={c.name}></option>
    </datalist>

    <div
      :for={condition <- @conditions}
      id={"condition-#{condition.id}"}
      data-condition
      data-search={
        [condition.name, condition.category, condition.subcategory | condition.synonyms || []]
        |> Enum.reject(&is_nil/1)
        |> Enum.join(" ")
        |> String.downcase()
      }
      x-data="{ expanded: false }"
      x-show="!q || $el.dataset.search.includes(q.trim().toLowerCase())"
      class="rounded-lg border border-ink-panel2 bg-ink-panel px-4 py-2.5"
    >
      <% rec_count = length(@recs[condition.id] || []) + length(@nutrient_recs[condition.id] || []) %>
      <% paper_count = length(@condition_studies[condition.id] || []) %>
      <% facts = @fact_counts[condition.id] || %{total: 0, verified: 0} %>

      <%!-- Compact row: expand toggle (chevron + name + category) · count badges ·
           per-condition actions. The detail block is revealed on expand. --%>
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          @click="expanded = !expanded"
          x-bind:aria-expanded="expanded"
          class="flex items-center gap-2 min-w-0 text-left rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-basil/50"
        >
          <svg
            class="w-3 h-3 shrink-0 text-parchment-dim transition-transform duration-200 motion-reduce:transition-none"
            x-bind:class="expanded && 'rotate-90'"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-parchment font-medium truncate">{condition.name}</span>
          <span
            :if={condition.category}
            class="shrink-0 text-xs rounded bg-ink-panel2 text-parchment-dim px-2 py-0.5"
          >
            {condition.category}
          </span>
        </button>

        <%!-- Counts; the fact tally doubles as the link to the nutritionist research
             surface where the mined facts actually render (new tab — a different live
             session). Plain dim text when there are no facts yet. --%>
        <span class="text-[11px] text-parchment-dim tabular-nums whitespace-nowrap">
          {rec_count} advice · {paper_count} paper{if paper_count == 1, do: "", else: "s"} ·
          <a
            :if={facts.total > 0}
            href={~p"/nutritionist/research/#{condition.id}"}
            target="_blank"
            rel="noopener"
            class="text-basil hover:underline"
          >{facts.total} fact{if facts.total == 1, do: "", else: "s"}<span :if={
              facts.verified > 0
            }> ({facts.verified} verified)</span> →</a><span :if={facts.total == 0}>0 facts</span>
        </span>

        <%!-- Primary per-condition action: open the mine modal to edit the prompt,
             then mine this one condition's facts (a one-row batch on the serialized
             :fact_mining queue). Progress is the button's own state + a result flash. --%>
        <button
          type="button"
          phx-click="open_mine_modal"
          phx-value-id={condition.id}
          disabled={MapSet.member?(@mining_conditions, condition.id)}
          class="ml-auto text-xs rounded bg-basil text-ink font-medium px-2.5 py-1 hover:opacity-90 disabled:opacity-60 disabled:cursor-not-allowed"
        >
          {if MapSet.member?(@mining_conditions, condition.id), do: "Mining…", else: "Mine facts"}
        </button>
        <button
          type="button"
          phx-click="search_condition_papers"
          phx-value-id={condition.id}
          disabled={MapSet.member?(@crawling, condition.id)}
          class="text-xs rounded border border-ink-panel2 bg-ink-panel2 text-parchment px-2 py-1 hover:bg-ink-panel disabled:opacity-60"
        >
          {if MapSet.member?(@crawling, condition.id), do: "Searching…", else: "Search papers"}
        </button>
        <button
          type="button"
          phx-click="delete_condition"
          phx-value-id={condition.id}
          data-confirm={"Delete “#{condition.name}” and all its recommendations?"}
          class="text-xs text-red-400 hover:underline"
        >
          Delete condition
        </button>
      </div>

      <%!-- Detail: description + recommendations, revealed on expand (x-cloak so it
           doesn't flash open before Alpine inits). The heavy papers sub-list keeps its
           own server-side lazy toggle nested inside. --%>
      <div x-show="expanded" x-cloak class="mt-2 space-y-2">
      <p :if={condition.description} class="text-xs text-parchment-dim">
        {condition.description}
      </p>

      <div class="divide-y divide-ink-panel2 border-t border-ink-panel2 pt-1">
        <p :if={@recs[condition.id] == []} class="text-xs text-parchment-dim py-2">
          No recommendations yet.
        </p>
        <div
          :for={rec <- @recs[condition.id]}
          class="py-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm"
        >
          <span class={"font-medium #{rec_class(rec.recommendation)}"}>{rec.recommendation}</span>
          <span class="text-parchment">{rec.compound.name}</span>
          <span class="text-xs text-parchment-dim">
            {[rec.severity, rec.evidence_level, rec.source]
            |> Enum.reject(&is_nil/1)
            |> Enum.join(" · ")}
          </span>
          <button
            type="button"
            phx-click="delete_recommendation"
            phx-value-id={rec.id}
            data-confirm="Remove this recommendation?"
            class="ml-auto text-xs text-red-400 hover:underline"
          >
            Remove
          </button>
        </div>

        <div
          :for={rec <- @nutrient_recs[condition.id] || []}
          class="py-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm"
        >
          <span class={"font-medium #{rec_class(rec.recommendation)}"}>{rec.recommendation}</span>
          <span class="text-parchment">{rec.nutrient_name}</span>
          <span class="text-xs rounded bg-ink-panel2 text-parchment-dim px-1.5 py-0.5">nutrient</span>
          <span class="text-xs text-parchment-dim">
            {[rec.severity, rec.evidence_level, rec.source]
            |> Enum.reject(&is_nil/1)
            |> Enum.join(" · ")}
          </span>
          <button
            type="button"
            phx-click="delete_nutrient_recommendation"
            phx-value-id={rec.id}
            data-confirm="Remove this nutrient recommendation?"
            class="ml-auto text-xs text-red-400 hover:underline"
          >
            Remove
          </button>
        </div>
      </div>

      <%!-- ── Discovered papers (collapse) ──────────────────────────────── --%>
      <div
        :if={Map.has_key?(@condition_studies, condition.id)}
        class="mt-2 pt-2 border-t border-ink-panel2"
      >
        <button
          type="button"
          phx-click="toggle_condition_papers"
          phx-value-id={condition.id}
          class="cursor-pointer inline-flex items-center gap-1 text-[11px] text-parchment-dim hover:text-parchment transition-colors"
        >
          <svg
            class={[
              "w-3 h-3 transition-transform duration-200",
              MapSet.member?(@papers_open, condition.id) && "rotate-90"
            ]}
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          Papers ({length(@condition_studies[condition.id])})
        </button>

        <%!-- Rendered server-side only when opened: a condition can carry hundreds of
             paper rows (each with its own re-assign form), so rendering every
             condition's papers up front made the whole page load forever. --%>
        <div :if={MapSet.member?(@papers_open, condition.id)}>
          <div>
            <p
              :if={@condition_studies[condition.id] == []}
              class="text-xs text-parchment-dim mt-2"
            >
              No papers found yet — try searching again later.
            </p>

            <div :if={@condition_studies[condition.id] != []} class="mt-2 space-y-1">
              <div
                :for={study <- @condition_studies[condition.id]}
                class="flex flex-wrap items-start justify-between gap-2 py-0.5"
              >
                <div class="flex items-start gap-2 text-xs text-parchment-dim min-w-0 flex-1">
                  <span class="min-w-0">
                    <a
                      href={"https://pubmed.ncbi.nlm.nih.gov/#{study.pmid}/"}
                      target="_blank"
                      rel="noopener"
                      class="text-basil hover:underline"
                    >{study.pmid}</a>
                    <span class="text-parchment">{study.title}</span>
                  </span>
                </div>

                <%!-- Re-assign this paper to a better-fitting condition. "Move + flag":
                     it is linked to the target, removed from here, and flagged so a
                     re-crawl of this condition never re-grabs it. --%>
                <form
                  id={"reassign-#{condition.id}-#{study.id}"}
                  phx-submit="reassign_study"
                  class="flex items-center gap-1 shrink-0"
                >
                  <input type="hidden" name="study_id" value={study.id} />
                  <input type="hidden" name="from_condition_id" value={condition.id} />
                  <input
                    type="text"
                    name="target"
                    list="conditions-datalist"
                    required
                    placeholder="Re-assign to…"
                    title="Type or pick a condition this paper fits better"
                    class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-[11px] px-2 py-0.5 w-40 placeholder:text-parchment-dim"
                  />
                  <button
                    type="submit"
                    class="text-[11px] rounded border border-ink-panel2 bg-ink-panel2 text-parchment px-2 py-0.5 hover:bg-ink-panel"
                  >
                    Move
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <%!-- Per-condition mine modal: edit the prompt before mining one condition. --%>
  <.modal
    :if={@mine_modal_condition}
    id="mine-condition-modal"
    show
    on_cancel={JS.push("close_mine_modal")}
  >
    <h2 class="text-lg font-medium text-parchment mb-1">
      Mine facts — {@mine_modal_condition.name}
    </h2>
    <p class="text-parchment-dim text-sm mb-3">
      Edit the question sent to the biomed-fact-miner, then mine. This
      <span class="font-medium">replaces</span>
      the condition's stored facts.
    </p>
    <form phx-submit="mine_condition" class="space-y-3">
      <textarea
        name="query"
        rows="3"
        class="w-full rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-2 placeholder:text-parchment-dim"
        placeholder="give me all the food related facts about …"
      >{@mine_query}</textarea>
      <p class="text-xs text-parchment-dim">
        Leave blank to fall back to the default
        <em>"give me all the food related facts about {"{condition}"}"</em>.
      </p>
      <div class="flex items-center justify-end gap-2">
        <button
          type="button"
          phx-click="close_mine_modal"
          class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm hover:bg-ink-panel2"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
        >
          Mine
        </button>
      </div>
    </form>
  </.modal>
</div>
