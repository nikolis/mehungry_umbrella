<div class="max-w-5xl mx-auto p-4 space-y-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-parchment">Health Conditions</h1>
      <p class="text-parchment-dim text-sm">
        Curate the advice layer: create conditions and attach compound recommendations
        (condition → <span class="font-medium">compound</span> → advice). Recommendations
        reference compounds only — the implicated food species are resolved at read time and
        shown on <code class="text-parchment">/conditions/:id</code>.
      </p>
    </div>
    <button
      type="button"
      phx-click="seed_conditions"
      data-confirm="Bulk-load the bundled condition catalogue? Idempotent — existing conditions are refreshed, not duplicated."
      class="shrink-0 rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 hover:bg-ink-panel"
    >
      Seed registry
    </button>
  </div>

  <%!-- ── Add condition ──────────────────────────────────────────────── --%>
  <section class="space-y-3 rounded-lg border border-ink-panel2 bg-ink-panel p-4">
    <h2 class="text-lg font-medium text-parchment">Add condition</h2>
    <form phx-submit="save_condition" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <input
        type="text"
        name="condition[name]"
        required
        placeholder="Name (e.g. Kidney Stones)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim"
      />
      <input
        type="text"
        name="condition[category]"
        placeholder="Category (e.g. renal, GI)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim"
      />
      <input
        type="text"
        name="condition[synonyms]"
        placeholder="Synonyms (comma-separated)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim sm:col-span-2"
      />
      <textarea
        name="condition[description]"
        placeholder="Description (optional)"
        rows="2"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim sm:col-span-2"
      ></textarea>
      <button
        type="submit"
        class="justify-self-start px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
      >
        Add condition
      </button>
    </form>
  </section>

  <%!-- ── Add recommendation ─────────────────────────────────────────── --%>
  <section class="space-y-3 rounded-lg border border-ink-panel2 bg-ink-panel p-4">
    <h2 class="text-lg font-medium text-parchment">Add recommendation</h2>
    <p :if={@conditions == []} class="text-parchment-dim text-sm">
      Add a condition first.
    </p>
    <form
      :if={@conditions != []}
      phx-submit="save_recommendation"
      class="grid grid-cols-1 sm:grid-cols-3 gap-3"
    >
      <select name="recommendation[condition_id]" required class={select_class()}>
        <option value="">Condition…</option>
        <option :for={c <- @conditions} value={c.id}>{c.name}</option>
      </select>
      <select name="recommendation[compound_id]" required class={select_class()}>
        <option value="">Compound…</option>
        <option :for={c <- @compounds} value={c.id}>{c.name}</option>
      </select>
      <select name="recommendation[recommendation]" class={select_class()}>
        <option :for={r <- recommendations()} value={r}>{r}</option>
      </select>
      <select name="recommendation[severity]" class={select_class()}>
        <option value="">Severity…</option>
        <option :for={s <- severities()} value={s}>{s}</option>
      </select>
      <select name="recommendation[evidence_level]" class={select_class()}>
        <option value="">Evidence…</option>
        <option :for={e <- evidence_levels()} value={e}>{e}</option>
      </select>
      <select name="recommendation[source]" class={select_class()}>
        <option :for={s <- sources()} value={s}>{s}</option>
      </select>
      <input
        type="text"
        name="recommendation[notes]"
        placeholder="Notes (optional)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim sm:col-span-2"
      />
      <input
        type="text"
        name="recommendation[reference_label]"
        placeholder="Source label (required for manual/guideline)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim"
      />
      <input
        type="url"
        name="recommendation[reference_url]"
        placeholder="Source URL (PubMed/guideline link)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim"
      />
      <button
        type="submit"
        class="justify-self-start px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
      >
        Add recommendation
      </button>
    </form>
  </section>

  <%!-- ── Add nutrient recommendation ────────────────────────────────── --%>
  <section class="space-y-3 rounded-lg border border-ink-panel2 bg-ink-panel p-4">
    <h2 class="text-lg font-medium text-parchment">Add nutrient recommendation</h2>
    <p class="text-parchment-dim text-sm">
      Links a condition to a nutrient (resolved to foods high in it via USDA data).
      Encourage a beneficial nutrient (Omega-3, Fiber…) or limit a harmful one
      (Saturated Fat, Added Sugar, Sodium).
    </p>
    <p :if={@conditions == []} class="text-parchment-dim text-sm">
      Add a condition first.
    </p>
    <form
      :if={@conditions != []}
      phx-submit="save_nutrient_recommendation"
      class="grid grid-cols-1 sm:grid-cols-3 gap-3"
    >
      <select name="recommendation[condition_id]" required class={select_class()}>
        <option value="">Condition…</option>
        <option :for={c <- @conditions} value={c.id}>{c.name}</option>
      </select>
      <select name="recommendation[nutrient_name]" required class={select_class()}>
        <option value="">Nutrient…</option>
        <option :for={n <- @nutrient_labels} value={n}>{n}</option>
      </select>
      <select name="recommendation[recommendation]" class={select_class()}>
        <option :for={r <- recommendations()} value={r}>{r}</option>
      </select>
      <select name="recommendation[severity]" class={select_class()}>
        <option value="">Severity…</option>
        <option :for={s <- severities()} value={s}>{s}</option>
      </select>
      <select name="recommendation[evidence_level]" class={select_class()}>
        <option value="">Evidence…</option>
        <option :for={e <- evidence_levels()} value={e}>{e}</option>
      </select>
      <select name="recommendation[source]" class={select_class()}>
        <option :for={s <- sources()} value={s}>{s}</option>
      </select>
      <input
        type="text"
        name="recommendation[notes]"
        placeholder="Notes (optional)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim sm:col-span-2"
      />
      <input
        type="text"
        name="recommendation[reference_label]"
        placeholder="Source label (required for manual/guideline)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim"
      />
      <input
        type="url"
        name="recommendation[reference_url]"
        placeholder="Source URL (guideline link)"
        class="rounded border border-ink-panel2 bg-ink-panel2 text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim"
      />
      <button
        type="submit"
        class="justify-self-start px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
      >
        Add nutrient recommendation
      </button>
    </form>
  </section>

  <%!-- ── Review derived recommendations (from literature) ───────────── --%>
  <section class="space-y-3 rounded-lg border border-ink-panel2 bg-ink-panel p-4">
    <div class="flex flex-wrap items-center gap-2">
      <h2 class="text-lg font-medium text-parchment mr-2">
        Review derived recommendations ({length(@rec_candidates)})
      </h2>
      <.link
        navigate={~p"/professional/science"}
        class="text-sm text-basil hover:underline ml-auto"
      >
        Derive more →
      </.link>
    </div>
    <p class="text-parchment-dim text-sm">
      Candidates derived from PubTator's directional chemical↔disease relations. The
      <span class="font-medium">suggested</span>
      direction comes from relation valence
      (negative → encourage, positive → avoid); confirm the direction & severity, then
      <span class="font-medium">Promote</span>
      to write a curated recommendation
      (<code class="text-parchment">source: literature</code>). Nothing is auto-promoted.
    </p>

    <p :if={@rec_candidates == []} class="text-parchment-dim text-sm">
      No pending candidates. Run derivation from the Science Pipeline.
    </p>

    <div
      :for={cand <- @rec_candidates}
      class="py-3 border-t border-ink-panel2 flex flex-wrap items-start gap-3 justify-between"
    >
      <div class="min-w-0 flex-1">
        <div class="text-parchment font-medium truncate">
          {cand.condition.name}
          <span class="text-parchment-dim">·</span>
          {cand.compound.name}
          <span class={"text-xs ml-1 #{rec_class(cand.suggested_recommendation)}"}>
            (suggests {cand.suggested_recommendation || "neutral"})
          </span>
        </div>
        <div class="text-xs text-parchment-dim">
          evidence: <span class="font-medium">{cand.evidence_level || "insufficient"}</span>
          · score: {cand.evidence_score} · relations −{(cand.relation_counts || %{})["negative"] ||
            0} / +{(cand.relation_counts || %{})["positive"] || 0} / ~{(cand.relation_counts ||
                                                                          %{})["association"] || 0} · {cand.study_count} stud{if cand.study_count ==
                                                                                                                                   1,
                                                                                                                                 do:
                                                                                                                                   "y",
                                                                                                                                 else:
                                                                                                                                   "ies"}
        </div>
        <div :if={cand.studies != []} class="text-xs text-parchment-dim mt-0.5">
          refs:
          <a
            :for={study <- cand.studies}
            href={"https://pubmed.ncbi.nlm.nih.gov/#{study.pmid}/"}
            target="_blank"
            rel="noopener"
            class="text-basil hover:underline mr-1"
          >{study.pmid}</a>
        </div>
      </div>

      <form phx-submit="promote_recommendation" class="flex flex-wrap items-center gap-2">
        <input type="hidden" name="candidate_id" value={cand.id} />
        <select name="recommendation" class={select_class()}>
          <option
            :for={r <- recommendations()}
            value={r}
            selected={r == default_rec(cand.suggested_recommendation)}
          >
            {r}
          </option>
        </select>
        <select name="severity" class={select_class()}>
          <option value="">Severity…</option>
          <option :for={s <- severities()} value={s}>{s}</option>
        </select>
        <button
          type="submit"
          class="px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
        >
          Promote
        </button>
        <button
          type="button"
          phx-click="reject_recommendation"
          phx-value-id={cand.id}
          data-confirm="Reject this candidate? It will not be promoted."
          class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
        >
          Reject
        </button>
      </form>
    </div>
  </section>

  <%!-- ── Review phase-aware candidates (Active Flare vs Remission …) ──── --%>
  <section class="space-y-3 rounded-lg border border-paprika/30 bg-ink-panel p-4">
    <div class="flex flex-wrap items-center gap-2">
      <h2 class="text-lg font-medium text-parchment mr-2">
        Review phase-aware candidates ({length(@phase_candidates)})
      </h2>
      <.link navigate={~p"/professional/science"} class="text-sm text-basil hover:underline ml-auto">
        Run condition crawl →
      </.link>
    </div>
    <p class="text-parchment-dim text-sm">
      Extracted from condition literature by the offline Python service, each tagged
      with a <span class="font-medium">disease phase</span>
      (Active Flare, Remission …). Confirm the direction, severity and phase, then
      <span class="font-medium">Promote</span>
      to write a phase-specific recommendation
      (<code class="text-parchment">condition_state_recommendations</code>, shown only on
      the condition page). Nothing is auto-promoted.
    </p>

    <p :if={@phase_candidates == []} class="text-parchment-dim text-sm">
      No pending phase candidates. Run the condition crawl + Python extractor.
    </p>

    <div
      :for={cand <- @phase_candidates}
      class="py-3 border-t border-ink-panel2 flex flex-wrap items-start gap-3 justify-between"
    >
      <div class="min-w-0 flex-1">
        <div class="text-parchment font-medium truncate">
          {cand.condition.name}
          <span class="text-parchment-dim">·</span>
          {phase_target(cand)}
          <span class="text-xs ml-1 px-2 py-0.5 rounded-full bg-paprika/20 text-paprika-soft">
            {if cand.condition_state, do: cand.condition_state.name, else: "general"}
          </span>
          <span class={"text-xs ml-1 #{rec_class(cand.suggested_recommendation)}"}>
            (suggests {cand.suggested_recommendation || "neutral"})
          </span>
        </div>
        <div class="text-xs text-parchment-dim">
          target: <span class="font-medium">{cand.target_kind}</span>
          · confidence: {cand.confidence || cand.evidence_score} · {cand.study_count} stud{if cand.study_count ==
                                                                                                 1,
                                                                                               do: "y",
                                                                                               else: "ies"}
        </div>
        <div :if={is_map(cand.evidence) && cand.evidence["snippet"]} class="text-xs text-parchment-dim/80 mt-0.5 italic truncate">
          “{cand.evidence["snippet"]}”
        </div>
        <div :if={cand.studies != []} class="text-xs text-parchment-dim mt-0.5">
          refs:
          <a
            :for={study <- cand.studies}
            href={"https://pubmed.ncbi.nlm.nih.gov/#{study.pmid}/"}
            target="_blank"
            rel="noopener"
            class="text-basil hover:underline mr-1"
          >{study.pmid}</a>
        </div>
      </div>

      <form phx-submit="promote_phase_candidate" class="flex flex-wrap items-center gap-2">
        <input type="hidden" name="candidate_id" value={cand.id} />
        <select name="condition_state_id" class={select_class()}>
          <option value="">General (all phases)</option>
          <option
            :for={st <- states_for_candidate(cand)}
            value={st.id}
            selected={cand.condition_state_id == st.id}
          >
            {st.name}
          </option>
        </select>
        <select name="recommendation" class={select_class()}>
          <option
            :for={r <- recommendations()}
            value={r}
            selected={r == default_rec(cand.suggested_recommendation)}
          >
            {r}
          </option>
        </select>
        <select name="severity" class={select_class()}>
          <option value="">Severity…</option>
          <option :for={s <- severities()} value={s} selected={s == cand.suggested_severity}>
            {s}
          </option>
        </select>
        <button
          type="submit"
          class="px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
        >
          Promote
        </button>
        <button
          type="button"
          phx-click="reject_phase_candidate"
          phx-value-id={cand.id}
          data-confirm="Reject this candidate? It will not be promoted."
          class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
        >
          Reject
        </button>
      </form>
    </div>
  </section>

  <%!-- ── Conditions list ────────────────────────────────────────────── --%>
  <section class="space-y-3">
    <h2 class="text-lg font-medium text-parchment">
      Conditions ({length(@conditions)})
    </h2>

    <p :if={@conditions == []} class="text-parchment-dim text-sm">
      No conditions yet.
    </p>

    <div
      :for={condition <- @conditions}
      class="rounded-lg border border-ink-panel2 bg-ink-panel p-4 space-y-2"
    >
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-parchment font-medium">{condition.name}</span>
        <span
          :if={condition.category}
          class="text-xs rounded bg-ink-panel2 text-parchment-dim px-2 py-0.5"
        >
          {condition.category}
        </span>
        <button
          type="button"
          phx-click="search_condition_papers"
          phx-value-id={condition.id}
          disabled={MapSet.member?(@crawling, condition.id)}
          class="ml-auto text-xs rounded border border-ink-panel2 bg-ink-panel2 text-parchment px-2 py-1 hover:bg-ink-panel disabled:opacity-60"
        >
          {if MapSet.member?(@crawling, condition.id), do: "Searching…", else: "Search papers"}
        </button>
        <button
          type="button"
          phx-click="delete_condition"
          phx-value-id={condition.id}
          data-confirm={"Delete “#{condition.name}” and all its recommendations?"}
          class="text-xs text-red-400 hover:underline"
        >
          Delete condition
        </button>
      </div>

      <p :if={condition.description} class="text-xs text-parchment-dim">
        {condition.description}
      </p>

      <div class="divide-y divide-ink-panel2 border-t border-ink-panel2 pt-1">
        <p :if={@recs[condition.id] == []} class="text-xs text-parchment-dim py-2">
          No recommendations yet.
        </p>
        <div
          :for={rec <- @recs[condition.id]}
          class="py-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm"
        >
          <span class={"font-medium #{rec_class(rec.recommendation)}"}>{rec.recommendation}</span>
          <span class="text-parchment">{rec.compound.name}</span>
          <span class="text-xs text-parchment-dim">
            {[rec.severity, rec.evidence_level, rec.source]
            |> Enum.reject(&is_nil/1)
            |> Enum.join(" · ")}
          </span>
          <button
            type="button"
            phx-click="delete_recommendation"
            phx-value-id={rec.id}
            data-confirm="Remove this recommendation?"
            class="ml-auto text-xs text-red-400 hover:underline"
          >
            Remove
          </button>
        </div>

        <div
          :for={rec <- @nutrient_recs[condition.id] || []}
          class="py-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm"
        >
          <span class={"font-medium #{rec_class(rec.recommendation)}"}>{rec.recommendation}</span>
          <span class="text-parchment">{rec.nutrient_name}</span>
          <span class="text-xs rounded bg-ink-panel2 text-parchment-dim px-1.5 py-0.5">nutrient</span>
          <span class="text-xs text-parchment-dim">
            {[rec.severity, rec.evidence_level, rec.source]
            |> Enum.reject(&is_nil/1)
            |> Enum.join(" · ")}
          </span>
          <button
            type="button"
            phx-click="delete_nutrient_recommendation"
            phx-value-id={rec.id}
            data-confirm="Remove this nutrient recommendation?"
            class="ml-auto text-xs text-red-400 hover:underline"
          >
            Remove
          </button>
        </div>
      </div>

      <%!-- ── Discovered papers (collapse) + analyze form ──────────────── --%>
      <div
        :if={Map.has_key?(@condition_studies, condition.id)}
        class="mt-2 pt-2 border-t border-ink-panel2"
        x-data="{ open: false }"
      >
        <button
          type="button"
          @click="open = !open"
          class="cursor-pointer inline-flex items-center gap-1 text-[11px] text-parchment-dim hover:text-parchment transition-colors"
        >
          <svg
            class="w-3 h-3 transition-transform duration-200"
            x-bind:class="open && 'rotate-90'"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          Papers ({length(@condition_studies[condition.id])})
        </button>

        <div
          class="grid transition-all duration-200 ease-out"
          style="grid-template-rows: 0fr"
          x-bind:style="open ? 'grid-template-rows: 1fr' : 'grid-template-rows: 0fr'"
        >
          <div class="overflow-hidden">
            <p
              :if={@condition_studies[condition.id] == []}
              class="text-xs text-parchment-dim mt-2"
            >
              No papers found yet — try searching again later.
            </p>

            <form
              :if={@condition_studies[condition.id] != []}
              phx-submit="analyze_condition"
              class="mt-2 space-y-1"
            >
              <div class="flex items-center gap-3 mb-1">
                <button
                  type="button"
                  @click="$el.closest('form').querySelectorAll('.condition-pmid').forEach(c => c.checked = true)"
                  class="text-[11px] text-basil hover:underline"
                >
                  Select all
                </button>
                <button
                  type="submit"
                  disabled={@analyzing}
                  class="px-3 py-1.5 rounded bg-basil text-ink text-xs font-medium hover:opacity-90 disabled:opacity-60"
                >
                  {if @analyzing, do: "Analyzing…", else: "Analyze selected"}
                </button>
                <button
                  type="button"
                  @click="$el.closest('form').querySelectorAll('.condition-pmid').forEach(c => c.checked = false)"
                  class="text-[11px] text-parchment-dim hover:underline"
                >
                  Clear
                </button>
              </div>
              <label
                :for={study <- @condition_studies[condition.id]}
                class="flex items-start gap-2 text-xs text-parchment-dim py-0.5"
              >
                <input
                  type="checkbox"
                  name="pmids[]"
                  value={study.pmid}
                  class="condition-pmid mt-0.5 accent-basil"
                />
                <span class="min-w-0">
                  <a
                    href={"https://pubmed.ncbi.nlm.nih.gov/#{study.pmid}/"}
                    target="_blank"
                    rel="noopener"
                    class="text-basil hover:underline"
                  >{study.pmid}</a>
                  <span class="text-parchment">{study.title}</span>
                </span>
              </label>

              <p class="text-[11px] text-parchment-dim pt-1">Select 1–200 papers.</p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- ── Extractor analysis result (modal) ──────────────────────────── --%>
  <%!-- Opened by the inner content's phx-mounted when @analysis is set (server-side
       `show` flips don't re-fire the modal's own phx-mounted). --%>
  <.modal id="analysis-modal" show={false} on_cancel={JS.push("close_analysis")}>
    <div :if={@analysis} phx-mounted={show_modal("analysis-modal")} class="space-y-4">
      <div>
        <h3 class="text-lg font-medium text-parchment">Batch analysis</h3>
        <p class="text-xs text-parchment-dim">
          {length(@analysis["included_pmids"] || [])} of {length(
            @analysis["requested_pmids"] || []
          )} papers included · engine {get_in(@analysis, ["run", "synthesis_version"]) || "?"}
        </p>
      </div>

      <div>
        <h4 class="text-sm font-medium text-parchment mb-1">
          Conclusions ({length(@analysis["conclusions"] || [])})
        </h4>
        <p :if={(@analysis["conclusions"] || []) == []} class="text-xs text-parchment-dim">
          No cross-paper conclusions — the papers may not share a topic core.
        </p>
        <div
          :for={c <- @analysis["conclusions"] || []}
          class="py-2 border-t border-ink-panel2 text-sm"
        >
          <div class="text-parchment">
            <span class="font-medium">{c["subject_name"]}</span>
            <span class="text-parchment-dim">— {c["predicate"]} —</span>
            <span class="font-medium">{c["object_name"]}</span>
            <span class="text-xs ml-1 px-2 py-0.5 rounded-full bg-ink-panel2 text-parchment-dim">
              {c["direction"]} · {c["paper_count"]} paper(s)
            </span>
          </div>
          <p :if={first_quote(c)} class="text-xs text-parchment-dim/80 italic mt-1">
            “{first_quote(c)}”
          </p>
        </div>
      </div>

      <div :if={(@analysis["outliers"] || []) != []}>
        <h4 class="text-sm font-medium text-parchment mb-1">
          Outliers ({length(@analysis["outliers"])})
        </h4>
        <div :for={o <- @analysis["outliers"]} class="text-xs text-parchment-dim">
          {o["pmid"]} — {o["reason"]}
        </div>
      </div>

      <div :if={(@analysis["warnings"] || []) != []}>
        <h4 class="text-sm font-medium text-parchment mb-1">Warnings</h4>
        <ul class="list-disc pl-5 text-xs text-parchment-dim space-y-0.5">
          <li :for={w <- @analysis["warnings"]}>{w}</li>
        </ul>
      </div>
    </div>
  </.modal>
</div>
