<div class="max-w-5xl mx-auto p-4 space-y-6">
  <div class="flex flex-wrap items-center gap-3">
    <h1 class="text-2xl font-semibold text-parchment">Discovered Studies</h1>

    <nav class="flex items-center gap-1 ml-auto rounded-lg border border-ink-panel2 p-1 text-sm font-medium">
      <.link
        patch={~p"/professional/science"}
        class="px-3 py-1 rounded text-parchment-dim hover:text-parchment"
      >
        Pipeline
      </.link>
      <span class="px-3 py-1 rounded bg-basil text-ink">Studies</span>
      <.link
        patch={~p"/professional/science/entities"}
        class="px-3 py-1 rounded text-parchment-dim hover:text-parchment"
      >
        Entities
      </.link>
    </nav>

    <button
      type="button"
      phx-click="refresh"
      class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
    >
      Refresh
    </button>
  </div>

  <p class="text-parchment-dim text-sm">
    Papers discovered by the Entrez/PubMed crawl (stage 1). Expand a row to see the
    ingredients it was linked to and the entities extracted from it (stage 2).
  </p>

  <section class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-3">
      <div class="text-2xl font-semibold text-parchment">{@total_all}</div>
      <div class="text-xs text-parchment-dim">studies discovered</div>
    </div>
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-3">
      <div class="text-2xl font-semibold text-basil">{@ledger["matched"]}</div>
      <div class="text-xs text-parchment-dim">terms matched</div>
    </div>
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-3">
      <div class="text-2xl font-semibold text-parchment-dim">{@ledger["no_results"]}</div>
      <div class="text-xs text-parchment-dim">terms no results</div>
    </div>
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-3">
      <div class={"text-2xl font-semibold #{if @ledger["error"] > 0, do: "text-red-400", else: "text-parchment-dim"}"}>
        {@ledger["error"]}
      </div>
      <div class="text-xs text-parchment-dim">terms errored</div>
    </div>
  </section>

  <form phx-submit="search" class="flex items-center gap-2">
    <input
      type="text"
      name="q"
      value={@search}
      placeholder="Search title or PMID…"
      class="flex-1 rounded border border-ink-panel2 bg-ink-panel text-parchment text-sm px-3 py-1.5 placeholder:text-parchment-dim"
    />
    <button
      type="submit"
      class="px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
    >
      Search
    </button>
    <button
      :if={@search != ""}
      type="button"
      phx-click="clear"
      class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
    >
      Clear
    </button>
  </form>

  <div class="text-xs text-parchment-dim">
    {@total} result{if @total == 1, do: "", else: "s"}{if @search != "",
      do: " for “#{@search}”",
      else: ""}
  </div>

  <section class="divide-y divide-ink-panel2 rounded-lg border border-ink-panel2">
    <div :if={@studies == []} class="p-6 text-center text-parchment-dim text-sm">
      No studies yet — run the crawl on the Pipeline tab.
    </div>

    <div :for={study <- @studies} class="p-3">
      <div class="flex flex-wrap items-start gap-3 justify-between">
        <div class="min-w-0 flex-1">
          <a
            href={pubmed_url(study.pmid)}
            target="_blank"
            rel="noopener"
            class="text-parchment font-medium hover:underline"
          >
            {study.title || "(untitled)"}
          </a>
          <div class="text-xs text-parchment-dim mt-0.5">
            {meta_line(study)}
            <span :if={meta_line(study) != ""}>·</span>
            PMID {study.pmid} ·
            <span class="text-basil">{Map.get(@ing_counts, study.id, 0)}</span>
            ingredients
            · <span class="text-parchment">{Map.get(@mention_counts, study.id, 0)}</span>
            mentions
          </div>
        </div>

        <button
          type="button"
          phx-click="toggle"
          phx-value-id={study.id}
          class="px-3 py-1 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90 shrink-0"
        >
          {if @open_id == study.id, do: "Hide", else: "Details"}
        </button>
      </div>

      <div
        :if={@open_id == study.id && @detail}
        class="mt-3 pl-3 border-l-2 border-ink-panel2 space-y-3"
      >
        <p :if={study.abstract} class="text-xs text-parchment-dim line-clamp-4">
          {study.abstract}
        </p>

        <div>
          <div class="text-xs font-semibold text-parchment mb-1">Linked ingredients</div>
          <div class="flex flex-wrap gap-1">
            <span :if={@detail.ingredients == []} class="text-xs text-parchment-dim">none</span>
            <span
              :for={ing <- @detail.ingredients}
              class="text-xs rounded bg-ink-panel2 text-parchment px-2 py-0.5"
            >
              {ing.name}
            </span>
          </div>
        </div>

        <div>
          <div class="text-xs font-semibold text-parchment mb-1">
            Entity mentions ({length(@detail.mentions)})
          </div>
          <div :if={@detail.mentions == []} class="text-xs text-parchment-dim">
            not annotated yet — run annotation (stage 2)
          </div>
          <div class="flex flex-wrap gap-1">
            <span
              :for={m <- @detail.mentions}
              class={"text-xs rounded border border-ink-panel2 px-2 py-0.5 #{mention_class(m.entity_type)}"}
              title={"#{m.entity_type} · #{m.normalized_identifier}"}
            >
              {m.text_span}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="flex items-center justify-between text-sm">
    <button
      type="button"
      phx-click="prev"
      disabled={@page <= 1}
      class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment font-medium hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed"
    >
      ← Prev
    </button>
    <span class="text-parchment-dim">Page {@page} of {max(ceil(@total / 25), 1)}</span>
    <button
      type="button"
      phx-click="next"
      disabled={@page >= max(ceil(@total / 25), 1)}
      class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment font-medium hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed"
    >
      Next →
    </button>
  </div>
</div>
