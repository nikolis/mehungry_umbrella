<div class="max-w-5xl mx-auto p-4 space-y-8">
  <h1 class="text-2xl font-semibold text-parchment">Ingredient Reconciliation</h1>

  <p class="text-parchment-dim text-sm">
    Backfills <code>data_type</code> from <code>food_class</code> and bumps each
    row's <code>version</code>, in batches, until every ingredient is covered.
    Safe to run online — it takes only short per-row locks.
  </p>

  <section class="space-y-3 rounded-lg border border-ink-panel2 bg-ink-panel p-4">
    <div class="flex flex-wrap items-center gap-2">
      <button
        type="button"
        phx-click="backfill"
        data-confirm="Start the data_type backfill? It re-enqueues itself until every ingredient is done. Idempotent."
        class="px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
      >
        Start Backfill
      </button>

      <button
        type="button"
        phx-click="refresh"
        class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90 ml-auto"
      >
        Refresh
      </button>
    </div>

    <div>
      <div class="flex items-center justify-between text-xs text-parchment-dim mb-1">
        <span>
          Backfilled: {@progress.done} / {@progress.total} ({percent(@progress)}%)
        </span>
      </div>
      <div class="h-2 w-full rounded bg-ink-panel2 overflow-hidden">
        <div class="h-full bg-basil rounded" style={"width: #{percent(@progress)}%"}></div>
      </div>
    </div>
  </section>
</div>
