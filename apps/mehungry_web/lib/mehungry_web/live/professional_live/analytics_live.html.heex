<div class="px-4 py-6 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-6">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-white">Traffic</h1>
      <p class="text-parchment-dim text-sm mt-0.5">
        Consent-independent session count — the one number Google Analytics can't give you.
      </p>
      <p class="text-parchment-dim text-xs mt-1 max-w-2xl">
        Everything else (traffic sources, pages, devices, geography, user journeys, SEO) now
        lives in <span class="text-parchment">Google Analytics</span> and
        <span class="text-parchment">Search Console</span>, which measure it accurately and for
        all page loads — not just cookie-consented LiveView traffic.
      </p>
    </div>
    <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 shrink-0">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="text-emerald-400 text-sm font-semibold">{@online_count} online</span>
    </div>
  </div>

  <!-- Anonymous sessions (consent-independent, zero PII) -->
  <div class="bg-ink-panel border border-emerald-500/30 rounded-2xl p-5">
    <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
      <div>
        <h2 class="text-sm font-semibold text-white">Anonymous sessions — all traffic</h2>
        <p class="text-xs text-parchment-dim mt-0.5 max-w-xl">
          Counted for 100% of visitors regardless of the cookie banner (declined included),
          measured server-side from LiveView connection lifetime. Stores no IP, user agent,
          cookie, or user — only a daily count + total time. This is your true denominator;
          GA4 only sees the consented subset.
        </p>
      </div>
      <div class="flex gap-6 shrink-0">
        <div>
          <div class="text-xs font-semibold uppercase tracking-wider text-parchment-dim mb-1">
            Sessions today
          </div>
          <div class="text-3xl font-bold text-emerald-400">{@anon_sessions_today}</div>
          <div class="text-xs text-parchment-dim mt-1">all consent states</div>
        </div>
        <div>
          <div class="text-xs font-semibold uppercase tracking-wider text-parchment-dim mb-1">
            Avg session
          </div>
          <div class="text-3xl font-bold text-white">{@anon_avg_session}</div>
          <div class="text-xs text-parchment-dim mt-1">connected time today</div>
        </div>
      </div>
    </div>
    <div
      id="session-chart-wrapper"
      phx-hook="ResponsiveChart"
      data-id="session"
      data-origin_id="session"
      data-size="full"
      class="w-full overflow-hidden"
    >
      <div
        id="vega-session"
        phx-hook="VegaLite"
        data-spec={Jason.encode!(@session_chart_spec)}
        class="w-full"
      >
      </div>
    </div>
    <p class="text-xs text-parchment-dim mt-3">Sessions per day — last 14 days</p>
  </div>
</div>
