<div class="max-w-5xl mx-auto p-4 space-y-6">
  <%!-- ── Pipeline header + flow legend ─────────────────────────────────────── --%>
  <div class="space-y-3">
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-2xl font-semibold text-parchment">Compound pipeline</h1>
      <.link
        navigate={~p"/professional/usda-schema"}
        class="text-xs text-basil hover:underline"
      >
        ← USDA schema (curate species)
      </.link>
    </div>
    <p class="text-parchment-dim text-sm max-w-3xl">
      One self-contained flow that turns accumulated evidence into curated
      <span class="font-medium">species</span>↔compound facts. Each stage below feeds the next;
      the final facts are what <code class="text-parchment">Health</code> advice and the
      <code class="text-parchment">/foods</code> filter read.
    </p>

    <%!-- flow stepper legend --%>
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-parchment-dim">
      <li class="flex items-center gap-1.5">
        <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-ink-panel2 text-parchment font-semibold">1</span>
        Evidence
      </li>
      <li aria-hidden="true">→</li>
      <li class="flex items-center gap-1.5">
        <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-ink-panel2 text-parchment font-semibold">2</span>
        Derive &amp; score
      </li>
      <li aria-hidden="true">→</li>
      <li class="flex items-center gap-1.5">
        <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-ink-panel2 text-parchment font-semibold">3</span>
        Review
      </li>
      <li aria-hidden="true">→</li>
      <li class="flex items-center gap-1.5">
        <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-basil text-ink font-semibold">4</span>
        Curated facts
      </li>
      <li aria-hidden="true" class="text-parchment-dim/70">⇒ Health · /foods · literature terms</li>
    </ol>
  </div>

  <%!-- ═══ ① EVIDENCE (inputs the pipeline consumes) ══════════════════════════ --%>
  <section class="rounded-lg border border-ink-panel2 bg-ink-panel p-4 space-y-4">
    <header class="flex items-baseline gap-2">
      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-ink-panel2 text-parchment text-sm font-semibold">1</span>
      <h2 class="text-lg font-medium text-parchment">Evidence</h2>
      <span class="text-xs text-parchment-dim">the inputs — {@progress.total} evidence pair{if @progress.total == 1, do: "", else: "s"} available</span>
    </header>
    <p class="text-parchment-dim text-xs max-w-3xl">
      The pipeline derives from two accumulated signals: <span class="font-medium">literature
      co-occurrence</span> (a resolved chemical mentioned in a paper linked to the species —
      a <span class="italic">frozen corpus</span>, since the species crawl is dormant) and
      <span class="font-medium">measurements</span>. Adding a measurement below is the one live
      way to grow the evidence base.
    </p>

    <%!-- Add measurement --%>
    <div class="rounded border border-ink-panel2 bg-ink-panel2/40 p-3 space-y-3">
      <h3 class="text-sm font-medium text-parchment">Add measurement</h3>
      <p class="text-parchment-dim text-xs">
        Quantitative "contains" evidence for an ingredient (rolls up to its species and is
        blended into the candidate score via noisy-OR — stronger than co-occurrence).
        Immutable once saved; adding one re-scores that species candidate.
      </p>

      <p :if={@measurable == []} class="text-parchment-dim text-sm">
        No curated ingredients yet — assign ingredients to a species in the USDA Schema view first.
      </p>

      <form
        :if={@measurable != []}
        phx-submit="add_measurement"
        class="grid grid-cols-1 sm:grid-cols-3 gap-3"
      >
        <select name="measurement[ingredient_id]" required class={field_class()}>
          <option value="">Ingredient (→ species)…</option>
          <option :for={m <- @measurable} value={m.ingredient_id}>
            {m.ingredient_name} → {m.species_name}
          </option>
        </select>
        <select name="measurement[compound_id]" required class={field_class()}>
          <option value="">Compound…</option>
          <option :for={c <- @compounds} value={c.id}>{c.name}</option>
        </select>
        <select name="measurement[extraction_method]" class={field_class()}>
          <option :for={m <- extraction_methods()} value={m}>{m}</option>
        </select>
        <input
          type="number"
          step="any"
          name="measurement[value]"
          required
          placeholder="Value (e.g. 750)"
          class={field_class()}
        />
        <input
          type="text"
          name="measurement[unit]"
          required
          placeholder="Unit (e.g. mg/100g)"
          class={field_class()}
        />
        <input
          type="text"
          name="measurement[preparation_method]"
          placeholder="Preparation (e.g. Raw)"
          class={field_class()}
        />
        <input
          type="text"
          name="measurement[analytical_method]"
          placeholder="Analytical method (e.g. HPLC)"
          class={field_class()}
        />
        <input
          type="number"
          name="measurement[sample_size]"
          placeholder="Sample size (optional)"
          class={field_class()}
        />
        <input
          type="text"
          name="measurement[pmid]"
          placeholder="Source PMID (optional)"
          class={field_class()}
        />
        <button
          type="submit"
          class="justify-self-start px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
        >
          Record measurement
        </button>
      </form>
    </div>

    <%!-- Recorded measurements --%>
    <div>
      <h3 class="text-sm font-medium text-parchment mb-1">Recorded measurements</h3>
      <p class="text-parchment-dim text-xs mb-2">
        Newest first. The quoted sentence (when present) is the source context the value came
        from — kept as provenance.
      </p>

      <div id="recorded_measurements" phx-update="stream" class="divide-y divide-ink-panel2">
        <div
          :for={{dom_id, m} <- @streams.measurements}
          id={dom_id}
          class="py-3"
        >
          <div class="text-parchment font-medium">
            {m.ingredient.name} <span class="text-parchment-dim">contains</span> {m.compound.name}
            <span class="text-basil">· {m.value} {m.unit}</span>
          </div>
          <p
            :if={m.raw_span && m.raw_span != ""}
            class="text-xs text-parchment-dim italic mt-1 border-l-2 border-ink-panel2 pl-2"
          >
            “{m.raw_span}”
          </p>
          <div class="text-xs text-parchment-dim mt-1">
            {[m.preparation_method, m.analytical_method]
            |> Enum.reject(&is_nil/1)
            |> Enum.join(" · ")}
            <span :if={m.study && m.study.pmid}>
              ·
              <a
                href={"https://pubmed.ncbi.nlm.nih.gov/#{m.study.pmid}/"}
                target="_blank"
                rel="noopener"
                class="text-basil hover:underline"
              >PMID {m.study.pmid}</a>
            </span>
            · {m.extraction_method}
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- ═══ ② DERIVE & SCORE ═══════════════════════════════════════════════════ --%>
  <section class="rounded-lg border border-ink-panel2 bg-ink-panel p-4 space-y-3">
    <header class="flex items-baseline gap-2">
      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-ink-panel2 text-parchment text-sm font-semibold">2</span>
      <h2 class="text-lg font-medium text-parchment">Derive &amp; score</h2>
    </header>
    <p class="text-parchment-dim text-xs max-w-3xl">
      Scores each <span class="font-medium">(species, compound)</span> pair by blending its two
      evidence signals with noisy-OR, writing a <span class="font-medium">candidate</span>.
      Candidates that clear the threshold auto-promote <span class="italic">only</span> past two
      credibility gates — a curated <code class="text-parchment">dietary_relevance</code> flag and an
      LLM "reality check" — so document co-occurrence never masquerades as containment. The rest wait
      for review in ③.
    </p>

    <div class="flex flex-wrap items-center gap-2">
      <button
        type="button"
        phx-click="derive"
        disabled={running?(@run)}
        data-confirm="Derive candidates from all current evidence and auto-promote strong ones?"
        class="px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed"
      >
        {if running?(@run), do: "Deriving…", else: "Derive candidates"}
      </button>

      <button
        type="button"
        phx-click="refresh"
        class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90 ml-auto"
      >
        Refresh
      </button>
    </div>

    <div>
      <div class="flex items-center justify-between text-xs text-parchment-dim mb-1">
        <span>
          Derived: {@progress.processed} / {@progress.total} ({percent(@progress)}%)
        </span>
        <span class={"font-medium #{run_class(@run)}"} title={run_error(@run)}>
          {run_label(@run)}
        </span>
      </div>
      <div class="h-2 w-full rounded bg-ink-panel2 overflow-hidden">
        <div class="h-full bg-basil rounded" style={"width: #{percent(@progress)}%"}></div>
      </div>
    </div>
  </section>

  <%!-- ═══ ③ REVIEW (pending candidates) ══════════════════════════════════════ --%>
  <section class="rounded-lg border border-ink-panel2 bg-ink-panel p-4 space-y-3">
    <header class="flex items-baseline gap-2">
      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-ink-panel2 text-parchment text-sm font-semibold">3</span>
      <h2 class="text-lg font-medium text-parchment">Review</h2>
      <span class="text-xs text-parchment-dim">strongest evidence first</span>
    </header>
    <p class="text-parchment-dim text-xs">
      Candidates that didn't auto-promote. <span class="font-medium">Promote</span>
      writes a curated fact (→ ④); <span class="font-medium">Reject</span>
      drops it; <span class="font-medium">Non-dietary</span>
      excludes the compound everywhere. Each row shows its score and the LLM reality-check verdict.
    </p>

    <div
      id="compound_candidates"
      phx-hook="InfiniteScroll"
      phx-update="stream"
      data-page={@page}
      class="divide-y divide-ink-panel2"
    >
      <div
        :for={{dom_id, candidate} <- @streams.candidates}
        id={dom_id}
        class="py-3 flex flex-wrap items-center gap-3 justify-between"
      >
        <div class="min-w-0 flex-1">
          <div class="text-parchment font-medium truncate">
            {candidate.species.name} <span class="text-parchment-dim">contains</span>
            {candidate.compound.name}
          </div>
          <div class="text-xs text-parchment-dim">
            evidence:
            <span class={"font-medium #{level_class(candidate.evidence_level)}"}>
              {candidate.evidence_level || "insufficient"}
            </span>
            · score: {score_label(candidate.evidence_score)} · {candidate.study_count} lit · {candidate.measurement_study_count} meas
            · sources: {(candidate.sources || []) |> Enum.join(", ")}
          </div>
          <div :if={candidate.studies != []} class="text-xs text-parchment-dim mt-0.5">
            refs:
            <a
              :for={study <- candidate.studies}
              href={"https://pubmed.ncbi.nlm.nih.gov/#{study.pmid}/"}
              target="_blank"
              rel="noopener"
              class="text-basil hover:underline mr-1"
            >{study.pmid}</a>
          </div>
          <div
            :if={candidate.plausibility_verdict}
            class={"text-xs mt-0.5 #{plausibility_class(candidate.plausibility_verdict)}"}
          >
            reality check: <span class="font-medium">{candidate.plausibility_verdict}</span>
            <span :if={candidate.plausibility_reason && candidate.plausibility_reason != ""} class="text-parchment-dim">
              — {candidate.plausibility_reason}
            </span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            phx-click="promote"
            phx-value-id={candidate.id}
            class="px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
          >
            Promote
          </button>
          <button
            type="button"
            phx-click="reject"
            phx-value-id={candidate.id}
            data-confirm="Reject this candidate? It will not be promoted."
            class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
          >
            Reject
          </button>
          <button
            type="button"
            phx-click="mark_non_dietary"
            phx-value-id={candidate.id}
            phx-value-compound-id={candidate.compound.id}
            data-confirm={"Mark #{candidate.compound.name} as non-dietary? It will be excluded everywhere (facts + advice) and its existing facts purged. Use for solvents, contaminants, assay reagents, and non-specific class terms."}
            class="px-3 py-1.5 rounded border border-red-500/50 text-red-300 text-sm font-medium hover:opacity-90"
          >
            Non-dietary
          </button>
        </div>
      </div>
    </div>

    <p class="text-parchment-dim text-xs mt-2">
      Scroll to load more. Promoted and rejected rows leave this list.
    </p>
  </section>

  <%!-- ═══ ④ CURATED FACTS (the outcome) ══════════════════════════════════════ --%>
  <section class="rounded-lg border border-basil/40 bg-ink-panel p-4 space-y-4">
    <header class="flex flex-wrap items-baseline gap-2">
      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-basil text-ink text-sm font-semibold">4</span>
      <h2 class="text-lg font-medium text-parchment">Curated facts ({@rel_count})</h2>
      <span class="text-xs text-parchment-dim">the outcome</span>
      <button
        type="button"
        phx-click="audit_facts"
        data-confirm="Re-check every promoted literature fact with the plausibility gate? Implausible ones will be flagged for review (nothing is deleted)."
        class="ml-auto px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
      >
        Audit facts
      </button>
      <button
        type="button"
        phx-click="purge"
        data-confirm={"Delete all curated facts for non-dietary compounds (#{Enum.join(non_dietary_names(), ", ")})? They are assay reagents, not foods."}
        class="px-3 py-1.5 rounded border border-red-400/40 text-red-400 text-sm font-medium hover:opacity-90"
      >
        Purge non-dietary
      </button>
    </header>
    <p class="text-parchment-dim text-xs max-w-3xl">
      Promoted species↔compound relationships — the facts <code class="text-parchment">Health</code>
      advice and the <code class="text-parchment">/foods</code> filter resolve to (promoted
      compounds also become targeted literature search terms). <span class="font-medium">Undo</span>
      deletes a fact and rejects its candidate so it won't re-promote.
    </p>

    <%!-- Flagged facts — needs review (audit output) --%>
    <div :if={@flagged != [] or @audit_pending > 0} class="rounded border border-red-500/30 bg-red-500/5 p-3 space-y-2">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="text-sm font-medium text-red-200">Flagged facts — needs review</h3>
        <span :if={@audit_pending > 0} class="text-xs text-parchment-dim">
          {@audit_pending} literature fact{if @audit_pending == 1, do: "", else: "s"} awaiting audit
        </span>
      </div>
      <p class="text-parchment-dim text-xs">
        Already-promoted facts the plausibility audit judged implausible (document co-occurrence
        isn't containment). <span class="font-medium">Undo</span>
        removes the fact; <span class="font-medium">Non-dietary</span>
        excludes the compound everywhere.
      </p>

      <div :if={@flagged != []} class="divide-y divide-ink-panel2">
        <div
          :for={f <- @flagged}
          class="py-3 flex flex-wrap items-center gap-3 justify-between"
        >
          <div class="min-w-0 flex-1">
            <div class="text-parchment font-medium truncate">
              {f.species.name} <span class="text-parchment-dim">contains</span> {f.compound.name}
            </div>
            <div class="text-xs text-red-300">
              reality check: <span class="font-medium">implausible</span>
              <span
                :if={f.plausibility_reason && f.plausibility_reason != ""}
                class="text-parchment-dim"
              >
                — {f.plausibility_reason}
              </span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              phx-click="flagged_undo"
              phx-value-id={f.id}
              phx-value-rel-id={f.promoted_relationship_id}
              data-confirm="Delete this curated fact and reject its candidate?"
              class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
            >
              Undo
            </button>
            <button
              type="button"
              phx-click="flagged_non_dietary"
              phx-value-id={f.id}
              phx-value-compound-id={f.compound.id}
              data-confirm={"Mark #{f.compound.name} non-dietary and purge its facts everywhere?"}
              class="px-3 py-1.5 rounded border border-red-500/50 text-red-300 text-sm font-medium hover:opacity-90"
            >
              Non-dietary
            </button>
          </div>
        </div>
      </div>

      <p :if={@flagged == []} class="text-parchment-dim text-xs">
        Audit running — flagged facts appear here after you Refresh.
      </p>
    </div>

    <%!-- Curated facts list --%>
    <div id="curated_relationships" phx-update="stream" class="divide-y divide-ink-panel2">
      <div
        :for={{dom_id, rel} <- @streams.relationships}
        id={dom_id}
        class="py-3 flex flex-wrap items-center gap-3 justify-between"
      >
        <div class="min-w-0 flex-1">
          <div class="text-parchment font-medium truncate">
            {rel.species.name} <span class="text-parchment-dim">{rel.relationship_type}</span>
            {rel.compound.name}
          </div>
          <div class="text-xs text-parchment-dim">
            source: {rel.source} · confidence: {score_label(rel.confidence)}
          </div>
        </div>

        <button
          type="button"
          phx-click="undo"
          phx-value-id={rel.id}
          data-confirm="Delete this curated fact and reject its candidate?"
          class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
        >
          Undo
        </button>
      </div>
    </div>

    <p :if={@rel_count == 0} class="text-parchment-dim text-sm">
      No curated facts yet — promote candidates in ③ (or strong ones auto-promote on derive).
    </p>

    <button
      :if={@rel_count > @rel_page * 25}
      type="button"
      phx-click="load-more-rel"
      class="mt-2 px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
    >
      Load more
    </button>
  </section>
</div>
