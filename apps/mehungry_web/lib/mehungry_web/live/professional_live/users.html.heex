<%= if @confirm_delete_user do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60">
    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 w-full max-w-sm shadow-2xl">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-full bg-red-500/20 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
            />
          </svg>
        </div>
        <div>
          <h3 class="text-white font-semibold">Delete User</h3>
          <p class="text-slate-400 text-sm">This action cannot be undone.</p>
        </div>
      </div>
      <p class="text-slate-300 text-sm mb-6">
        Are you sure you want to permanently delete
        <span class="text-white font-medium">{@confirm_delete_user.email}</span>
        and all their data?
      </p>
      <div class="flex gap-3">
        <button
          phx-click="cancel_delete"
          class="flex-1 px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-300 hover:text-white text-sm font-medium transition"
        >
          Cancel
        </button>
        <button
          phx-click="delete_user"
          phx-value-id={@confirm_delete_user.id}
          class="flex-1 px-4 py-2 rounded-lg bg-red-600 hover:bg-red-500 text-white text-sm font-medium transition"
        >
          Delete
        </button>
      </div>
    </div>
  </div>
<% end %>

<div class="min-h-screen bg-slate-900">
  <div class="container mx-auto px-4 py-6 max-w-2xl">
    <!-- Header -->
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-white flex items-center gap-3">
        <svg
          class="w-7 h-7 text-primary-500 flex-shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
          />
        </svg>
        User Management
      </h1>
      <div class="flex gap-4 mt-2">
        <span class="text-slate-400 text-sm">Total: {Enum.count(@streams.users)}</span>
        <span class="text-amber-400 text-sm">Pro: {@pro_count}</span>
      </div>
    </div>

    <!-- User Cards -->
    <div class="space-y-3">
      <%= for {_id, user} <- @streams.users do %>
        <div class="bg-slate-800 rounded-xl border border-slate-700 hover:border-primary-500/50 transition p-4">
          <div class="flex items-start gap-3">
            <!-- Avatar -->
            <%= if user.profile_pic do %>
              <img
                src={user.profile_pic}
                alt={user.name}
                class="w-10 h-10 rounded-full object-cover flex-shrink-0"
              />
            <% else %>
              <div class="w-10 h-10 rounded-full bg-primary-500/20 flex items-center justify-center flex-shrink-0">
                <span class="text-primary-500 font-semibold">
                  {String.at(user.email, 0) |> String.upcase()}
                </span>
              </div>
            <% end %>

            <!-- Info -->
            <div class="flex-1 min-w-0">
              <!-- Name + badge -->
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-white font-semibold truncate">
                  {user.name || String.split(user.email, "@") |> List.first()}
                </span>
                <% sub = Map.get(@subscriptions, user.id) %>
                <%= if sub && sub.tier == "pro" do %>
                  <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-400 font-semibold border border-amber-500/30">
                    Pro
                  </span>
                <% else %>
                  <span class="text-xs px-2 py-0.5 rounded-full bg-slate-700 text-slate-400">
                    Free
                  </span>
                <% end %>
              </div>

              <!-- Email -->
              <p class="text-slate-400 text-sm truncate mt-0.5">{user.email}</p>

              <!-- Meta row -->
              <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 mt-2 text-xs text-slate-500">
                <span>ID: #{user.id}</span>
                <span>Joined: {Calendar.strftime(user.inserted_at, "%Y-%m-%d")}</span>
                <%= if sub && sub.tier == "pro" && sub.period_end do %>
                  <span class="text-amber-500/70">
                    Renews: {Calendar.strftime(sub.period_end, "%Y-%m-%d")}
                  </span>
                <% end %>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-2 flex-shrink-0">
              <a
                href={"/professional/user/#{user.id}"}
                class="p-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-300 hover:text-white transition"
                title="View Profile"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                  />
                </svg>
              </a>
              <button
                phx-click="confirm_delete"
                phx-value-user-id={user.id}
                phx-value-user-email={user.email}
                class="p-2 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 hover:text-red-300 transition"
                title="Delete User"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                  />
                </svg>
              </button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
