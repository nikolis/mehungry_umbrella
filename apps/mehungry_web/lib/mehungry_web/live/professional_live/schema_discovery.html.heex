<div class="max-w-5xl mx-auto p-4 space-y-8">
  <div class="flex flex-wrap items-start gap-3">
    <div class="flex-1 min-w-[16rem]">
      <h1 class="text-2xl font-semibold text-parchment">Schema Discovery</h1>
      <p class="text-parchment-dim text-sm mt-1">
        Regex-mined structured dimensions found in USDA ingredient names. Dimensions the
        deterministic parser already extracts are reported for QA only; genuinely un-captured
        ones (e.g. variety, size, origin) are proposed as new
        <code class="text-parchment">ingredient_parsed_foods</code>
        columns.
      </p>
    </div>
    <button
      type="button"
      phx-click="recompute"
      class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
    >
      Recompute
    </button>
  </div>

  <section class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-4">
      <div class="text-parchment-dim text-xs uppercase tracking-wide">Ingredients</div>
      <div class="text-parchment text-2xl font-semibold">{@total_ingredients}</div>
    </div>
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-4">
      <div class="text-parchment-dim text-xs uppercase tracking-wide">Parse fill-rate</div>
      <div class="text-parchment text-2xl font-semibold">{pct(@parse_fill_rate)}</div>
      <div class="text-parchment-dim text-xs mt-1">have a linked canonical food</div>
    </div>
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-4">
      <div class="text-parchment-dim text-xs uppercase tracking-wide">Projected coverage</div>
      <div class="text-parchment text-2xl font-semibold">{pct(@projected_coverage)}</div>
      <div class="text-parchment-dim text-xs mt-1">union of selected dimensions</div>
    </div>
  </section>

  <section class="space-y-3">
    <h2 class="text-lg font-semibold text-parchment">Dimensions</h2>
    <div class="overflow-x-auto rounded-lg border border-ink-panel2">
      <table class="min-w-full text-sm">
        <thead class="bg-ink-panel2 text-parchment-dim">
          <tr>
            <th class="text-left px-3 py-2 font-medium">Dimension</th>
            <th class="text-right px-3 py-2 font-medium">Coverage</th>
            <th class="text-left px-3 py-2 font-medium">Status</th>
            <th class="text-left px-3 py-2 font-medium">Top values</th>
            <th class="text-left px-3 py-2 font-medium">Priority</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-panel2">
          <tr :for={d <- @dimensions} class="bg-ink-panel">
            <td class="px-3 py-2 text-parchment font-medium">{d.field}</td>
            <td class="px-3 py-2 text-right text-parchment">{pct(d.coverage)}</td>
            <td class="px-3 py-2">
              <span
                :if={d.new_column?}
                class="inline-block px-2 py-0.5 rounded text-xs border bg-paprika/20 text-paprika-soft border-paprika/30"
              >
                new column
              </span>
              <span :if={not d.new_column?} class="text-parchment-dim text-xs">
                captured → <code class="text-parchment">{d.existing_column}</code>
              </span>
            </td>
            <td class="px-3 py-2 text-parchment-dim max-w-xs truncate">{top_values(d)}</td>
            <td class="px-3 py-2">
              <span class={"inline-block px-2 py-0.5 rounded text-xs border #{priority_class(d.priority)}"}>
                {d.priority}
              </span>
            </td>
          </tr>
          <tr :if={@dimensions == []}>
            <td colspan="5" class="px-3 py-6 text-center text-parchment-dim">
              No dimensions matched at least 5 ingredients.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="space-y-3">
    <h2 class="text-lg font-semibold text-parchment">Proposed migrations</h2>
    <p class="text-parchment-dim text-sm">
      Only dimensions the parser does not already capture. {@summary}
    </p>
    <div :if={@migrations == []} class="text-parchment-dim text-sm">
      Nothing to propose — every mined dimension above target is already a column.
    </div>
    <pre
      :for={sql <- @migrations}
      class="overflow-x-auto rounded-lg border border-ink-panel2 bg-ink-panel p-4 text-xs text-parchment whitespace-pre"
    >{sql}</pre>
  </section>

  <section :if={@semantic_groups != []} class="space-y-3">
    <h2 class="text-lg font-semibold text-parchment">Semantic outlier clusters</h2>
    <p class="text-parchment-dim text-sm">
      Ingredients with low parse confidence, grouped by embedding similarity.
    </p>

    <div class="flex flex-wrap items-center gap-2">
      <span class="text-parchment-dim text-xs uppercase tracking-wide w-20">Similarity ≥</span>
      <button
        :for={t <- @threshold_options}
        type="button"
        phx-click="set_threshold"
        phx-value-t={t}
        class={"px-2.5 py-1 rounded border text-xs font-medium #{threshold_class(t, @cluster_threshold)}"}
      >
        {threshold_label(t)}
      </button>
      <span class="text-parchment-dim text-xs">
        higher = stricter (fewer, tighter clusters)
      </span>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <span class="text-parchment-dim text-xs uppercase tracking-wide w-20">Min size</span>
      <button
        :for={min <- @cluster_filters}
        type="button"
        phx-click="filter_clusters"
        phx-value-min={min}
        class={"px-2.5 py-1 rounded border text-xs font-medium #{cluster_filter_class(min, @min_cluster_size)}"}
      >
        {cluster_filter_label(min)}
      </button>
    </div>

    <% clusters = visible_clusters(@semantic_groups, @min_cluster_size) %>
    <div class="space-y-2">
      <details
        :for={g <- clusters}
        class="group rounded-lg border border-ink-panel2 bg-ink-panel"
      >
        <summary class="flex flex-wrap items-center gap-x-2 gap-y-1 cursor-pointer p-3 text-sm">
          <span class="text-parchment-dim group-open:rotate-90 transition-transform">▸</span>
          <span class="text-parchment font-medium">{g.label || "—"}</span>
          <span class="text-parchment-dim">· {g.size} items · suggests</span>
          <code class="text-parchment">{g.suggested_field}</code>
          <span class="text-parchment-dim text-xs ml-auto">cluster {g.cluster_id}</span>
        </summary>
        <ul class="max-h-64 overflow-y-auto px-4 pb-3 pt-1 space-y-0.5 border-t border-ink-panel2">
          <li :for={ing <- g.ingredients} class="text-parchment-dim text-xs">
            {ing.name}
          </li>
        </ul>
      </details>
      <div :if={clusters == []} class="text-parchment-dim text-sm">
        No clusters with more than {@min_cluster_size} item(s).
      </div>
    </div>
  </section>
</div>
