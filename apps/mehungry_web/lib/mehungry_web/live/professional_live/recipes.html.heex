<div class="px-4 py-6 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold text-white">Recipes Admin</h1>
    <div class="flex items-center gap-2">
      <button
        type="button"
        phx-click="recompute_nutrients"
        disabled={recalc_running?(@recalc_run)}
        data-confirm={"Recompute nutrients for all #{@total_count} recipe(s)? This enqueues one background job per recipe."}
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-700 hover:bg-emerald-600 text-white font-semibold text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <.icon
          name="hero-arrow-path"
          class={"w-4 h-4 #{if recalc_running?(@recalc_run), do: "animate-spin"}"}
        />
        {if recalc_running?(@recalc_run), do: "Recomputing…", else: "Recompute all nutrients"}
      </button>
      <button
        type="button"
        phx-click="reconcile_portions"
        phx-value-dry_run="true"
        disabled={@portion_running}
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-ink-panel2 hover:bg-ink-panel2 text-white font-semibold text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <.icon name="hero-magnifying-glass" class="w-4 h-4" /> Assess portions
      </button>
      <button
        type="button"
        phx-click="reconcile_portions"
        phx-value-dry_run="false"
        disabled={@portion_running}
        data-confirm="Reconcile all legacy recipe ingredients onto IngredientPortions? This backfills links and creates missing mass/volume portions."
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-700 hover:bg-indigo-600 text-white font-semibold text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <.icon
          name="hero-wrench-screwdriver"
          class={"w-4 h-4 #{if @portion_running, do: "animate-spin"}"}
        />
        {if @portion_running, do: "Reconciling…", else: "Reconcile portions"}
      </button>
      <button
        type="button"
        phx-click="delete_without_ingredients"
        disabled={@empty_count == 0}
        data-confirm={"Delete all #{@empty_count} recipe(s) with zero ingredients? This cannot be undone."}
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-red-700 hover:bg-red-600 text-white font-semibold text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <.icon name="hero-trash" class="w-4 h-4" /> Delete recipes with zero ingredients
      </button>
      <button
        type="button"
        phx-click="reconcile_hashtags"
        disabled={@hashtag_running}
        data-confirm="Reconcile hashtags for every recipe? This reconnects description #tags and re-attaches #vegan/#vegetarian. It only adds tags — nothing is deleted."
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-fuchsia-700 hover:bg-fuchsia-600 text-white font-semibold text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <.icon name="hero-hashtag" class="w-4 h-4" />
        {if @hashtag_running, do: "Reconciling…", else: "Reconcile hashtags"}
      </button>
      <.link
        navigate={~p"/professional/myplate-review"}
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-teal-700 hover:bg-teal-600 text-white font-semibold text-sm transition-colors"
      >
        <.icon name="hero-clipboard-document-check" class="w-4 h-4" /> Review MyPlate imports
      </.link>
      <button
        type="button"
        phx-click="delete_myplate_recipes"
        disabled={@myplate_count == 0}
        data-confirm={"Delete all #{@myplate_count} MyPlate-imported recipe(s) and their references? This cannot be undone."}
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-red-800 hover:bg-red-700 text-white font-semibold text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <.icon name="hero-trash" class="w-4 h-4" /> Delete MyPlate imports ({@myplate_count})
      </button>
      <.link
        navigate={~p"/professional/gutenberg-review"}
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-700 hover:bg-indigo-600 text-white font-semibold text-sm transition-colors"
      >
        <.icon name="hero-book-open" class="w-4 h-4" /> Review Gutenberg imports
      </.link>
      <button
        type="button"
        phx-click="delete_gutenberg_recipes"
        disabled={@gutenberg_count == 0}
        data-confirm={"Delete all #{@gutenberg_count} Gutenberg-imported recipe(s) and their references? This cannot be undone."}
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-red-800 hover:bg-red-700 text-white font-semibold text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <.icon name="hero-trash" class="w-4 h-4" /> Delete Gutenberg imports ({@gutenberg_count})
      </button>
      <.link
        navigate={~p"/professional/unitools-review"}
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-sky-700 hover:bg-sky-600 text-white font-semibold text-sm transition-colors"
      >
        <.icon name="hero-globe-alt" class="w-4 h-4" /> Review UniTools imports
      </.link>
      <button
        type="button"
        phx-click="delete_unitools_recipes"
        disabled={@unitools_count == 0}
        data-confirm={"Delete all #{@unitools_count} UniTools-imported recipe(s) and their references? This cannot be undone."}
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-red-800 hover:bg-red-700 text-white font-semibold text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <.icon name="hero-trash" class="w-4 h-4" /> Delete UniTools imports ({@unitools_count})
      </button>
    </div>
  </div>

  <div class="bg-ink-panel border border-ink-panel2 rounded-2xl p-4 mb-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-parchment-dim mb-1">
          Recipe image provider
        </p>
        <p class="text-sm text-white">
          Active: <span class="font-semibold">{provider_label(@image_provider)}</span>
          <span class="text-parchment-dim">
            — applies to every new AI-generated cover (user-created recipes, API, and the
            AI bot), across all machines.
          </span>
        </p>
        <%= if @image_provider == :flux and not @bfl_configured do %>
          <p class="text-xs text-amber-300 mt-1">
            ⚠ BFL_KEY is not set on the server — FLUX generation will fail until the key is configured.
          </p>
        <% end %>
      </div>
      <div class="inline-flex rounded-full border border-ink-panel2 overflow-hidden">
        <button
          type="button"
          phx-click="set_image_provider"
          phx-value-provider="openai"
          disabled={@image_provider == :openai}
          class={[
            "px-4 py-2 text-sm font-semibold transition-colors",
            if(@image_provider == :openai,
              do: "bg-emerald-700 text-white cursor-default",
              else: "bg-transparent text-parchment-dim hover:bg-ink-panel2"
            )
          ]}
        >
          gpt-image-2
        </button>
        <button
          type="button"
          phx-click="set_image_provider"
          phx-value-provider="flux"
          disabled={@image_provider == :flux}
          class={[
            "px-4 py-2 text-sm font-semibold transition-colors",
            if(@image_provider == :flux,
              do: "bg-emerald-700 text-white cursor-default",
              else: "bg-transparent text-parchment-dim hover:bg-ink-panel2"
            )
          ]}
        >
          FLUX 2 pro
        </button>
      </div>
    </div>
  </div>

  <%= if @recalc_run do %>
    <div class="bg-ink-panel border border-ink-panel2 rounded-2xl p-4 mb-6">
      <div class="flex items-center justify-between mb-2">
        <p class="text-xs font-semibold uppercase tracking-wider text-parchment-dim">
          Nutrient recomputation
          <span class={[
            "ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border",
            if(recalc_running?(@recalc_run),
              do: "bg-amber-500/20 text-amber-300 border-amber-500/30",
              else: "bg-emerald-500/20 text-emerald-300 border-emerald-500/30"
            )
          ]}>
            {if recalc_running?(@recalc_run), do: "Running", else: "Completed"}
          </span>
        </p>
        <p class="text-sm font-semibold text-white">{recalc_percent(@recalc_run)}%</p>
      </div>

      <div class="w-full bg-ink-panel2 rounded-full h-2 overflow-hidden mb-3">
        <div
          class={[
            "h-2 rounded-full transition-all duration-500",
            if(recalc_running?(@recalc_run), do: "bg-amber-500", else: "bg-emerald-500")
          ]}
          style={"width: #{recalc_percent(@recalc_run)}%"}
        >
        </div>
      </div>

      <div class="flex flex-wrap gap-4 text-sm">
        <span class="text-parchment-dim">Total
        <span class="text-white font-semibold">{@recalc_run.total}</span></span>
        <span class="text-green-400">Done
        <span class="font-semibold">{@recalc_run.completed}</span></span>
        <span class="text-red-400">Failed <span class="font-semibold">{@recalc_run.failed}</span></span>
        <span class="text-blue-400">Remaining
        <span class="font-semibold">{recalc_remaining(@recalc_run)}</span></span>
      </div>

      <%= if @recalc_run.failed > 0 and @recalc_run.error do %>
        <p class="mt-2 text-xs text-red-400/80 truncate" title={@recalc_run.error}>
          Last error: {@recalc_run.error}
        </p>
      <% end %>
    </div>
  <% end %>

  <%= if hashtag_total(@hashtag_counts) > 0 do %>
    <div class="bg-ink-panel border border-ink-panel2 rounded-2xl p-4 mb-6">
      <div class="flex items-center justify-between mb-2">
        <p class="text-xs font-semibold uppercase tracking-wider text-parchment-dim">
          Hashtag reconciliation
          <span class={[
            "ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border",
            if(@hashtag_running,
              do: "bg-amber-500/20 text-amber-300 border-amber-500/30",
              else: "bg-emerald-500/20 text-emerald-300 border-emerald-500/30"
            )
          ]}>
            {if @hashtag_running, do: "Running", else: "Idle"}
          </span>
        </p>
        <div class="flex items-center gap-3">
          <p class="text-sm font-semibold text-white">{hashtag_percent(@hashtag_counts)}%</p>
          <button
            type="button"
            phx-click="reset_hashtag_reconciliation"
            class="text-xs text-parchment-dim hover:text-parchment underline"
          >
            Reset
          </button>
        </div>
      </div>

      <div class="w-full bg-ink-panel2 rounded-full h-2 overflow-hidden mb-3">
        <div
          class={[
            "h-2 rounded-full transition-all duration-500",
            if(@hashtag_running, do: "bg-amber-500", else: "bg-fuchsia-500")
          ]}
          style={"width: #{hashtag_percent(@hashtag_counts)}%"}
        >
        </div>
      </div>

      <div class="flex flex-wrap gap-4 text-sm">
        <span class="text-parchment-dim">Total
        <span class="text-white font-semibold">{hashtag_total(@hashtag_counts)}</span></span>
        <span class="text-parchment">Pending
        <span class="font-semibold">{Map.get(@hashtag_counts, "pending", 0)}</span></span>
        <span class="text-blue-400">Processing
        <span class="font-semibold">{Map.get(@hashtag_counts, "processing", 0)}</span></span>
        <span class="text-green-400">Completed
        <span class="font-semibold">{Map.get(@hashtag_counts, "completed", 0)}</span></span>
        <span class="text-red-400">Failed
        <span class="font-semibold">{Map.get(@hashtag_counts, "failed", 0)}</span></span>
      </div>
    </div>
  <% end %>

  <%= if @portion_report do %>
    <div class="bg-ink-panel border border-ink-panel2 rounded-2xl p-4 mb-6">
      <div class="flex items-center justify-between mb-3">
        <p class="text-xs font-semibold uppercase tracking-wider text-parchment-dim">
          Ingredient portion reconciliation
          <span class={[
            "ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border",
            if(@portion_report.dry_run,
              do: "bg-ink-panel2/20 text-parchment border-ink-panel2/30",
              else: "bg-indigo-500/20 text-indigo-300 border-indigo-500/30"
            )
          ]}>
            {if @portion_report.dry_run, do: "Dry run (no writes)", else: "Applied"}
          </span>
        </p>
      </div>

      <div class="flex flex-wrap gap-4 text-sm mb-2">
        <span class="text-parchment-dim">
          Rows with a unit
          <span class="text-white font-semibold">{@portion_report.total_with_unit}</span>
        </span>
        <span class="text-parchment-dim">
          Already linked
          <span class="text-white font-semibold">{@portion_report.already_set}</span>
        </span>
        <span class="text-parchment-dim">
          Grams (skipped)
          <span class="text-white font-semibold">{@portion_report.gram_skipped}</span>
        </span>
        <span class="text-parchment-dim">
          Need work <span class="text-white font-semibold">{@portion_report.needs_work}</span>
        </span>
        <span class="text-green-400">
          Linked <span class="font-semibold">{@portion_report.backfilled}</span>
        </span>
        <span class="text-teal-400">
          Named-linked <span class="font-semibold">{@portion_report.description_linked}</span>
        </span>
        <span class="text-blue-400">
          Portions created
          <span class="font-semibold">{@portion_report.synthesized_portions}</span>
        </span>
        <span class="text-amber-400">
          Need review <span class="font-semibold">{length(@portion_report.unresolved)}</span>
        </span>
      </div>

      <%= if @portion_report.unresolved == [] do %>
        <p class="text-sm text-emerald-400">
          ✅ Every non-gram recipe ingredient resolves to a portion.
        </p>
      <% else %>
        <div class="mt-2 border-t border-ink-panel2 pt-3">
          <p class="text-xs font-semibold uppercase tracking-wider text-amber-400 mb-2">
            Pairs needing admin review
          </p>
          <div class="divide-y divide-ink-panel2 max-h-80 overflow-y-auto">
            <div :for={u <- @portion_report.unresolved} class="py-2">
              <div class="flex items-center justify-between gap-3">
                <p class="text-white text-sm font-medium truncate">
                  {u.ingredient_name || "ingredient ##{u.ingredient_id}"}
                  <span class="text-parchment-dim font-normal">× {u.unit_name ||
                    "unit ##{u.measurement_unit_id}"}</span>
                </p>
                <span class="shrink-0 text-xs text-parchment-dim">
                  {u.row_count} row(s) · {length(u.recipe_ids)} recipe(s)
                </span>
              </div>
              <p class="text-xs text-amber-300/80 mt-0.5">
                {portion_reason_label(u.reason)}
              </p>
              <p class="text-[11px] text-parchment-dim mt-0.5 truncate">
                recipes: {Enum.join(u.recipe_ids, ", ")}
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-4 mb-6">
    <div class="bg-ink-panel border border-ink-panel2 rounded-2xl p-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-parchment-dim mb-1">
        Total recipes
      </p>
      <p class="text-3xl font-bold text-white">{@total_count}</p>
    </div>
    <div class="bg-ink-panel border border-ink-panel2 rounded-2xl p-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-parchment-dim mb-1">
        With zero ingredients
      </p>
      <p class="text-3xl font-bold text-red-400">{@empty_count}</p>
    </div>
  </div>

  <div class="bg-ink-panel border border-ink-panel2 rounded-2xl p-4">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-parchment-dim mb-3">
      Recipes with zero ingredients
    </h2>
    <div id="empty-recipes" phx-update="stream" class="divide-y divide-ink-panel2">
      <div
        id="empty-recipes-empty"
        class="only:block hidden text-parchment-dim text-sm italic py-3"
      >
        No recipes with zero ingredients.
      </div>
      <div
        :for={{dom_id, recipe} <- @streams.empty_recipes}
        id={dom_id}
        class="flex items-center justify-between py-2.5"
      >
        <div class="min-w-0">
          <p class="text-white text-sm font-medium truncate">
            {recipe.title || "(untitled)"}
          </p>
          <p class="text-parchment-dim text-xs">
            #{recipe.id} · {(recipe.user && recipe.user.email) || "no owner"}
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-ink-panel border border-ink-panel2 rounded-2xl p-4 mt-6">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-parchment-dim mb-3">
      Delete any recipe
    </h2>
    <p class="text-parchment-dim text-xs mb-3">
      Deleting a recipe also removes all of its ingredients, comments, posts,
      likes, ratings, meal-plan entries, basket items, hashtags, translations and
      bot records. This cannot be undone.
    </p>

    <div :if={@graphic_error} class="mb-3 rounded-lg bg-red-900/40 border border-red-700 text-red-200 text-xs px-3 py-2">
      Graphic generation failed: {@graphic_error}
    </div>

    <div
      :if={@graphic_result}
      class="mb-4 rounded-xl bg-ink border border-ink-panel2 p-3 flex gap-3"
    >
      <img
        src={@graphic_result.image_url}
        alt="Generated insight graphic"
        class="w-32 h-32 rounded-lg object-cover shrink-0"
      />
      <div class="min-w-0 flex flex-col">
        <p class="text-white text-sm font-semibold">{@graphic_result.headline}</p>
        <p class="text-parchment-dim text-xs mt-1 line-clamp-3">{@graphic_result.caption}</p>
        <a
          href={@graphic_result.image_url}
          target="_blank"
          rel="noopener"
          class="mt-auto inline-flex items-center gap-1.5 text-paprika hover:text-paprika-soft text-xs font-semibold"
        >
          <.icon name="hero-arrow-down-tray" class="w-3.5 h-3.5" /> Open / download
        </a>
      </div>
    </div>

    <form
      id="admin-recipe-search"
      phx-change="search_recipes"
      phx-submit="search_recipes"
      class="mb-3"
    >
      <input
        type="text"
        name="query"
        value={@search_query}
        phx-debounce="300"
        placeholder="Search recipes by title or id…"
        autocomplete="off"
        class="w-full rounded-lg bg-ink border border-ink-panel2 text-white text-sm px-3 py-2 placeholder-parchment-dim focus:outline-none focus:border-indigo-500"
      />
    </form>

    <div id="search-recipes" phx-update="stream" class="divide-y divide-ink-panel2">
      <div
        id="search-recipes-empty"
        class="only:block hidden text-parchment-dim text-sm italic py-3"
      >
        No recipes match your search.
      </div>
      <div
        :for={{dom_id, recipe} <- @streams.search_results}
        id={dom_id}
        class="flex items-center justify-between gap-3 py-2.5"
      >
        <div class="min-w-0">
          <p class="text-white text-sm font-medium truncate">
            {recipe.title || "(untitled)"}
          </p>
          <p class="text-parchment-dim text-xs">
            #{recipe.id} · {(recipe.user && recipe.user.email) || "no owner"} · {recipe.ingredient_count} ingredient(s)
          </p>
        </div>
        <div class="shrink-0 flex items-center gap-2">
          <button
            type="button"
            phx-click="generate_graphic"
            phx-value-id={recipe.id}
            disabled={@graphic_running_id == recipe.id}
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-paprika hover:bg-paprika-soft disabled:opacity-50 text-white font-semibold text-xs transition-colors"
          >
            <.icon
              name={if @graphic_running_id == recipe.id, do: "hero-arrow-path", else: "hero-photo"}
              class={"w-3.5 h-3.5 #{if @graphic_running_id == recipe.id, do: "animate-spin"}"}
            />
            {if @graphic_running_id == recipe.id, do: "Generating…", else: "Make graphic"}
          </button>
          <button
            type="button"
            phx-click="delete_recipe"
            phx-value-id={recipe.id}
            data-confirm={"Permanently delete “#{recipe.title || "(untitled)"}” (##{recipe.id}) and all its references? This cannot be undone."}
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-red-700 hover:bg-red-600 text-white font-semibold text-xs transition-colors"
          >
            <.icon name="hero-trash" class="w-3.5 h-3.5" /> Delete
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
