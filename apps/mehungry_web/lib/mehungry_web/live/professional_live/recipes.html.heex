<div class="px-4 py-6 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold text-white">Recipes Admin</h1>
    <div class="flex items-center gap-2">
      <button
        type="button"
        phx-click="recompute_nutrients"
        disabled={recalc_running?(@recalc_run)}
        data-confirm={"Recompute nutrients for all #{@total_count} recipe(s)? This enqueues one background job per recipe."}
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-700 hover:bg-emerald-600 text-white font-semibold text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <.icon
          name="hero-arrow-path"
          class={"w-4 h-4 #{if recalc_running?(@recalc_run), do: "animate-spin"}"}
        />
        {if recalc_running?(@recalc_run), do: "Recomputing…", else: "Recompute all nutrients"}
      </button>
      <button
        type="button"
        phx-click="reconcile_portions"
        phx-value-dry_run="true"
        disabled={@portion_running}
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-slate-700 hover:bg-slate-600 text-white font-semibold text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <.icon name="hero-magnifying-glass" class="w-4 h-4" /> Assess portions
      </button>
      <button
        type="button"
        phx-click="reconcile_portions"
        phx-value-dry_run="false"
        disabled={@portion_running}
        data-confirm="Reconcile all legacy recipe ingredients onto IngredientPortions? This backfills links and creates missing mass/volume portions."
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-700 hover:bg-indigo-600 text-white font-semibold text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <.icon
          name="hero-wrench-screwdriver"
          class={"w-4 h-4 #{if @portion_running, do: "animate-spin"}"}
        />
        {if @portion_running, do: "Reconciling…", else: "Reconcile portions"}
      </button>
      <button
        type="button"
        phx-click="delete_without_ingredients"
        disabled={@empty_count == 0}
        data-confirm={"Delete all #{@empty_count} recipe(s) with zero ingredients? This cannot be undone."}
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-red-700 hover:bg-red-600 text-white font-semibold text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <.icon name="hero-trash" class="w-4 h-4" /> Delete recipes with zero ingredients
      </button>
    </div>
  </div>

  <%= if @recalc_run do %>
    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 mb-6">
      <div class="flex items-center justify-between mb-2">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
          Nutrient recomputation
          <span class={[
            "ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border",
            if(recalc_running?(@recalc_run),
              do: "bg-amber-500/20 text-amber-300 border-amber-500/30",
              else: "bg-emerald-500/20 text-emerald-300 border-emerald-500/30"
            )
          ]}>
            {if recalc_running?(@recalc_run), do: "Running", else: "Completed"}
          </span>
        </p>
        <p class="text-sm font-semibold text-white">{recalc_percent(@recalc_run)}%</p>
      </div>

      <div class="w-full bg-slate-700 rounded-full h-2 overflow-hidden mb-3">
        <div
          class={[
            "h-2 rounded-full transition-all duration-500",
            if(recalc_running?(@recalc_run), do: "bg-amber-500", else: "bg-emerald-500")
          ]}
          style={"width: #{recalc_percent(@recalc_run)}%"}
        >
        </div>
      </div>

      <div class="flex flex-wrap gap-4 text-sm">
        <span class="text-slate-400">Total
        <span class="text-white font-semibold">{@recalc_run.total}</span></span>
        <span class="text-green-400">Done
        <span class="font-semibold">{@recalc_run.completed}</span></span>
        <span class="text-red-400">Failed <span class="font-semibold">{@recalc_run.failed}</span></span>
        <span class="text-blue-400">Remaining
        <span class="font-semibold">{recalc_remaining(@recalc_run)}</span></span>
      </div>

      <%= if @recalc_run.failed > 0 and @recalc_run.error do %>
        <p class="mt-2 text-xs text-red-400/80 truncate" title={@recalc_run.error}>
          Last error: {@recalc_run.error}
        </p>
      <% end %>
    </div>
  <% end %>

  <%= if @portion_report do %>
    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 mb-6">
      <div class="flex items-center justify-between mb-3">
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
          Ingredient portion reconciliation
          <span class={[
            "ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border",
            if(@portion_report.dry_run,
              do: "bg-slate-500/20 text-slate-300 border-slate-500/30",
              else: "bg-indigo-500/20 text-indigo-300 border-indigo-500/30"
            )
          ]}>
            {if @portion_report.dry_run, do: "Dry run (no writes)", else: "Applied"}
          </span>
        </p>
      </div>

      <div class="flex flex-wrap gap-4 text-sm mb-2">
        <span class="text-slate-400">
          Rows with a unit
          <span class="text-white font-semibold">{@portion_report.total_with_unit}</span>
        </span>
        <span class="text-slate-400">
          Already linked
          <span class="text-white font-semibold">{@portion_report.already_set}</span>
        </span>
        <span class="text-slate-400">
          Grams (skipped)
          <span class="text-white font-semibold">{@portion_report.gram_skipped}</span>
        </span>
        <span class="text-slate-400">
          Need work <span class="text-white font-semibold">{@portion_report.needs_work}</span>
        </span>
        <span class="text-green-400">
          Linked <span class="font-semibold">{@portion_report.backfilled}</span>
        </span>
        <span class="text-teal-400">
          Named-linked <span class="font-semibold">{@portion_report.description_linked}</span>
        </span>
        <span class="text-blue-400">
          Portions created
          <span class="font-semibold">{@portion_report.synthesized_portions}</span>
        </span>
        <span class="text-amber-400">
          Need review <span class="font-semibold">{length(@portion_report.unresolved)}</span>
        </span>
      </div>

      <%= if @portion_report.unresolved == [] do %>
        <p class="text-sm text-emerald-400">
          ✅ Every non-gram recipe ingredient resolves to a portion.
        </p>
      <% else %>
        <div class="mt-2 border-t border-slate-700 pt-3">
          <p class="text-xs font-semibold uppercase tracking-wider text-amber-400 mb-2">
            Pairs needing admin review
          </p>
          <div class="divide-y divide-slate-700 max-h-80 overflow-y-auto">
            <div :for={u <- @portion_report.unresolved} class="py-2">
              <div class="flex items-center justify-between gap-3">
                <p class="text-white text-sm font-medium truncate">
                  {u.ingredient_name || "ingredient ##{u.ingredient_id}"}
                  <span class="text-slate-400 font-normal">× {u.unit_name ||
                    "unit ##{u.measurement_unit_id}"}</span>
                </p>
                <span class="shrink-0 text-xs text-slate-400">
                  {u.row_count} row(s) · {length(u.recipe_ids)} recipe(s)
                </span>
              </div>
              <p class="text-xs text-amber-300/80 mt-0.5">
                {portion_reason_label(u.reason)}
              </p>
              <p class="text-[11px] text-slate-500 mt-0.5 truncate">
                recipes: {Enum.join(u.recipe_ids, ", ")}
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-4 mb-6">
    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">
        Total recipes
      </p>
      <p class="text-3xl font-bold text-white">{@total_count}</p>
    </div>
    <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">
        With zero ingredients
      </p>
      <p class="text-3xl font-bold text-red-400">{@empty_count}</p>
    </div>
  </div>

  <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">
      Recipes with zero ingredients
    </h2>
    <div id="empty-recipes" phx-update="stream" class="divide-y divide-slate-700">
      <div id="empty-recipes-empty" class="only:block hidden text-slate-500 text-sm italic py-3">
        No recipes with zero ingredients.
      </div>
      <div
        :for={{dom_id, recipe} <- @streams.empty_recipes}
        id={dom_id}
        class="flex items-center justify-between py-2.5"
      >
        <div class="min-w-0">
          <p class="text-white text-sm font-medium truncate">
            {recipe.title || "(untitled)"}
          </p>
          <p class="text-slate-500 text-xs">
            #{recipe.id} · {(recipe.user && recipe.user.email) || "no owner"}
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 mt-6">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">
      Delete any recipe
    </h2>
    <p class="text-slate-500 text-xs mb-3">
      Deleting a recipe also removes all of its ingredients, comments, posts,
      likes, ratings, meal-plan entries, basket items, hashtags, translations and
      bot records. This cannot be undone.
    </p>

    <form
      id="admin-recipe-search"
      phx-change="search_recipes"
      phx-submit="search_recipes"
      class="mb-3"
    >
      <input
        type="text"
        name="query"
        value={@search_query}
        phx-debounce="300"
        placeholder="Search recipes by title or id…"
        autocomplete="off"
        class="w-full rounded-lg bg-slate-900 border border-slate-700 text-white text-sm px-3 py-2 placeholder-slate-500 focus:outline-none focus:border-indigo-500"
      />
    </form>

    <div id="search-recipes" phx-update="stream" class="divide-y divide-slate-700">
      <div id="search-recipes-empty" class="only:block hidden text-slate-500 text-sm italic py-3">
        No recipes match your search.
      </div>
      <div
        :for={{dom_id, recipe} <- @streams.search_results}
        id={dom_id}
        class="flex items-center justify-between gap-3 py-2.5"
      >
        <div class="min-w-0">
          <p class="text-white text-sm font-medium truncate">
            {recipe.title || "(untitled)"}
          </p>
          <p class="text-slate-500 text-xs">
            #{recipe.id} · {(recipe.user && recipe.user.email) || "no owner"} · {recipe.ingredient_count} ingredient(s)
          </p>
        </div>
        <button
          type="button"
          phx-click="delete_recipe"
          phx-value-id={recipe.id}
          data-confirm={"Permanently delete “#{recipe.title || "(untitled)"}” (##{recipe.id}) and all its references? This cannot be undone."}
          class="shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-red-700 hover:bg-red-600 text-white font-semibold text-xs transition-colors"
        >
          <.icon name="hero-trash" class="w-3.5 h-3.5" /> Delete
        </button>
      </div>
    </div>
  </div>
</div>
