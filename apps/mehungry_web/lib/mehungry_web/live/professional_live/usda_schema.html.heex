<div class="max-w-5xl mx-auto p-4 pb-28 space-y-8">
  <div class="flex flex-wrap items-start gap-3">
    <div class="flex-1 min-w-[16rem]">
      <h1 class="text-2xl font-semibold text-parchment">USDA Schema</h1>
      <p class="text-parchment-dim text-sm mt-1">
        Curate raw USDA ingredients onto a <span class="text-parchment">fundamental food species</span>. Search by name, select the
        matches, and assign them in one move — a curated ingredient then feeds the species layer
        (facts, icons, <code class="text-parchment">/foods</code>). The parser's structural
        <em>schema</em>
        grouping is kept under <span class="text-parchment">Structural view</span>
        below.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <.link
        navigate={~p"/professional/compound-pipeline"}
        class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
      >
        Compound pipeline
      </.link>
      <button
        type="button"
        phx-click="recompute"
        disabled={@loading}
        class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90 disabled:opacity-50"
      >
        Recompute
      </button>
    </div>
  </div>

  <div
    :if={@loading}
    class="rounded-lg border border-ink-panel2 bg-ink-panel p-4 text-parchment-dim text-sm"
  >
    Computing schema analysis from the ingredient corpus…
  </div>

  <%!-- ── Find & assign console (the primary workflow) ───────────────────────── --%>
  <section class="space-y-3">
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-4 space-y-3">
      <form id="usda-search-form" phx-change="search" class="relative">
        <span
          class="absolute left-3 top-1/2 -translate-y-1/2 text-parchment-dim text-sm"
          aria-hidden="true"
        >
          🔍
        </span>
        <input
          id="usda-search"
          type="text"
          name="q"
          value={@query}
          phx-debounce="200"
          autocomplete="off"
          placeholder="Search USDA ingredients by name — e.g. apple · beef chuck · spinach"
          class="w-full bg-ink-panel2 text-parchment border border-ink-panel2 rounded pl-9 pr-3 py-2 text-base focus:outline-none focus:border-paprika/60"
        />
      </form>

      <div
        :if={@query != "" and @result_ids != []}
        class="flex items-center justify-between text-xs text-parchment-dim"
      >
        <span>
          {if @results_capped,
            do: "Showing the first #{length(@result_ids)} matches — refine to narrow",
            else:
              "#{length(@result_ids)} #{if length(@result_ids) == 1, do: "match", else: "matches"}"}
        </span>
        <button type="button" phx-click="select_all" class="text-parchment hover:opacity-90">
          Select all {length(@result_ids)}
        </button>
      </div>

      <p :if={@query == ""} class="text-parchment-dim text-sm py-2">
        Type to search {map_size(@universe)} uncurated ingredients, then select and assign them to a species.
      </p>
      <p :if={@query != "" and @result_ids == []} class="text-parchment-dim text-sm py-2">
        No uncurated ingredients match “{@query}”.
      </p>

      <ul
        :if={@result_ids != []}
        id="results-list"
        phx-update="stream"
        class="divide-y divide-ink-panel2 max-h-[28rem] overflow-auto"
      >
        <li
          :for={{dom_id, row} <- @streams.results}
          id={dom_id}
          class="flex items-center gap-3"
        >
          <button
            type="button"
            phx-click="toggle_select"
            phx-value-id={row.id}
            class="flex-1 flex items-center gap-3 text-left min-w-0 py-2 hover:opacity-90"
          >
            <span class={[
              "h-4 w-4 rounded border flex items-center justify-center shrink-0 text-[10px] leading-none",
              if(MapSet.member?(@selected, row.id),
                do: "bg-paprika border-paprika text-white",
                else: "border-ink-panel2 text-transparent"
              )
            ]}>
              ✓
            </span>
            <span class="text-parchment text-sm truncate">{row.name}</span>
            <span
              :if={row.data_type}
              class="inline-block px-2 py-0.5 rounded text-xs border bg-ink-panel2 text-parchment-dim border-ink-panel2 shrink-0"
            >
              {row.data_type}
            </span>
          </button>
          <a
            href={~p"/professional/ingredients/#{row.id}/show"}
            class="text-parchment-dim text-xs hover:text-parchment shrink-0 pr-1"
          >
            #{row.id}
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-4">
      <div class="text-parchment-dim text-xs uppercase tracking-wide">Ingredients</div>
      <div class="text-parchment text-2xl font-semibold">{@total_ingredients}</div>
    </div>
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-4">
      <div class="text-parchment-dim text-xs uppercase tracking-wide">Schemas</div>
      <div class="text-parchment text-2xl font-semibold">{@schema_count}</div>
    </div>
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-4">
      <div class="text-parchment-dim text-xs uppercase tracking-wide">Matched</div>
      <div class="text-parchment text-2xl font-semibold">{@matched_count}</div>
    </div>
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-4">
      <div class="text-parchment-dim text-xs uppercase tracking-wide">Unmatched</div>
      <div class="text-parchment text-2xl font-semibold">{@unmatched_count}</div>
    </div>
  </section>

  <%!-- ── Structural view (demoted schema + unmatched accordions) ────────────── --%>
  <section class="space-y-3">
    <button
      type="button"
      phx-click="toggle"
      phx-value-key="structural"
      class="w-full flex items-center gap-3 rounded-lg border border-ink-panel2 bg-ink-panel px-4 py-3 text-left hover:opacity-90"
    >
      <span class="text-parchment-dim text-xs w-4">
        {if expanded?(@expanded, "structural"), do: "▾", else: "▸"}
      </span>
      <div class="flex-1">
        <div class="text-parchment font-medium">Structural view</div>
        <div class="text-parchment-dim text-xs mt-1">
          Ingredients grouped by the parser's field <em>schema</em>
          ({source_label(@source)}) — plus the unmatched pile. Per-row assign still works here.
        </div>
      </div>
      <div class="text-parchment-dim text-xs shrink-0">
        {@schema_count} schemas · {@unmatched_count} unmatched
      </div>
    </button>

    <div :if={expanded?(@expanded, "structural")} class="space-y-6">
      <div class="space-y-2">
        <h2 class="text-lg font-semibold text-parchment">Schemas</h2>
        <div
          :for={{schema, idx} <- Enum.with_index(@schemas)}
          class="rounded-lg border border-ink-panel2 bg-ink-panel"
        >
          <button
            type="button"
            phx-click="open_panel"
            phx-value-key={schema.key}
            class="w-full flex items-center gap-3 px-4 py-3 text-left hover:opacity-90"
          >
            <span class="text-parchment-dim text-xs w-4">
              {if @active_key == schema.key, do: "▾", else: "▸"}
            </span>
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-1.5">
                <span
                  :for={dim <- schema.dimensions}
                  class="inline-block px-2 py-0.5 rounded text-xs border bg-ink-panel2 text-parchment border-ink-panel2"
                >
                  {dim}
                </span>
              </div>
              <div class="text-parchment-dim text-xs mt-1 truncate">
                e.g. {Enum.join(schema.reference_examples, " · ")}
              </div>
            </div>
            <div class="text-right shrink-0">
              <div class="text-parchment text-lg font-semibold">{schema.matched_count}</div>
              <div class="text-parchment-dim text-xs">
                {schema.reference_count} ref
              </div>
            </div>
          </button>

          <div :if={@active_key == schema.key} class="border-t border-ink-panel2">
            <p :if={@active_rows == []} class="px-4 py-3 text-parchment-dim text-sm">
              No ingredients matched this schema.
            </p>
            <ul
              :if={@active_rows != []}
              id={"schema-rows-#{idx}"}
              phx-update="stream"
              class="divide-y divide-ink-panel2"
            >
              <li
                :for={{dom_id, row} <- @streams.rows}
                id={dom_id}
                class="px-4 py-2 flex items-center justify-between gap-3"
              >
                <div class="min-w-0 flex items-center gap-2">
                  <span class="text-parchment text-sm truncate">{row.name}</span>
                  <span
                    :if={row.data_type}
                    class="inline-block px-2 py-0.5 rounded text-xs border bg-ink-panel2 text-parchment-dim border-ink-panel2 shrink-0"
                  >
                    {row.data_type}
                  </span>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <.species_combobox row={row} species={@species} />
                  <a
                    href={~p"/professional/ingredients/#{row.id}/show"}
                    class="text-parchment-dim text-xs hover:text-parchment"
                  >
                    #{row.id}
                  </a>
                </div>
              </li>
            </ul>
            <div
              :if={@row_limit < length(@active_rows)}
              class="px-4 py-2 border-t border-ink-panel2"
            >
              <button
                type="button"
                phx-click="load_more"
                class="text-parchment text-xs hover:opacity-90"
              >
                Show more — {@row_limit} of {length(@active_rows)}
              </button>
            </div>
          </div>
        </div>

        <p :if={@schemas == []} class="text-parchment-dim text-sm">
          No schemas derived. Seed some fdc-backed ingredients first.
        </p>
      </div>

      <div :if={@unmatched_count > 0} class="space-y-2">
        <h2 class="text-lg font-semibold text-parchment">Unmatched</h2>

        <div class="rounded-lg border border-ink-panel2 bg-ink-panel">
          <button
            type="button"
            phx-click="open_panel"
            phx-value-key="__unmatched__"
            class="w-full flex items-center gap-3 px-4 py-3 text-left hover:opacity-90"
          >
            <span class="text-parchment-dim text-xs w-4">
              {if @active_key == "__unmatched__", do: "▾", else: "▸"}
            </span>
            <div class="flex-1">
              <div class="text-parchment font-medium">No exact schema match</div>
              <div class="text-parchment-dim text-xs mt-1">
                unparseable, no base food, or a signature absent from the catalog
              </div>
            </div>
            <div class="text-parchment text-lg font-semibold shrink-0">{@unmatched_count}</div>
          </button>

          <div :if={@active_key == "__unmatched__"} class="border-t border-ink-panel2">
            <ul
              :if={@active_rows != []}
              id="unmatched-rows"
              phx-update="stream"
              class="divide-y divide-ink-panel2"
            >
              <li
                :for={{dom_id, row} <- @streams.rows}
                id={dom_id}
                class="px-4 py-2 flex items-center justify-between gap-3"
              >
                <span class="text-parchment text-sm truncate">{row.name}</span>
                <div class="flex items-center gap-2 shrink-0">
                  <.species_combobox row={row} species={@species} />
                  <span :if={row.reason} class="text-parchment-dim text-xs">{row.reason}</span>
                </div>
              </li>
            </ul>
            <div
              :if={@row_limit < length(@active_rows)}
              class="px-4 py-2 border-t border-ink-panel2"
            >
              <button
                type="button"
                phx-click="load_more"
                class="text-parchment text-xs hover:opacity-90"
              >
                Show more — {@row_limit} of {length(@active_rows)}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="space-y-3">
    <h2 class="text-lg font-semibold text-parchment">Foundemental Foods</h2>
    <p class="text-parchment-dim text-sm">
      Ingredients curated onto a fundamental food species. Each node is a
      species; its leaves are the USDA ingredients assigned to it.
    </p>

    <div class="space-y-2">
      <div
        :for={species <- @species_with_foods}
        class="rounded-lg border border-ink-panel2 bg-ink-panel overflow-hidden"
      >
        <button
          type="button"
          phx-click="toggle"
          phx-value-key={"species:#{species.id}"}
          class="w-full flex items-center gap-3 px-4 py-3 text-left hover:opacity-90"
        >
          <span class="text-parchment-dim text-xs w-4">
            {if expanded?(@expanded, "species:#{species.id}"), do: "▾", else: "▸"}
          </span>
          <span class="text-lg shrink-0" aria-hidden="true">{Mehungry.Food.species_icon(species)}</span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="text-parchment font-medium truncate">{species_label(species)}</span>
              <span
                :if={species.private}
                class="inline-block px-2 py-0.5 rounded text-xs border bg-paprika/20 text-paprika border-paprika/40 shrink-0"
              >
                Private
              </span>
            </div>
            <div class="text-parchment-dim text-xs mt-1 truncate">
              {[species.scientific_name, species.family]
              |> Enum.reject(&(&1 in [nil, ""]))
              |> Enum.join(" · ")}
            </div>
          </div>
          <div class="text-parchment text-lg font-semibold shrink-0">
            {length(species.foundemental_foods)}
          </div>
        </button>

        <div
          :if={expanded?(@expanded, "species:#{species.id}")}
          class="border-t border-ink-panel2"
        >
          <form
            phx-submit="update_species_details"
            class="px-4 py-3 border-b border-ink-panel2 space-y-2"
          >
            <input type="hidden" name="species_id" value={species.id} />
            <div class="text-parchment-dim text-xs uppercase tracking-wide">Edit details</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <label class="block">
                <span class="text-parchment-dim text-xs">Name</span>
                <input
                  type="text"
                  name="name"
                  value={species.name}
                  required
                  class="w-full bg-ink-panel2 text-parchment rounded border border-ink-panel2 px-2 py-1 text-sm"
                />
              </label>
              <label class="block">
                <span class="text-parchment-dim text-xs">Variety</span>
                <input
                  type="text"
                  name="variety"
                  value={species.variety}
                  class="w-full bg-ink-panel2 text-parchment rounded border border-ink-panel2 px-2 py-1 text-sm"
                />
              </label>
              <label class="block">
                <span class="text-parchment-dim text-xs">Scientific name</span>
                <input
                  type="text"
                  name="scientific_name"
                  value={species.scientific_name}
                  class="w-full bg-ink-panel2 text-parchment rounded border border-ink-panel2 px-2 py-1 text-sm"
                />
              </label>
              <label class="block">
                <span class="text-parchment-dim text-xs">Family</span>
                <input
                  type="text"
                  name="family"
                  value={species.family}
                  class="w-full bg-ink-panel2 text-parchment rounded border border-ink-panel2 px-2 py-1 text-sm"
                />
              </label>
            </div>
            <button
              type="submit"
              phx-disable-with="Saving..."
              class="text-parchment-dim text-xs hover:text-parchment px-2 py-1 rounded border border-ink-panel2"
            >
              Save details
            </button>
          </form>
          <form
            phx-submit="update_species_icon"
            class="flex items-center gap-2 px-4 py-3 border-b border-ink-panel2"
          >
            <input type="hidden" name="species_id" value={species.id} />
            <label class="text-parchment-dim text-xs">Icon</label>
            <input
              type="text"
              name="icon"
              value={species.icon}
              placeholder={Mehungry.Food.SpeciesIcons.default_icon(species)}
              maxlength="8"
              class="w-16 text-center bg-ink-panel2 text-parchment rounded border border-ink-panel2 px-2 py-1 text-base"
            />
            <button
              type="submit"
              class="text-parchment-dim text-xs hover:text-parchment px-2 py-1 rounded border border-ink-panel2"
            >
              Save
            </button>
            <span class="text-parchment-dim text-xs">Blank = auto ({Mehungry.Food.SpeciesIcons.default_icon(
              species
            )})</span>
          </form>
          <div class="flex items-center gap-2 px-4 py-3 border-b border-ink-panel2">
            <label class="text-parchment-dim text-xs">Visibility</label>
            <span class="text-parchment text-xs">
              {if species.private,
                do: "Private — hidden from /foods",
                else: "Public — shown on /foods"}
            </span>
            <button
              type="button"
              phx-click="toggle_species_private"
              phx-value-species_id={species.id}
              class="text-parchment-dim text-xs hover:text-parchment px-2 py-1 rounded border border-ink-panel2"
            >
              {if species.private, do: "Make public", else: "Make private"}
            </button>
          </div>
          <p
            :if={species.foundemental_foods == []}
            class="px-4 py-3 text-parchment-dim text-sm"
          >
            No ingredients assigned to this species yet.
          </p>
          <ul :if={species.foundemental_foods != []} class="divide-y divide-ink-panel2">
            <li
              :for={food <- species.foundemental_foods}
              class="px-4 flex items-center justify-between gap-3"
            >
              <button
                type="button"
                phx-click="toggle_move_select"
                phx-value-id={food.ingredient_id}
                title="Select to move to another species"
                class="flex-1 flex items-center gap-3 text-left min-w-0 py-2 hover:opacity-90"
              >
                <span class={[
                  "h-4 w-4 rounded border flex items-center justify-center shrink-0 text-[10px] leading-none",
                  if(MapSet.member?(@move_selected, food.ingredient_id),
                    do: "bg-paprika border-paprika text-white",
                    else: "border-ink-panel2 text-transparent"
                  )
                ]}>
                  ✓
                </span>
                <span class="text-parchment text-sm truncate">{food.usda_name}</span>
              </button>
              <a
                href={~p"/professional/ingredients/#{food.ingredient_id}/show"}
                class="text-parchment-dim text-xs hover:text-parchment shrink-0"
              >
                #{food.ingredient_id}
              </a>
            </li>
          </ul>
        </div>
      </div>

      <p :if={@species_with_foods == []} class="text-parchment-dim text-sm">
        No species defined yet. Search above, select ingredients, and assign them to create the first one.
      </p>
    </div>
  </section>
</div>

<%!-- ── Sticky trays: assign (console selection) + move (curated-leaf selection) ── --%>
<div
  :if={MapSet.size(@selected) > 0 or MapSet.size(@move_selected) > 0}
  class="fixed bottom-0 inset-x-0 z-40 border-t border-ink-panel2 bg-ink-panel/95 backdrop-blur"
>
  <div
    :if={MapSet.size(@move_selected) > 0}
    class="max-w-5xl mx-auto px-4 py-3 flex items-center gap-3 border-b border-ink-panel2"
  >
    <span class="text-parchment text-sm font-medium">
      {MapSet.size(@move_selected)} selected to move
    </span>
    <div class="flex-1"></div>
    <button
      type="button"
      phx-click="clear_move_selection"
      class="text-parchment-dim text-xs hover:text-parchment px-2 py-1 rounded border border-ink-panel2"
    >
      Clear
    </button>
    <.tray_species_combobox
      species={@species}
      event="move_choose_species"
      label="Move to species"
    />
  </div>

  <div
    :if={MapSet.size(@selected) > 0}
    class="max-w-5xl mx-auto px-4 py-3 flex items-center gap-3"
  >
    <span class="text-parchment text-sm font-medium">
      {MapSet.size(@selected)} selected
    </span>
    <div class="flex-1"></div>
    <button
      type="button"
      phx-click="clear_selection"
      class="text-parchment-dim text-xs hover:text-parchment px-2 py-1 rounded border border-ink-panel2"
    >
      Clear
    </button>
    <.tray_species_combobox species={@species} event="choose_species" label="Assign to species" />
  </div>
</div>

<.modal
  :if={@show_species_modal}
  id="species-modal"
  show={true}
  on_cancel={JS.push("close_species_modal")}
>
  <div class="space-y-4">
    <div>
      <h3 class="text-lg font-semibold text-parchment">New food species</h3>
      <p :if={@pending_assignment} class="text-parchment-dim text-sm mt-1">
        {assignment_label(@pending_assignment.ingredients)} will be {if Map.get(
                                                                          @pending_assignment,
                                                                          :mode,
                                                                          :assign
                                                                        ) == :move,
                                                                        do: "moved to",
                                                                        else: "assigned to"} this species once created.
      </p>
    </div>

    <.simple_form
      for={@species_form}
      id="species-form"
      phx-submit="create_species"
    >
      <.input field={@species_form[:name]} type="text" label="Name" />
      <.input field={@species_form[:variety]} type="text" label="Variety (optional)" />
      <.input
        field={@species_form[:alternative_name]}
        type="text"
        label="Alternative name (optional)"
      />
      <.input
        field={@species_form[:scientific_name]}
        type="text"
        label="Scientific name (optional)"
      />
      <.input field={@species_form[:family]} type="text" label="Family (optional)" />
      <.input
        field={@species_form[:private]}
        type="checkbox"
        label="Private (hide from the public /foods browser)"
      />

      <:actions>
        <.button phx-disable-with="Creating...">Create species</.button>
      </:actions>
    </.simple_form>
  </div>
</.modal>

<.modal
  :if={@show_assign_modal}
  id="assign-modal"
  show={true}
  on_cancel={JS.push("close_assign_modal")}
>
  <div :if={@pending_assignment} class="space-y-4">
    <% moving? = Map.get(@pending_assignment, :mode, :assign) == :move %>
    <div>
      <h3 class="text-lg font-semibold text-parchment">
        {if moving?, do: "Move to species", else: "Assign to species"}
      </h3>
      <p class="text-parchment-dim text-sm mt-1">
        {assignment_label(@pending_assignment.ingredients)} will be {if moving?,
          do: "moved to",
          else: "assigned to"} “{@pending_assignment.species_label}”.
      </p>
    </div>

    <div class="flex justify-end gap-2">
      <button
        type="button"
        phx-click="close_assign_modal"
        class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
      >
        Cancel
      </button>
      <.button
        phx-click="confirm_assignment"
        phx-disable-with={if moving?, do: "Moving...", else: "Assigning..."}
      >
        {if moving?, do: "Move", else: "Assign"}
      </.button>
    </div>
  </div>
</.modal>
