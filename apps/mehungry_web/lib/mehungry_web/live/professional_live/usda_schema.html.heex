<div class="max-w-5xl mx-auto p-4 space-y-8">
  <div class="flex flex-wrap items-start gap-3">
    <div class="flex-1 min-w-[16rem]">
      <h1 class="text-2xl font-semibold text-parchment">USDA Schema</h1>
      <p class="text-parchment-dim text-sm mt-1">
        Ingredients grouped by the structural <em>schema</em> of their USDA description — the
        set of semantic dimensions the deterministic parser populates
        (<code class="text-parchment">food + processing + packaging</code>, …). The catalog of
        valid schemas is inherited from the
        <span class="text-parchment">{source_label(@source)}</span>. Ingredients whose signature
        matches no schema exactly are set aside below. Assign an ingredient to a
        <span class="text-parchment">fundamental food species</span>
        and it moves into the Foundemental Foods accordion.
      </p>
    </div>
    <button
      type="button"
      phx-click="recompute"
      disabled={@loading}
      class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90 disabled:opacity-50"
    >
      Recompute
    </button>
  </div>

  <div
    :if={@loading}
    class="rounded-lg border border-ink-panel2 bg-ink-panel p-4 text-parchment-dim text-sm"
  >
    Computing schema analysis from the ingredient corpus…
  </div>

  <section class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-4">
      <div class="text-parchment-dim text-xs uppercase tracking-wide">Ingredients</div>
      <div class="text-parchment text-2xl font-semibold">{@total_ingredients}</div>
    </div>
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-4">
      <div class="text-parchment-dim text-xs uppercase tracking-wide">Schemas</div>
      <div class="text-parchment text-2xl font-semibold">{@schema_count}</div>
    </div>
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-4">
      <div class="text-parchment-dim text-xs uppercase tracking-wide">Matched</div>
      <div class="text-parchment text-2xl font-semibold">{@matched_count}</div>
    </div>
    <div class="rounded-lg border border-ink-panel2 bg-ink-panel p-4">
      <div class="text-parchment-dim text-xs uppercase tracking-wide">Unmatched</div>
      <div class="text-parchment text-2xl font-semibold">{@unmatched_count}</div>
    </div>
  </section>

  <section class="space-y-3">
    <h2 class="text-lg font-semibold text-parchment">Schemas</h2>

    <div class="space-y-2">
      <div
        :for={{schema, idx} <- Enum.with_index(@schemas)}
        class="rounded-lg border border-ink-panel2 bg-ink-panel overflow-hidden"
      >
        <button
          type="button"
          phx-click="open_panel"
          phx-value-key={schema.key}
          class="w-full flex items-center gap-3 px-4 py-3 text-left hover:opacity-90"
        >
          <span class="text-parchment-dim text-xs w-4">
            {if @active_key == schema.key, do: "▾", else: "▸"}
          </span>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-1.5">
              <span
                :for={dim <- schema.dimensions}
                class="inline-block px-2 py-0.5 rounded text-xs border bg-ink-panel2 text-parchment border-ink-panel2"
              >
                {dim}
              </span>
            </div>
            <div class="text-parchment-dim text-xs mt-1 truncate">
              e.g. {Enum.join(schema.reference_examples, " · ")}
            </div>
          </div>
          <div class="text-right shrink-0">
            <div class="text-parchment text-lg font-semibold">{schema.matched_count}</div>
            <div class="text-parchment-dim text-xs">
              {schema.reference_count} ref
            </div>
          </div>
        </button>

        <div :if={@active_key == schema.key} class="border-t border-ink-panel2">
          <p :if={@active_rows == []} class="px-4 py-3 text-parchment-dim text-sm">
            No ingredients matched this schema.
          </p>
          <ul
            :if={@active_rows != []}
            id={"schema-rows-#{idx}"}
            phx-update="stream"
            class="divide-y divide-ink-panel2"
          >
            <li
              :for={{dom_id, row} <- @streams.rows}
              id={dom_id}
              class="px-4 py-2 flex items-center justify-between gap-3"
            >
              <div class="min-w-0 flex items-center gap-2">
                <span class="text-parchment text-sm truncate">{row.name}</span>
                <span
                  :if={row.data_type}
                  class="inline-block px-2 py-0.5 rounded text-xs border bg-ink-panel2 text-parchment-dim border-ink-panel2 shrink-0"
                >
                  {row.data_type}
                </span>
                <span
                  :if={row.food_class}
                  class="inline-block px-2 py-0.5 rounded text-xs border bg-ink-panel2 text-parchment-dim border-ink-panel2 shrink-0"
                >
                  {row.food_class}
                </span>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <form phx-change="select_species">
                  <input type="hidden" name="ingredient_id" value={row.id} />
                  <input type="hidden" name="usda_name" value={row.name} />
                  <select
                    name="species_id"
                    class="bg-ink-panel2 text-parchment border border-ink-panel2 rounded text-xs px-2 py-1 max-w-[12rem] focus:outline-none"
                  >
                    <option value="">— assign species —</option>
                    <option :for={{label, id} <- species_options(@species)} value={id}>
                      {label}
                    </option>
                    <option value="__new__">+ New species…</option>
                  </select>
                </form>
                <a
                  href={~p"/professional/ingredients/#{row.id}/show"}
                  class="text-parchment-dim text-xs hover:text-parchment"
                >
                  #{row.id}
                </a>
              </div>
            </li>
          </ul>
          <div
            :if={@row_limit < length(@active_rows)}
            class="px-4 py-2 border-t border-ink-panel2"
          >
            <button type="button" phx-click="load_more" class="text-parchment text-xs hover:opacity-90">
              Show more — {@row_limit} of {length(@active_rows)}
            </button>
          </div>
        </div>
      </div>

      <p :if={@schemas == []} class="text-parchment-dim text-sm">
        No schemas derived. Seed some fdc-backed ingredients first.
      </p>
    </div>
  </section>

  <section :if={@unmatched_count > 0} class="space-y-3">
    <h2 class="text-lg font-semibold text-parchment">Unmatched</h2>

    <div class="rounded-lg border border-ink-panel2 bg-ink-panel overflow-hidden">
      <button
        type="button"
        phx-click="open_panel"
        phx-value-key="__unmatched__"
        class="w-full flex items-center gap-3 px-4 py-3 text-left hover:opacity-90"
      >
        <span class="text-parchment-dim text-xs w-4">
          {if @active_key == "__unmatched__", do: "▾", else: "▸"}
        </span>
        <div class="flex-1">
          <div class="text-parchment font-medium">No exact schema match</div>
          <div class="text-parchment-dim text-xs mt-1">
            unparseable, no base food, or a signature absent from the catalog
          </div>
        </div>
        <div class="text-parchment text-lg font-semibold shrink-0">{@unmatched_count}</div>
      </button>

      <div :if={@active_key == "__unmatched__"} class="border-t border-ink-panel2">
        <ul
          :if={@active_rows != []}
          id="unmatched-rows"
          phx-update="stream"
          class="divide-y divide-ink-panel2"
        >
          <li
            :for={{dom_id, row} <- @streams.rows}
            id={dom_id}
            class="px-4 py-2 flex items-center justify-between gap-3"
          >
            <span class="text-parchment text-sm truncate">{row.name}</span>
            <div class="flex items-center gap-2 shrink-0">
              <form phx-change="select_species">
                <input type="hidden" name="ingredient_id" value={row.id} />
                <input type="hidden" name="usda_name" value={row.name} />
                <select
                  name="species_id"
                  class="bg-ink-panel2 text-parchment border border-ink-panel2 rounded text-xs px-2 py-1 max-w-[12rem] focus:outline-none"
                >
                  <option value="">— assign species —</option>
                  <option :for={{label, id} <- species_options(@species)} value={id}>
                    {label}
                  </option>
                  <option value="__new__">+ New species…</option>
                </select>
              </form>
              <span :if={row.reason} class="text-parchment-dim text-xs">{row.reason}</span>
            </div>
          </li>
        </ul>
        <div :if={@row_limit < length(@active_rows)} class="px-4 py-2 border-t border-ink-panel2">
          <button type="button" phx-click="load_more" class="text-parchment text-xs hover:opacity-90">
            Show more — {@row_limit} of {length(@active_rows)}
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="space-y-3">
    <h2 class="text-lg font-semibold text-parchment">Foundemental Foods</h2>
    <p class="text-parchment-dim text-sm">
      Ingredients curated onto a fundamental food species. Each node is a
      species; its leaves are the USDA ingredients assigned to it.
    </p>

    <div class="space-y-2">
      <div
        :for={species <- @species_with_foods}
        class="rounded-lg border border-ink-panel2 bg-ink-panel overflow-hidden"
      >
        <button
          type="button"
          phx-click="toggle"
          phx-value-key={"species:#{species.id}"}
          class="w-full flex items-center gap-3 px-4 py-3 text-left hover:opacity-90"
        >
          <span class="text-parchment-dim text-xs w-4">
            {if expanded?(@expanded, "species:#{species.id}"), do: "▾", else: "▸"}
          </span>
          <div class="flex-1 min-w-0">
            <div class="text-parchment font-medium truncate">{species_label(species)}</div>
            <div class="text-parchment-dim text-xs mt-1 truncate">
              {[species.scientific_name, species.family]
              |> Enum.reject(&(&1 in [nil, ""]))
              |> Enum.join(" · ")}
            </div>
          </div>
          <div class="text-parchment text-lg font-semibold shrink-0">
            {length(species.foundemental_foods)}
          </div>
        </button>

        <div
          :if={expanded?(@expanded, "species:#{species.id}")}
          class="border-t border-ink-panel2"
        >
          <p
            :if={species.foundemental_foods == []}
            class="px-4 py-3 text-parchment-dim text-sm"
          >
            No ingredients assigned to this species yet.
          </p>
          <ul :if={species.foundemental_foods != []} class="divide-y divide-ink-panel2">
            <li
              :for={food <- species.foundemental_foods}
              class="px-4 py-2 flex items-center justify-between gap-3"
            >
              <span class="text-parchment text-sm truncate">{food.usda_name}</span>
              <a
                href={~p"/professional/ingredients/#{food.ingredient_id}/show"}
                class="text-parchment-dim text-xs hover:text-parchment shrink-0"
              >
                #{food.ingredient_id}
              </a>
            </li>
          </ul>
        </div>
      </div>

      <p :if={@species_with_foods == []} class="text-parchment-dim text-sm">
        No species defined yet. Assign an ingredient above to create the first one.
      </p>
    </div>
  </section>
</div>

<.modal
  :if={@show_species_modal}
  id="species-modal"
  show={true}
  on_cancel={JS.push("close_species_modal")}
>
  <div class="space-y-4">
    <div>
      <h3 class="text-lg font-semibold text-parchment">New food species</h3>
      <p :if={@pending_assignment} class="text-parchment-dim text-sm mt-1">
        “{@pending_assignment.usda_name}” will be assigned to this species once created.
      </p>
    </div>

    <.simple_form
      for={@species_form}
      id="species-form"
      phx-submit="create_species"
    >
      <.input field={@species_form[:name]} type="text" label="Name" />
      <.input field={@species_form[:variety]} type="text" label="Variety (optional)" />
      <.input
        field={@species_form[:scientific_name]}
        type="text"
        label="Scientific name (optional)"
      />
      <.input field={@species_form[:family]} type="text" label="Family (optional)" />

      <:actions>
        <.button phx-disable-with="Creating...">Create species</.button>
      </:actions>
    </.simple_form>
  </div>
</.modal>

<.modal
  :if={@show_assign_modal}
  id="assign-modal"
  show={true}
  on_cancel={JS.push("close_assign_modal")}
>
  <div class="space-y-4">
    <div>
      <h3 class="text-lg font-semibold text-parchment">Assign to species</h3>
      <p :if={@pending_assignment} class="text-parchment-dim text-sm mt-1">
        “{@pending_assignment.usda_name}” will be assigned to
        “{@pending_assignment.species_label}”.
      </p>
    </div>

    <div class="flex justify-end gap-2">
      <button
        type="button"
        phx-click="close_assign_modal"
        class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
      >
        Cancel
      </button>
      <.button phx-click="confirm_assignment" phx-disable-with="Assigning...">
        Assign
      </.button>
    </div>
  </div>
</.modal>
