<div class="max-w-5xl mx-auto p-4 space-y-8">
  <h1 class="text-2xl font-semibold text-parchment">Glycemic Index</h1>
  <p class="text-parchment-dim text-sm">
    GI values <span class="font-medium">re-derived from primary literature</span>
    — discovered by the species&nbsp;× <code class="text-parchment">"glycemic index"</code>
    crawl and extracted from each paper's full text by the local-AI service (never
    ingested from the copyrighted International Tables). Each extracted value is fanned
    over the species the study links to and waits here for review; nothing auto-promotes.
    Promoting writes the value onto every ingredient of the species as a reviewed
    <code class="text-parchment">glycemic_index</code> property.
  </p>

  <section class="space-y-3 rounded-lg border border-ink-panel2 bg-ink-panel p-4">
    <div class="flex flex-wrap items-center gap-2">
      <div class="text-xs text-parchment-dim">
        Pending: <span class="text-parchment font-medium">{@pending_count}</span>
        · Promoted: <span class="text-parchment font-medium">{@promoted_count}</span>
      </div>
      <button
        type="button"
        phx-click="refresh"
        class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90 ml-auto"
      >
        Refresh
      </button>
    </div>
    <p class="text-xs text-parchment-dim">
      Extraction runs off-box in the local-AI service (<code>mix local_ai.extract</code>);
      this page is review-only.
    </p>
  </section>

  <%!-- ── Pending review ──────────────────────────────────────────────────── --%>
  <section>
    <h2 class="text-lg font-medium text-parchment mb-2">Pending review ({@pending_count})</h2>
    <p class="text-parchment-dim text-sm mb-3">
      ISO-method values first. <span class="font-medium">Promote</span>
      writes the GI value onto the species' ingredients; adjust the species first if the
      study was fanned onto the wrong food. <span class="font-medium">Reject</span>
      drops it. Both leave the queue.
    </p>

    <div
      id="glycemic_candidates"
      phx-hook="InfiniteScroll"
      phx-update="stream"
      data-page={@page}
      class="divide-y divide-ink-panel2"
    >
      <div
        :for={{dom_id, candidate} <- @streams.candidates}
        id={dom_id}
        class="py-3 flex flex-wrap items-start gap-3 justify-between"
      >
        <div class="min-w-0 flex-1">
          <div class="text-parchment font-medium">
            {(candidate.species && candidate.species.name) || "—"}
            <span class="text-basil">· {gi_label(candidate)}</span>
          </div>
          <div class="text-xs text-parchment-dim mt-0.5">
            <% {iso_text, iso_cls} = iso_badge(candidate) %>
            <span class={"font-medium #{iso_cls}"}>{iso_text}</span>
            <span :if={candidate.country}>· {candidate.country}</span>
            <span :if={candidate.year}>· {candidate.year}</span>
            <span :if={candidate.sample_size}>· n={candidate.sample_size}</span>
            · score {conf_label(candidate.score)}
          </div>
          <div class="text-xs text-parchment-dim mt-0.5">
            <a
              :if={study_url(candidate)}
              href={study_url(candidate)}
              target="_blank"
              rel="noopener"
              class="text-basil hover:underline"
            >
              {study_ref(candidate)}
            </a>
            <span :if={study_title(candidate)} class="italic">— {study_title(candidate)}</span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <form phx-submit="promote" class="flex items-center gap-2">
            <input type="hidden" name="candidate_id" value={candidate.id} />
            <select name="species_id" class={field_class()} title="Promote onto this species">
              <option value="">
                keep: {(candidate.species && candidate.species.name) || "—"}
              </option>
              <option :for={s <- @species} value={s.id}>{species_label(s)}</option>
            </select>
            <button
              type="submit"
              class="px-3 py-1.5 rounded bg-basil text-ink text-sm font-medium hover:opacity-90"
            >
              Promote
            </button>
          </form>
          <button
            type="button"
            phx-click="reject"
            phx-value-id={candidate.id}
            data-confirm="Reject this value? No GI value will be written."
            class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
          >
            Reject
          </button>
        </div>
      </div>
    </div>

    <p :if={@pending_count == 0} class="text-parchment-dim text-sm">
      Nothing pending — run the crawl + local-AI extraction, or every value is decided.
    </p>

    <button
      :if={@pending_count > @page * 25}
      type="button"
      phx-click="load-more"
      class="mt-4 px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
    >
      Load more
    </button>
  </section>

  <%!-- ── Curated GI values (promoted) ────────────────────────────────────── --%>
  <section>
    <h2 class="text-lg font-medium text-parchment mb-2">Curated GI values ({@promoted_count})</h2>
    <p class="text-parchment-dim text-sm mb-3">
      Promoted values — written onto every ingredient of the species.
      <span class="font-medium">Undo</span>
      deletes those property rows and rejects the value so it won't re-promote.
    </p>

    <div id="glycemic_promoted" phx-update="stream" class="divide-y divide-ink-panel2">
      <div
        :for={{dom_id, candidate} <- @streams.promoted}
        id={dom_id}
        class="py-3 flex flex-wrap items-center gap-3 justify-between"
      >
        <div class="min-w-0 flex-1">
          <div class="text-parchment font-medium">
            {(candidate.species && candidate.species.name) || "—"}
            <span class="text-basil">· {gi_label(candidate)}</span>
          </div>
          <div class="text-xs text-parchment-dim">
            {length(candidate.promoted_property_ids || [])} ingredient propert{if length(
                                                                                    candidate.promoted_property_ids ||
                                                                                      []
                                                                                  ) == 1,
                                                                                  do: "y",
                                                                                  else: "ies"} · {study_ref(candidate)}
          </div>
        </div>

        <button
          type="button"
          phx-click="undo"
          phx-value-id={candidate.id}
          data-confirm="Delete the written GI properties and reject this value?"
          class="px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
        >
          Undo
        </button>
      </div>
    </div>

    <p :if={@promoted_count == 0} class="text-parchment-dim text-sm">
      No promoted values yet — promote reviewed values above.
    </p>

    <button
      :if={@promoted_count > @promoted_page * 25}
      type="button"
      phx-click="load-more-promoted"
      class="mt-4 px-3 py-1.5 rounded border border-ink-panel2 text-parchment text-sm font-medium hover:opacity-90"
    >
      Load more
    </button>
  </section>
</div>
