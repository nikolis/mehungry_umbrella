<div class="px-4 py-6 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-6">
  <!-- Header card -->
  <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6">
    <div class="flex items-center justify-between mb-4">
      <.back navigate={~p"/professional/ingredients"}>Back</.back>
      <.link patch={~p"/professional/ingredients/#{@ingredient.id}/edit"}>
        <button
          type="button"
          class="flex items-center gap-2 px-4 py-2 rounded-full border border-slate-600 text-slate-300 hover:bg-slate-700 text-sm font-semibold transition-colors"
        >
          <.icon name="hero-pencil-square" class="w-4 h-4" /> Edit
        </button>
      </.link>
    </div>

    <h1 class="text-2xl font-bold text-white mb-1">{@ingredient.name}</h1>
    <%= if @ingredient.description do %>
      <p class="text-slate-400 text-sm mb-4">{@ingredient.description}</p>
    <% end %>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-4">
      <div class="bg-slate-700/50 rounded-xl p-3">
        <div class="text-xs text-slate-500 mb-1">Category</div>
        <div class="text-sm text-white font-medium">
          {(@ingredient.category && @ingredient.category.name) || "—"}
        </div>
      </div>
      <div class="bg-slate-700/50 rounded-xl p-3">
        <div class="text-xs text-slate-500 mb-1">Default Unit</div>
        <div class="text-sm text-white font-medium">
          {(@ingredient.measurement_unit && @ingredient.measurement_unit.name) || "—"}
        </div>
      </div>
      <div class="bg-slate-700/50 rounded-xl p-3">
        <div class="text-xs text-slate-500 mb-1">Food Class</div>
        <div class="text-sm text-white font-medium">{@ingredient.food_class || "—"}</div>
      </div>
      <div class="bg-slate-700/50 rounded-xl p-3">
        <div class="text-xs text-slate-500 mb-1">FDC ID</div>
        <div class="text-sm text-white font-medium">{@ingredient.fdc_id || "—"}</div>
      </div>
      <div class="bg-slate-700/50 rounded-xl p-3">
        <div class="text-xs text-slate-500 mb-1">Publication Date</div>
        <div class="text-sm text-white font-medium">{@ingredient.publication_date || "—"}</div>
      </div>
    </div>
  </div>

  <!-- Nutrients -->
  <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6">
    <h2 class="text-lg font-semibold text-white mb-4">Nutrients</h2>
    <%= if @ingredient.ingredient_nutrients == [] do %>
      <p class="text-slate-500 text-sm">No nutrients available.</p>
    <% else %>
      <div class="overflow-x-auto -mx-2">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-slate-700">
              <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Nutrient
              </th>
              <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Amount
              </th>
              <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Unit
              </th>
              <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Type
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-700">
            <%= for n <- @ingredient.ingredient_nutrients do %>
              <tr class="hover:bg-slate-700/30 transition-colors">
                <td class="px-3 py-2 text-white">{n.nutrient && n.nutrient.name}</td>
                <td class="px-3 py-2 text-slate-300">{n.amount}</td>
                <td class="px-3 py-2 text-slate-400">{n.nutrient.measurement_unit.name}</td>
                <td class="px-3 py-2">
                  <span class="text-xs bg-slate-700 text-slate-300 px-2 py-0.5 rounded-full">
                    {n.type_}
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <!-- Portions -->
  <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6">
    <h2 class="text-lg font-semibold text-white mb-4">Portions</h2>
    <%= if @ingredient.ingredient_portions == [] do %>
      <p class="text-slate-500 text-sm">No portions available.</p>
    <% else %>
      <div class="space-y-2">
        <%= for portion <- @ingredient.ingredient_portions do %>
          <div class="bg-slate-700/40 rounded-xl p-3 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
            <div class="text-sm">
              <span class="text-slate-500 text-xs">Amount</span>
              <div class="text-white font-medium">{portion.amount}</div>
            </div>
            <div class="text-sm">
              <span class="text-slate-500 text-xs">Gram Weight</span>
              <div class="text-white font-medium">{portion.gram_weight}</div>
            </div>
            <div class="text-sm">
              <span class="text-slate-500 text-xs">Unit</span>
              <div class="text-white font-medium">
                {(portion.measurement_unit && portion.measurement_unit.name) || "—"}
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Translations -->
  <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6">
    <h2 class="text-lg font-semibold text-white mb-4">Translations</h2>
    <%= if @ingredient.ingredient_translation == [] do %>
      <p class="text-slate-500 text-sm">No translations available.</p>
    <% else %>
      <div class="space-y-2">
        <%= for tr <- @ingredient.ingredient_translation do %>
          <div class="bg-slate-700/40 rounded-xl p-3">
            <div class="flex items-center gap-3 mb-1">
              <span class="text-xs bg-primary-500/20 text-primary-400 border border-primary-500/30 px-2 py-0.5 rounded-full font-medium">
                {tr.language && tr.language.name}
              </span>
              <span class="text-white font-medium text-sm">{tr.name}</span>
            </div>
            <%= if tr.description do %>
              <p class="text-slate-400 text-xs">{tr.description}</p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
