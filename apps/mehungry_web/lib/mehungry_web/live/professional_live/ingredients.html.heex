<div class="px-4 py-6 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold text-white">Ingredients Explorer</h1>
    <div class="flex items-center gap-3">
      <button
        type="button"
        phx-click="delete_without_nutrients"
        data-confirm="Delete all ingredients with no nutrients? This cannot be undone."
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-red-700 hover:bg-red-600 text-white font-semibold text-sm transition-colors"
      >
        <.icon name="hero-trash" class="w-4 h-4" /> Delete without nutrients
      </button>
      <button
        type="button"
        phx-click="enqueue_translation"
        class="flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition-colors"
      >
        <.icon name="hero-language" class="w-4 h-4" /> Translate to Greek
      </button>
      <.link patch="/professional/ingredients/new">
        <button
          type="button"
          class="flex items-center gap-2 px-4 py-2 rounded-full bg-primary-500 hover:bg-primary-600 text-white font-semibold text-sm transition-colors"
        >
          <.icon name="hero-plus" class="w-4 h-4" /> New Ingredient
        </button>
      </.link>
    </div>
  </div>

  <%!-- Translation coverage stats --%>
  <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 mb-4">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">
      Translation Coverage
    </h2>
    <div class="flex items-center gap-2 mb-1">
      <span class="text-slate-400 text-sm w-24">Total</span>
      <span class="text-white font-semibold text-sm"><%= @translation_stats.total %></span>
    </div>
    <%= if @translation_stats.languages == [] do %>
      <p class="text-slate-500 text-sm italic">No languages configured yet.</p>
    <% else %>
      <%= for stat <- @translation_stats.languages do %>
        <% pct = if @translation_stats.total > 0, do: round(stat.translated / @translation_stats.total * 100), else: 0 %>
        <div class="mt-2">
          <div class="flex items-center justify-between mb-1">
            <span class="text-slate-300 text-sm font-medium uppercase"><%= stat.language %></span>
            <span class="text-slate-400 text-xs">
              <%= stat.translated %> / <%= stat.total %> (<%= pct %>%)
            </span>
          </div>
          <div class="w-full bg-slate-700 rounded-full h-1.5">
            <div
              class="bg-emerald-500 h-1.5 rounded-full transition-all"
              style={"width: #{pct}%"}
            >
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 mb-6">
    <form id="ingredients-search-form" phx-change="search_change">
      <div class="flex flex-col sm:flex-row gap-3 flex-wrap">
        <div class="flex-1 min-w-0">
          <.live_component
            module={MehungryWeb.SelectComponent}
            items={@food_classes}
            form={@form}
            id="category_select_component"
            input_variable={:classes}
            mode={:multi}
          />
        </div>
        <%!-- Search language toggle — overrides user profile preference for this page only --%>
        <div class="flex items-center gap-1 bg-slate-700 rounded-lg p-0.5 self-center">
          <button
            type="button"
            phx-click="set_search_language"
            phx-value-lang="en"
            class={"px-3 py-1.5 rounded-md text-xs font-semibold transition-colors #{if @search_language == "en", do: "bg-slate-500 text-white", else: "text-slate-400 hover:text-white"}"}
          >
            EN
          </button>
          <button
            type="button"
            phx-click="set_search_language"
            phx-value-lang="el"
            class={"px-3 py-1.5 rounded-md text-xs font-semibold transition-colors #{if @search_language == "el", do: "bg-primary-500 text-white", else: "text-slate-400 hover:text-white"}"}
          >
            ΕΛ
          </button>
        </div>
        <div :if={@search_language == "en"}>
          <.input
            type="select"
            options={@search_methods}
            name="search_form[search_method]"
            value={@search_method}
          />
        </div>
        <div class="flex-1 min-w-0 sm:max-w-xs">
          <.input
            type="text"
            name="search_form[query]"
            value={@form[:query].value}
            placeholder={if @search_language == "el", do: "Αναζήτηση…", else: "Search ingredients…"}
          />
        </div>
      </div>
    </form>
  </div>
  
<!-- Table header — hidden on mobile -->
  <div class="hidden sm:grid sm:grid-cols-12 gap-2 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-slate-500 border-b border-slate-700 mb-1">
    <div class="col-span-1">ID</div>
    <div class="col-span-5">Name</div>
    <div class="col-span-3">Class</div>
    <div class="col-span-2">Category</div>
    <div class="col-span-1"></div>
  </div>

  <div
    id="ingredients_container"
    phx-hook="InfiniteScroll"
    phx-update="stream"
    data-page={@page}
    class="space-y-1"
  >
    <%= for {dom_id, ingredient} <- @streams.ingredients do %>
      <div class="relative group" id={dom_id}>
        <.link patch={"/professional/ingredients/" <> Integer.to_string(ingredient.id) <> "/show"}>
          <div class="bg-slate-800/60 hover:bg-slate-800 border border-transparent hover:border-slate-700 rounded-xl px-4 py-3 transition-colors cursor-pointer">
            <!-- Mobile layout: stacked -->
            <div class="sm:hidden">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <span class="text-slate-500 text-xs mr-1">#{ingredient.id}</span>
                  <span class="text-white font-medium">{ingredient.name}</span>
                </div>
                <.link
                  patch={"/professional/ingredients/" <> Integer.to_string(ingredient.id) <> "/edit"}
                  class="text-primary-400 hover:text-primary-300 text-xs font-semibold shrink-0"
                >
                  Edit
                </.link>
              </div>
              <div class="mt-1 flex flex-wrap gap-2">
                <span class="text-xs text-slate-400 bg-slate-700 px-2 py-0.5 rounded-full">
                  {ingredient.food_class}
                </span>
                <span class="text-xs text-slate-400">
                  {ingredient.category.name}
                </span>
              </div>
            </div>
            <!-- Desktop layout: grid -->
            <div class="hidden sm:grid sm:grid-cols-12 gap-2 items-center">
              <div class="col-span-1 text-slate-500 text-sm">#{ingredient.id}</div>
              <div class="col-span-5 text-white text-sm font-medium truncate">
                {ingredient.name}
              </div>
              <div class="col-span-3">
                <span class="text-xs text-slate-400 bg-slate-700 px-2 py-0.5 rounded-full">
                  {ingredient.food_class}
                </span>
              </div>
              <div class="col-span-2 text-slate-400 text-sm truncate">
                {ingredient.category.name}
              </div>
              <div class="col-span-1 flex justify-end">
                <.link
                  patch={"/professional/ingredients/" <> Integer.to_string(ingredient.id) <> "/edit"}
                  class="opacity-0 group-hover:opacity-100 text-primary-400 hover:text-primary-300 text-xs font-semibold transition-opacity"
                >
                  Edit
                </.link>
              </div>
            </div>
          </div>
        </.link>
      </div>
    <% end %>
  </div>
</div>
