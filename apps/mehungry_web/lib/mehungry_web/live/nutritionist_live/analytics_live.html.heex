<div class="px-4 py-6 sm:px-6 lg:px-8 max-w-5xl mx-auto space-y-6">
  <!-- Header + time range -->
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-white font-display">{gettext("Earnings & pipeline")}</h1>
      <p class="text-parchment-dim text-sm mt-0.5">
        {gettext(
          "What you've earned, what's in flight, and where money leaks — read straight from your payments."
        )}
      </p>
    </div>
    <div class="inline-flex rounded-xl border border-ink-panel2 bg-ink-panel p-1 shrink-0">
      <%= for r <- ranges() do %>
        <button
          type="button"
          phx-click="set_range"
          phx-value-range={r}
          class={[
            "px-3 py-1.5 rounded-lg text-sm font-medium transition-colors",
            if(@range == r,
              do: "bg-basil/15 text-basil",
              else: "text-parchment-dim hover:text-parchment"
            )
          ]}
        >
          {range_label(r)}
        </button>
      <% end %>
    </div>
  </div>

  <!-- Hero KPI tiles -->
  <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
    <div class="bg-ink-panel border border-ink-panel2 rounded-2xl p-5">
      <p class="text-xs font-semibold uppercase tracking-wider text-parchment-dim">
        {gettext("Net earned")}
      </p>
      <p class="text-3xl font-bold text-basil [font-variant-numeric:tabular-nums] mt-1">
        {euros(@net_cents)}
      </p>
      <p class="text-xs text-parchment-dim mt-1">
        {gettext("after 5% platform fee ·")} {range_label(@range)}
      </p>
    </div>
    <div class="bg-ink-panel border border-ink-panel2 rounded-2xl p-5">
      <p class="text-xs font-semibold uppercase tracking-wider text-parchment-dim">
        {gettext("In flight")}
      </p>
      <p class="text-3xl font-bold text-basil [font-variant-numeric:tabular-nums] mt-1">
        {euros(@in_flight_cents)}
      </p>
      <p class="text-xs text-parchment-dim mt-1">{gettext("authorized holds awaiting accept")}</p>
    </div>
    <div class="bg-ink-panel border border-ink-panel2 rounded-2xl p-5 col-span-2 md:col-span-1">
      <p class="text-xs font-semibold uppercase tracking-wider text-parchment-dim">
        {gettext("Pending requests")}
      </p>
      <p class="text-3xl font-bold text-basil [font-variant-numeric:tabular-nums] mt-1">
        {@pending_count}
      </p>
      <a
        href="/nutritionist/appointments"
        class="text-paprika hover:text-paprika-soft text-xs mt-1 block"
      >{gettext("Review requests →")}</a>
    </div>
  </div>

  <!-- Secondary: revenue over time + breakdown -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Revenue over time -->
    <div class="bg-ink-panel border border-ink-panel2 rounded-2xl p-5">
      <h2 class="text-sm font-semibold text-white">{gettext("Revenue over time")}</h2>
      <p class="text-xs text-parchment-dim mt-0.5">{gettext("Net €,")} {range_label(@range)}</p>
      <%= if @has_revenue? do %>
        <div class="w-full overflow-hidden mt-3">
          <div
            id="revenue-chart"
            phx-hook="VegaLite"
            data-spec={Jason.encode!(@revenue_spec)}
            class="w-full"
          >
          </div>
        </div>
      <% else %>
        <div class="mt-3 rounded-xl border border-dashed border-ink-panel2 py-10 text-center">
          <p class="text-parchment text-sm font-medium">{gettext("No revenue recorded yet")}</p>
          <p class="text-parchment-dim text-xs mt-1 max-w-xs mx-auto">
            {gettext("Paid consultations show up here once clients book and you accept them.")}
          </p>
          <a
            href="/nutritionist/payments"
            class="inline-block mt-3 px-4 py-2 rounded-lg bg-paprika hover:bg-paprika-soft text-white text-sm font-medium"
          >{gettext("Set up your services")}</a>
        </div>
      <% end %>

      <div class="mt-5 pt-4 border-t border-ink-panel2">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-parchment-dim">
              {gettext("Appointments")}
            </p>
            <p class="text-xs text-parchment-dim">
              {@appts_this_week} {gettext("this week · active clients:")} {@client_count}
            </p>
          </div>
        </div>
        <div class="w-full overflow-hidden mt-2">
          <div
            id="appts-chart"
            phx-hook="VegaLite"
            data-spec={Jason.encode!(@appts_spec)}
            class="w-full"
          >
          </div>
        </div>
      </div>
    </div>

    <!-- Breakdown -->
    <div class="bg-ink-panel border border-ink-panel2 rounded-2xl p-5">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-sm font-semibold text-white">{gettext("Where it came from")}</h2>
        <div class="inline-flex rounded-lg border border-ink-panel2 p-0.5">
          <%= for d <- dimensions() do %>
            <button
              type="button"
              phx-click="set_dimension"
              phx-value-dim={d}
              class={[
                "px-2.5 py-1 rounded-md text-xs font-medium transition-colors",
                if(@dimension == d,
                  do: "bg-basil/15 text-basil",
                  else: "text-parchment-dim hover:text-parchment"
                )
              ]}
            >
              {dimension_label(d)}
            </button>
          <% end %>
        </div>
      </div>

      <%= if @has_revenue? do %>
        <div class="w-full overflow-hidden mt-3">
          <div
            id="breakdown-chart"
            phx-hook="VegaLite"
            data-spec={Jason.encode!(@breakdown_spec)}
            class="w-full"
          >
          </div>
        </div>
      <% else %>
        <div class="mt-3 rounded-xl border border-dashed border-ink-panel2 py-10 text-center">
          <p class="text-parchment-dim text-sm">{gettext("Nothing to break down yet.")}</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Leakage strip (only when non-zero) -->
  <%= if @leakage? do %>
    <div class="bg-ink-panel border border-ink-panel2 rounded-2xl p-5">
      <h2 class="text-sm font-semibold text-white mb-3">
        {gettext("Outcome")} ({range_label(@range)})
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div>
          <p class="text-xs uppercase tracking-wider text-parchment-dim">{gettext("Captured")}</p>
          <p class="text-xl font-bold text-basil [font-variant-numeric:tabular-nums] mt-0.5">
            {euros(@outcome.captured_cents)}
          </p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-parchment-dim">
            {gettext("No-show retained")}
          </p>
          <p class="text-xl font-bold text-parchment [font-variant-numeric:tabular-nums] mt-0.5">
            {euros(@outcome.no_show_cents)}
          </p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-parchment-dim">{gettext("Refunded")}</p>
          <p class="text-xl font-bold text-paprika [font-variant-numeric:tabular-nums] mt-0.5">
            {euros(@outcome.refunded_cents)}
          </p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-parchment-dim">
            {gettext("Released (declined/expired)")}
          </p>
          <p class="text-xl font-bold text-paprika [font-variant-numeric:tabular-nums] mt-0.5">
            {euros(@outcome.released_cents)}
          </p>
        </div>
      </div>
    </div>
  <% end %>
</div>
