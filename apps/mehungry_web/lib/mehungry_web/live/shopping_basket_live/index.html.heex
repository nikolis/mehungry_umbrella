<div
  class="h-112 pb-4 sm:min-h-screen bg-slate-900 "
  id="shopping_basket_index"
>
  <div class="container mx-auto px-4 py-8 overflow-hidden">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white flex items-center gap-3">
        <svg
          class="w-8 h-8 text-primary-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-1.5 1.5M17 13l1.5 1.5M9 21h6M12 21v-8"
          />
        </svg>
        Shopping Lists
      </h1>
      <p class="text-slate-400 mt-1">Manage your grocery lists and track items</p>
    </div>
    
<!-- Two Column Layout -->
    <div class="flex flex-col sm:flex-row gap-6 relative" style="height: 100%; overflow:hidden; ">
      
<!-- Sidebar - Shopping Lists -->
      <div
        class="lg:w-80 flex-shrink-0 bakset-side-nav-hidden bg-black-400  bd-black-400"
        id="basket-side-navbar"
      >
        <div class="bg-slate-800 rounded-xl border border-slate-700 overflow-hidden">
          <!-- Header with New List Button -->
          <div class="p-4 border-b border-slate-700 flex justify-between items-center">
            <h2 class="text-white font-semibold">My Lists</h2>
            <button
              phx-click={
                case @live_action in ["index"] do
                  true ->
                    ""

                  false ->
                    JS.remove_class("active", to: "#basket-basic-form.active")
                    |> JS.add_class("active", to: "#basket-basic-form:not(.active)")
                end
              }
              class="p-1.5 rounded-lg bg-primary-500/10 hover:bg-primary-500/20 text-primary-500 transition"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4v16m8-8H4"
                />
              </svg>
            </button>
          </div>
          <.live_component
            module={MehungryWeb.ShoppingBasketLive.BasicFormComponent}
            id={@processing_basket.id || :new}
            action={@live_action}
            shopping_basket={@processing_basket}
            user={@current_user}
            page_title="Create"
            patch={~p"/basket"}
          />
          <.render_basket_titles
            shopping_baskets={@shopping_baskets}
            shopping_basket={@shopping_basket}
          />
        </div>
      </div>
      <div class="item-list-container w-full  sm:p-6">
        <%= if @shopping_basket do %>
          <.render_basket_items shopping_basket={@shopping_basket} />
        <% end %>
        <%= if length(@shopping_basket.basket_ingredients) < 1 do %>
          <h4 class="text-center text-base font-semibold text-greyfriend-2">Empty</h4>
        <% end %>
      </div>
    </div>
  </div>
  <!-- Add Item Modal -->
  <%= if @show_add_item_modal do %>
    <div
      id={@id}
      phx-mounted={@show_add_item_modal && show_modal(@id)}
      phx-remove={hide_modal(@id)}
      data-cancel={JS.exec(JS.patch(~p"/basket"), "phx-remove")}
      class="relative z-50 hidden"
    >
      <div
        class="fixed inset-0 bg-black/50 flex items-center justify-center z-50"
        phx-click=""
      >
        <div
          class="bg-slate-800 rounded-xl max-w-lg w-full mx-4 overflow-hidden"
          phx-click-away="close_add_item_modal"
        >
          <!-- Modal Header -->
          <div class="flex justify-between items-center p-4 border-b border-slate-700">
            <h2 class="text-xl font-semibold text-white">Add Item to List</h2>
            <button phx-click="close_add_item_modal" class="text-slate-400 hover:text-white">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                />
              </svg>
            </button>
          </div>
          
<!-- Modal Body -->
          <div class="p-4">
            <%= if @selected_usda_item do %>
              <!-- USDA Item Selected - Show nutrition preview -->
              <div class="mb-4">
                <h3 class="text-white font-semibold mb-2">
                  {@selected_usda_item["description"]}
                </h3>
                <div class="bg-slate-700 rounded-lg p-3 mb-4">
                  <p class="text-slate-300 text-sm mb-2">Nutrition per 100g:</p>
                  <div class="grid grid-cols-2 gap-2 text-sm">
                    <div class="flex justify-between">
                      <span class="text-slate-400">Calories:</span>
                      <span class="text-white">
                        {get_nutrition_value(@selected_usda_item, "Energy")} kcal
                      </span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-slate-400">Protein:</span>
                      <span class="text-white">
                        {get_nutrition_value(@selected_usda_item, "Protein")} g
                      </span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-slate-400">Fat:</span>
                      <span class="text-white">
                        {get_nutrition_value(@selected_usda_item, "Total Fat")} g
                      </span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-slate-400">Carbs:</span>
                      <span class="text-white">
                        {get_nutrition_value(@selected_usda_item, "Carbohydrates")} g
                      </span>
                    </div>
                  </div>
                </div>
                
<!-- Quantity and Unit -->
                <div class="flex gap-3 mb-4">
                  <div class="flex-1">
                    <label class="block text-slate-400 text-sm mb-1">Quantity</label>
                    <input
                      type="number"
                      id="quantity"
                      value={@custom_quantity}
                      phx-keyup="update_quantity"
                      class="w-full px-3 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white"
                    />
                  </div>
                  <div class="flex-1">
                    <label class="block text-slate-400 text-sm mb-1">Unit</label>

                    <select
                      id="unit"
                      phx-change="update_unit"
                      class="w-full px-3 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white"
                    >
                      <option value="g">grams (g)</option>
                      <option value="kg">kilograms (kg)</option>
                      <option value="pcs">pieces (pcs)</option>
                      <option value="cup">cups</option>
                      <option value="tbsp">tablespoons (tbsp)</option>
                      <option value="tsp">teaspoons (tsp)</option>
                    </select>
                  </div>
                </div>

                <div class="flex gap-3">
                  <button
                    phx-click="add_usda_item"
                    phx-value-quantity={@custom_quantity}
                    phx-value-unit={@custom_unit}
                    class="flex-1 bg-primary-500 hover:bg-primary-600 text-white py-2 rounded-lg transition"
                  >
                    Add with Nutrition
                  </button>
                  <button
                    phx-click="cancel_usda_selection"
                    class="flex-1 border border-slate-600 text-slate-300 hover:text-white py-2 rounded-lg transition"
                  >
                    Back
                  </button>
                </div>
              </div>
            <% else %>
              <!-- Search for item -->
              <div class="mb-4">
                <!--

                <label class="block text-slate-400 text-sm mb-1">Search for item</label>
                <input
                type="text"
                placeholder="e.g., avocado, chicken breast, olive oil..."
                value={@search_query}
                phx-keyup="search_usda"
                class="w-full px-4 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white focus:outline-none focus:border-primary-500"
                />
                -->
                <!-- Search Results -->
                <!--
                <%= if @searching do %>
                  <div class="text-center py-4">
                  <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-primary-500">
                  </div>
                  <p class="text-slate-400 text-sm mt-2">Searching USDA database...</p>
                  </div>
                <% end %>
                -->
                <%= if @search_results != [] do %>
                  <div class="mt-3 space-y-2 max-h-64 overflow-y-auto">
                    <%= for result <- @search_results do %>
                      <div
                        class="flex justify-between items-center p-3 bg-slate-700/50 hover:bg-slate-700 rounded-lg cursor-pointer transition"
                        phx-click="select_usda_item"
                        phx-value-fdc_id={result.fdc_id}
                      >
                        <div>
                          <div class="text-white font-medium">{result.description}</div>
                          <div class="text-slate-400 text-xs">{result.data_type}</div>
                        </div>
                        <svg
                          class="w-5 h-5 text-primary-500"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"
                          />
                        </svg>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
              
<!-- Divider -->
<!-- 
              <div class="relative my-4">
                <div class="absolute inset-0 flex items-center">
                  <div class="w-full border-t border-slate-700"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                  <span class="px-2 bg-slate-800 text-slate-400">or</span>
                </div>
              </div>
-->
              <!-- Manual entry -->
              <div>
                <label class="block text-slate-400 text-sm mb-1">Add manually</label>
                <.simple_form
                  :let={f}
                  for={@change_basket}
                  phx-submit="add_plain_item"
                  class="space-y-3"
                >
                  <input
                    type="text"
                    name="name"
                    placeholder="Item name"
                    required
                    class="w-full px-4 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white focus:outline-none focus:border-primary-500"
                  />
                  <div class="flex gap-3">
                    <input
                      type="number"
                      name="quantity"
                      placeholder="Quantity"
                      value="1"
                      step="0.25"
                      class="w-1/2 px-3 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white"
                    />
                    <.live_component
                      module={MehungryWeb.SelectComponent}
                      items={
                        Enum.map(@measurement_units, fn x -> {Integer.to_string(x.id), x.name} end)
                      }
                      form={f}
                      id="measurement_unit select"
                      input_variable={:measurement_unit_id}
                    />
                  </div>
                  <button
                    type="submit"
                    class="w-full bg-slate-700 hover:bg-slate-600 text-white py-2 rounded-lg transition"
                  >
                    Add to List
                  </button>
                </.simple_form>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  <.modal
    :if={@live_action in [:import_items]}
    on_cancel={JS.patch(~p"/basket")}
    id="shopping_basket_modal"
    show
  >
    <.live_component
      module={MehungryWeb.ShoppingBasketLive.FormComponent}
      id={@processing_basket.id || :new}
      title="Alter Basket"
      action={@live_action}
      shopping_basket={@processing_basket}
      user={@current_user}
      patch={~p"/basket"}
    />
  </.modal>
  <button
    class="basket-side-button"
    phx-click={
      JS.remove_class("active", to: "#basket-side-navbar.active")
      |> JS.add_class("active", to: "#basket-side-navbar:not(.active)")
    }
  >
    <.icon name="hero-arrow-down-circle" class="md:hidden h-10 w-10 text-complementary" />
  </button>
</div>
