<div class="browse-page min-h-screen bg-ink text-parchment p-4">
  <div class="mx-auto md:pt-4 md:pl-8">
    <!-- Header -->
    <div class="mb-2">
      <h1 class="text-3xl font-display font-medium text-parchment flex items-center gap-3">
        <svg
          class="w-8 h-8 text-paprika"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          />
        </svg>
        Discover Recipes
      </h1>
      <p class="text-parchment-dim mt-1">Explore recipes from our community</p>

      <div :if={@diet_mode_available} class="mt-2">
        <button
          type="button"
          phx-click="toggle_diet_mode"
          title={
            if @diet_mode,
              do: "Showing only ##{@diet_mode} recipes — click to see everything",
              else: "Click to filter to ##{@diet_mode_available} recipes"
          }
          class={[
            "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-semibold border transition",
            if(@diet_mode,
              do: "bg-basil/20 text-basil border-basil/40",
              else: "bg-ink-panel text-parchment-dim border-ink-panel2 hover:text-parchment"
            )
          ]}
        >
          <span class={[
            "w-2 h-2 rounded-full",
            if(@diet_mode, do: "bg-basil", else: "bg-parchment-dim")
          ]}></span>
          #{@diet_mode_available} mode {if @diet_mode, do: "on", else: "off"}
        </button>
      </div>
    </div>

    <!-- Recipes ↔ Blueprints switch -->
    <div class="inline-flex items-center gap-1 p-1 rounded-full bg-ink-panel border border-ink-panel2 mt-3 mb-1">
      <button
        type="button"
        phx-click="set_browse_mode"
        phx-value-mode="recipes"
        class={[
          "px-4 py-1.5 rounded-full text-sm font-semibold transition",
          if(@browse_mode == :recipes,
            do: "bg-paprika text-ink",
            else: "text-parchment-dim hover:text-parchment"
          )
        ]}
      >
        Recipes
      </button>
      <button
        type="button"
        phx-click="set_browse_mode"
        phx-value-mode="blueprints"
        class={[
          "px-4 py-1.5 rounded-full text-sm font-semibold transition",
          if(@browse_mode == :blueprints,
            do: "bg-basil text-ink",
            else: "text-parchment-dim hover:text-parchment"
          )
        ]}
      >
        Meal Blueprints
      </button>
      <button
        type="button"
        phx-click="set_browse_mode"
        phx-value-mode="meal_plans"
        class={[
          "px-4 py-1.5 rounded-full text-sm font-semibold transition",
          if(@browse_mode == :meal_plans,
            do: "bg-paprika text-ink",
            else: "text-parchment-dim hover:text-parchment"
          )
        ]}
      >
        Meal Plans
      </button>
    </div>

    <!-- Search Bar -->
    <div :if={@browse_mode == :recipes} class="">
      <!-- Sort Options -->
      <!-- Sort Options
      <div class="flex gap-2 mt-4">
        <button
          phx-click="sort_by"
          phx-value-sort="recent"
          class={[
            "px-4 py-1.5 rounded-full text-sm font-medium transition",
            (@sort_by == "recent" && "bg-primary-500 text-white") ||
              (@sort_by != "recent" && "bg-slate-800 text-slate-400 hover:bg-slate-700")
          ]}
        >
          Most Recent
        </button>
        <button
          phx-click="sort_by"
          phx-value-sort="popular"
          class={[
            "px-4 py-1.5 rounded-full text-sm font-medium transition",
            (@sort_by == "popular" && "bg-primary-500 text-white") ||
              (@sort_by != "popular" && "bg-slate-800 text-slate-400 hover:bg-slate-700")
          ]}
        >
          Most Saved
        </button>
        <button
          phx-click="sort_by"
          phx-value-sort="easy"
          class={[
            "px-4 py-1.5 rounded-full text-sm font-medium transition",
            (@sort_by == "easy" && "bg-primary-500 text-white") ||
              (@sort_by != "easy" && "bg-slate-800 text-slate-400 hover:bg-slate-700")
          ]}
        >
          Easiest
        </button>
      </div>
    -->
    </div>
    <div :if={@browse_mode == :recipes} class="search_comp_cont">
      <.live_component
        module={MehungryWeb.SearchLive.Index}
        id={5}
        ,
        class="search_comp"
        query_string={@query_string}
      />
    </div>
    <!-- Nutrient-claim filter chips (EU per-serving "High in X" claims). Each is a
         real crawlable link to /search/nutrient/:slug, not a client-only toggle. -->
    <div
      :if={@browse_mode == :recipes}
      class="flex gap-2 overflow-x-auto mt-2 pb-1 -mx-1 px-1"
      aria-label={gettext("Filter recipes by nutrient")}
    >
      <.link
        :for={label <- MehungryWeb.RecipeBrowserLive.Index.chip_nutrients()}
        navigate={~p"/search/nutrient/#{Mehungry.Food.claim_slug(label)}"}
        class={[
          "whitespace-nowrap rounded-full px-3 py-1 text-xs font-medium border transition-colors",
          if(@active_nutrient == label,
            do: "bg-basil text-white border-basil",
            else: "bg-parchment-dim text-ink border-ink-panel2 hover:border-basil"
          )
        ]}
      >
        {MehungryWeb.NutrientLabels.claim_label(label)}
      </.link>
    </div>
    <p :if={@active_nutrient} class="text-parchment-dim text-xs mt-1">
      {gettext("Claims follow EU Reg. 1169/2011 & 1924/2006, per serving.")}
    </p>
    <%= if !is_nil(@must_be_loged_in) do %>
      <.modal
        id="browse_index_must_be_login"
        show
        on_cancel={JS.push("keep_browsing")}
        class="h-full"
      >
        <.live_component module={MehungryWeb.MustBeLoginComponent} id={:new} patch={~p"/browse"} />
      </.modal>
    <% end %>

    <%= if !is_nil(@current_user_profile) do %>
      <.modal
        :if={
          is_nil(@current_user_profile.onboarding_level) or
            @current_user_profile.onboarding_level < 1
        }
        id="onboarding-modal"
        show
        on_cancel={JS.patch(~p"/")}
      >
        <.live_component
          module={MehungryWeb.Onboarding.FormComponent}
          user_profile={@user_profile}
          id={:new}
          patch={~p"/"}
        />
      </.modal>
    <% end %>
    <!-- Blueprint browsing -->
    <div :if={@browse_mode == :blueprints} class="mt-3">
      <form
        id="blueprint-search-form"
        phx-submit="search_blueprints"
        phx-change="search_blueprints"
        class="mb-5"
      >
        <input
          type="text"
          name="query"
          value={@blueprint_query}
          placeholder="Search blueprints by title…"
          phx-debounce="300"
          class="w-full bg-ink-panel text-parchment rounded-xl px-4 py-3 text-sm border border-ink-panel2 focus:border-basil focus:outline-none"
        />
      </form>

      <div :if={@blueprints == []} class="text-center text-parchment-dim py-16">
        No public blueprints found.
      </div>

      <div class="pb-20 w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <.blueprint_card :for={bp <- @blueprints} blueprint={bp} from="browse" />
      </div>
    </div>

    <!-- Published meal-plan browsing -->
    <div :if={@browse_mode == :meal_plans} class="mt-3">
      <form
        id="meal-plan-search-form"
        phx-submit="search_meal_plans"
        phx-change="search_meal_plans"
        class="mb-5"
      >
        <input
          type="text"
          name="query"
          value={@meal_plan_query}
          placeholder="Search meal plans by title…"
          phx-debounce="300"
          class="w-full bg-ink-panel text-parchment rounded-xl px-4 py-3 text-sm border border-ink-panel2 focus:border-paprika focus:outline-none"
        />
      </form>

      <div :if={@meal_plans == []} class="text-center text-parchment-dim py-16">
        No meal plans found.
        <div class="mt-1 text-sm">
          <.link navigate={~p"/meal-plans"} class="text-paprika hover:underline">
            Browse all meal plans
          </.link>
        </div>
      </div>

      <div class="pb-20 w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <.meal_plan_card :for={plan <- @meal_plans} plan={plan} from="browse" />
      </div>
    </div>

    <!-- The recipes stream container must stay mounted across tab switches:
         a `phx-update="stream"` container only receives its items once, so
         removing it from the DOM (via :if) and re-adding it leaves it empty.
         We hide it with CSS instead when Blueprints is active. -->
    <div class={[@browse_mode != :recipes && "hidden"]}>
      <div :if={@not_empty} class="">
        <div
          class="pb-20 w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 "
          id="recipes_container"
          phx-hook="InfiniteScroll"
          phx-update="stream"
          data-page={@page}
        >
          <%= for {dom_id, recipe} <- @streams.recipes do %>
            <RecipeComponents.recipe_card
              recipe={recipe}
              user_recipes={@current_user_recipes}
              return_to={@return_to}
              path_to_details={~p"/browse/#{recipe.id}"}
              id={dom_id}
              type="browse"
            />
          <% end %>
        </div>

        <form name="ignore_me">
          <input type="hidden" id="page_is_dirty" name="page_is_dirty" value="0" />
        </form>
      </div>
      <div :if={!@not_empty} style="height: 20vh">
        <h3 class="text-center p-10 font-display text-parchment-dim">
          We were not able to find a recipe according to your search
        </h3>
      </div>
    </div>
    <MehungryWeb.RecipeComponents.recipe_modal
      :if={@live_action in [:show_recipe]}
      on_cancel={JS.patch(@return_to)}
      id="recipe_details_modal"
      show
    >
      <div class="w-full h-full">
        <.live_component
          module={MehungryWeb.RecipeDetailsComponent}
          id="recipe_details_component"
          recipe={@recipe}
          user={@current_user}
          user_recipes={@current_user_recipes}
          current_user={@current_user}
          user_follows={@current_user_follows}
          page_title={"Recipe #{@recipe.title}"}
          live_action={@live_action}
          return_to={Routes.recipe_browser_index_path(@socket, :index)}
        />
      </div>
    </MehungryWeb.RecipeComponents.recipe_modal>
  </div>
</div>
