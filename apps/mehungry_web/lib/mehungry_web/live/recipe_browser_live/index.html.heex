<div id="page-timer" phx-hook="PageTimer" class="hidden"></div>
<div class="browse-page min-h-screen bg-ink text-parchment p-4">
  <div class="mx-auto md:pt-4 md:pl-8">
    <!-- Header -->
    <div class="mb-2">
      <h1 class="text-3xl font-display font-medium text-parchment flex items-center gap-3">
        <svg
          class="w-8 h-8 text-paprika"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          />
        </svg>
        Discover Recipes
      </h1>
      <p class="text-parchment-dim mt-1">Explore recipes from our community</p>

      <div :if={@diet_mode_available} class="mt-2">
        <button
          type="button"
          phx-click="toggle_diet_mode"
          title={
            if @diet_mode,
              do: "Showing only ##{@diet_mode} recipes — click to see everything",
              else: "Click to filter to ##{@diet_mode_available} recipes"
          }
          class={[
            "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-semibold border transition",
            if(@diet_mode,
              do: "bg-basil/20 text-basil border-basil/40",
              else: "bg-ink-panel text-parchment-dim border-ink-panel2 hover:text-parchment"
            )
          ]}
        >
          <span class={["w-2 h-2 rounded-full", if(@diet_mode, do: "bg-basil", else: "bg-parchment-dim")]}>
          </span>
          #{@diet_mode_available} mode {if @diet_mode, do: "on", else: "off"}
        </button>
      </div>
    </div>

    <!-- Search Bar -->
    <div class="">
      <!-- Sort Options -->
      <!-- Sort Options 
      <div class="flex gap-2 mt-4">
        <button
          phx-click="sort_by"
          phx-value-sort="recent"
          class={[
            "px-4 py-1.5 rounded-full text-sm font-medium transition",
            (@sort_by == "recent" && "bg-primary-500 text-white") ||
              (@sort_by != "recent" && "bg-slate-800 text-slate-400 hover:bg-slate-700")
          ]}
        >
          Most Recent
        </button>
        <button
          phx-click="sort_by"
          phx-value-sort="popular"
          class={[
            "px-4 py-1.5 rounded-full text-sm font-medium transition",
            (@sort_by == "popular" && "bg-primary-500 text-white") ||
              (@sort_by != "popular" && "bg-slate-800 text-slate-400 hover:bg-slate-700")
          ]}
        >
          Most Saved
        </button>
        <button
          phx-click="sort_by"
          phx-value-sort="easy"
          class={[
            "px-4 py-1.5 rounded-full text-sm font-medium transition",
            (@sort_by == "easy" && "bg-primary-500 text-white") ||
              (@sort_by != "easy" && "bg-slate-800 text-slate-400 hover:bg-slate-700")
          ]}
        >
          Easiest
        </button>
      </div>
    -->
    </div>
    <div class="search_comp_cont">
      <.live_component
        module={MehungryWeb.SearchLive.Index}
        id={5}
        ,
        class="search_comp"
        query_string={@query_string}
        filter_active={not Enum.empty?(@selected_condition_ids)}
      />
      <!-- Extended search settings — filter by health condition -->
      <div class={[
        "overflow-hidden transition-all duration-300 ease-in-out",
        (@show_search_settings && "max-h-[600px] opacity-100 mt-2") || "max-h-0 opacity-0"
      ]}>
        <div class="bg-ink-panel border border-ink-panel2 rounded-xl p-4">
          <div class="flex items-start justify-between mb-3">
            <div>
              <p class="text-sm font-display font-medium text-parchment">
                Filter by health condition
              </p>
              <p class="text-xs text-parchment-dim mt-0.5">
                Show recipes containing compounds recommended for these conditions.
              </p>
            </div>
            <button
              type="button"
              phx-click="toggle_search_settings"
              aria-label="Close filters"
              class="text-parchment-dim hover:text-parchment transition"
            >
              <.icon name="hero-x-mark" class="h-5 w-5" />
            </button>
          </div>

          <div :if={@conditions_by_category == []} class="text-sm text-parchment-dim py-2">
            No health conditions available yet.
          </div>

          <div class="m3-scrollbar max-h-64 overflow-y-auto space-y-3 pr-1">
            <div :for={{category, conditions} <- @conditions_by_category}>
              <p class="text-xs uppercase tracking-wide text-parchment-dim mb-1.5">{category}</p>
              <div class="flex flex-wrap gap-2">
                <button
                  :for={condition <- conditions}
                  type="button"
                  phx-click="toggle_condition"
                  phx-value-id={condition.id}
                  class={
                    condition_pill_class(MapSet.member?(@selected_condition_ids, condition.id))
                  }
                >
                  {if MapSet.member?(@selected_condition_ids, condition.id), do: "✓ ", else: ""}{condition.name}
                </button>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-end gap-2 mt-4">
            <button
              type="button"
              phx-click="clear_conditions"
              class="px-4 py-1.5 rounded-full text-sm font-medium text-parchment-dim hover:text-parchment transition"
            >
              Clear
            </button>
            <button
              type="button"
              phx-click="apply_condition_filter"
              class="px-5 py-1.5 rounded-full text-sm font-semibold bg-paprika text-white hover:opacity-90 transition"
            >
              Apply filters
            </button>
          </div>
        </div>
      </div>
    </div>
    <%= if !is_nil(@must_be_loged_in) do %>
      <.modal
        id="browse_index_must_be_login"
        show
        on_cancel={JS.push("keep_browsing")}
        class="h-full"
      >
        <.live_component module={MehungryWeb.MustBeLoginComponent} id={:new} patch={~p"/browse"} />
      </.modal>
    <% end %>

    <%= if !is_nil(@current_user_profile) do %>
      <.modal
        :if={
          is_nil(@current_user_profile.onboarding_level) or
            @current_user_profile.onboarding_level < 1
        }
        id="onboarding-modal"
        show
        on_cancel={JS.patch(~p"/")}
      >
        <.live_component
          module={MehungryWeb.Onboarding.FormComponent}
          user_profile={@user_profile}
          id={:new}
          patch={~p"/"}
        />
      </.modal>
    <% end %>
    <%= if @not_empty do %>
      <div class="">
        <div
          class="pb-20 w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 "
          id="recipes_container"
          phx-hook="InfiniteScroll"
          phx-update="stream"
          data-page={@page}
        >
          <%= for {dom_id, recipe} <- @streams.recipes do %>
            <RecipeComponents.recipe_card
              recipe={recipe}
              user_recipes={@current_user_recipes}
              return_to={@return_to}
              path_to_details={~p"/browse/#{recipe.id}"}
              id={dom_id}
              type="browse"
            />
          <% end %>
        </div>

        <form name="ignore_me">
          <input type="hidden" id="page_is_dirty" name="page_is_dirty" value="0" />
        </form>
      </div>
    <% else %>
      <div style="height: 20vh">
        <h3 class="text-center p-10 font-display text-parchment-dim">
          We were not able to find a recipe according to your search
        </h3>
      </div>
    <% end %>
    <MehungryWeb.RecipeComponents.recipe_modal
      :if={@live_action in [:show_recipe]}
      on_cancel={JS.patch(@return_to)}
      id="recipe_details_modal"
      show
    >
      <div class="w-full h-full">
        <.live_component
          module={MehungryWeb.RecipeDetailsComponent}
          id="recipe_details_component"
          recipe={@recipe}
          user={@current_user}
          user_recipes={@current_user_recipes}
          current_user={@current_user}
          user_follows={@current_user_follows}
          page_title={"Recipe #{@recipe.title}"}
          live_action={@live_action}
          return_to={Routes.recipe_browser_index_path(@socket, :index)}
        />
      </div>
    </MehungryWeb.RecipeComponents.recipe_modal>
  </div>
</div>
