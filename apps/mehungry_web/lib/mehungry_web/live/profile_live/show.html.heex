<div class="sm:p-10 bg-slate-800 rounded-2xl border border-slate-700 overflow-hidden mb-8">
  <div class=""></div>
  <%= if @live_action == :index do %>
    <.user_details_card
      user={@current_user}
      myself={@myself}
      total_recipes={count_user_created_recipes(@user.id)}
      user_follows={@user_follows}
      user_profile={@user_profile}
      current_user={@current_user}
      socket={@socket}
    />

    <div class="flex justify-center m-6 relative  flex-wrap gap-2">
      <.link href={~p"/upgrade"}>
        <button
          class="border-2 py-2 px-4 rounded-full border-primary-500 text-primary-400 hover:bg-primary-500 hover:text-white h-full text-md font-semibold sm:text-xl transition-colors"
          type="button"
        >
          <.icon name="hero-sparkles" class="w-6 h-6 sm:h-7 sm:w-7 flex-none" /> Upgrade to Pro
        </button>
      </.link>
      <.link patch={~p"/users/log_out"} phx-click={JS.push_focus()}>
        <button
          class="border-2 py-2 px-4  rounded-full border-slate-400  text-slate-400 hover:text-white hover:bg-slate-400  h-full text-md font-semibold sm:text-xl"
          type="button"
        >
          <.icon name="hero-pencil-square" class="w-6 h-6 sm:h-7 sm:w-7 flex-none " /> Logout
        </button>
      </.link>
      <%= if !is_nil(@current_user) do %>
        <%= if !is_nil(@current_user.email) do %>
          <%= if @current_user.email == "nikolisgal@gmail.com" do %>
            <.link patch={~p"/professional/activeusers"} phx-click={JS.push_focus()}>
              <button
                class="border-2 py-2 px-4  rounded-full border-primary-500 text-primary-500 hover:bg-primary-500 hover:text-white h-full text-md sm:text-xl font-semibold"
                type="button"
              >
                <.icon name="hero-pencil-square" class="w-6 h-6 sm:h-7 sm:w-7 flex-none " />
                Professional
              </button>
            </.link>
          <% end %>
        <% end %>
        <.link
          patch={~p"/users/delete"}
          phx-click={JS.push_focus()}
          data-confirm="Are you sure you wan't to completely erase your account ?"
          ]
        >
          <button
            class="border-2   py-2 px-4 rounded-full  h-full text-md font-semibold sm:text-xl text-red-600 border-red-600 hover:text-white hover:bg-red-600"
            type="button"
          >
            <.icon name="hero-trash" class="w-6 h-6 sm:h-7 sm:w-7 flex-none " /> Delete Account
          </button>
        </.link>
      <% end %>
    </div>
  <% else %>
    <.user_details_card
      user={@user}
      myself={@myself}
      socket={@socket}
      total_recipes={count_user_created_recipes(@user.id)}
      user_follows={@user_follows}
      user_recipes={@user_recipes}
      user_profile={@user_profile}
      current_user={@current_user}
    />
  <% end %>
</div>
