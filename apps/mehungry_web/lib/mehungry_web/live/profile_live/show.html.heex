<div class="bg-ink-panel rounded-2xl border border-ink-panel2 p-6 sm:p-8 mb-8">
  <%= if @live_action == :index do %>
    <.profile_hero
      mode={:index}
      compact={@content_state in [:edit_profile, :connected_accounts, :ingredients]}
      user={@current_user}
      current_user={@current_user}
      user_profile={@user_profile}
      user_follows={@user_follows}
      myself={@myself}
      socket={@socket}
    />
  <% else %>
    <.profile_hero
      mode={:show}
      user={@user}
      current_user={@current_user}
      user_profile={@user_profile}
      user_follows={@user_follows}
      friend_status={@friend_status}
      myself={@myself}
      socket={@socket}
    />
  <% end %>
</div>
