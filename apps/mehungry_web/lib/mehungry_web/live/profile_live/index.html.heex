<div id="page-timer" phx-hook="PageTimer" class="hidden"></div>
<div class="profile-page min-h-screen bg-ink text-parchment">
  <%= if !is_nil(@must_be_loged_in) do %>
    <.modal
      id="profile_must_be_login"
      show
      on_cancel={JS.push("keep_browsing")}
    >
      <.live_component module={MehungryWeb.MustBeLoginComponent} id={:new} patch={~p"/browse"} />
    </.modal>
  <% end %>
  <%= if !is_nil(@current_user) do %>
    <.modal
      :if={
        is_nil(@current_user_profile.onboarding_level) or
          @current_user_profile.onboarding_level < 1
      }
      id="onboarding-modal"
      show
      on_cancel={JS.patch(~p"/")}
    >
      <.live_component
        module={MehungryWeb.Onboarding.FormComponent}
        user_profile={@current_user_profile}
        id={:new}
        patch={~p"/"}
      />
    </.modal>
  <% end %>
  <div class="profile_index_main container mx-auto px-4 py-8">
    <div class="profile_index_info pb-10">
      <%= case @live_action  do %>
        <% :index -> %>
          <.live_component
            module={Show}
            id="hero"
            user_profile={@current_user_profile}
            live_action={@live_action}
            page_title={@page_title}
            user={@current_user}
            current_user={@current_user}
            user_follows={@current_user_follows}
            form={@form}
          />
        <% :edit -> %>
          <.live_component
            module={MehungryWeb.ProfileLive.Form}
            categories={@categories}
            category_ids={@category_ids}
            food_restriction_ids={@food_restriction_ids}
            food_restrictions={@food_restrictions}
            id="hero"
            user_profile={@user_profile}
            live_action={@live_action}
            current_user={@current_user}
            title={@page_title}
            action={@live_action}
            form={@form}
          />
        <% :show -> %>
          <.live_component
            module={Show}
            id="hero"
            live_action={@live_action}
            user={@user}
            current_user={@current_user}
            current_user_profile={@current_user_profile}
            user_profile={@user_profile}
            user_follows={@current_user_follows}
            user_recipes={@current_user_recipes}
            page_title={@page_title}
            form={@form}
          />
        <% _action -> %>
          <MehungryWeb.RecipeComponents.recipe_modal
            :if={@live_action in [:show_recipe]}
            on_cancel={JS.patch(@cancel_path)}
            id="recipe_details_modal"
            show
          >
            <div class="w-full" style="min-height: 55vh;">
              <.live_component
                module={MehungryWeb.RecipeDetailsComponent}
                id="recipe_details_component"
                primary_size={@primary_size}
                nutrients={@nutrients}
                recipe={@recipe}
                user_follows={@current_user_follows}
                user_recipes={@user_recipes}
                current_user={@current_user}
                page_title={"Recipe #{@recipe.title}"}
                live_action={@live_action}
                return_to={Routes.profile_index_path(@socket, :index)}
              />
            </div>
          </MehungryWeb.RecipeComponents.recipe_modal>
      <% end %>
    </div>
  </div>

  <%= if @live_action in [:index, :show] do %>
    <div class="border-b border-ink-panel2 mb-6 pb-10">
      <div class="flex justify-center overflow-x-auto">
        <.link
          id="tab_button_profile_saved_recipes"
          patch={tab_path(assigns, "saved")}
          class={
                "flex-shrink-0 px-3 py-3 sm:px-6 text-sm font-medium transition-all duration-200 rounded-t-lg" <> get_active(@content_state, :saved)}
        >
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
              />
            </svg>
            <span class="hidden sm:inline">Saved ({length(@user_saved_recipes)})</span>
          </div>
        </.link>
        <.link
          patch={tab_path(assigns, "created")}
          class={
                "flex-shrink-0 px-3 py-3 sm:px-6 text-sm font-medium transition-all duration-200 rounded-t-lg" <> get_active(@content_state, :created )
              }
        >
          <div class="flex items-center gap-2">
            <svg
              class="w-5 h-5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 19.2674V7.84496C19 5.64147 17.4253 3.74489 15.2391 3.31522C13.1006 2.89493 10.8994 2.89493 8.76089 3.31522C6.57467 3.74489 5 5.64147 5 7.84496V19.2674C5 20.6038 6.46752 21.4355 7.63416 20.7604L10.8211 18.9159C11.5492 18.4945 12.4508 18.4945 13.1789 18.9159L16.3658 20.7604C17.5325 21.4355 19 20.6038 19 19.2674z"
              />
            </svg>
            <span class="hidden sm:inline">Created ({length(@user_created_recipes)})</span>
          </div>
        </.link>
        <%= if @live_action in [:index] do %>
          <.link
            patch={tab_path(assigns, "my_ingredients")}
            class={[
              "flex-shrink-0 px-3 py-3 sm:px-6 text-sm font-medium transition-all duration-200 rounded-t-lg" <>
                get_active(@content_state, :my_ingredients)
            ]}
          >
            <div class="flex items-center gap-2">
              <svg
                class="w-5 h-5 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 3v18m0-18c-1.657 0-3 1.79-3 4s1.343 4 3 4m0-8c1.657 0 3 1.79 3 4s-1.343 4-3 4m-6 6h12"
                />
              </svg>
              <span class="hidden sm:inline">My Ingredients ({length(@user_ingredients)})</span>
            </div>
          </.link>
          <.link
            patch={tab_path(assigns, "edit_profile")}
            class={[
              "flex-shrink-0 px-3 py-3 sm:px-6 text-sm font-medium transition-all duration-200 rounded-t-lg" <>
                get_active(@content_state, :edit_profile)
            ]}
          >
            <div class="flex items-center gap-2">
              <svg
                class="w-5 h-5 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                />
              </svg>
              <span class="hidden sm:inline">Edit Profile</span>
            </div>
          </.link>
          <.link
            patch={tab_path(assigns, "connected_accounts")}
            class={[
              "flex-shrink-0 px-3 py-3 sm:px-6 text-sm font-medium transition-all duration-200 rounded-t-lg" <>
                get_active(@content_state, :connected_accounts)
            ]}
          >
            <div class="flex items-center gap-2">
              <svg
                class="w-5 h-5 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                />
              </svg>
              <span class="hidden sm:inline">Connections</span>
            </div>
          </.link>
        <% end %>
      </div>
      <div class="line"></div>

      <.get_profile_content
        content_state={@content_state}
        user_created_recipes={@user_created_recipes}
        user_saved_recipes={@user_saved_recipes}
        user_ingredients={@user_ingredients}
        live_action={@live_action}
        user_recipes={@user_recipes}
        current_user_recipes={@current_user_recipes}
        current_user_profile={@current_user_profile}
        categories={@categories}
        category_ids={@category_ids}
        food_restriction_ids={@food_restriction_ids}
        food_restrictions={@food_restrictions}
        current_user={@current_user}
        page_title={@page_title}
        form={@form}
      />
    </div>
  <% end %>
</div>
