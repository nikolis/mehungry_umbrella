<div style="height: 60px;">
  <.form
    :let={f}
    id="recipe-search-form"
    for={@search_changeset}
    class="form-search"
    phx-change="validate"
    phx-submit="search"
    style="height: 60px;"
  >
    <div class="h-full">
      <div class="relative">
        <svg
          class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-parchment-dim"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          />
        </svg>
        {text_input(f, :query_string,
          class:
            "w-full pl-10 pr-4 py-3 bg-ink-panel border border-ink-panel2 rounded-xl text-parchment placeholder-parchment-dim focus:outline-none focus:border-paprika focus:ring-1 focus:ring-paprika transition",
          id: "text-search-input#{@id}",
          placeholder: "e.g Crispy broccoli steaks ..",
          value: @query_string || ""
        )}
        <button
          type="button"
          phx-click="toggle_search_settings"
          aria-label="Filter by health condition"
          title="Filter by health condition"
          class="absolute right-14 md:right-3 top-1/2 -translate-y-1/2 text-parchment-dim hover:text-paprika transition"
        >
          <.icon name="hero-adjustments-horizontal" class="h-6 w-6" />
          <span
            :if={assigns[:filter_active]}
            class="absolute -top-0.5 -right-0.5 h-2 w-2 rounded-full bg-paprika"
          ></span>
        </button>
        <button
          type="submit"
          class="absolute right-0 top-0 bottom-0 sm:right-4 m-auto md:hidden"
        >
          <.icon
            name="hero-arrow-right-circle"
            class="h-7 w-7 flex-none text-paprika cursor-pointer mr-4"
          />
        </button>
      </div>
      {submit("", phx_disable_with: "Searching...", class: "invisible")}
    </div>
  </.form>
</div>
