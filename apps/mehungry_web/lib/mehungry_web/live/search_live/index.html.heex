<div style="height: 60px;">
  <.form
    :let={f}
    for={@search_changeset}
    class="form-search"
    phx-change="validate"
    phx-submit="search"
    style="height: 60px;"
  >
    <div class="h-full">
      <%= if @query_string do %>
        <div>
          {text_input(f, :query_string,
            class:
              " md:text-lg w-full h-full rounded-full md:p-4 md:rounded-lg md:p-4 md:border-2 md:border-gray-300 md:bg-white",
            id: "text-search-input1#{@id}",
            placeholder: "e.g Crispy brocolli steaks ..",
            value: @query_string
          )}
          <button phx-clic="submit" class="absolute right-2  sm:right-4 m-auto md:hidden">
            <.icon
              name="hero-arrow-right-circle"
              class="h-9 w-9 flex-none text-primary cursor-pointer mr-4"
            />
          </button>
        </div>
      <% else %>
        {text_input(f, :query_string,
          class: "w-full h-full rounded-full",
          style: "background-color:#eaeaea",
          id: "text-search-input#{@id}"
        )}
      <% end %>
      {submit("", phx_disable_with: "Searching...", class: "invisible")}
    </div>
  </.form>
</div>
