<div class="health-page min-h-screen bg-ink text-parchment pb-16">
  <div class="container max-w-4xl mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-display font-medium text-parchment mb-2">
        {gettext("Health Conditions")}
      </h1>
      <p class="text-parchment-dim">
        {gettext(
          "Dietary guidance by condition — which bioactive compounds to be mindful of, and the foods that contain them."
        )}
      </p>
    </div>

    <%= if length(@conditions) == 0 do %>
      <div class="text-center py-16 text-parchment-dim">
        <p>{gettext("No health conditions have been added yet.")}</p>
      </div>
    <% else %>
      <div class="text-sm text-parchment-dim mb-4">
        {gettext("Showing %{count} conditions", count: length(@conditions))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <%= for condition <- @conditions do %>
          <a
            href={~p"/#{@locale}/conditions/#{condition.id}"}
            class="group block bg-ink-panel border border-ink-panel2 rounded-xl p-4 hover:border-paprika/50 hover:bg-ink-panel2/80 transition-colors"
          >
            <div class="flex items-start justify-between gap-2">
              <h2 class="text-sm font-semibold text-parchment group-hover:text-paprika-soft transition-colors leading-snug">
                {condition.name}
              </h2>
              <svg
                class="w-4 h-4 text-parchment-dim/50 group-hover:text-parchment-dim flex-shrink-0 mt-0.5 transition-colors"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
            <%= if condition.category do %>
              <span class="mt-2 inline-block text-xs px-2 py-0.5 rounded-full bg-ink-panel2 text-parchment-dim group-hover:text-parchment transition-colors">
                {condition.category}
              </span>
            <% end %>
          </a>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
