<div class="foods-page min-h-screen bg-ink text-parchment pb-16">
  <div class="container max-w-4xl mx-auto px-4 py-8">
    <div class="mb-6">
      <h1 class="text-3xl font-display font-medium text-parchment mb-2">{gettext("Foods & Nutrition")}</h1>
      <p class="text-parchment-dim max-w-[60ch]">
        {gettext(
          "Browse food species for nutrition facts, the research behind them, and the bioactive compounds they carry."
        )}
      </p>

      <%!-- Professional rail — frames the database as the working tool of the
            platform's nutritionists and sends the demand side into the marketplace. --%>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mt-5 px-4 py-3 rounded-2xl border border-basil/30 bg-gradient-to-r from-basil/10 to-transparent">
        <span class="h-2.5 w-2.5 rounded-full bg-basil shadow-[0_0_0_4px_rgba(69,196,174,0.18)] shrink-0"></span>
        <p class="text-sm text-parchment m-0">
          {gettext("The USDA-backed database nutritionists use to build evidence-based client meal plans.")}
        </p>
        <a
          href={"/#{@language}/nutritionists"}
          class="ml-auto inline-flex items-center gap-1 text-sm font-semibold text-basil-soft hover:text-basil whitespace-nowrap transition-colors"
        >
          {gettext("Find your nutritionist")}
          <.icon name="hero-arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <.nutritionist_recruit_cta current_user={assigns[:current_user]} variant={:inline} class="mt-3" />
    </div>

    <div class="flex items-stretch gap-2 mb-4">
      <form id="foods-search-form" phx-change="search" phx-submit="search" class="flex-1">
        <div class="relative">
          <svg
            class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-parchment-dim pointer-events-none"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"
            />
          </svg>
          <input
            type="text"
            name="q"
            value={@query}
            placeholder={gettext("Search species — e.g. apple, spinach, cattle...")}
            phx-debounce="300"
            class="w-full bg-ink-panel border border-ink-panel2 rounded-xl pl-10 pr-4 py-3 text-parchment placeholder-parchment-dim focus:outline-none focus:border-paprika focus:ring-1 focus:ring-paprika transition-colors"
            autocomplete="off"
          />
        </div>
      </form>

      <button
        type="button"
        phx-click="toggle_filters"
        aria-expanded={@show_filters}
        class={[
          "flex items-center gap-2 px-4 rounded-xl border text-sm font-medium transition-colors",
          (filters_active?(assigns) &&
             "bg-paprika/15 border-paprika/50 text-paprika-soft") ||
            "bg-ink-panel border-ink-panel2 text-parchment-dim hover:text-parchment"
        ]}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 4h18M6 12h12M10 20h4"
          />
        </svg>
        {gettext("Filters")}
        <%= if filters_active?(assigns) do %>
          <span class="ml-0.5 min-w-5 h-5 px-1.5 inline-flex items-center justify-center text-xs font-bold rounded-full bg-paprika text-white [font-variant-numeric:tabular-nums]">
            {MapSet.size(@selected_compound_ids)}
          </span>
        <% end %>
      </button>
    </div>

    <%!-- Always-visible one-click compound facet chips — the shortcut into the
          same filter the panel's search drives, so the feature is discoverable
          without opening Filters. A pressed chip appears selected here and in
          the panel's chip row (shared `selected_compound_ids`). --%>
    <div
      :if={@quick_compounds != []}
      role="group"
      aria-label={gettext("Filter by compound")}
      class="flex flex-wrap gap-2 mb-4"
    >
      <button
        :for={compound <- @quick_compounds}
        type="button"
        phx-click={
          if compound_selected?(@selected_compound_ids, compound.id),
            do: "remove_compound",
            else: "add_compound"
        }
        phx-value-id={compound.id}
        aria-pressed={compound_selected?(@selected_compound_ids, compound.id)}
        class={pill_class(compound_selected?(@selected_compound_ids, compound.id))}
      >
        {compound.name}
      </button>
    </div>

    <div class={[
      "transition-all duration-300 ease-in-out",
      (@show_filters && "max-h-[900px] opacity-100 mb-6 overflow-visible") ||
        "max-h-0 opacity-0 overflow-hidden"
    ]}>
      <div class="bg-ink-panel border border-ink-panel2 rounded-xl p-4 space-y-4">
        <!-- Biochemical compounds — multi-search select -->
        <div>
          <p class="text-sm font-display font-medium text-parchment">{gettext("Contains a compound")}</p>
          <p class="text-xs text-parchment-dim mt-0.5 mb-2">
            {gettext("Search and pick bioactive compounds; foods containing any of them are shown.")}
          </p>

          <!-- Selected compound chips -->
          <div :if={@selected_compound_ids != MapSet.new()} class="flex flex-wrap gap-2 mb-2">
            <span
              :for={compound <- selected_compounds(assigns)}
              class="inline-flex items-center gap-1.5 pl-3 pr-1.5 py-1 rounded-full text-sm font-medium bg-paprika text-white"
            >
              {compound.name}
              <button
                type="button"
                phx-click="remove_compound"
                phx-value-id={compound.id}
                aria-label={"Remove #{compound.name}"}
                class="inline-flex items-center justify-center w-4 h-4 rounded-full hover:bg-white/25 transition"
              >
                <.icon name="hero-x-mark" class="w-3 h-3" />
              </button>
            </span>
          </div>

          <div class="relative">
            <form id="compound-search-form" phx-change="search_compounds" phx-submit="search_compounds" autocomplete="off">
              <input
                type="text"
                name="q"
                value={@compound_query}
                placeholder={gettext("Search compounds — e.g. Quercetin, Iron, Potassium...")}
                phx-debounce="150"
                class="w-full bg-ink border border-ink-panel2 rounded-xl px-4 py-2.5 text-sm text-parchment placeholder-parchment-dim focus:outline-none focus:border-paprika focus:ring-1 focus:ring-paprika transition-colors"
              />
            </form>

            <!-- Suggestions dropdown -->
            <div
              :if={@compound_query != ""}
              id="compound-suggestions"
              class="m3-scrollbar absolute z-10 mt-1 w-full max-h-56 overflow-y-auto bg-ink-panel2 border border-ink-panel2 rounded-xl shadow-lg"
            >
              <div :if={@compound_results == []} class="px-4 py-3 text-sm text-parchment-dim">
                {gettext("No compounds match \"%{query}\".", query: @compound_query)}
              </div>
              <button
                :for={compound <- @compound_results}
                type="button"
                phx-click="add_compound"
                phx-value-id={compound.id}
                class="w-full text-left px-4 py-2 text-sm text-parchment hover:bg-paprika/20 transition-colors"
              >
                {compound.name}
              </button>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-1">
          <button
            :if={filters_active?(assigns)}
            type="button"
            phx-click="clear_filters"
            class="px-4 py-1.5 rounded-full text-sm font-medium text-parchment-dim hover:text-parchment transition"
          >
            {gettext("Clear all")}
          </button>
          <button
            type="button"
            phx-click="toggle_filters"
            class="px-5 py-1.5 rounded-full text-sm font-semibold bg-paprika text-white hover:opacity-90 transition"
          >
            {gettext("Done")}
          </button>
        </div>
      </div>
    </div>

    <div class="text-sm text-parchment-dim mb-4">
      <%= cond do %>
        <% @query != "" -> %>
          <span class="font-bold text-basil [font-variant-numeric:tabular-nums]">{length(@species)}</span>
          {gettext("results for")} "<span class="text-parchment">{@query}</span>"<%= if filters_active?(assigns), do: " " <> gettext("(filtered)") %>
        <% filters_active?(assigns) -> %>
          <span class="font-bold text-basil [font-variant-numeric:tabular-nums]">{length(@species)}</span>
          {gettext("filtered species")}
        <% true -> %>
          {gettext("Showing")}
          <span class="font-bold text-basil [font-variant-numeric:tabular-nums]">{length(@species)}</span>
          {gettext("species")}
      <% end %>
    </div>

    <%= if length(@species) == 0 do %>
      <div class="text-center py-16 text-parchment-dim">
        <svg
          class="w-12 h-12 mx-auto mb-4 opacity-40"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"
          />
        </svg>
        <%= if @query != "" do %>
          <p>{gettext("No species found for")} "<span class="text-parchment-dim">{@query}</span>"</p>
        <% else %>
          <p>{gettext("No species match the selected filters.")}</p>
        <% end %>
      </div>
    <% else %>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        <%= for {species, idx} <- Enum.with_index(@species) do %>
          <%!-- Marketplace nudge woven into the collection at the 9th slot. --%>
          <%= if spotlight?(assigns) and idx == 8 do %>
            <a
              href={"/#{@language}/nutritionists"}
              class="col-span-2 group flex flex-col justify-between rounded-2xl border border-basil/35 p-5 bg-[radial-gradient(120%_120%_at_100%_0%,rgba(69,196,174,0.18),transparent_60%)] bg-ink-panel hover:border-basil/60 transition-colors"
            >
              <div>
                <span class="text-xs font-semibold uppercase tracking-[0.14em] text-basil-soft">
                  {gettext("For your goals")}
                </span>
                <h3 class="font-display text-xl text-parchment mt-2 mb-1">
                  {gettext("Turn this data into a plan")}
                </h3>
                <p class="text-sm text-parchment-dim m-0">
                  {gettext(
                    "Browsing is the start. A nutritionist on the platform builds it around your body, conditions, and week."
                  )}
                </p>
              </div>
              <span class="mt-4 self-start inline-flex items-center gap-1 rounded-lg bg-basil-soft px-3 py-1.5 text-sm font-bold text-ink group-hover:bg-basil transition-colors">
                {gettext("Browse nutritionists")}
                <.icon name="hero-arrow-right" class="h-4 w-4" />
              </span>
            </a>
          <% end %>

          <a
            href={"/#{@language}/foods/#{species_slug(species)}"}
            class="group flex flex-col bg-ink-panel border border-ink-panel2 rounded-2xl p-4 hover:border-paprika/50 hover:bg-ink-panel2/80 hover:-translate-y-0.5 transition-all"
          >
            <span class="block text-[2.5rem] leading-none" aria-hidden="true">
              {Mehungry.Food.species_icon(species)}
            </span>
            <h2 class="mt-3 font-display text-lg text-parchment group-hover:text-paprika-soft transition-colors leading-snug">
              {species_label(species)}
            </h2>
            <div class="mt-3 pt-3 flex items-center justify-between gap-2 border-t border-ink-panel2 text-xs text-parchment-dim">
              <span class="italic truncate">{species_sublabel(species) || gettext("Species")}</span>
              <span class="inline-flex items-center gap-1 shrink-0 text-parchment-dim/60 group-hover:text-paprika-soft transition-colors">
                {gettext("Nutrition")}
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        <% end %>
      </div>

      <%= if @cursor_after && @query == "" do %>
        <div class="mt-8 text-center">
          <button
            phx-click="load_more"
            class="px-6 py-2.5 bg-ink-panel border border-ink-panel2 rounded-xl text-parchment-dim hover:text-parchment hover:border-basil/40 transition-colors text-sm font-medium"
          >
            {gettext("Load more")}
          </button>
        </div>
      <% end %>
    <% end %>
  </div>

  <%!-- Crawlable A–Z directory: links every food so link equity reaches the
        detail pages the paginated feed never renders on the dead render. Shown
        only in the default browse state (not during an active search/filter). --%>
  <%= if @directory != [] and default_browse?(assigns) do %>
    <section class="mt-12 border-t border-ink-panel2 pt-8">
      <details class="group">
        <summary class="cursor-pointer select-none text-sm font-medium text-parchment-dim hover:text-parchment">
          {gettext("Browse all foods A–Z")}
        </summary>
        <nav aria-label={gettext("All foods")} class="mt-6 space-y-6">
          <%= for {letter, entries} <- @directory do %>
            <div>
              <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-parchment-dim/60">
                {letter}
              </h2>
              <ul class="flex flex-wrap gap-x-4 gap-y-1">
                <%= for entry <- entries do %>
                  <li>
                    <a
                      href={entry.path}
                      class="text-sm text-parchment-dim transition-colors hover:text-paprika-soft"
                    >
                      {entry.label}
                    </a>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </nav>
      </details>
    </section>
  <% end %>
</div>
