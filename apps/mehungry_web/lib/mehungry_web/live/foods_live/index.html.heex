<div class="foods-page min-h-screen bg-ink text-parchment pb-16">
  <div class="container max-w-4xl mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-display font-medium text-parchment mb-2">Foods & Nutrition</h1>
      <p class="text-parchment-dim">
        Browse food species for nutrition facts, the research behind them, and the bioactive compounds they carry.
      </p>
    </div>

    <div class="flex items-stretch gap-2 mb-4">
      <form id="foods-search-form" phx-change="search" phx-submit="search" class="flex-1">
        <div class="relative">
          <svg
            class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-parchment-dim pointer-events-none"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"
            />
          </svg>
          <input
            type="text"
            name="q"
            value={@query}
            placeholder="Search species — e.g. apple, spinach, cattle..."
            phx-debounce="300"
            class="w-full bg-ink-panel border border-ink-panel2 rounded-xl pl-10 pr-4 py-3 text-parchment placeholder-parchment-dim focus:outline-none focus:border-paprika focus:ring-1 focus:ring-paprika transition-colors"
            autocomplete="off"
          />
        </div>
      </form>

      <button
        type="button"
        phx-click="toggle_filters"
        aria-expanded={@show_filters}
        class={[
          "flex items-center gap-2 px-4 rounded-xl border text-sm font-medium transition-colors",
          (filters_active?(assigns) &&
             "bg-paprika/15 border-paprika/50 text-paprika-soft") ||
            "bg-ink-panel border-ink-panel2 text-parchment-dim hover:text-parchment"
        ]}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 4h18M6 12h12M10 20h4"
          />
        </svg>
        Filters
        <%= if filters_active?(assigns) do %>
          <span class="ml-0.5 min-w-5 h-5 px-1.5 inline-flex items-center justify-center text-xs font-bold rounded-full bg-paprika text-white [font-variant-numeric:tabular-nums]">
            {if @filter_mode == :condition,
              do: MapSet.size(@selected_condition_ids),
              else: MapSet.size(@selected_compound_ids)}
          </span>
        <% end %>
      </button>
    </div>

    <div class={[
      "transition-all duration-300 ease-in-out",
      (@show_filters && "max-h-[900px] opacity-100 mb-6 overflow-visible") ||
        "max-h-0 opacity-0 overflow-hidden"
    ]}>
      <div class="bg-ink-panel border border-ink-panel2 rounded-xl p-4 space-y-4">
        <!-- Mode switch: filter by condition OR by compound (mutually exclusive) -->
        <div class="inline-flex items-center gap-1 p-1 rounded-full bg-ink border border-ink-panel2">
          <button
            type="button"
            phx-click="set_filter_mode"
            phx-value-mode="condition"
            class={[
              "px-4 py-1.5 rounded-full text-sm font-semibold transition",
              (@filter_mode == :condition && "bg-paprika text-white") ||
                "text-parchment-dim hover:text-parchment"
            ]}
          >
            By condition
          </button>
          <button
            type="button"
            phx-click="set_filter_mode"
            phx-value-mode="compound"
            class={[
              "px-4 py-1.5 rounded-full text-sm font-semibold transition",
              (@filter_mode == :compound && "bg-paprika text-white") ||
                "text-parchment-dim hover:text-parchment"
            ]}
          >
            By compound
          </button>
        </div>

        <!-- Health conditions -->
        <div :if={@filter_mode == :condition}>
          <p class="text-sm font-display font-medium text-parchment">Encouraged for a condition</p>
          <p class="text-xs text-parchment-dim mt-0.5 mb-2">
            Show foods carrying a compound recommended for these health conditions.
          </p>

          <div :if={@conditions_by_category == []} class="text-sm text-parchment-dim py-1">
            No health conditions available yet.
          </div>

          <div class="m3-scrollbar max-h-56 overflow-y-auto space-y-3 pr-1">
            <div :for={{category, conditions} <- @conditions_by_category}>
              <p class="text-xs uppercase tracking-wide text-parchment-dim mb-1.5">{category}</p>
              <div class="flex flex-wrap gap-2">
                <button
                  :for={condition <- conditions}
                  type="button"
                  phx-click="toggle_condition"
                  phx-value-id={condition.id}
                  class={pill_class(MapSet.member?(@selected_condition_ids, condition.id))}
                >
                  {if MapSet.member?(@selected_condition_ids, condition.id), do: "✓ ", else: ""}{condition.name}
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Biochemical compounds — multi-search select -->
        <div :if={@filter_mode == :compound}>
          <p class="text-sm font-display font-medium text-parchment">Contains a compound</p>
          <p class="text-xs text-parchment-dim mt-0.5 mb-2">
            Search and pick bioactive compounds; foods containing any of them are shown.
          </p>

          <!-- Selected compound chips -->
          <div :if={@selected_compound_ids != MapSet.new()} class="flex flex-wrap gap-2 mb-2">
            <span
              :for={compound <- selected_compounds(assigns)}
              class="inline-flex items-center gap-1.5 pl-3 pr-1.5 py-1 rounded-full text-sm font-medium bg-paprika text-white"
            >
              {compound.name}
              <button
                type="button"
                phx-click="remove_compound"
                phx-value-id={compound.id}
                aria-label={"Remove #{compound.name}"}
                class="inline-flex items-center justify-center w-4 h-4 rounded-full hover:bg-white/25 transition"
              >
                <.icon name="hero-x-mark" class="w-3 h-3" />
              </button>
            </span>
          </div>

          <div class="relative">
            <form phx-change="search_compounds" phx-submit="search_compounds" autocomplete="off">
              <input
                type="text"
                name="q"
                value={@compound_query}
                placeholder="Search compounds — e.g. Quercetin, Iron, Potassium..."
                phx-debounce="150"
                class="w-full bg-ink border border-ink-panel2 rounded-xl px-4 py-2.5 text-sm text-parchment placeholder-parchment-dim focus:outline-none focus:border-paprika focus:ring-1 focus:ring-paprika transition-colors"
              />
            </form>

            <!-- Suggestions dropdown -->
            <div
              :if={@compound_query != ""}
              class="m3-scrollbar absolute z-10 mt-1 w-full max-h-56 overflow-y-auto bg-ink-panel2 border border-ink-panel2 rounded-xl shadow-lg"
            >
              <div :if={@compound_results == []} class="px-4 py-3 text-sm text-parchment-dim">
                No compounds match "{@compound_query}".
              </div>
              <button
                :for={compound <- @compound_results}
                type="button"
                phx-click="add_compound"
                phx-value-id={compound.id}
                class="w-full text-left px-4 py-2 text-sm text-parchment hover:bg-paprika/20 transition-colors"
              >
                {compound.name}
              </button>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-1">
          <button
            :if={filters_active?(assigns)}
            type="button"
            phx-click="clear_filters"
            class="px-4 py-1.5 rounded-full text-sm font-medium text-parchment-dim hover:text-parchment transition"
          >
            Clear all
          </button>
          <button
            type="button"
            phx-click="toggle_filters"
            class="px-5 py-1.5 rounded-full text-sm font-semibold bg-paprika text-white hover:opacity-90 transition"
          >
            Done
          </button>
        </div>
      </div>
    </div>

    <div class="text-sm text-parchment-dim mb-4">
      <%= cond do %>
        <% @query != "" -> %>
          <span class="font-bold text-basil [font-variant-numeric:tabular-nums]">{length(@species)}</span>
          results for "<span class="text-parchment">{@query}</span>"<%= if filters_active?(assigns), do: " (filtered)" %>
        <% filters_active?(assigns) -> %>
          <span class="font-bold text-basil [font-variant-numeric:tabular-nums]">{length(@species)}</span>
          filtered species
        <% true -> %>
          Showing
          <span class="font-bold text-basil [font-variant-numeric:tabular-nums]">{length(@species)}</span>
          species
      <% end %>
    </div>

    <%= if length(@species) == 0 do %>
      <div class="text-center py-16 text-parchment-dim">
        <svg
          class="w-12 h-12 mx-auto mb-4 opacity-40"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"
          />
        </svg>
        <%= if @query != "" do %>
          <p>No species found for "<span class="text-parchment-dim">{@query}</span>"</p>
        <% else %>
          <p>No species match the selected filters.</p>
        <% end %>
      </div>
    <% else %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <%= for species <- @species do %>
          <a
            href={"/foods/#{species_slug(species)}"}
            class="group block bg-ink-panel border border-ink-panel2 rounded-xl p-4 hover:border-paprika/50 hover:bg-ink-panel2/80 transition-colors"
          >
            <div class="flex items-start justify-between gap-2">
              <h2 class="text-sm font-semibold text-parchment group-hover:text-paprika-soft transition-colors leading-snug">
                {species_label(species)}
              </h2>
              <svg
                class="w-4 h-4 text-parchment-dim/50 group-hover:text-parchment-dim flex-shrink-0 mt-0.5 transition-colors"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
            <%= if sub = species_sublabel(species) do %>
              <span class="mt-2 inline-block text-xs px-2 py-0.5 rounded-full bg-ink-panel2 text-parchment-dim group-hover:text-parchment transition-colors">
                {sub}
              </span>
            <% end %>
          </a>
        <% end %>
      </div>

      <%= if @cursor_after && @query == "" do %>
        <div class="mt-8 text-center">
          <button
            phx-click="load_more"
            class="px-6 py-2.5 bg-ink-panel border border-ink-panel2 rounded-xl text-parchment-dim hover:text-parchment hover:border-basil/40 transition-colors text-sm font-medium"
          >
            Load more
          </button>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
