<div class="min-h-screen bg-slate-900 pb-16">
  <div class="container max-w-4xl mx-auto px-4 py-8">
    
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white mb-2">Foods & Nutrition</h1>
      <p class="text-slate-400">
        Search our database of ingredients for detailed nutrition facts, vitamins, and minerals.
      </p>
    </div>

    <form phx-change="search" phx-submit="search" class="mb-8">
      <div class="relative">
        <svg
          class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"
          />
        </svg>
        <input
          type="text"
          name="q"
          value={@query}
          placeholder="Search ingredients — e.g. banana, olive oil, feta..."
          phx-debounce="300"
          class="w-full bg-slate-800 border border-slate-700 rounded-xl pl-10 pr-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
          autocomplete="off"
        />
      </div>
    </form>

    <div class="text-sm text-slate-500 mb-4">
      <%= if @query != "" do %>
        {length(@ingredients)} results for "<span class="text-slate-300">{@query}</span>"
      <% else %>
        Showing {length(@ingredients)} ingredients
      <% end %>
    </div>

    <%= if length(@ingredients) == 0 do %>
      <div class="text-center py-16 text-slate-500">
        <svg
          class="w-12 h-12 mx-auto mb-4 opacity-40"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"
          />
        </svg>
        <p>No ingredients found for "<span class="text-slate-400">{@query}</span>"</p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <%= for ingredient <- @ingredients do %>
          <a
            href={"/foods/#{ingredient_slug(ingredient)}"}
            class="group block bg-slate-800 border border-slate-700 rounded-xl p-4 hover:border-primary/50 hover:bg-slate-700/80 transition-colors"
          >
            <div class="flex items-start justify-between gap-2">
              <h2 class="text-sm font-semibold text-white group-hover:text-primary-300 transition-colors leading-snug">
                {Map.get(ingredient, :display_name) || ingredient.name}
              </h2>
              <svg
                class="w-4 h-4 text-slate-600 group-hover:text-slate-400 flex-shrink-0 mt-0.5 transition-colors"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
            <%= if ingredient.category do %>
              <span class="mt-2 inline-block text-xs px-2 py-0.5 rounded-full bg-slate-700 text-slate-400 group-hover:bg-slate-600 transition-colors">
                {ingredient.category.name}
              </span>
            <% end %>
          </a>
        <% end %>
      </div>

      <%= if @cursor_after && @query == "" do %>
        <div class="mt-8 text-center">
          <button
            phx-click="load_more"
            class="px-6 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-slate-300 hover:text-white hover:border-slate-500 transition-colors text-sm font-medium"
          >
            Load more
          </button>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
