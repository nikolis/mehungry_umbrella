<div class="condition-detail-page min-h-screen bg-ink text-parchment pb-16">
  <div class="container max-w-3xl mx-auto px-4 py-8">
    <nav class="text-sm text-parchment-dim mb-6">
      <a href="/conditions" class="hover:text-parchment transition-colors">Conditions</a>
      <span class="mx-2">›</span>
      <span class="text-parchment">{@condition.name}</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-display font-medium text-parchment mb-2">{@condition.name}</h1>
      <%= if @condition.category do %>
        <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-ink-panel2 text-parchment-dim mb-3">
          {@condition.category}
        </span>
      <% end %>
      <%= if @condition.description && @condition.description != "" do %>
        <p class="text-parchment-dim leading-relaxed">{@condition.description}</p>
      <% end %>
    </div>

    <%!-- ── Recommendations ─────────────────────────────────────────────── --%>
    <section class="mb-10">
      <h2 class="text-lg font-display font-medium text-parchment mb-4">Dietary Recommendations</h2>

      <%= cond do %>
        <% @recommendations.loading -> %>
          <div class="space-y-3" aria-hidden="true">
            <div
              :for={_ <- 1..3}
              class="rounded-xl border border-ink-panel2 bg-ink-panel p-4 space-y-2"
            >
              <div class="m3-skeleton h-3.5 w-2/5 rounded bg-ink-panel2" />
              <div class="m3-skeleton h-3 w-3/5 rounded bg-ink-panel2" />
            </div>
          </div>
        <% @recommendations.failed -> %>
          <p class="text-parchment-dim text-sm">Couldn't load recommendations.</p>
        <% @recommendations.ok? && length(@recommendations.result) == 0 -> %>
          <p class="text-parchment-dim text-sm">No recommendations recorded for this condition yet.</p>
        <% true -> %>
          <div class="space-y-6">
            <%= for {rec, rows} <- grouped_recommendations(@recommendations.result) do %>
              <div>
                <h3 class="text-sm font-semibold text-paprika-soft uppercase tracking-wide mb-3">
                  {recommendation_label(rec)}
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <%= for row <- rows do %>
                    <div class="bg-ink-panel border border-ink-panel2 rounded-xl p-4">
                      <div class="flex items-start justify-between gap-2 mb-2">
                        <span class="text-sm font-semibold text-parchment leading-snug">
                          {row.compound.name}
                        </span>
                        <%= if row.severity do %>
                          <span class="text-xs px-2 py-0.5 rounded-full bg-ink-panel2 text-parchment-dim whitespace-nowrap">
                            {String.capitalize(row.severity)}
                          </span>
                        <% end %>
                      </div>
                      <div class="flex flex-wrap items-center gap-2 text-xs text-parchment-dim">
                        <%= if row.evidence_level do %>
                          <span class="px-2 py-0.5 rounded-full bg-ink-panel2">
                            Evidence: {String.capitalize(row.evidence_level)}
                          </span>
                        <% end %>
                        <span class="px-2 py-0.5 rounded-full bg-ink-panel2">
                          {String.capitalize(row.source)}
                        </span>
                      </div>
                      <%= if row.notes && row.notes != "" do %>
                        <p class="text-xs text-parchment-dim mt-2 leading-relaxed">{row.notes}</p>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
      <% end %>
    </section>

    <%!-- ── Foods to be mindful of (derived via the shared compound) ─────── --%>
    <section class="mb-10">
      <h2 class="text-lg font-display font-medium text-parchment mb-4">Foods to Be Mindful Of</h2>

      <%= cond do %>
        <% @ingredients.loading -> %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" aria-hidden="true">
            <div
              :for={_ <- 1..4}
              class="flex items-center gap-3 bg-ink-panel border border-ink-panel2 rounded-xl p-3"
            >
              <div class="flex-1 min-w-0 space-y-2">
                <div class="m3-skeleton h-3.5 w-4/5 rounded bg-ink-panel2" />
                <div class="m3-skeleton h-3 w-1/3 rounded bg-ink-panel2" />
              </div>
            </div>
          </div>
        <% @ingredients.failed -> %>
          <p class="text-parchment-dim text-sm">Couldn't load foods for this condition.</p>
        <% @ingredients.ok? && length(@ingredients.result) == 0 -> %>
          <p class="text-parchment-dim text-sm">
            No foods linked yet — recommendations reference compounds; foods appear once a compound is linked to an ingredient.
          </p>
        <% true -> %>
          <p class="text-sm text-parchment-dim mb-4">
            <span class="font-bold text-basil [font-variant-numeric:tabular-nums]">{length(
              @ingredients.result
            )}</span>
            foods contain a compound flagged for this condition.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <%= for row <- @ingredients.result do %>
              <a
                href={"/foods/#{ingredient_slug(row.ingredient)}"}
                class="group flex items-center justify-between gap-3 bg-ink-panel border border-ink-panel2 rounded-xl p-3 hover:border-paprika/50 hover:bg-ink-panel2/80 transition-colors"
              >
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-parchment group-hover:text-paprika-soft transition-colors truncate">
                    {row.ingredient.name}
                  </p>
                  <p class="text-xs text-parchment-dim mt-0.5">
                    {recommendation_label(row.recommendation)} · {row.compound.name}<%= if row.severity do %>
                      · {String.capitalize(row.severity)}<% end %>
                  </p>
                </div>
                <svg
                  class="w-4 h-4 text-parchment-dim/50 group-hover:text-parchment-dim flex-shrink-0 transition-colors"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            <% end %>
          </div>
      <% end %>
    </section>
  </div>
</div>
