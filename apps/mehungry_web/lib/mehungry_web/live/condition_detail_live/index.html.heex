<div class="condition-detail-page min-h-screen bg-ink text-parchment pb-16">
  <div class="container max-w-3xl mx-auto px-4 py-8">
    <nav class="text-sm text-parchment-dim mb-6">
      <.link navigate={~p"/#{@locale}/conditions"} class="hover:text-parchment transition-colors">
        {gettext("Conditions")}
      </.link>
      <span class="mx-2">›</span>
      <span class="text-parchment">{@condition.name}</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-display font-medium text-parchment mb-2">{@condition.name}</h1>
      <%= if @condition.category do %>
        <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-ink-panel2 text-parchment-dim mb-3">
          {@condition.category}
        </span>
      <% end %>
      <%= if @condition.description && @condition.description != "" do %>
        <p class="text-parchment-dim leading-relaxed">{@condition.description}</p>
      <% end %>
      <%= if is_list(@condition.synonyms) && @condition.synonyms != [] do %>
        <p class="text-xs text-parchment-dim/80 mt-2">
          {gettext("Also known as:")} {Enum.join(@condition.synonyms, ", ")}
        </p>
      <% end %>
    </div>

    <%!-- ── Phase-aware guidance (Active Flare vs Remission …) ───────────── --%>
    <%= if @states != [] do %>
      <section class="mb-10">
        <div class="rounded-xl border border-paprika/30 bg-ink-panel p-4">
          <div class="flex items-start justify-between gap-3 mb-1">
            <h2 class="text-lg font-display font-medium text-parchment">
              {gettext("Advice by disease phase")}
            </h2>
            <.disclaimer_badge />
          </div>
          <p class="text-xs text-parchment-dim mb-3 leading-relaxed">
            {gettext(
              "Dietary advice for this condition depends on its phase — guidance during an active flare can differ sharply from remission. Pick a phase to see phase-specific guidance."
            )}
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <button
              type="button"
              phx-click="select_state"
              phx-value-state="general"
              class={[
                "px-3 py-1.5 rounded-full text-xs font-medium border transition-colors",
                if(is_nil(@selected_state),
                  do: "bg-paprika text-ink border-paprika",
                  else: "border-ink-panel2 text-parchment-dim hover:text-parchment"
                )
              ]}
            >
              {gettext("General")}
            </button>
            <button
              :for={s <- @states}
              type="button"
              phx-click="select_state"
              phx-value-state={s.slug}
              class={[
                "px-3 py-1.5 rounded-full text-xs font-medium border transition-colors",
                if(@selected_state && @selected_state.id == s.id,
                  do: "bg-paprika text-ink border-paprika",
                  else: "border-ink-panel2 text-parchment-dim hover:text-parchment"
                )
              ]}
            >
              {s.name}
            </button>
          </div>

          <%= if @selected_state && @selected_state.description do %>
            <p class="text-xs text-parchment-dim mb-4 italic">{@selected_state.description}</p>
          <% end %>

          <%!-- Phase-specific guidance rows. Dietary Recommendations (phase-less
                compound/nutrient advice) are shown under the "General" tab only —
                advice without a state belongs to General. --%>
          <% show_dietary = is_nil(@selected_state) %>
          <% has_dietary = @recommendations.ok? && @recommendations.result != [] %>

          <%= if @state_recommendations == [] and not (show_dietary and has_dietary) do %>
            <p class="text-parchment-dim text-sm">
              {gettext("No phase-specific guidance recorded for this selection yet.")}
            </p>
          <% else %>
            <%= if @state_recommendations != [] do %>
              <div class="space-y-6">
                <%= for {rec, rows} <- grouped_state_recommendations(@state_recommendations) do %>
                  <div>
                    <h3 class="text-sm font-semibold text-paprika-soft uppercase tracking-wide mb-3">
                      {String.capitalize(rec)}
                    </h3>
                    <ul class="space-y-2">
                      <li
                        :for={row <- rows}
                        class="rounded-lg border border-ink-panel2 bg-ink p-3"
                      >
                        <div class="flex items-center justify-between">
                          <.rec_target_name
                            name={state_rec_target(row)}
                            linkable={rec == "encourage"}
                            blueprint_links={@blueprint_links}
                          />
                          <%= if row.severity do %>
                            <span class="text-xs text-parchment-dim">{row.severity}</span>
                          <% end %>
                        </div>
                        <%= if row.notes && row.notes != "" do %>
                          <p class="text-xs text-parchment-dim mt-1">{row.notes}</p>
                        <% end %>
                        <%= if row.studies != [] do %>
                          <div class="mt-1 flex flex-wrap gap-2">
                            <a
                              :for={s <- row.studies}
                              href={"https://pubmed.ncbi.nlm.nih.gov/#{s.pmid}"}
                              target="_blank"
                              rel="noopener"
                              class="text-[11px] text-basil hover:underline"
                            >
                              PMID {s.pmid}
                            </a>
                          </div>
                        <% end %>
                      </li>
                    </ul>
                  </div>
                <% end %>
              </div>
            <% end %>

            <%= if show_dietary and has_dietary do %>
              <div class={[@state_recommendations != [] && "mt-6 pt-4 border-t border-ink-panel2"]}>
                <h3 class="text-sm font-semibold text-parchment uppercase tracking-wide mb-3">
                  {gettext("Dietary Recommendations")}
                </h3>
                <.dietary_recommendations
                  recommendations={@recommendations}
                  blueprint_links={@blueprint_links}
                />
              </div>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>

    <%!-- ── Free-text notes (verified suggestions with no registry match) ── --%>
    <%= if @general_notes != [] do %>
      <section class="mb-10">
        <div class="rounded-xl border border-ink-panel2 bg-ink-panel p-4">
          <h2 class="text-lg font-display font-medium text-parchment mb-1">
            {gettext("Noted dietary suggestions")}
          </h2>
          <p class="text-xs text-parchment-dim mb-3 leading-relaxed">
            {gettext(
              "Suggestions drawn from the research that we don't yet map to specific foods — informational only, not medical advice."
            )}
          </p>
          <div class="space-y-6">
            <%= for {rec, rows} <- grouped_state_recommendations(@general_notes) do %>
              <div>
                <h3 class="text-sm font-semibold text-paprika-soft uppercase tracking-wide mb-3">
                  {recommendation_label(rec)}
                </h3>
                <ul class="space-y-2">
                  <li :for={row <- rows} class="rounded-lg border border-ink-panel2 bg-ink p-3">
                    <div class="flex items-center justify-between">
                      <.rec_target_name
                        name={state_rec_target(row)}
                        linkable={rec == "encourage"}
                        blueprint_links={@blueprint_links}
                      />
                      <%= if row.severity do %>
                        <span class="text-xs text-parchment-dim">{row.severity}</span>
                      <% end %>
                    </div>
                    <%= if row.studies != [] do %>
                      <div class="mt-1 flex flex-wrap gap-2">
                        <a
                          :for={s <- row.studies}
                          href={pubmed_url(s.pmid)}
                          target="_blank"
                          rel="noopener"
                          class="text-[11px] text-basil hover:underline"
                        >
                          PMID {s.pmid}
                        </a>
                      </div>
                    <% end %>
                  </li>
                </ul>
              </div>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>

    <%!-- ── Recommendations ─────────────────────────────────────────────── --%>
    <%!-- A condition with disease phases shows its (phase-less) dietary
          recommendations inside the "Advice by disease phase" panel under the
          "General" tab; only a phase-less condition renders them as their own
          section here. --%>
    <%= if @states == [] do %>
      <section class="mb-10">
        <div class="flex items-start justify-between gap-3 mb-2">
          <h2 class="text-lg font-display font-medium text-parchment">
            {gettext("Dietary Recommendations")}
          </h2>
          <.disclaimer_badge />
        </div>
        <.dietary_recommendations
          recommendations={@recommendations}
          blueprint_links={@blueprint_links}
        />
      </section>
    <% end %>

    <%!-- ── Research on this condition (reverse-crawl studies) ──────────── --%>
    <%= if @condition_studies != [] do %>
      <section class="mb-10">
        <h2 class="text-lg font-display font-medium text-parchment mb-2">
          {gettext("Research on this condition")}
        </h2>
        <p class="text-xs text-parchment-dim mb-4 leading-relaxed">
          {gettext(
            "Studies discovered about this condition from PubMed. Discovery only — inclusion is not endorsement."
          )}
        </p>
        <ul class="space-y-2">
          <li
            :for={s <- @condition_studies}
            class="rounded-lg border border-ink-panel2 bg-ink-panel p-3"
          >
            <a
              href={"https://pubmed.ncbi.nlm.nih.gov/#{s.pmid}"}
              target="_blank"
              rel="noopener"
              class="text-sm text-parchment hover:text-basil"
            >
              {s.title || "PMID #{s.pmid}"}
            </a>
            <div class="text-[11px] text-parchment-dim mt-0.5">
              <%= if s.journal do %>
                {s.journal} ·
              <% end %>
              PMID {s.pmid}
            </div>
          </li>
        </ul>
      </section>
    <% end %>

    <%!-- ── Diet suggestions (built on encouraged foods, free of mindful ones) ── --%>
    <section class="mb-10">
      <h2 class="text-lg font-display font-medium text-parchment mb-4">
        {gettext("%{name} diet suggestions", name: @condition.name)}
      </h2>

      <%= cond do %>
        <% @recommended_recipes.loading -> %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" aria-hidden="true">
            <div
              :for={_ <- 1..4}
              class="flex items-center gap-3 bg-ink-panel border border-ink-panel2 rounded-xl p-3"
            >
              <div class="m3-skeleton w-16 h-16 rounded-lg bg-ink-panel2 flex-shrink-0" />
              <div class="flex-1 min-w-0 space-y-2">
                <div class="m3-skeleton h-3.5 w-4/5 rounded bg-ink-panel2" />
                <div class="m3-skeleton h-3 w-1/3 rounded bg-ink-panel2" />
              </div>
            </div>
          </div>
        <% @recommended_recipes.failed -> %>
          <p class="text-parchment-dim text-sm">{gettext("Couldn't load recipes.")}</p>
        <% @recommended_recipes.ok? && length(@recommended_recipes.result) == 0 -> %>
          <p class="text-parchment-dim text-sm">
            {gettext("No recipes yet that pair an encouraged food with none of the mindful ones.")}
          </p>
        <% true -> %>
          <p class="text-sm text-parchment-dim mb-4">
            {gettext(
              "Recipes that include an encouraged food and none of the foods to be mindful of."
            )}
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <%= for recipe <- @recommended_recipes.result do %>
              <div class="relative">
                <a
                  href={~p"/#{@locale}/browse/#{recipe.id}"}
                  class="group flex items-center gap-3 bg-ink-panel border border-ink-panel2 rounded-xl p-3 hover:border-paprika/50 hover:bg-ink-panel2/80 transition-colors"
                >
                  <div class="w-16 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-ink-panel2">
                    <%= if recipe.image_url do %>
                      <img
                        src={recipe.image_url}
                        alt={recipe.title}
                        class="w-full h-full object-cover"
                      />
                    <% else %>
                      <div class="w-full h-full flex items-center justify-center">
                        <svg
                          class="w-6 h-6 text-parchment-dim"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                          />
                        </svg>
                      </div>
                    <% end %>
                  </div>
                  <div class="flex-1 min-w-0 pr-7">
                    <p class="text-sm font-medium text-parchment group-hover:text-paprika-soft transition-colors truncate">
                      {recipe.title}
                    </p>
                    <%= if recipe.cooking_time_lower_limit do %>
                      <p class="text-xs text-parchment-dim mt-0.5">
                        <span class="font-bold text-basil [font-variant-numeric:tabular-nums]">{recipe.cooking_time_lower_limit}</span>
                        {gettext("min")}
                      </p>
                    <% end %>
                  </div>
                </a>
                <button
                  :if={is_nil(@current_user) or recipe.user_id != @current_user.id}
                  id={"save-recommended-recipe-#{recipe.id}"}
                  phx-click="save_user_recipe"
                  phx-value-recipe_id={recipe.id}
                  type="button"
                  aria-label={gettext("Save recipe for later")}
                  class="absolute top-2 right-2 z-10 p-1.5 rounded-full bg-ink/40 hover:bg-ink/70 transition backdrop-blur-sm"
                >
                  <svg
                    class="w-4 h-4"
                    fill={if recipe.id in @current_user_recipes, do: "#eb4034", else: "none"}
                    stroke="#eb4034"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                    />
                  </svg>
                </button>
              </div>
            <% end %>
          </div>
      <% end %>
    </section>

    <%!-- ── Food species to be mindful of (derived via the shared compound) ── --%>
    <section class="mb-10">
      <h2 class="text-lg font-display font-medium text-parchment mb-4">
        {gettext("Foods to Avoid or Limit")}
      </h2>

      <%= cond do %>
        <% @species.loading -> %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" aria-hidden="true">
            <div
              :for={_ <- 1..4}
              class="flex items-center gap-3 bg-ink-panel border border-ink-panel2 rounded-xl p-3"
            >
              <div class="flex-1 min-w-0 space-y-2">
                <div class="m3-skeleton h-3.5 w-4/5 rounded bg-ink-panel2" />
                <div class="m3-skeleton h-3 w-1/3 rounded bg-ink-panel2" />
              </div>
            </div>
          </div>
        <% @species.failed -> %>
          <p class="text-parchment-dim text-sm">
            {gettext("Couldn't load foods for this condition.")}
          </p>
        <% @species.ok? && length(mindful_species(@species.result)) == 0 -> %>
          <p class="text-parchment-dim text-sm">
            {gettext(
              "No foods linked yet — recommendations reference compounds; food species appear once a compound is linked to a species."
            )}
          </p>
        <% true -> %>
          <p class="text-sm text-parchment-dim mb-4">
            {gettext("%{count} food species contain a compound flagged for this condition.",
              count: length(mindful_species(@species.result))
            )}
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-start">
            <%= for row <- mindful_species(@species.result) do %>
              <div class="flex flex-col gap-2 bg-ink-panel border border-ink-panel2 rounded-xl p-3">
                <div class="min-w-0">
                  <p class="text-sm font-medium text-parchment truncate">
                    {row.species.name}
                    <span
                      :if={row.species.variety not in [nil, ""]}
                      class="text-parchment-dim font-normal"
                    >· {row.species.variety}</span>
                  </p>
                  <p
                    :if={row.species.scientific_name not in [nil, ""]}
                    class="text-xs italic text-parchment-dim/80 truncate"
                  >
                    {row.species.scientific_name}
                  </p>
                  <p class="text-xs text-parchment-dim mt-0.5">
                    {recommendation_label(row.recommendation)}
                    <%= if row.compound do %>
                      · {row.compound.name}
                    <% end %>
                    <%= if row.severity do %>
                      · {String.capitalize(row.severity)}
                    <% end %>
                  </p>
                </div>
                <%!-- Studies backing the containment fact (e.g. "Alfalfa contains
                      Reactive Oxygen Species") — collapsed to a small toggle while
                      browsing. Each card has its own Alpine state, so expanding one
                      never resizes its neighbour; the grid-rows 0fr→1fr transition
                      animates the open/close. --%>
                <%= if row.fact_citations != [] do %>
                  <div x-data="{ open: false }">
                    <button
                      type="button"
                      @click="open = !open"
                      class="cursor-pointer inline-flex items-center gap-1 text-[11px] text-parchment-dim hover:text-parchment transition-colors"
                    >
                      <svg
                        class="w-3 h-3 transition-transform duration-200"
                        x-bind:class="open && 'rotate-90'"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                      </svg>
                      {gettext("Sources (%{count})", count: length(row.fact_citations))}
                    </button>
                    <div
                      class="grid transition-all duration-200 ease-out"
                      style="grid-template-rows: 0fr"
                      x-bind:style="open ? 'grid-template-rows: 1fr' : 'grid-template-rows: 0fr'"
                    >
                      <div class="overflow-hidden">
                        <ul class="space-y-1 mt-2 pl-4">
                          <li :for={study <- row.fact_citations} class="text-xs leading-snug">
                            <a
                              href={pubmed_url(study.pmid)}
                              target="_blank"
                              rel="noopener nofollow"
                              class="text-basil hover:underline"
                            >
                              {study_label(study)}
                            </a>
                          </li>
                        </ul>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
      <% end %>
    </section>

    <%!-- ── Encouraged foods (good for this condition, via the shared compound) ── --%>
    <section class="mb-10">
      <h2 class="text-lg font-display font-medium text-parchment mb-4">
        {gettext("Foods to Eat")}
      </h2>

      <%= cond do %>
        <% @species.loading -> %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" aria-hidden="true">
            <div
              :for={_ <- 1..2}
              class="flex items-center gap-3 bg-ink-panel border border-ink-panel2 rounded-xl p-3"
            >
              <div class="flex-1 min-w-0 space-y-2">
                <div class="m3-skeleton h-3.5 w-4/5 rounded bg-ink-panel2" />
                <div class="m3-skeleton h-3 w-1/3 rounded bg-ink-panel2" />
              </div>
            </div>
          </div>
        <% @species.failed -> %>
          <p class="text-parchment-dim text-sm">
            {gettext("Couldn't load foods for this condition.")}
          </p>
        <% @species.ok? && length(encouraged_species(@species.result)) == 0 -> %>
          <p class="text-parchment-dim text-sm">
            {gettext("No encouraged foods recorded for this condition yet.")}
          </p>
        <% true -> %>
          <p class="text-sm text-parchment-dim mb-4">
            {gettext(
              "Foods worth including — each contains a compound recommended for this condition."
            )}
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <%= for row <- encouraged_species(@species.result) do %>
              <div class="flex items-center justify-between gap-3 bg-ink-panel border border-ink-panel2 rounded-xl p-3">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-parchment truncate">
                    {row.species.name}
                    <span
                      :if={row.species.variety not in [nil, ""]}
                      class="text-parchment-dim font-normal"
                    >· {row.species.variety}</span>
                  </p>
                  <p
                    :if={row.species.scientific_name not in [nil, ""]}
                    class="text-xs italic text-parchment-dim/80 truncate"
                  >
                    {row.species.scientific_name}
                  </p>
                  <p :if={row.compound} class="text-xs text-parchment-dim mt-0.5">
                    {gettext("via %{compound}", compound: row.compound.name)}
                  </p>
                  <p :if={is_nil(row.compound)} class="text-xs text-parchment-dim mt-0.5">
                    {gettext("Suggested for this condition")}
                  </p>
                </div>
                <.link
                  patch={~p"/#{@locale}/conditions/#{@condition.id}/food/#{row.species.id}"}
                  class="flex-shrink-0 inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold bg-basil/15 text-basil hover:bg-basil/25 transition-colors"
                >
                  {gettext("Details →")}
                </.link>
              </div>
            <% end %>
          </div>
      <% end %>
    </section>

    <%!-- ── Suggested meal plans (blueprints matched to this condition) ───── --%>
    <%= if @suggested_blueprints != [] do %>
      <section class="mb-10">
        <h2 class="text-lg font-display font-medium text-parchment mb-4">
          {gettext("Suggested Meal Plans")}
        </h2>
        <p class="text-sm text-parchment-dim mb-4">
          {gettext("Ready-made meal-plan blueprints matched to this condition.")}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <%= for row <- @suggested_blueprints do %>
            <.link
              navigate={~p"/#{@locale}/blueprints/#{row.blueprint.slug}"}
              class="group flex flex-col gap-1 bg-ink-panel border border-ink-panel2 rounded-xl p-4 hover:border-paprika/50 hover:bg-ink-panel2/80 transition-colors"
            >
              <span class="text-sm font-semibold text-parchment group-hover:text-paprika-soft transition-colors">
                {row.blueprint.name}
              </span>
              <span
                :if={row.blueprint.description not in [nil, ""]}
                class="text-xs text-parchment-dim line-clamp-2"
              >
                {row.blueprint.description}
              </span>
              <span class="mt-1 text-xs font-bold text-basil">
                {gettext("View plan →")}
              </span>
            </.link>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <%!-- ── Encouraged-food preview modal ───────────────────────────────────── --%>
  <.modal
    :if={@live_action == :show_food && @modal_species}
    id="encouraged-food-modal"
    show
    on_cancel={JS.patch(~p"/#{@locale}/conditions/#{@condition.id}")}
  >
    <div class="space-y-6">
      <%!-- Identity --%>
      <div>
        <h2
          id="encouraged-food-modal-title"
          class="text-2xl font-display font-medium text-parchment mb-2"
        >
          {@modal_species.name}
        </h2>
        <div class="flex flex-wrap gap-2">
          <span
            :if={@modal_species.scientific_name not in [nil, ""]}
            class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-ink-panel2 text-parchment-dim italic"
          >
            {@modal_species.scientific_name}
          </span>
          <span
            :if={@modal_species.family not in [nil, ""]}
            class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-ink-panel2 text-parchment-dim"
          >
            {@modal_species.family}
          </span>
          <span
            :if={@modal_species.variety not in [nil, ""]}
            class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-ink-panel2 text-parchment-dim"
          >
            {@modal_species.variety}
          </span>
        </div>
      </div>

      <%!-- Nutrition snapshot --%>
      <div>
        <h3 class="text-sm font-semibold text-parchment-dim uppercase tracking-wide mb-3">
          {gettext("Nutrition")}
          <span class="font-normal normal-case">{gettext("per 100g")}</span>
        </h3>
        <%= cond do %>
          <% @modal_nutrients.loading -> %>
            <div class="grid grid-cols-3 sm:grid-cols-5 gap-3" aria-hidden="true">
              <div :for={_ <- 1..5} class="m3-skeleton h-20 rounded-xl bg-ink-panel2" />
            </div>
          <% @modal_nutrients.failed -> %>
            <p class="text-parchment-dim text-sm">{gettext("Couldn't load nutrition.")}</p>
          <% @modal_nutrients.ok? && length(@modal_nutrients.result) == 0 -> %>
            <p class="text-parchment-dim text-sm">
              {gettext("No nutrition data for this food yet.")}
            </p>
          <% true -> %>
            <div class="grid grid-cols-3 sm:grid-cols-5 gap-3">
              <%= for n <- @modal_nutrients.result do %>
                <div class="bg-ink-panel rounded-xl p-3 text-center border border-ink-panel2">
                  <div class="text-xl font-bold text-basil [font-variant-numeric:tabular-nums]">
                    {format_amount(n.amount)}
                  </div>
                  <div class="text-xs text-parchment-dim mt-0.5">{n.unit}</div>
                  <div class="text-xs font-medium text-parchment-dim mt-1">
                    {nutrient_label(n.label)}
                  </div>
                </div>
              <% end %>
            </div>
        <% end %>
      </div>

      <%!-- Bioactive compounds --%>
      <div>
        <h3 class="text-sm font-semibold text-parchment-dim uppercase tracking-wide mb-3">
          {gettext("Bioactive Compounds")}
        </h3>
        <%= cond do %>
          <% @modal_compounds.loading -> %>
            <div class="flex flex-wrap gap-2" aria-hidden="true">
              <div :for={_ <- 1..4} class="m3-skeleton h-8 w-24 rounded-xl bg-ink-panel2" />
            </div>
          <% @modal_compounds.failed -> %>
            <p class="text-parchment-dim text-sm">{gettext("Couldn't load compounds.")}</p>
          <% @modal_compounds.ok? && length(@modal_compounds.result) == 0 -> %>
            <p class="text-parchment-dim text-sm">
              {gettext("No compounds linked to this food yet.")}
            </p>
          <% true -> %>
            <div class="flex flex-wrap gap-2">
              <%= for rel <- @modal_compounds.result do %>
                <span class="inline-flex items-center gap-2 bg-ink-panel border border-ink-panel2 rounded-xl px-3 py-1.5 text-sm">
                  <span class="text-parchment">{rel.compound.name}</span>
                  <span class="text-xs text-parchment-dim">{relationship_label(
                    rel.relationship_type
                  )}</span>
                </span>
              <% end %>
            </div>
        <% end %>
      </div>

      <%!-- Sample recipes --%>
      <div>
        <h3 class="text-sm font-semibold text-parchment-dim uppercase tracking-wide mb-3">
          {gettext("Sample Recipes")}
        </h3>
        <%= cond do %>
          <% @modal_recipes.loading -> %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" aria-hidden="true">
              <div
                :for={_ <- 1..2}
                class="flex items-center gap-3 bg-ink-panel border border-ink-panel2 rounded-xl p-3"
              >
                <div class="m3-skeleton w-16 h-16 rounded-lg bg-ink-panel2 flex-shrink-0" />
                <div class="flex-1 min-w-0 space-y-2">
                  <div class="m3-skeleton h-3.5 w-4/5 rounded bg-ink-panel2" />
                  <div class="m3-skeleton h-3 w-1/3 rounded bg-ink-panel2" />
                </div>
              </div>
            </div>
          <% @modal_recipes.failed -> %>
            <p class="text-parchment-dim text-sm">{gettext("Couldn't load recipes.")}</p>
          <% @modal_recipes.ok? && length(@modal_recipes.result) == 0 -> %>
            <p class="text-parchment-dim text-sm">
              {gettext("No recipes found for this food yet.")}
            </p>
          <% true -> %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <%= for recipe <- @modal_recipes.result do %>
                <div class="relative">
                  <a
                    href={~p"/#{@locale}/browse/#{recipe.id}"}
                    class="group flex items-center gap-3 bg-ink-panel border border-ink-panel2 rounded-xl p-3 hover:border-paprika/50 hover:bg-ink-panel2/80 transition-colors"
                  >
                    <div class="w-16 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-ink-panel2">
                      <%= if recipe.image_url do %>
                        <img
                          src={recipe.image_url}
                          alt={recipe.title}
                          class="w-full h-full object-cover"
                        />
                      <% else %>
                        <div class="w-full h-full flex items-center justify-center">
                          <svg
                            class="w-6 h-6 text-parchment-dim"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                            />
                          </svg>
                        </div>
                      <% end %>
                    </div>
                    <div class="flex-1 min-w-0 pr-7">
                      <p class="text-sm font-medium text-parchment group-hover:text-paprika-soft transition-colors truncate">
                        {recipe.title}
                      </p>
                      <%= if recipe.cooking_time_lower_limit do %>
                        <p class="text-xs text-parchment-dim mt-0.5">
                          <span class="font-bold text-basil [font-variant-numeric:tabular-nums]">{recipe.cooking_time_lower_limit}</span>
                          {gettext("min")}
                        </p>
                      <% end %>
                    </div>
                  </a>
                  <%!-- Save-for-later heart, mirroring the recipe browser card;
                        hidden on the user's own recipes. --%>
                  <button
                    :if={is_nil(@current_user) or recipe.user_id != @current_user.id}
                    id={"save-modal-recipe-#{recipe.id}"}
                    phx-click="save_user_recipe"
                    phx-value-recipe_id={recipe.id}
                    type="button"
                    aria-label={gettext("Save recipe for later")}
                    class="absolute top-2 right-2 z-10 p-1.5 rounded-full bg-ink/40 hover:bg-ink/70 transition backdrop-blur-sm"
                  >
                    <svg
                      class="w-4 h-4"
                      fill={if recipe.id in @current_user_recipes, do: "#eb4034", else: "none"}
                      stroke="#eb4034"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                      />
                    </svg>
                  </button>
                </div>
              <% end %>
            </div>
        <% end %>
      </div>

      <%!-- Link to the full food page --%>
      <div class="pt-2">
        <a
          href={~p"/#{@locale}/foods/#{species_slug(@modal_species)}"}
          class="inline-flex items-center gap-1 px-5 py-2.5 bg-paprika hover:bg-paprika-soft text-ink rounded-xl transition-colors text-sm font-bold"
        >
          {gettext("View full food page →")}
        </a>
      </div>
    </div>
  </.modal>

  <%!-- ── Blueprint preview modal (encouraged dietary pattern → blueprint) ──── --%>
  <%!-- Mirrors the public blueprint preview page (/blueprints/:slug): header with
        targets, sample meal plans, and the daily macro targets breakdown. --%>
  <.modal
    :if={@modal_blueprint}
    id="condition-blueprint-modal"
    show
    on_cancel={JS.push("close_blueprint")}
  >
    <div class="space-y-6">
      <%!-- Header --%>
      <div>
        <h2
          id="condition-blueprint-modal-title"
          class="text-2xl font-display font-medium text-parchment mb-2"
        >
          {@modal_blueprint.name}
        </h2>
        <p :if={@modal_blueprint.description not in [nil, ""]} class="text-parchment-dim">
          {@modal_blueprint.description}
        </p>

        <div class="flex flex-wrap items-center gap-1.5 mt-3">
          <span
            :if={@modal_blueprint.condition}
            class="text-[11px] px-2 py-0.5 rounded-full bg-paprika/15 text-paprika-soft"
          >
            {@modal_blueprint.condition.name}
          </span>
          <span class="text-[11px] px-2 py-0.5 rounded-full bg-ink-panel2 text-parchment-dim">
            {gettext("7 days · 5 meals/day")}
          </span>
        </div>

        <.blueprint_tag_row
          label={gettext("Prefer")}
          tags={@modal_blueprint.required_nutrients ++ @modal_blueprint.required_compounds}
          tone={:basil}
        />
        <.blueprint_tag_row
          label={gettext("Avoid")}
          tags={@modal_blueprint.avoid_nutrients ++ @modal_blueprint.avoid_compounds}
          tone={:paprika}
        />
        <.blueprint_tag_row
          label={gettext("Preferred foods")}
          tags={@modal_blueprint.preferred_foods}
          tone={:muted}
        />
      </div>

      <%!-- Sample plans --%>
      <div :if={@modal_blueprint_plans != []}>
        <h3 class="text-sm font-semibold text-parchment-dim uppercase tracking-wide mb-3">
          {gettext("Sample meal plans")}
        </h3>
        <div class="space-y-4">
          <div
            :for={plan <- @modal_blueprint_plans}
            class="bg-ink-panel border border-ink-panel2 rounded-xl p-4"
          >
            <div class="flex items-center justify-between mb-3">
              <span class="text-sm font-semibold text-parchment">{plan.name}</span>
              <span class="text-parchment-dim text-xs">
                {gettext("%{count} meals", count: plan.meals_count)}
              </span>
            </div>
            <.plan_meals meals={plan.meals} />
          </div>
        </div>
      </div>

      <%!-- Daily macro targets --%>
      <details class="bg-ink-panel border border-ink-panel2 rounded-xl">
        <summary class="cursor-pointer select-none px-4 py-3 font-semibold text-parchment">
          {gettext("Daily macro targets")}
        </summary>
        <div class="px-4 pb-4 space-y-4">
          <div :for={day <- @modal_blueprint.days}>
            <div class="text-parchment-dim text-xs font-semibold uppercase tracking-wide mb-1.5">
              {gettext("Day %{n}", n: day.day_index)}
              <span :if={day.total_calorie_target} class="normal-case font-normal">
                · {day.total_calorie_target} kcal
              </span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
              <div
                :for={meal <- day.meals}
                class="flex items-center justify-between text-sm"
              >
                <span class="text-parchment-dim">{MealType.label(meal.meal_type)}</span>
                <span class="text-parchment [font-variant-numeric:tabular-nums] text-xs">
                  P {meal.protein_pct}% · C {meal.carbs_pct}% · F {meal.fats_pct}%
                </span>
              </div>
            </div>
          </div>
        </div>
      </details>

      <%!-- Link to the full blueprint page --%>
      <div class="pt-2">
        <a
          href={~p"/#{@locale}/blueprints/#{@modal_blueprint.slug}"}
          class="inline-flex items-center gap-1 px-5 py-2.5 bg-paprika hover:bg-paprika-soft text-ink rounded-xl transition-colors text-sm font-bold"
        >
          {gettext("View full plan →")}
        </a>
      </div>
    </div>
  </.modal>
</div>
