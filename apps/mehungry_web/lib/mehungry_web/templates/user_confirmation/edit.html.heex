<div
  class="min-h-screen bg-ink flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8"
  style="min-height: 95vh;"
>
  <div class="max-w-md w-full space-y-6 bg-ink-panel border border-ink-panel2 rounded-2xl p-8">
    <div class="w-fit h-fit m-auto">
      <img style="width: 48px;" src="/images/logo2.svg" />
    </div>
    <div class="text-center">
      <h1 class="font-display font-medium text-2xl text-parchment">Confirm your account</h1>
      <p class="text-parchment-dim text-sm mt-1">One click away from exploring more</p>
    </div>

    <.form
      :let={_f}
      for={%{}}
      as={:user}
      class="space-y-3"
      action={Routes.user_confirmation_path(@conn, :update, @token)}
    >
      {submit("Confirm my account",
        class:
          "w-full bg-paprika hover:bg-paprika-soft text-ink font-bold py-2.5 rounded-lg transition"
      )}

      <div class="flex items-center gap-3 text-parchment-dim text-xs">
        <div class="flex-1 h-px bg-ink-panel2"></div>
        OR
        <div class="flex-1 h-px bg-ink-panel2"></div>
      </div>

      <a
        href={Routes.user_session_path(@conn, :new)}
        class="flex items-center justify-center w-full py-2.5 rounded-lg border border-ink-panel2 text-parchment hover:border-parchment-dim transition text-sm font-medium"
      >
        Back to Login
      </a>
      <a
        href={Routes.user_registration_path(@conn, :new)}
        class="flex items-center justify-center w-full py-2.5 rounded-lg border border-ink-panel2 text-parchment hover:border-parchment-dim transition text-sm font-medium"
      >
        Register
      </a>
    </.form>
  </div>
</div>
