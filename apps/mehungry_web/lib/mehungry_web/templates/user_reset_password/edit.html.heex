<div
  class="min-h-screen bg-ink flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8"
  style="min-height: 95vh;"
>
  <div class="max-w-md w-full space-y-6 bg-ink-panel border border-ink-panel2 rounded-2xl p-8">
    <div class="w-fit h-fit m-auto">
      <img style="width: 48px;" src="/images/logo2.svg" />
    </div>
    <div class="text-center">
      <h1 class="font-display font-medium text-2xl text-parchment">Reset password</h1>
      <p class="text-parchment-dim text-sm mt-1">Choose a new password for your account</p>
    </div>

    <.form
      :let={f}
      for={@changeset}
      class="space-y-4"
      action={Routes.user_reset_password_path(@conn, :update, @token)}
    >
      <%= if @changeset.action do %>
        <div class="rounded-lg border border-red-500/30 bg-red-500/10 text-red-400 text-sm px-3 py-2">
          <p>Oops, something went wrong! Please check the errors below.</p>
        </div>
      <% end %>

      <div>
        {label(f, :password, "New password", class: "block text-sm text-parchment-dim mb-1")}
        {password_input(f, :password,
          required: true,
          placeholder: "new password",
          class:
            "w-full rounded-lg bg-ink-panel2 border border-ink-panel2 text-parchment px-3 py-2.5 focus:border-paprika focus:outline-none"
        )}
        {error_tag(f, :password)}
      </div>

      <div>
        {label(f, :password_confirmation, "Confirm new password",
          class: "block text-sm text-parchment-dim mb-1"
        )}
        {password_input(f, :password_confirmation,
          required: true,
          placeholder: "confirm password",
          class:
            "w-full rounded-lg bg-ink-panel2 border border-ink-panel2 text-parchment px-3 py-2.5 focus:border-paprika focus:outline-none"
        )}
        {error_tag(f, :password_confirmation)}
      </div>

      <div class="space-y-3 pt-2">
        {submit("Reset password",
          class:
            "w-full bg-paprika hover:bg-paprika-soft text-ink font-bold py-2.5 rounded-lg transition"
        )}

        <div class="flex items-center gap-3 text-parchment-dim text-xs">
          <div class="flex-1 h-px bg-ink-panel2"></div>
          OR
          <div class="flex-1 h-px bg-ink-panel2"></div>
        </div>

        <a
          href={Routes.user_session_path(@conn, :new)}
          class="flex items-center justify-center w-full py-2.5 rounded-lg border border-ink-panel2 text-parchment hover:border-parchment-dim transition text-sm font-medium"
        >
          Back to Login
        </a>
        <a
          href={Routes.user_registration_path(@conn, :new)}
          class="flex items-center justify-center w-full py-2.5 rounded-lg border border-ink-panel2 text-parchment hover:border-parchment-dim transition text-sm font-medium"
        >
          Register
        </a>
      </div>
    </.form>
  </div>
</div>
