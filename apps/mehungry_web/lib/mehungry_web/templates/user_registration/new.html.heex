<div
  class="min-h-screen bg-ink flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8"
  style="min-height: 95vh;"
>
  <div class="max-w-md w-full space-y-6 bg-ink-panel border border-ink-panel2 rounded-2xl p-8">
    <div class="w-fit h-fit m-auto">
      <img style="width: 48px;" src="/images/logo2.svg" />
    </div>
    <div class="text-center">
      <h1 class="font-display font-medium text-2xl text-parchment">Register</h1>
      <p class="text-parchment-dim text-sm mt-1">Explore your taste</p>
    </div>

    <.form
      :let={f}
      for={@changeset}
      class="space-y-4"
      action={Routes.user_registration_path(@conn, :create)}
    >
      <%= if @changeset.action do %>
        <div class="rounded-lg border border-red-500/30 bg-red-500/10 text-red-400 text-sm px-3 py-2">
          <p>Oops, something went wrong! Please check the errors below.</p>
        </div>
      <% end %>

      <div>
        {label(f, :email, class: "block text-sm text-parchment-dim mb-1")}
        {email_input(f, :email,
          required: true,
          class:
            "w-full rounded-lg bg-ink-panel2 border border-ink-panel2 text-parchment px-3 py-2.5 focus:border-paprika focus:outline-none"
        )}
        {error_tag(f, :email)}
      </div>
      <div>
        {label(f, :password, class: "block text-sm text-parchment-dim mb-1")}
        {password_input(f, :password,
          required: true,
          class:
            "w-full rounded-lg bg-ink-panel2 border border-ink-panel2 text-parchment px-3 py-2.5 focus:border-paprika focus:outline-none"
        )}
        <div class="text-right mt-1">
          {link("Forgot your password?",
            to: Routes.user_reset_password_path(@conn, :new),
            class: "text-xs text-parchment-dim hover:text-parchment"
          )}
        </div>
        {error_tag(f, :password)}
      </div>

      <%= if assigns[:turnstile_site_key] do %>
        <div>
          <div class="cf-turnstile w-fit m-auto" data-sitekey={@turnstile_site_key}></div>
          <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer>
          </script>
        </div>
      <% end %>

      <div class="space-y-3 pt-2">
        {submit("Register",
          class:
            "w-full bg-paprika hover:bg-paprika-soft text-ink font-bold py-2.5 rounded-lg transition"
        )}

        <div class="flex items-center gap-3 text-parchment-dim text-xs">
          <div class="flex-1 h-px bg-ink-panel2"></div>
          OR
          <div class="flex-1 h-px bg-ink-panel2"></div>
        </div>

        <a
          href="/auth/facebook"
          class="flex items-center justify-center gap-2 w-full py-2.5 rounded-lg border border-ink-panel2 text-parchment hover:border-parchment-dim transition"
        >
          <img style="width: 20px;" src="/images/facebook.svg" />
          <span class="text-sm font-medium">Sign in with Facebook</span>
        </a>
        <a
          href={Routes.auth_path(@conn, :request, "google")}
          class="flex items-center justify-center gap-2 w-full py-2.5 rounded-lg border border-ink-panel2 text-parchment hover:border-parchment-dim transition"
        >
          <img style="width: 20px" src="/images/google_login.svg" />
          <span class="text-sm font-medium">Sign in with Google</span>
        </a>
        <a
          href="/users/log_in"
          class="flex items-center justify-center w-full py-2.5 rounded-lg text-parchment-dim hover:text-parchment transition text-sm"
        >
          Already have an account? <span class="text-paprika-soft ml-1">Log in</span>
        </a>
      </div>
    </.form>
  </div>
</div>
