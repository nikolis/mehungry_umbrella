<div class="invisible md:visible h-screen w-16 md:w-60 bg-slate-900 border-r border-slate-800 fixed top-0 left-0 flex flex-col z-40">
  <!-- Logo -->
  <div class="px-4 py-5 border-b border-slate-800 flex-shrink-0">
    <a href="/" class="flex items-center gap-3 px-2 rounded-lg">
      {MehungryWeb.SvgComponents.get_logo(%{id: "Main menu"})}
    </a>
  </div>
  
<!-- Main navigation -->
  <nav class="flex-1 flex flex-col gap-1 p-3 overflow-y-auto">
    <a
      href="/browse"
      class="nav_link_basic flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
    >
      <svg
        class="w-5 h-5 flex-shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"
        >
        </path>
      </svg>
      <span class="hidden md:block text-sm font-medium">Browse</span>
    </a>

    <a
      href="/foods"
      class="nav_link_basic flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
    >
      <svg
        class="w-5 h-5 flex-shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16a1 1 0 0 1 1 1v3a8 8 0 0 1-8 8 8 8 0 0 1-8-8V7a1 1 0 0 1 1-1z"
        />
      </svg>
      <span class="hidden md:block text-sm font-medium">Foods</span>
    </a>

    <a
      href="/create_recipe"
      class="nav_link_basic flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
    >
      <svg
        class="w-5 h-5 flex-shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m-8-8h16"></path>
      </svg>
      <span class="hidden md:block text-sm font-medium">Create Recipe</span>
    </a>

    <a
      href="/calendar"
      class="nav_link_basic flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
    >
      <.icon name="hero-calendar" class="h-5 w-5 flex-shrink-0" />
      <span class="hidden md:block text-sm font-medium">Calendar</span>
    </a>

    <a
      href="/basket"
      class="nav_link_basic flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
    >
      <.icon name="hero-shopping-cart" class="h-5 w-5 flex-shrink-0" />
      <span class="hidden md:block text-sm font-medium">Basket</span>
    </a>

    <a
      href="/feedback"
      class="nav_link_basic flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
    >
      <.icon name="hero-chat-bubble-left-ellipsis" class="h-5 w-5 flex-shrink-0" />
      <span class="hidden md:block text-sm font-medium">Give Feedback</span>
    </a>

    <!-- Nutritionist Panel (only for pro/nutritionist subscribers) -->
    <%= if @current_user && Mehungry.Subscriptions.nutritionist?(@current_user.id) do %>
      <a
        href="/nutritionist"
        class="nav_link_basic flex items-center gap-3 px-3 py-2.5 rounded-lg text-teal-400 hover:text-white hover:bg-teal-500/20 border border-teal-500/30 hover:border-teal-500/60 transition-colors mt-2"
      >
        <.icon name="hero-academic-cap" class="h-5 w-5 flex-shrink-0" />
        <span class="hidden md:block text-sm font-medium">Nutritionist Panel</span>
      </a>
    <% end %>

    <!-- Tutor invitations badge (for non-professional users who have pending invitations) -->
    <%= if @current_user && !Mehungry.Subscriptions.nutritionist?(@current_user.id) do %>
      <% pending_count = Mehungry.Professionals.count_pending_invitations_for_client(@current_user.id) %>
      <%= if pending_count > 0 do %>
        <a
          href="/notifications/invitations"
          class="nav_link_basic relative flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors mt-1"
        >
          <div class="relative flex-shrink-0">
            <.icon name="hero-bell" class="h-5 w-5" />
            <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full text-[10px] text-white font-bold flex items-center justify-center">
              {pending_count}
            </span>
          </div>
          <span class="hidden md:block text-sm font-medium">Tutor Invitations</span>
        </a>
      <% end %>
    <% end %>

    <a
      href="/upgrade"
      class="nav_link_basic flex items-center gap-3 px-3 py-2.5 rounded-lg text-primary-400 hover:text-white hover:bg-primary-500/20 border border-primary-500/30 hover:border-primary-500/60 transition-colors mt-2"
    >
      <.icon name="hero-sparkles" class="h-5 w-5 flex-shrink-0" />
      <span class="hidden md:block text-sm font-medium">Upgrade to Pro</span>
    </a>
  </nav>
  
<!-- Bottom: language toggle + profile / login -->
  <div class="p-3 border-t border-slate-800 flex-shrink-0">
    <%= if @current_user do %>
      <div class="flex items-center justify-center gap-1 bg-slate-800 rounded-full p-0.5 mb-2">
        <a
          href="/users/language/en"
          class={"flex-1 text-center px-2 py-1 rounded-full text-xs font-semibold transition-colors #{if @current_language == "en", do: "bg-primary-500 text-white", else: "text-slate-400 hover:text-white"}"}
        >
          EN
        </a>
        <a
          href="/users/language/el"
          class={"flex-1 text-center px-2 py-1 rounded-full text-xs font-semibold transition-colors #{if @current_language == "el", do: "bg-primary-500 text-white", else: "text-slate-400 hover:text-white"}"}
        >
          ΕΛ
        </a>
      </div>
    <% end %>
    <%= if @current_user do %>
      <a
        href="/profile"
        class="nav_link_basic flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
      >
        <img
          src={@current_user.profile_pic}
          class="w-6 h-6 rounded-full flex-shrink-0 object-cover"
        />
        <span class="hidden md:block text-sm font-medium">Profile</span>
      </a>
    <% else %>
      <a
        href="/users/log_in"
        class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
      >
        <.icon name="hero-arrow-right-on-rectangle" class="h-5 w-5 flex-shrink-0" />
        <span class="hidden md:block text-sm font-medium">Log in</span>
      </a>
    <% end %>
  </div>
</div>

<!-- Content area offset -->
<div class="md:ml-60 h-full">
  {@inner_content}
</div>
