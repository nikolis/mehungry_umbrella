<%!-- Consumer mobile bottom bar: five flat labeled tabs. The relationship tab
      (4th) resolves per persona. Recipe creation is intentionally NOT here — it
      is an occasional contribution surfaced contextually (Browse header +
      Profile "Created" tab), not the bar's hero action. Active state is painted
      by fix_navigation_active/0 (assets/js/navigation.js) as `a.current` →
      paprika/basil icon/label + top indicator; phx-update="ignore" so JS owns
      that class. --%>
<% is_nutritionist = @current_user && Mehungry.Subscriptions.nutritionist?(@current_user.id) %>
<nav
  class="nav_container_mobile fixed border-t border-ink-panel2 bg-ink-panel text-parchment-dim"
  id="nav_bar_mobile"
  phx-update="ignore"
>
  <%!-- auto-cols-fr sizes one equal-width column per child, so the five tabs
        stay evenly spread. --%>
  <div class="grid grid-flow-col auto-cols-fr bg-inherit">
    <!-- Browse -->
    <.link
      patch={"/#{@current_language}/browse"}
      class="nav_tab relative flex flex-col items-center justify-center gap-0.5 min-h-[56px] pt-2 pb-1 hover:text-parchment transition-colors"
      title={gettext("Browse")}
      aria-label={gettext("Browse")}
    >
      <span class="nav_tab_indicator absolute top-0 h-0.5 w-7 rounded-full bg-paprika opacity-0"></span>
      <.icon name="hero-book-open" class="h-6 w-6" />
      <span class="text-[10px] leading-none font-medium">{gettext("Browse")}</span>
    </.link>

    <!-- Foods -->
    <.link
      patch={"/#{@current_language}/foods"}
      class="nav_tab relative flex flex-col items-center justify-center gap-0.5 min-h-[56px] pt-2 pb-1 hover:text-parchment transition-colors"
      title={gettext("Foods")}
      aria-label={gettext("Foods")}
    >
      <span class="nav_tab_indicator absolute top-0 h-0.5 w-7 rounded-full bg-paprika opacity-0"></span>
      <svg
        class="h-6 w-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16a1 1 0 0 1 1 1v3a8 8 0 0 1-8 8 8 8 0 0 1-8-8V7a1 1 0 0 1 1-1z"
        />
      </svg>
      <span class="text-[10px] leading-none font-medium">{gettext("Foods")}</span>
    </.link>

    <!-- Calendar -->
    <.link
      patch={"/#{@current_language}/calendar"}
      class="nav_tab relative flex flex-col items-center justify-center gap-0.5 min-h-[56px] pt-2 pb-1 hover:text-parchment transition-colors"
      title={gettext("Calendar")}
      aria-label={gettext("Calendar")}
    >
      <span class="nav_tab_indicator absolute top-0 h-0.5 w-7 rounded-full bg-paprika opacity-0"></span>
      <.icon name="hero-calendar" class="h-6 w-6" />
      <span class="text-[10px] leading-none font-medium">{gettext("Calendar")}</span>
    </.link>

    <%!-- The product's core relationship surface — resolves per persona:
          a nutritionist jumps to their own practice, a client to their
          nutritionist hub, everyone else to the public directory (the
          "find a nutritionist" funnel). --%>
    <%= if is_nutritionist do %>
      <.link
        navigate="/nutritionist"
        class="nav_tab nav_tab_basil relative flex flex-col items-center justify-center gap-0.5 min-h-[56px] pt-2 pb-1 text-basil hover:text-basil-soft transition-colors"
        title={gettext("Your practice")}
        aria-label={gettext("Your practice")}
      >
        <span class="nav_tab_indicator absolute top-0 h-0.5 w-7 rounded-full bg-basil opacity-0"></span>
        <.icon name="hero-squares-2x2" class="h-6 w-6" />
        <span class="text-[10px] leading-none font-medium">{gettext("Practice")}</span>
      </.link>
    <% else %>
      <.link
        navigate={
          if @current_user,
            do: "/#{@current_language}/my-nutritionist",
            else: "/#{@current_language}/nutritionists"
        }
        class="nav_tab relative flex flex-col items-center justify-center gap-0.5 min-h-[56px] pt-2 pb-1 hover:text-parchment transition-colors"
        title={gettext("Nutritionist")}
        aria-label={gettext("Nutritionist")}
      >
        <span class="nav_tab_indicator absolute top-0 h-0.5 w-7 rounded-full bg-paprika opacity-0"></span>
        <.icon name="hero-user-circle" class="h-6 w-6" />
        <span class="text-[10px] leading-none font-medium">{gettext("Nutritionist")}</span>
      </.link>
    <% end %>

    <!-- You / Log in -->
    <a
      href={"/#{@current_language}/profile"}
      class="nav_tab relative flex flex-col items-center justify-center gap-0.5 min-h-[56px] pt-2 pb-1 hover:text-parchment transition-colors"
      title={if @current_user, do: gettext("Profile"), else: gettext("Log in")}
      aria-label={if @current_user, do: gettext("Profile"), else: gettext("Log in")}
    >
      <span class="nav_tab_indicator absolute top-0 h-0.5 w-7 rounded-full bg-paprika opacity-0"></span>
      <%= if @current_user do %>
        <img
          src={@current_user.profile_pic}
          alt=""
          class="h-6 w-6 rounded-full object-cover border border-ink-panel2"
        />
        <span class="text-[10px] leading-none font-medium">{gettext("You")}</span>
      <% else %>
        <.icon name="hero-arrow-right-on-rectangle" class="h-6 w-6" />
        <span class="text-[10px] leading-none font-medium">{gettext("Log in")}</span>
      <% end %>
    </a>
  </div>
</nav>
