<% show_invitations =
  @current_user && !Mehungry.Subscriptions.nutritionist?(@current_user.id) &&
    Mehungry.Professionals.count_pending_invitations_for_client(@current_user.id) > 0 %>
<% friend_requests_count = (@current_user && Mehungry.Friends.count_pending_requests_for(@current_user.id)) || 0 %>
<% show_friend_requests = friend_requests_count > 0 %>
<% menu_cols = 8 + (if show_invitations, do: 1, else: 0) + (if show_friend_requests, do: 1, else: 0) %>
<nav
  class="nav_container_mobile fixed border-t border-ink-panel2 bg-ink-panel text-parchment-dim"
  id="nav_bar_mobile"
  phx-update="ignore"
>
  <div
    class={"grid #{%{8 => "grid-cols-8", 9 => "grid-cols-9", 10 => "grid-cols-10"}[menu_cols]} bg-inherit"}
    style="overflow: hidden; max-height: 64px;"
  >
    <!-- Logo -->
    <.link
      class="flex items-center justify-center p-3 nav_link_basic hover:text-parchment hover:bg-ink-panel2 rounded-lg  transition-colors"
      patch="/"
    >
      {MehungryWeb.SvgComponents.logo_mark(%{id: "nav-mobile", class: "h-7 w-7 text-white"})}
    </.link>

    <!-- Browse -->
    <.link
      patch="/browse"
      class="flex items-center justify-center p-3 nav_link_basic hover:text-parchment hover:bg-ink-panel2 rounded-lg transition-colors"
    >
      <.icon name="hero-book-open" class="h-7 w-7" />
    </.link>

    <a
      href="/conditions"
      class=" flex items-center   rounded-lg text-parchment-dim hover:text-parchment hover:bg-ink-panel2 transition-colors"
    >
      <.icon
        name="hero-heart"
        class="w-7 h-7 flex-shrink-0 mx-auto"
      />
    </a>

    <!-- Foods -->
    <.link
      patch="/foods"
      class="flex items-center justify-center p-3 nav_link_basic rounded-lg text-parchment-dim hover:text-parchment hover:bg-ink-panel2 transition-colors"
    >
      <svg
        class="h-7 w-7"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16a1 1 0 0 1 1 1v3a8 8 0 0 1-8 8 8 8 0 0 1-8-8V7a1 1 0 0 1 1-1z"
        />
      </svg>
    </.link>

    <!-- Create -->
    <.link
      patch="/create_recipe"
      class="flex items-center justify-center p-3 nav_link_basic rounded-lg text-parchment-dim hover:text-parchment hover:bg-ink-panel2 transition-colors"
    >
      <.icon name="hero-plus-circle" class="h-7 w-7" />
    </.link>

    <!-- Calendar -->
    <.link
      patch="/calendar"
      class="flex items-center justify-center p-3 nav_link_basic text-parchment-dim hover:text-parchment hover:bg-ink-panel2 transition-colors rounded-lg"
    >
      <.icon name="hero-calendar" class="h-7 w-7" />
    </.link>

    <!-- Basket -->
    <.link
      patch="/basket"
      class="flex items-center justify-center p-3 nav_link_basic text-parchment-dim hover:text-parchment hover:bg-ink-panel2 transition-colors rounded-lg"
    >
      <.icon name="hero-shopping-cart" class="h-7 w-7" />
    </.link>

    <!-- Tutor invitations (non-professional users with pending invitations) -->
    <%= if show_invitations do %>
      <a
        href="/notifications/invitations"
        class="flex items-center justify-center p-3 nav_link_basic hover:text-parchment hover:bg-ink-panel2 rounded-lg transition-colors"
      >
        <div class="relative">
          <.icon name="hero-bell" class="h-7 w-7" />
          <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full text-[10px] text-white font-bold flex items-center justify-center">
            {Mehungry.Professionals.count_pending_invitations_for_client(@current_user.id)}
          </span>
        </div>
      </a>
    <% end %>

    <!-- Friend requests -->
    <%= if show_friend_requests do %>
      <a
        href="/friends"
        class="flex items-center justify-center p-3 nav_link_basic hover:text-parchment hover:bg-ink-panel2 rounded-lg transition-colors"
      >
        <div class="relative">
          <.icon name="hero-users" class="h-7 w-7" />
          <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full text-[10px] text-white font-bold flex items-center justify-center">
            {friend_requests_count}
          </span>
        </div>
      </a>
    <% end %>

    <!-- Profile / Login -->
    <a
      href={~p"/profile"}
      class="flex items-center justify-center p-3 nav_link_basic hover:text-parchment transition-colors"
    >
      <%= if @current_user do %>
        <img
          src={@current_user.profile_pic}
          class="w-7 h-7 rounded-full object-cover border border-ink-panel2"
        />
      <% else %>
        <.icon name="hero-arrow-right-on-rectangle" class="h-7 w-7" />
      <% end %>
    </a>
  </div>
</nav>
