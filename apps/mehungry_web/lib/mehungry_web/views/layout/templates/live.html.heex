<main role="main" class="" style="height: 100vh; ">
  <div class="mobile_header text-xl text-center text-parchment font-semibold m-auto bg-ink-panel  border-b border-ink-panel2">
    <nav class=" m-auto bg-ink-panel/95 backdrop-blur-md  transition-all duration-300 h-18">
      <span
        class="w-fit m-auto block p-2"
        style="--logo-text-color: #F4EEDD; --logo-tagline-color: transparent;"
      >
        {MehungryWeb.SvgComponents.get_logo(%{id: "live-nav", class: "h-14 w-[220px]"})}
      </span>
    </nav>
  </div>
  <.get_menu
    current_user={assigns[:current_user]}
    current_language={assigns[:current_language] || "en"}
    inner_content={@inner_content}
  />
  <p class="alert alert-info" role="alert" phx-click="lv:clear-flash" phx-value-key="info">
    {Phoenix.Flash.get(@flash, :info)}
  </p>
  <p class="alert alert-danger" role="alert" phx-click="lv:clear-flash" phx-value-key="error">
    {Phoenix.Flash.get(@flash, :error)}
  </p>
  <div></div>
</main>
