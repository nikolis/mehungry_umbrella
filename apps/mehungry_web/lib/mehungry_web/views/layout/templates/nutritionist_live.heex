<div class="min-h-screen bg-ink flex">
  <!-- Nutritionist sidebar -->
  <.nutritionist_sidebar current_user={assigns[:current_user]} />

  <!-- Main content -->
  <div class="flex-1 flex flex-col min-w-0 ml-0 md:ml-64 transition-all duration-300">
    <!-- Flash messages -->
    <%= if Phoenix.Flash.get(@flash, :info) do %>
      <div
        class="fixed top-4 right-4 z-50 flex items-center gap-3 px-4 py-3 rounded-xl bg-basil/10 border border-basil/30 text-basil text-sm shadow-lg max-w-sm"
        phx-click="lv:clear-flash"
        phx-value-key="info"
        role="alert"
      >
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 13l4 4L19 7"
          />
        </svg>
        {Phoenix.Flash.get(@flash, :info)}
      </div>
    <% end %>

    <%= if Phoenix.Flash.get(@flash, :error) do %>
      <div
        class="fixed top-4 right-4 z-50 flex items-center gap-3 px-4 py-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm shadow-lg max-w-sm"
        phx-click="lv:clear-flash"
        phx-value-key="error"
        role="alert"
      >
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
        {Phoenix.Flash.get(@flash, :error)}
      </div>
    <% end %>

    <main class="flex-1 p-4 md:p-8">
      {@inner_content}
    </main>
  </div>
</div>
