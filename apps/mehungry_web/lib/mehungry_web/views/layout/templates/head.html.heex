<% # ─── Compute derived SEO values ─────────────────────────────────────────────
page_title_data = @conn.assigns[:page_seo_data] || @conn.assigns[:page_title]

page_description =
  @conn.assigns[:page_description] ||
    "Discover, share, and analyze recipes with M3Hungry — your AI-powered food companion with USDA nutrition data."

recipe_jsonld = @conn.assigns[:recipe_jsonld]

# Generic structured data: a list of schema.org node maps (e.g. BreadcrumbList,
# MedicalWebPage) emitted together under a single @graph. Pages set it via a
# `:structured_data` assign; other pages leave it nil and emit nothing.
structured_data = @conn.assigns[:structured_data]

# Resolve title, OG image, canonical URL from page_title assign
{resolved_title, og_image, canonical_path} =
  cond do
    is_map(page_title_data) ->
      {
        page_title_data.title <> " | M3Hungry",
        page_title_data[:img],
        "/browse/" <> to_string(page_title_data[:id] || "")
      }

    is_binary(page_title_data) and page_title_data != "" ->
      {page_title_data <> " | M3Hungry", nil, @conn.request_path}

    true ->
      {"M3Hungry — Discover & Analyze Recipes", nil, @conn.request_path}
  end

# A page may override the canonical path (e.g. a modal/deep-link URL that should
# point back at its base page to avoid duplicate content). Locale is applied below.
canonical_path = @conn.assigns[:canonical_path] || canonical_path

base_url = "https://www.m3hungry.com"

# Locale-aware canonical + hreflang alternates. `@locale` is only assigned on
# the localized `:browser` surface (admin/nutritionist run a different pipeline
# and leave it nil) — there we prefix the canonical path with the active locale
# and emit one <link rel="alternate" hreflang> per supported locale + x-default.
locale = @conn.assigns[:locale]

{canonical_url, hreflang_alternates} =
  if locale do
    {
      base_url <> MehungryWeb.Locale.swap_path(canonical_path, locale),
      Enum.map(MehungryWeb.Locale.supported(), fn loc ->
        {loc, base_url <> MehungryWeb.Locale.swap_path(canonical_path, loc)}
      end)
    }
  else
    {base_url <> canonical_path, []}
  end

# Pages that should never be indexed
noindex_prefixes = [
  "/profile",
  "/basket",
  "/calendar",
  "/create_recipe",
  "/users/",
  "/upgrade",
  "/professional/",
  "/admin-dashboard"
]

noindex = Enum.any?(noindex_prefixes, &String.starts_with?(@conn.request_path, &1))

ga_measurement_id = Application.get_env(:mehungry_web, :ga_measurement_id, "G-JPGJG6GCSK")
ga_consent_granted = @conn.assigns[:cookie_consent] == :accepted

# Suppress GA entirely on localhost and for owner/team accounts (their traffic
# would otherwise skew analytics). When gtag is not emitted, the page_view and
# custom-event listeners in app.js no-op via their `typeof gtag === "function"`
# guard — no other wiring needs to change.
ga_blocked_emails = [
  "nikolisgal@gmail.com",
  "ariston.pap@gmail.com",
  "efsouzou@gmail.com",
  "3763921323750265@facebook.user",
  "r3qviem@hotmail.com"
]

ga_current_email = @conn.assigns[:current_user] && @conn.assigns.current_user.email

ga_enabled =
  @conn.host not in ["localhost", "127.0.0.1"] and ga_current_email not in ga_blocked_emails %>
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- ─── Primary SEO ──────────────────────────────────────────────────────── -->
  <title>{resolved_title}</title>
  <meta name="description" content={page_description} />
  <link rel="canonical" href={canonical_url} />
  <%= if not noindex and hreflang_alternates != [] do %>
    <%= for {loc, href} <- hreflang_alternates do %>
      <link rel="alternate" hreflang={loc} href={href} />
    <% end %>
    <link
      rel="alternate"
      hreflang="x-default"
      href={base_url <> MehungryWeb.Locale.swap_path(canonical_path, MehungryWeb.Locale.default())}
    />
  <% end %>
  <%= if noindex do %>
    <meta name="robots" content="noindex, nofollow" />
  <% else %>
    <meta name="robots" content="index, follow" />
  <% end %>

  <!-- ─── Open Graph (Facebook / LinkedIn / Slack previews) ───────────────── -->
  <meta property="og:site_name" content="M3Hungry" />
  <meta property="og:title" content={resolved_title} />
  <meta property="og:description" content={page_description} />
  <meta property="og:url" content={canonical_url} />
  <%= if og_image do %>
    <meta property="og:image" content={og_image} />
    <meta property="og:type" content="article" />
  <% else %>
    <meta property="og:image" content={"#{base_url}/images/og-default.png"} />
    <meta property="og:type" content="website" />
  <% end %>

  <!-- ─── Twitter card ────────────────────────────────────────────────────── -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={resolved_title} />
  <meta name="twitter:description" content={page_description} />
  <%= if og_image do %>
    <meta name="twitter:image" content={og_image} />
  <% end %>

  <!-- ─── JSON-LD structured data (Recipe rich results) ──────────────────── -->
  <%!-- NOTE: use <%= raw(...) %> here, not {..} — HEEx does not evaluate curly
       interpolation inside <script>/<style> tags (it renders as literal text). --%>
  <%= if recipe_jsonld do %>
    <script type="application/ld+json">
      <%= raw(Jason.encode!(recipe_jsonld)) %>
    </script>
  <% end %>
  <%= if structured_data do %>
    <script type="application/ld+json">
      <%= raw(Jason.encode!(%{"@context" => "https://schema.org", "@graph" => structured_data})) %>
    </script>
  <% end %>

  <!-- ─── Favicons ────────────────────────────────────────────────────────── -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="any" />

  <style>
    input:focus,
    textarea:focus,
    select:focus,
    a:focus {
      outline: none;
    }
  </style>

  <!-- ─── Third-party scripts & styles ────────────────────────────────────── -->
  <script
    src="https://code.jquery.com/jquery-3.6.0.min.js"
    integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4="
    crossorigin="anonymous"
  >
  </script>

  <%= if ga_enabled do %>
    <script async src={"https://www.googletagmanager.com/gtag/js?id=#{ga_measurement_id}"}>
    </script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: '<%= if ga_consent_granted, do: "granted", else: "denied" %>'
      });
      gtag('js', new Date());
      gtag('config', '<%= ga_measurement_id %>', { send_page_view: false });
    </script>
  <% end %>

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/gh/habibmhamadi/multi-select-tag@2.0.1/dist/css/multi-select-tag.css"
  />
  <script src="https://cdn.jsdelivr.net/gh/habibmhamadi/multi-select-tag@2.0.1/dist/js/multi-select-tag.js">
  </script>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/selectize.js/0.15.2/css/selectize.default.min.css"
    integrity="sha512-pTaEn+6gF1IeWv3W1+7X7eM60TFu/agjgoHmYhAfLEU8Phuf6JKiiE8YmsNC0aCgQv4192s4Vai8YZ6VNM6vyQ=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  />
  <script
    src="https://cdnjs.cloudflare.com/ajax/libs/selectize.js/0.15.2/js/selectize.min.js"
    integrity="sha512-IOebNkvA/HZjMM7MxL0NYeLYEalloZ8ckak+NDtOViP7oiYzG5vn6WVXyrJDiJPhl4yRdmNAG49iuLmhkUdVsQ=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  >
  </script>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.3.0/css/all.min.css"
    integrity="sha512-SzlrxWUlpfuzQ+pcUCosxcglQRNAq/DZjVsC0lE40xsADsfeQoEypE+enwcOiGjk/bSuGGKHEyjSoQ1zVisanQ=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  />

  <link rel="stylesheet" href="https://uicdn.toast.com/calendar/latest/toastui-calendar.min.css" />
  <script src="https://uicdn.toast.com/calendar/latest/toastui-calendar.min.js">
  </script>

  <link phx-track-static rel="stylesheet" href={Routes.static_path(@conn, "/css/app.css")} />
  <script
    defer
    phx-track-static
    type="text/javascript"
    src={Routes.static_path(@conn, "/js/app.js")}
  >
  </script>

  {csrf_meta_tag()}

  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js">
  </script>
</head>
