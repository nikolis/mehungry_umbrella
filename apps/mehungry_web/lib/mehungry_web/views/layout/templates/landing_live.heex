<div class="w-full bg-ink">
  <%= if Phoenix.Flash.get(@flash, :info) do %>
    <div
      class="fixed top-20 left-1/2 z-50 -translate-x-1/2 rounded-lg border border-basil/30 bg-ink-panel px-4 py-3 text-sm text-basil-soft shadow-xl"
      role="alert"
      phx-click="lv:clear-flash"
      phx-value-key="info"
    >
      {Phoenix.Flash.get(@flash, :info)}
    </div>
  <% end %>
  <%= if Phoenix.Flash.get(@flash, :error) do %>
    <div
      class="fixed top-20 left-1/2 z-50 -translate-x-1/2 rounded-lg border border-red-500/30 bg-ink-panel px-4 py-3 text-sm text-red-300 shadow-xl"
      role="alert"
      phx-click="lv:clear-flash"
      phx-value-key="error"
    >
      {Phoenix.Flash.get(@flash, :error)}
    </div>
  <% end %>
  {@inner_content}
</div>
